      "translations": {
        "en.badr-shahin": [
          "My father, Allah may have mercy upon him, narrated to us from Sa’d bin Abdullah from … al-Harithi that Abu Abdullah (a) said: Anyone who enjoys stinginess, envy, and cowardice cannot be believer. The believer is never coward, stingy, or acquisitive."
        ]
      }
