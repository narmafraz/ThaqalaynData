        "chunks": [
          {
            "arabic_text": "حَدَّثَنِي مُحَمَّدُ بْنُ عَلِيٍّ مَاجِيلَوَيْهَ - رَحِمَهُ اللَّهُ -، عَنْ عَمِّهِ مُحَمَّدِ بْنِ أَبِي الْقَاسِمِ، عَنْ مُحَمَّدِ بْنِ عَلِيٍّ الْقُرَشِيِّ، عَنْ سُفْيَانَ الْجَرِيرِيِّ، عَنْ عَلِيِّ بْنِ الْحَزُورِ، عَنِ الْأَصْبَغِ بْنِ نُبَاتَةَ قَالَ",
            "chunk_type": "isnad",
            "word_end": 32,
            "word_start": 0
          },
          {
            "arabic_text": "لَمَّا أَقْبَلَ أَمِيرُ الْمُؤْمِنِينَ عَلَيْهِ السَّلَامُ مِنَ الْبَصْرَةِ تَلَقَّاهُ أَشْرَافُ النَّاسِ فَهَنَّأُوهُ وَقَالُوا: إِنَّا نَرْجُو أَنْ يَكُونَ هَذَا الْأَمْرَ فِيكُمْ وَلَا يُنَازِعُكُمْ فِيهِ أَحَدٌ أَبَدًا",
            "chunk_type": "body",
            "word_end": 57,
            "word_start": 32
          },
          {
            "arabic_text": "فَقَالَ: هَيْهَاتَ - فِي كَلَامٍ لَهُ - أَنَّى ذَلِكَ وَلَمَّا تَرْمُونَ بِالصَّلْعَاءِ",
            "chunk_type": "body",
            "word_end": 69,
            "word_start": 57
          },
          {
            "arabic_text": "قَالُوا: يَا أَمِيرَ الْمُؤْمِنِينَ وَمَا الصَّلْعَاءُ؟ قَالَ: تُؤْخَذُ أَمْوَالُكُمْ قَسْرًا فَلَا تَمْنَعُونَ",
            "chunk_type": "body",
