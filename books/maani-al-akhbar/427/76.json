        "chunks": [
          {
            "arabic_text": "وَبِهَذَا الْإِسْنَادِ، عَن مُحَمَّدِ بْنِ أَحْمَدَ، عَن مُحَمَّدِ بْنِ هَارُونَ، عَن أَبِي يَحْيَى الْوَاسِطِيِّ، عَمَّنْ ذَكَرَهُ قَالَ",
            "chunk_type": "isnad",
            "word_end": 17,
            "word_start": 0
          },
          {
            "arabic_text": "قَالَ رَجُلٌ لِأَبِي عَبْدِ اللَّهِ عَلَيْهِ السَّلَامُ: إِنَّ النَّاسَ يَقُولُونَ: مَنْ لَمْ يَكُنْ عَرَبِيًّا صَلْبًا أَوْ مَوْلًى صَرِيحًا فَهُوَ سَفِلِيٌّ، فَقَالَ: وَأَيُّ شَيْءٍ الْمَوْلَى الصَّرِيحُ؟ فَقَالَ لَهُ الرَّجُلُ: مَنْ مَلَكَ أَبَوَاهُ، قَالَ: وَلِمَ قَالُوا هَذَا؟",
            "chunk_type": "body",
            "word_end": 52,
            "word_start": 17
          },
          {
            "arabic_text": "قَالَ: قَالُوا لِقَوْلِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَآلِهِ: «مَوْلَى الْقَوْمِ مِنْ أَنْفُسِهِمْ»، فَقَالَ: سُبْحَانَ اللَّهِ، أَمَا بَلَغَكَ أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَآلِهِ قَالَ: «أَنَا مَوْلَى مَنْ لَا مَوْلَى لَهُ، وَأَنَا مَوْلَى كُلِّ مُسْلِمٍ عَرَبِيٍّ وَعَجَمِيٍّ»؟",
            "chunk_type": "body",
            "word_end": 90,
            "word_start": 52
          },
          {
            "arabic_text": "فَمَنْ وَالَى رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَآلَهُ أَفَلَيْسَ يَكُونُ مِنْ نَفْسِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَآلَهُ؟",
            "chunk_type": "body",
            "word_end": 108,
            "word_start": 90
          },
          {
            "arabic_text": "ثُمَّ قَالَ: أَيُّهُمَا أَشْرَفُ: مَنْ كَانَ مِنْ نَفْسِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَآلَهُ، أَوْ مَنْ كَانَ مِنْ نَفْسِ أَعْرَابِيٍّ جُلْفٍ بَائِلٍ عَلَى عَقِبَيْهِ؟",
            "chunk_type": "body",
            "word_end": 132,
            "word_start": 108
          },
          {
            "arabic_text": "ثُمَّ قَالَ صَلَّى اللَّهُ عَلَيْهِ وَآلَهُ: مَنْ دَخَلَ فِي الْإِسْلَامِ رَغْبَةً خَيْرٌ مِمَّنْ دَخَلَ رَهْبَةً، وَدَخَلَ الْمُنَافِقُونَ رَهْبَةً وَالْمَوَالِي دَخَلُوا رَغْبَةً.",
