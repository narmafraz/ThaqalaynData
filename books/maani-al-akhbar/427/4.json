            "chunk_type": "body",
            "word_end": 44,
            "word_start": 25
          },
          {
            "arabic_text": "قُلْتُ: وَالرَّجُلُ يَقَعُ بَيْنَهُ وَبَيْنَ الرَّجُلِ شَيْءٌ فَيَضْرِبُهُ بِسَيْفِهِ فَيَقْتُلُهُ؟",
