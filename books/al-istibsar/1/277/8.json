            "word_end": 18,
            "word_start": 0
          },
          {
            "arabic_text": "الصَّلَاةُ عَلَى الْمَيِّتِ بَعْدَ مَا يُدْفَنُ إِنَّمَا هُوَ الدُّعَاءُ.",
