            "word_end": 29,
            "word_start": 0
          },
          {
            "arabic_text": "يَغْتَسِلُ الَّذِي غَسَّلَ الْمَيِّتَ، وَكُلُّ مَنْ مَسَّ مَيِّتًا فَعَلَيْهِ الْغُسْلُ، وَإِنْ كَانَ الْمَيِّتُ قَدْ غُسِّلَ.",
