      "narrator_chain": {
        "parts": [
          {
            "kind": "plain",
            "text": "وَ بِهَذَا الإِسنَادِ عَن أَحمَدَ بنِ مُحَمّدِ بنِ عِيسَي عَن عَلِيّ بنِ أَحمَدَ بنِ أَشيَمَ عَن صَفوَانَ بنِ يَحيَي قَالَ"
          }
        ]
      },
      "part_type": "Hadith",
      "path": "/books/al-istibsar:1:110:2",
      "text": [
        " سَأَلتُ الرّضَا ع عَنِ التّطَوّعِ بِالنّهَارِ وَ أَنَا فِي السّفَرِ فَقَالَ لَا وَ لَكِن تقَضيِ صَلَاةَ اللّيلِ بِالنّهَارِ وَ أَنتَ فِي السّفَرِ فَقُلتُ جُعِلتُ فِدَاكَ صَلَاةُ النّهَارِ التّيِ أُصَلّيهَا فِي الحَضَرِ أَقضِيهَا بِالنّهَارِ فِي السّفَرِ قَالَ أَمّا أَنَا فَلَا أَقضِيهَا"
      ]
