      "narrator_chain": {
        "parts": [
          {
            "kind": "plain",
            "text": "أخَبرَنَيِ الشّيخُ رَحِمَهُ اللّهُ عَن أَبِي جَعفَرِ بنِ عَلِيّ عَن أَبِيهِ عَن مُحَمّدِ بنِ يَحيَي عَن مُحَمّدِ بنِ الحُسَينِ بنِ أَبِي الخَطّابِ عَن عَلِيّ بنِ أَسبَاطٍ عَن عَلِيّ بنِ جَعفَرٍ قَالَ"
          }
        ]
      },
      "part_type": "Hadith",
      "path": "/books/al-istibsar:1:107:1",
      "text": [
        " سَأَلتُ أَبَا الحَسَنِ مُوسَي ع عَنِ البِنَاءِ عَلَي القَبرِ وَ الجُلُوسِ عَلَيهِ هَل يَصلُحُ قَالَ لَا يَصلُحُ البِنَاءُ عَلَيهِ وَ لَا الجُلُوسُ وَ لَا تَجصِيصُهُ وَ لَا تَطيِينُهُ"
      ]
    },
