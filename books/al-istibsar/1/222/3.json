            "word_end": 21,
            "word_start": 0
          },
          {
            "arabic_text": "إِذَا اسْتَقْبَلْتَ الْقِبْلَةَ بِوَجْهِكَ فَلَا تُقَلِّبْ وَجْهَكَ عَنِ الْقِبْلَةِ فَتُفْسِدَ صَلَاتَكَ.",
            "chunk_type": "opening",
            "word_end": 32,
            "word_start": 21
          },
          {
            "arabic_text": "فَإِنَّ اللَّهَ تَعَالَى قَالَ لِنَبِيِّهِ صَلَّى اللَّهِ عَلَيْهِ وَآلِهِ وَسَلَّمَ فِي الْفَرِيضَةِ: ﴿فَوَلِّ وَجْهَكَ شَطْرَ الْمَسْجِدِ الْحَرَامِ وَحَيْثُ مَا كُنْتُمْ فَوَلُّوا وُجُوهَكُمْ شَطْرَهُ﴾.",
            "chunk_type": "quran_quote",
            "word_end": 55,
            "word_start": 32
          },
          {
            "arabic_text": "وَاخْشَعْ بِبَصَرِكَ وَلَا تَرْفَعْهُ إِلَى السَّمَاءِ وَلَكِنْ حِذَاءَ وَجْهِكَ فِي مَوْضِعِ سُجُودِكَ.",
