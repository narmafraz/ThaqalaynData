      "narrator_chain": {
        "parts": [
          {
            "kind": "plain",
            "text": "أخَبرَنَيِ الشّيخُ رَحِمَهُ اللّهُ عَن أَبِي جَعفَرٍ مُحَمّدِ بنِ عَلِيّ عَن أَبِيهِ عَن مُحَمّدِ بنِ يَحيَي عَن مُحَمّدِ بنِ أَحمَدَ بنِ يَحيَي عَن مُوسَي بنِ جَعفَرٍ عَن عَلِيّ بنِ سَعِيدٍ عَن عُبَيدِ اللّهِ بنِ الدّهقَانِ عَن أَبِي خَالِدٍ قَالَ"
          }
        ]
      },
      "part_type": "Hadith",
      "path": "/books/al-istibsar:1:104:1",
      "text": [
        " اغسِل كُلّ المَوتَي الغَرِيقَ وَ أَكِيلَ السّبُعِ وَ كُلّ شَيءٍ إِلّا مَا قُتِلَ بَينَ الصّفّينِ فَإِن كَانَ بِهِ رَمَقٌ غُسّلَ وَ إِلّا فَلَا"
      ]
    },
