            "word_start": 0
          },
          {
            "arabic_text": "لَبَنُ الْيَهُودِيَّةِ وَالنَّصْرَانِيَّةِ وَالْمَجُوسِيَّةِ أَحَبُّ إِلَيَّ مِن لَبَنِ وَلَدِ الزِّنَا وَكَانَ لَا يَرَى بَأْسًا بِوَلَدِ الزِّنَا إِذَا جَعَلَ مَوْلَى الْجَارِيَةِ الَّذِي فَجَرَ بِالْجَارِيَةِ فِي حِلٍّ",
            "chunk_type": "body",
            "word_end": 43,
