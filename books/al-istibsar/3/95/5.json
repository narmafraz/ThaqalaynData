          {
            "arabic_text": "عَنهُ عَن عِدَّةٍ مِنْ أَصْحَابِنَا عَن سَهْلِ بْنِ زِيَادٍ عَن أَحْمَدَ بْنِ مُحَمَّدِ بْنِ أَبِي نَصْرٍ عَن عَبْدِ الْكَرِيمِ عَن أَبِي بَصِيرٍ عَن أَبِي عَبْدِ اللَّهِ ع قَالَ",
            "chunk_type": "isnad",
            "word_end": 28,
            "word_start": 0
          },
          {
            "arabic_text": "لَا يَحِلّ لَهُ خُلْعُهَا حَتَّى تَقُولَ لِزَوْجِهَا",
            "chunk_type": "body",
            "word_end": 35,
            "word_start": 28
          },
          {
            "arabic_text": "ثُمَّ ذَكَرَ مِثْلَ مَا ذَكَرَ أَصْحَابُنَا",
            "chunk_type": "body",
            "word_end": 41,
            "word_start": 35
          },
          {
            "arabic_text": "ثُمَّ قَالَ أَبُو عَبْدِ اللَّهِ ع قَدْ كَانَ يُرَخَّصُ لِلنِّسَاءِ فِيمَا هُوَ دُونَ هَذَا",
            "chunk_type": "body",
            "word_end": 55,
            "word_start": 41
          },
          {
            "arabic_text": "فَإِذَا قَالَتْ لِزَوْجِهَا حَلّ خُلْعُهَا وَ حَلّ لِزَوْجِهَا مَا أَخَذَ مِنْهَا وَ كَانَتْ عَلَيْهِ تَطْلِيقَتَيْنِ بَاقِيَتَيْنِ فَكَانَ الْخُلْعُ تَطْلِيقَةً",
            "chunk_type": "body",
            "word_end": 74,
            "word_start": 55
          },
          {
            "arabic_text": "و لَا يَكُونُ الْكَلَامُ إِلَّا مِنْ عِنْدِهَا",
            "chunk_type": "body",
            "word_end": 81,
            "word_start": 74
          },
          {
            "arabic_text": "ثُمَّ قَالَ لَو كَانَ الْأَمْرُ إِلَيْنَا لَمْ يَكُنِ الطَّلَاقُ إِلَّا لِلْعِدَّةِ",
            "chunk_type": "closing",
            "word_end": 92,
