            "arabic_text": "مُحَمَّدُ بْنُ أَحْمَدَ بْنِ يَحْيَى عَنْ أَحْمَدَ بْنِ مُحَمَّدِ بْنِ خَالِدٍ عَنْ خَلَفِ بْنِ حَمَّادٍ فِي حَدِيثٍ لَهُ يَرْفَعُهُ إِلَى أَبِي عَبْدِ اللَّهِ ع",
            "chunk_type": "isnad",
            "word_end": 24,
            "word_start": 0
          },
          {
            "arabic_text": "فِي الْمُوَلَّى إِمَّا أَن يُوفِيَ أَوْ يُطَلَّقَ فَإِن فَعَلَ وَإِلَّا ضُرِبَتْ عُنُقُهُ",
            "chunk_type": "body",
            "word_end": 36,
            "word_start": 24
          },
          {
            "arabic_text": "فَهَذَا الْخَبَرُ مُرْسَلٌ لَا يُعْتَرَضُ بِمِثْلِهِ عَلَى الْأَخْبَارِ الْمُسَنَدَةِ",
            "chunk_type": "body",
            "word_end": 45,
            "word_start": 36
          },
          {
            "arabic_text": "وَلَوْ صَحَّ لَكَانَ مَحْمُولًا عَلَى مَنْ يَمْتَنِعُ مِنْ قَبُولِ حُكْمِ الْإِمَامِ إِمَّا الطَّلَاقِ أَوِ الْإِيفَاءِ خِلَافًا عَلَيْهِ وَعَلَى شَرِيعَةِ الْإِسْلَامِ",
            "chunk_type": "body",
            "word_end": 65,
            "word_start": 45
          },
          {
            "arabic_text": "فَإِنَّ مَنْ هَذِهِ صِفَتُهُ يَكُونُ كَافِرًا وَيَجِبُ عَلَيْهِ الْقَتْلُ",
            "chunk_type": "body",
            "word_end": 74,
            "word_start": 65
          },
          {
            "arabic_text": "فَأَمَّا مَنْ لَمْ يَكُنْ كَذَلِكَ لَمْ يَجِبْ عَلَيْهِ أَكْثَرُ مِنَ الْحَبْسِ وَالتَّضْيِيقِ عَلَيْهِ إِلَى أَنْ يُطَلَّقَ أَوْ يُوفِيَ حَسَبَ مَا تَضَمَّنَهُ الْخَبَرَانِ الْأَوَّلَانِ",
