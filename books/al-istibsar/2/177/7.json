          {
            "arabic_text": "سَأَلْتُ أَبَا عَبْدِ اللَّهِ عَنِ امْرَأَةٍ تَطُوفُ بَيْنَ الصَّفَا وَالْمَرْوَةِ وَهِيَ حَائِضٌ قَالَ لَا",
            "chunk_type": "body",
            "word_end": 26,
            "word_start": 12
          },
          {
            "arabic_text": "لِأَنَّ اللَّهَ تَعَالَىٰ يَقُولُ إِنَّ الصَّفَا وَالْمَرْوَةَ مِنْ شَعَائِرِ اللَّهِ",
            "chunk_type": "body",
            "word_end": 36,
            "word_start": 26
          },
          {
            "arabic_text": "وَوَجْهُ الِاسْتِدْلَالِ مِنْ هَذَيْنِ الْخَبَرَيْنِ أَنَّهُ إِنَّمَا مَنَعَاهَا مِنَ السَّعْيِ بَيْنَ الصَّفَا وَالْمَرْوَةِ لِأَنَّهَا لَمْ تَكُنْ طَافَتْ بَعْدُ",
            "chunk_type": "body",
            "word_end": 54,
            "word_start": 36
          },
          {
            "arabic_text": "وَمَشْنَنِ السَّعْيِ أَنْ يَكُونَ بَعْدَ الطَّوَافِ",
            "chunk_type": "body",
            "word_end": 60,
            "word_start": 54
          },
          {
            "arabic_text": "وَلَمْ يَمْنَعَاهَا مِنَ السَّعْيِ لِأَجْلِ كَوْنِهَا حَائِضًا",
            "chunk_type": "body",
            "word_end": 67,
            "word_start": 60
          },
          {
            "arabic_text": "لِأَنَّا قَدْ بَيَّنَّا أَنَّهُ لَيْسَ مِنْ شَرْطِ صِحَّةِ السَّعْيِ الطَّهَارَةُ وَإِنْ كَانَ الْأَفْضَلَ ذَلِكَ",
