            "arabic_text": "مُوسَىٰ بْنُ الْقَاسِمِ عَنِ ابْنِ أَبِي عُمَيْرٍ عَن حَمَّادٍ عَنِ الْحَلَبِيِّ قَالَ",
            "chunk_type": "isnad",
            "word_end": 12,
            "word_start": 0
