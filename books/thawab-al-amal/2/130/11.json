        "chunks": [
          {
            "arabic_text": "وَبِهَذَا الْإِسْنَادِ عَنِ الْحُسَيْنِ بْنِ سَعِيدٍ عَنِ ابْنِ أَبِي عُمَيْرٍ عَنْ عُمَرَ بْنِ أُذَيْنَةَ عَنِ الْفَضْلِ وَزُرَارَةَ عَنْ مُحَمَّدِ بْنِ مُسْلِمٍ عَنْ حُمْرَانَ أَنَّهُ سَأَلَ أَبَا جَعْفَرٍ ع",
            "chunk_type": "isnad",
            "word_end": 28,
            "word_start": 0
          },
          {
            "arabic_text": "عَنْ قَوْلِ اللَّهِ عَزَّ وَجَلَّ: ﴿إِنَّا أَنْزَلْنَاهُ فِي لَيْلَةِ الْقَدْرِ﴾",
            "chunk_type": "opening",
            "word_end": 38,
            "word_start": 28
          },
          {
            "arabic_text": "قَالَ: نَعَمْ، هِيَ لَيْلَةُ الْقَدْرِ، وَهِيَ فِي كُلِّ سَنَةٍ فِي شَهْرِ رَمَضَانَ فِي الْعَشْرِ الْأَوَاخِرِ. فَلَمْ يُنْزَلِ الْقُرْآنُ إِلَّا فِي لَيْلَةِ الْقَدْرِ.",
            "chunk_type": "body",
            "word_end": 60,
            "word_start": 38
          },
          {
            "arabic_text": "قَالَ اللَّهُ عَزَّ وَجَلَّ: ﴿فِيهَا يُفْرَقُ كُلُّ أَمْرٍ حَكِيمٍ﴾. قَالَ: يُقَدَّرُ فِي لَيْلَةِ الْقَدْرِ كُلُّ شَيْءٍ يَكُونُ فِي تِلْكَ السَّنَةِ إِلَى مِثْلِهَا مِنْ قَابِلٍ، مِنْ خَيْرٍ أَوْ شَرٍّ، أَوْ طَاعَةٍ أَوْ مَعْصِيَةٍ، أَوْ مَوْلُودٍ، أَوْ أَجَلٍ، أَوْ رِزْقٍ.",
            "chunk_type": "body",
            "word_end": 98,
            "word_start": 60
          },
          {
            "arabic_text": "فَمَا قُدِّرَ فِي تِلْكَ اللَّيْلَةِ وَقُضِيَ فَهُوَ مِنَ الْمَحْتُومِ، وَلِلَّهِ فِيهِ الْمَشِئَةُ.",
            "chunk_type": "body",
            "word_end": 110,
            "word_start": 98
          },
          {
            "arabic_text": "قَالَ: قُلْتُ لَهُ: ﴿لَيْلَةُ الْقَدْرِ خَيْرٌ مِنْ أَلْفِ شَهْرٍ﴾، أَيُّ شَيْءٍ عَنَى بِهَا؟",
            "chunk_type": "body",
            "word_end": 123,
            "word_start": 110
          },
          {
            "arabic_text": "قَالَ: الْعَمَلُ الصَّالِحُ فِيهَا مِنَ الصَّلَاةِ وَالزَّكَاةِ وَأَنْوَاعِ الْخَيْرِ، خَيْرٌ مِنَ الْعَمَلِ فِي أَلْفِ شَهْرٍ لَيْسَ فِيهَا لَيْلَةُ الْقَدْرِ. وَلَوْ لَا مَا يُضَاعِفُ اللَّهُ لِلْمُؤْمِنِينَ مَا بَلَغُوا، وَلَكِنَّ اللَّهَ عَزَّ وَجَلَّ يُضَاعِفُ لَهُمُ الْحَسَنَاتِ.",
            "chunk_type": "body",
            "word_end": 157,
            "word_start": 123
          }
