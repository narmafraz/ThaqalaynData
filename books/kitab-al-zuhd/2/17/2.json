        "chunks": [
          {
            "arabic_text": "الْحَسَنُ بْنُ مَحْبُوبٍ عَنْ عَلِيِّ بْنِ رِئَابٍ عَنْ أَبِي عَبْدِ اللَّهِ عَلَيْهِ السَّلَامُ قَالَ",
            "chunk_type": "isnad",
            "word_end": 14,
            "word_start": 0
          },
          {
            "arabic_text": "إِنَّ اللَّهَ لَيَمُنُّ عَلَى عَبْدِهِ الْمُؤْمِنِ يَوْمَ الْقِيَامَةِ وَيُدْنِيهِ مِنْ كَرَامَتِهِ ثُمَّ يُعَرِّفُهُ مَا أَنْعَمَ بِهِ عَلَيْهِ",
            "chunk_type": "body",
            "word_end": 31,
            "word_start": 14
          },
          {
            "arabic_text": "يَقُولُ تَبَارَكَ وَتَعَالَى: أَلَمْ تَدْعُنِي يَوْمَ كَذَا وَكَذَا (بِكَذَا وَكَذَا فَأَجَبْتُ عِبْدَكَ؟ أَلَمْ تَسْأَلْنِي يَوْمَ كَذَا وَكَذَا) فَأَعْطَيْتُكَ مَسْأَلَتَكَ؟ أَلَمْ تَسْتَغِثْنِي (فِي) يَوْمَ كَذَا وَكَذَا (فَأَغَثْتُكَ؟ أَلَمْ تَسْأَلْنِي فِي ضُرٍّ كَذَا وَكَذَا) فَكَشَفْتُ ضُرَّكَ وَرَحِمْتُ صَوْتَكَ؟ أَلَمْ تَسْأَلْنِي مَالًا فَامْلَكْتُكَ؟ أَلَمْ تَسْتَخْدِمْنِي فَأَخْدَمْتُكَ؟ أَلَمْ تَسْأَلْنِي أَنْ أُزَوِّجَكَ فَلَانَةَ فَزَوَّجْتُكَ - وَهِيَ مِنْيَعَةٌ عِنْدَ أَهْلِهَا - فَزَوَّجْنَاكَهَا؟",
            "chunk_type": "body",
            "word_end": 87,
            "word_start": 31
          },
          {
            "arabic_text": "فَيَقُولُ الْعَبْدُ: بَلَى يَا رَبِّ قَدْ أَعْطَيْتَنِي كُلَّ مَا سَأَلْتُكَ وَقَدْ كُنْتُ أَسْأَلُكَ الْجَنَّةَ",
            "chunk_type": "body",
            "word_end": 101,
            "word_start": 87
          },
          {
            "arabic_text": "فَيَقُولُ اللَّهُ: (عَزَّ وَجَلَّ) إِنِّي مُنْجِزُكَ مَا سَأَلْتَنِيهِ، هَذِهِ الْجَنَّةُ لَكَ مُبَاحَةٌ أَرْضَيْتَكَ",
            "chunk_type": "body",
            "word_end": 114,
            "word_start": 101
          },
          {
            "arabic_text": "فَيَقُولُ الْمُؤْمِنُ: نَعَمْ يَا رَبِّ (أَرْضَيْتَنِي) وَقَدْ رَضِيتَ",
            "chunk_type": "body",
            "word_end": 122,
            "word_start": 114
          },
          {
            "arabic_text": "فَيَقُولُ تَبَارَكَ وَتَعَالَى: يَا عَبْدِي إِنِّي كُنْتُ أَرْضَى أَعْمَالَكَ وَأَنَا أَرْضَى لَكَ حَسَنَ الْجَزَاءِ فَإِنَّ أَفْضَلَ جَزَائِكَ عِنْدِي أَنْ أُسْكِنَكَ الْجَنَّةَ",
            "chunk_type": "closing",
