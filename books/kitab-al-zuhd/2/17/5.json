          {
            "arabic_text": "الْقَاسِمُ بْنُ مُحَمَّدٍ عَنْ عَلِيٍّ قَالَ: سَمِعْتُ أَبَا عَبْدِ اللَّهِ عَلَيْهِ السَّلَامُ يَقُولُ",
            "chunk_type": "isnad",
            "word_end": 13,
            "word_start": 0
          },
          {
            "arabic_text": "إِنَّ اللَّهَ تَبَارَكَ وَتَعَالَى إِذَا أَرَادَ أَنْ يُحَاسِبَ الْمُؤْمِنَ أَعْطَاهُ كِتَابَهُ بِيَمِينِهِ وَحِسَابُهُ فِيمَا بَيْنَهُ وَبَيْنَهُ فِيَقُولُ: عَبْدِي فَعَلْتَ كَذَا وَكَذَا وَعَمِلْتَ كَذَا وَكَذَا؟ فَيَقُولُ: نَعَمْ يَا رَبِّ قَدْ فَعَلْتُ ذَلِكَ، فَيَقُولُ: قَدْ غَفَرْتُهَا لَكَ وَأَبْدَلْتُهَا حَسَنَاتٍ، فَيَقُولُ النَّاسُ: سُبْحَانَ اللَّهِ، أَمَا كَانَ لِهَذَا الْعَبْدِ سَيِّئَةً وَاحِدَةً؟",
            "chunk_type": "body",
            "word_end": 60,
            "word_start": 13
          },
          {
            "arabic_text": "فَأَمَّا مَنْ أُوتِيَ كِتَابَهُ بِيَمِينِهِ فَسَوْفَ يُحَاسَبُ حِسَابًا يَسِيرًا وَيَنْقَلِبُ إِلَى أَهْلِهِ مَسْرُورًا",
            "chunk_type": "quran_quote",
            "word_end": 73,
            "word_start": 60
          },
          {
            "arabic_text": "قُلْتُ: أَيُّ أَهْلٍ؟ قَالَ: أَهْلُهُ فِي الدُّنْيَا هُمْ أَهْلُهُ فِي الْجَنَّةِ إِنْ كَانُوا مُؤْمِنِينَ",
            "chunk_type": "body",
            "word_end": 87,
            "word_start": 73
          },
          {
            "arabic_text": "وَإِذَا أَرَادَ بِعَبْدٍ شَرًّا حَاسَبَهُ عَلَى رُءُوسِ النَّاسِ وَبَكَتْهُ وَأَعْطَاهُ كِتَابَهُ بِشِمَالِهِ",
            "chunk_type": "body",
            "word_end": 99,
            "word_start": 87
          },
          {
            "arabic_text": "وَأَمَّا مَنْ أُوتِيَ كِتَابَهُ وَرَاءَ ظَهْرِهِ فَسَوْفَ يَدْعُو ثُبُورًا وَيَصْلَىٰ سَعِيرًا إِنَّهُ كَانَ فِي أَهْلِهِ مَسْرُورًا",
            "chunk_type": "quran_quote",
            "word_end": 115,
            "word_start": 99
          },
          {
            "arabic_text": "قُلْتُ: أَيُّ أَهْلٍ؟ قَالَ: أَهْلُهُ فِي الدُّنْيَا",
            "chunk_type": "body",
            "word_end": 122,
            "word_start": 115
          },
          {
            "arabic_text": "قُلْتُ: قَوْلُهُ: إِنَّهُ ظَنَّ أَنْ لَنْ يَحُورَ، قَالَ: ظَنَّ أَنَّهُ لَنْ يَرْجِعَ",
