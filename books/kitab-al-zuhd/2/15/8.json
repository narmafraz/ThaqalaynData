          {
            "arabic_text": "قُلْتُ: جَعَلَنِي اللَّهُ فِدَاكَ مَالَهُ قَالَ هَذَا؟",
            "chunk_type": "body",
            "word_end": 66,
            "word_start": 59
          },
          {
            "arabic_text": "فَقَالَ: لِمَا أَرَى (رَأَى) مِنَ الْعَذَابِ",
