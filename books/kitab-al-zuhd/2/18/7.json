        "chunks": [
          {
            "arabic_text": "مُحَمَّدُ بْنُ أَبِي عُمَيْرٍ عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْحَجَّاجِ قَالَ",
            "chunk_type": "isnad",
            "word_end": 10,
            "word_start": 0
          },
          {
            "arabic_text": "قُلْتُ لِأَبِي عَبْدِ اللَّهِ عَلَيْهِ السَّلَامُ: حَدِيثٌ يَرْوِيهِ النَّاسُ",
            "chunk_type": "opening",
            "word_end": 19,
            "word_start": 10
          },
          {
            "arabic_text": "فَقَالَ: إِنَّهُ لَيْسَ كَمَا يَقُولُونَ",
            "chunk_type": "body",
            "word_end": 24,
            "word_start": 19
          },
          {
            "arabic_text": "ثُمَّ قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَآلِهِ: إِنَّ آخِرَ عَبْدٍ يُؤْمَرُ بِهِ إِلَى النَّارِ فَإِذَا أُمِرَ بِهِ إِلَى النَّارِ التَفَتَ",
            "chunk_type": "body",
            "word_end": 46,
            "word_start": 24
          },
          {
            "arabic_text": "فَيَقُولُ اللَّهُ عَزَّ وَجَلَّ الْجَبَّارُ: أَعْجِلُوهُ",
            "chunk_type": "body",
            "word_end": 52,
            "word_start": 46
          },
          {
            "arabic_text": "فَإِذَا أَتَى بِهِ قِيلَ لَهُ: يَا عَبْدِي لِمَ التَّفَتَّ؟",
            "chunk_type": "body",
            "word_end": 61,
            "word_start": 52
          },
          {
            "arabic_text": "فَيَقُولُ: يَا رَبِّ مَا كَانَ ظَنِّي بِكَ هَذَا",
            "chunk_type": "body",
            "word_end": 69,
            "word_start": 61
          },
          {
            "arabic_text": "فَيَقُولُ اللَّهُ جَلَّ جَلَالُهُ: يَا عَبْدِي وَمَا كَانَ ظَنُّكَ بِي؟",
            "chunk_type": "body",
            "word_end": 79,
            "word_start": 69
          },
          {
            "arabic_text": "فَيَقُولُ: يَا رَبِّ كَانَ ظَنِّي بِكَ أَنْ تَغْفِرَ لِي خَطِيئَتِي وَتُسْكِنِي وَتُدْخِلَنِي جَنَّتَكَ",
            "chunk_type": "body",
            "word_end": 92,
            "word_start": 79
          },
          {
            "arabic_text": "فَيَقُولُ اللَّهُ الْجَبَّارُ جَلَّ وَعَلَا: يَا مَلَائِكَتِي وَعَزَّتِي وَآلَائِي وَبَلَائِي وَجَلَالِي وَعَلُوِي وَارْتِفَاعُ مَكَانِي",
            "chunk_type": "body",
            "word_end": 106,
            "word_start": 92
          },
          {
            "arabic_text": "مَا ظَنَّ بِي عَبْدِي سَاعَةً مِنْ حَيَاتِهِ خَيْرًا قَطُّ",
            "chunk_type": "body",
            "word_end": 115,
            "word_start": 106
          },
          {
            "arabic_text": "وَلَوْ ظَنَّ بِي سَاعَةً مِنْ حَيَاتِهِ خَيْرًا لَمَا رُوِّعَ بِالنَّارِ",
            "chunk_type": "body",
            "word_end": 125,
            "word_start": 115
          },
          {
            "arabic_text": "أَجِيزُوا لَهُ كَذِبَهُ وَأَدْخِلُوهُ الْجَنَّةَ",
            "chunk_type": "body",
            "word_end": 130,
            "word_start": 125
          },
          {
            "arabic_text": "ثُمَّ قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَآلِهِ: لَيْسَ مِنْ عَبْدٍ ظَنَّ مَا ظَنَّ عَبْدٌ بِاللَّهِ خَيْرًا إِلَّا كَانَ اللَّهُ عِنْدَ ظَنِّهِ بِهِ",
            "chunk_type": "closing",
            "word_end": 153,
            "word_start": 130
          },
          {
            "arabic_text": "وَلَا ظَنَّ بِهِ سُوءًا إِلَّا كَانَ اللَّهُ عِنْدَ ظَنِّهِ بِهِ",
            "chunk_type": "closing",
            "word_end": 163,
            "word_start": 153
          },
          {
            "arabic_text": "وَذَلِكَ قَوْلُهُ تَعَالَى: (وَذَلِكَمْ ظَنُّكُمُ الَّذِي ظَنَنتُم بِرَبِّكُمْ أَرْدَاكُمْ فَأَصْبَحْتُم مِّنَ الْخَاسِرِينَ)",
            "chunk_type": "closing",
            "word_end": 175,
