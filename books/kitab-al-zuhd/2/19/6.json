        "chunks": [
          {
            "arabic_text": "النَّضْرُ بْنُ سَوِيدَ عَنْ دُرُسْتٍ عَنْ أَبِي الْمَغْرَاءِ عَنْ أَبِي بَصِيرٍ قَالَ: لَا أَعْلَمُهُ ذَكَرَهُ إِلَّا عَنْ أَبِي جَعْفَرٍ عَلَيْهِ السَّلَامُ",
            "chunk_type": "isnad",
            "word_end": 21,
            "word_start": 0
          },
          {
            "arabic_text": "قَالَ: إِذَا أَدْخَلَ اللَّهُ أَهْلَ الْجَنَّةِ الْجَنَّةَ وَأَهْلَ النَّارِ النَّارَ جِئَ بِالْمَوْتِ فِي صُورَةِ كَبْشٍ حَتَّى يُوقَفَ بَيْنَ الْجَنَّةِ وَالنَّارِ",
            "chunk_type": "body",
            "word_end": 41,
            "word_start": 21
          },
          {
            "arabic_text": "قَالَ: ثُمَّ يُنَادِي مُنَادٍ يَسْمَعُ أَهْلَ الدَّارَيْنِ جَمِيعًا: يَا أَهْلَ الْجَنَّةِ يَا أَهْلَ النَّارِ فَإِذَا سَمِعُوا الصَّوْتَ أَقْبَلُوا",
            "chunk_type": "body",
            "word_end": 59,
            "word_start": 41
          },
          {
            "arabic_text": "قَالَ: فَيُقَالُ لَهُمْ: أَتَدْرُونَ مَا هَذَا؟ هَذَا هُوَ الْمَوْتُ الَّذِي كُنْتُمْ تَخَافُونَ مِنْهُ فِي الدُّنْيَا",
            "chunk_type": "body",
            "word_end": 74,
            "word_start": 59
          },
          {
            "arabic_text": "قَالَ: فَيَقُولُ أَهْلُ الْجَنَّةِ: اللَّهُمَّ لَا تُدْخِلُوا الْمَوْتَ عَلَيْنَا، وَيَقُولُ أَهْلُ النَّارِ: اللَّهُمَّ أَدْخِلُوا الْمَوْتَ عَلَيْنَا",
            "chunk_type": "body",
            "word_end": 90,
            "word_start": 74
          },
          {
            "arabic_text": "قَالَ: ثُمَّ يُذْبَحُ كَمَا تُذْبَحُ الشَّاةُ",
            "chunk_type": "body",
            "word_end": 96,
            "word_start": 90
          },
          {
            "arabic_text": "قَالَ: ثُمَّ يُنَادِي مُنَادٍ: لَا مَوْتَ أَبَدًا، أَيْقِنُوا بِالْخُلُودِ",
            "chunk_type": "body",
            "word_end": 105,
            "word_start": 96
          },
          {
            "arabic_text": "قَالَ: فَيَفْرَحُ أَهْلُ الْجَنَّةِ فَرَحًا لَوْ كَانَ أَحَدٌ يَوْمَئِذٍ يَمُوتُ مِنْ فَرَحٍ لَمَاتُوا",
            "chunk_type": "body",
            "word_end": 118,
            "word_start": 105
          },
          {
            "arabic_text": "(أَفَمَا نَحْنُ بِمَيِّتِينَ إِلَّا مَوْتَتَنَا الْأُولَى وَمَا نَحْنُ بِمُعَذَّبِينَ إِنَّ هَذَا لَهُو الْفَوْزُ الْعَظِيمُ لِمِثْلِ هَذَا فَلْيَعْمَلِ الْعَامِلُونَ)",
            "chunk_type": "quran_quote",
            "word_end": 136,
            "word_start": 118
          },
          {
            "arabic_text": "قَالَ: وَيَشْهَقُ أَهْلُ النَّارِ شَهْقَةً لَوْ كَانَ أَحَدٌ مَيِّتًا يَمُوتُ مِنْ شَهيقٍ لَمَاتُوا",
            "chunk_type": "body",
            "word_end": 149,
            "word_start": 136
          },
          {
            "arabic_text": "وَهُوَ: قَوْلُ اللَّهِ عَزَّ وَجَلَّ: (وَأَنْذِرْهُمْ يَوْمَ الْحَسْرَةِ إِذَا قُضِيَ الْأَمْرُ)",
