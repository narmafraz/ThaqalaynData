        "chunks": [
          {
            "arabic_text": "التَّوْحِيدُ: أَبِي، عَنْ سَعْدٍ، عَنْ أَحْمَدَ بْنِ مُحَمَّدٍ، عَنْ أَبِيهِ، عَنِ ابْنِ الْمَغِيرَةِ، عَنِ ابْنِ مِسْكَانَ، عَنْ زُرَارَةَ قَالَ",
            "chunk_type": "isnad",
            "word_end": 19,
            "word_start": 0
          },
          {
            "arabic_text": "قُلْتُ لِأَبِي جَعْفَرٍ عَلَيْهِ السَّلَامُ: أَصْلَحَكَ اللَّهُ قَوْلُ اللَّهِ عَزَّ وَجَلَّ فِي كِتَابِهِ: «فِطْرَةَ اللَّهِ الَّتِي فَطَرَ النَّاسَ عَلَيْهَا»",
            "chunk_type": "body",
            "word_end": 38,
            "word_start": 19
          },
          {
            "arabic_text": "قَالَ: فَطَرَهُمْ عَلَى التَّوْحِيدِ عِنْدَ الْمِيثَاقِ عَلَى مَعْرِفَتِهِ أَنَّهُ رَبُّهُمْ",
            "chunk_type": "body",
            "word_end": 48,
            "word_start": 38
          },
          {
            "arabic_text": "قُلْتُ: وَخَاطَبُوهُ؟",
            "chunk_type": "body",
            "word_end": 50,
            "word_start": 48
          },
          {
            "arabic_text": "قَالَ: فَطَأْطَأَ رَأْسَهُ ثُمَّ قَالَ: لَوْلَا ذَلِكَ لَمْ يَعْلَمُوا مَنْ رَبُّهُمْ وَلَا مَنْ رَازِقُهُمْ",
            "chunk_type": "body",
            "word_end": 64,
