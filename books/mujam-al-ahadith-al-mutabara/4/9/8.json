        "chunks": [
          {
            "arabic_text": "التَّوْحِيدُ: أَبِي، عَنْ سَعْدٍ، عَنِ ابْنِ هَاشِمٍ وَابْنِ أَبِي الْخَطَّابِ وَابْنِ يَزِيدَ جَمِيعًا، عَنِ ابْنِ أَبِي عُمَيْرٍ، عَنِ ابْنِ أُذَيْنَةَ، عَنِ الزُّرَارَةِ، عَنْ أَبِي جَعْفَرٍ عَلَيْهِ السَّلَامُ قَالَ",
            "chunk_type": "isnad",
            "word_end": 28,
            "word_start": 0
          },
          {
            "arabic_text": "سَأَلْتُهُ عَنْ قَوْلِ اللَّهِ عَزَّ وَجَلَّ حُنَفَاءَ لِلَّهِ غَيْرَ مُشْرِكِينَ بِهِ، وَعَنِ الْحَنِيفِيَّةِ، فَقَالَ: هِيَ الْفِطْرَةُ الَّتِي فَطَرَ النَّاسَ عَلَيْهَا، لَا تَبْدِيلَ لِخَلْقِ اللَّهِ، قَالَ: فَطَرَهُمُ اللَّهُ عَلَى الْمَعْرِفَةِ.",
            "chunk_type": "body",
            "word_end": 57,
            "word_start": 28
          },
          {
            "arabic_text": "قَالَ الزُّرَارَةُ: وَسَأَلْتُهُ عَنْ قَوْلِ اللَّهِ: وَإِذْ أَخَذَ رَبُّكَ مِنْ بَنِي آدَمَ مِنْ ظُهُورِهِمْ ذُرِّيَّتَهُمْ، قَالَ: أَخْرَجَ مِنْ ظَهْرِ آدَمَ ذُرِّيَّتَهُ إِلَى يَوْمِ الْقِيَامَةِ، فَخَرَجُوا كَالذَّرِّ، فَعَرَفَهُمْ وَأَرَاهُمْ صُنْعَهُ، وَلَوْلَا ذَلِكَ لَمْ يَعْرِفْ أَحَدٌ رَبَّهُ.",
            "chunk_type": "body",
            "word_end": 92,
            "word_start": 57
          },
          {
            "arabic_text": "وَقَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَآلِهِ: كُلُّ مَوْلُودٍ يُولَدُ عَلَى الْفِطْرَةِ، يَعْنِي عَلَى الْمَعْرِفَةِ بِأَنَّ اللَّهَ عَزَّ وَجَلَّ خَالِقُهُ، فَذَلِكَ قَوْلُهُ: وَلَئِنْ سَأَلْتَهُمْ مَنْ خَلَقَ السَّمَاوَاتِ وَالْأَرْضَ لَيَقُولُنَّ اللَّهُ",
            "chunk_type": "body",
            "word_end": 123,
            "word_start": 92
          }
