            "chunk_type": "opening",
            "word_end": 41,
            "word_start": 17
          },
          {
            "arabic_text": "فَقَالَ أَبُو الْحَسَنِ عَلَيْهِ السَّلَامُ: سَلْ عَمَّا شِئْتَ",
            "chunk_type": "body",
            "word_end": 49,
            "word_start": 41
          },
          {
            "arabic_text": "فَقَالَ: أَخْبِرْنِي عَنْ رَبِّكَ مَتَى كَانَ؟ وَكَيْفَ كَانَ؟ وَعَلَى أَيِّ شَيْءٍ كَانَ اعْتِمَادُهُ؟",
            "chunk_type": "body",
            "word_end": 62,
            "word_start": 49
          },
          {
            "arabic_text": "فَقَالَ أَبُو الْحَسَنِ عَلَيْهِ السَّلَامُ: إِنَّ اللَّهَ تَبَارَكَ وَتَعَالَى أَضْنَى الْأَيْنَ بِلَا أَيْنٍ وَكَيْفَ الْكَيفَ بِلَا كَيْفٍ وَكَانَ اعْتِمَادُهُ عَلَى قُدْرَتِهِ",
            "chunk_type": "body",
            "word_end": 83,
            "word_start": 62
          },
          {
            "arabic_text": "فَقَامَ إِلَيْهِ الرَّجُلُ فَقَبَّلَ رَأْسَهُ وَقَالَ: أَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللَّهُ وَأَنَّ مُحَمَّدًا رَسُولُ اللَّهِ وَأَنَّ عَلِيًّا وَصِيَّ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَآلِهِ وَالْقَائِمَ بَعْدَهُ بِمَا قَامَ بِهِ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَآلِهِ وَأَنَّكُمُ الْأَئِمَّةُ الصَّادِقُونَ وَأَنَّكَ الْخَلَفُ مِنْ بَعْدِهِمْ",
