        "chunks": [
          {
            "arabic_text": "حَدَّثَنَا مُحَمَّدُ بْنُ يَحْيَى، عَنِ الْأَشْعَرِيِّ، عَنْ سَمَاكَةَ بْنِ مِهْرَانَ، عَنْ أَبِي بَصِيرٍ، عَنْ أَبِي عَبْدِ اللَّهِ عَلَيْهِ السَّلَامِ قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَآلِهِ وَسَلَّمَ: «إِنَّ اللَّهَ تَبَارَكَ وَتَعَالَى لَمْ يَبْعَثْ نَبِيًّا وَلَا إِمَامًا إِلَّا وَهُوَ أَعْلَمُ النَّاسِ بِأَمْرِ اللَّهِ، وَأَحْسَنُهُمْ فِيهِ، وَأَبْصَرُهُمْ لِعَاقِبَةِ أَمْرِهِ»",
            "chunk_type": "isnad",
            "word_end": 48,
            "word_start": 0
          },
          {
            "arabic_text": "قَالَ: «وَلَا يَأْمُرُهُمْ إِلَّا بِمَا يَأْمُرُهُمْ بِهِ اللَّهُ، وَلَا يَنْهَاهُمْ إِلَّا عَمَّا يَنْهَاهُمْ عَنْهُ اللَّهُ، وَلَا يَأْمُرُهُمْ إِلَّا بِمَا يُحِبُّونَ، وَلَا يَنْهَاهُمْ إِلَّا عَمَّا يَكْرَهُونَ»",
            "chunk_type": "body",
            "word_end": 73,
            "word_start": 48
          },
          {
            "arabic_text": "قَالَ: «وَلَا يَأْمُرُهُمْ إِلَّا بِمَا يُحِبُّونَ، وَلَا يَنْهَاهُمْ إِلَّا عَمَّا يَكْرَهُونَ، إِلَّا أَنْ يَكُونَ ذَلِكَ لِمَصْلَحَتِهِمْ، أَوْ لِيُبْتَلِيَهُمْ بِهِ»",
