            "word_end": 42,
            "word_start": 0
          },
          {
            "arabic_text": "قَالَ: فَإِنْ كَانَ ذَلِكَ كَذَلِكَ، فَإِنَّ اللَّهَ تَبَارَكَ وَتَعَالَى لَمْ يَجْعَلْ لِلنَّاسِ عِلْمًا بِمَا يَأْتِي إِلَّا بِالنَّبِيِّ أَوِ الْإِمَامِ",
            "chunk_type": "body",
            "word_end": 61,
            "word_start": 42
