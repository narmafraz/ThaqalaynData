          {
            "arabic_text": "عَنِ الْإِمَامِ الصَّادِقِ (عَلَيْهِ السَّلَامُ) قَالَ: إِنَّ اللَّهَ تَبَارَكَ وَتَعَالَى لَيْسَ بِظَلَّامٍ لِلْعَبِيدِ فِي قَضَائِهِ وَحُكْمِهِ، وَلَكِنَّهُ عَدْلٌ فِي ذَلِكَ.",
            "chunk_type": "opening",
            "word_end": 20,
            "word_start": 0
          },
          {
            "arabic_text": "وَقَالَ: إِنَّ اللَّهَ تَبَارَكَ وَتَعَالَى لَمْ يَخْلُقِ الْجِنَّ وَالْإِنْسَ إِلَّا لِيَعْبُدُوهُ، وَلَمْ يَخْلُقِ الْمَلَائِكَةَ إِلَّا لِلتَّسْبِيحِ وَالْتَقْدِيسِ.",
            "chunk_type": "body",
            "word_end": 37,
            "word_start": 20
          },
          {
            "arabic_text": "وَقَالَ: إِنَّ اللَّهَ تَبَارَكَ وَتَعَالَى خَلَقَ الْعَرْشَ لِعِزَّتِهِ، وَالْكَرْسِيَّ لِكَبْرِيَائِهِ، وَالْبَيْتَ لِحَجَّتِهِ.",
            "chunk_type": "body",
            "word_end": 49,
            "word_start": 37
          },
          {
            "arabic_text": "هَذَا مَا وَرَدَ فِي كِتَابِ كَمَالِ الدِّينِ وَالْإِكْمَالِ فِي حَدِيثِ عَدَدِ الشِّيعَةِ.",
            "chunk_type": "closing",
            "word_end": 61,
            "word_start": 49
          }
