          {
            "arabic_text": "عَنِ الْإِمَامِ جَعْفَرِ بْنِ مُحَمَّدٍ عَلَيْهِ السَّلَامِ قَالَ: قَالَ اللَّهُ تَبَارَكَ وَتَعَالَى: يَا عِبَادِي إِنِّي حَرَمْتُ عَلَىٰ نَفْسِي الظُّلْمَ وَجَعَلْتُهُ بَيْنَكُمْ حَرَامًا فَلَا تَظَالَمُوا.",
            "chunk_type": "body",
            "word_end": 28,
            "word_start": 4
          },
          {
            "arabic_text": "يَا عِبَادِي كُلُّكُمْ ضَالٌّ إِلَّا مَنْ هَدَيْتَ فَاسْتَهْدُونِي أَهْدِكُمْ.",
            "chunk_type": "body",
