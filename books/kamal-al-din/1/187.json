          },
          {
            "arabic_text": "يَا عِبَادِي كُلُّكُمْ جَائِعٌ إِلَّا مَنْ أَطْعَمْتَهُ فَاسْتَطْعِمُونِي أُطْعِمكُمْ.",
            "chunk_type": "body",
            "word_end": 46,
            "word_start": 37
          },
          {
            "arabic_text": "يَا عِبَادِي كُلُّكُمْ عَارٍ إِلَّا مَنْ كَسَوْتَهُ فَاسْتَكْسُونِي أَكْسُكُمْ.",
            "chunk_type": "body",
            "word_end": 55,
            "word_start": 46
          },
          {
            "arabic_text": "يَا عِبَادِي إِنَّكُمْ تُخْطِئُونَ بِاللَّيْلِ وَالنَّهَارِ وَأَنَا أَغْفِرُ الذُّنُوبَ جَمِيعًا فَاسْتَغْفِرُونِي أَغْفِرْ لَكُمْ.",
            "chunk_type": "body",
            "word_end": 68,
            "word_start": 55
          },
          {
            "arabic_text": "يَا عِبَادِي إِنَّكُمْ لَنْ تَبْلُغُوا ضُرِّي فَتَضُرُّونِي وَلَنْ تَبْلُغُوا نَفْعِي فَتَنْفَعُونِي.",
            "chunk_type": "body",
            "word_end": 79,
            "word_start": 68
          },
          {
            "arabic_text": "يَا عِبَادِي لَوْ أَنَّ أَوَّلَكُمْ وَآخِرَكُمْ وَإِنْسَكُمْ وَجِنَّكُمْ كَانُوا عَلَىٰ أَتْقَىٰ قَلْبِ رَجُلٍ وَاحِدٍ مِنْكُمْ لَمْ يَزِدْ فِي مُلْكِي شَيْئًا.",
            "chunk_type": "body",
