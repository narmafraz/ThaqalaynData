            "chunk_type": "body",
            "word_end": 39,
            "word_start": 26
          },
          {
            "arabic_text": "وَإِذَا شَهِدَ بِاللَّهِ وَبِالْإِمَامِ وَلَمْ يَشْهَدْ بِالرَّسُولِ أَعَانَهُ الشَّيْطَانُ عَلَى أَنْ يَكْفُرَ",
            "chunk_type": "body",
