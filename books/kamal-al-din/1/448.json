        "chunks": [
          {
            "arabic_text": "حَدَّثَنَا مُحَمَّدُ بْنُ يَحْيَى، عَنِ الْأَشْعَرِيِّ، عَنْ سَمَاكَةَ بْنِ مِهْرَانَ، عَنْ أَبِي بَصِيرٍ، عَنْ أَبِي عَبْدِ اللَّهِ عَلَيْهِ السَّلَامِ قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَآلِهِ وَسَلَّمَ: «إِنَّ اللَّهَ تَبَارَكَ وَتَعَالَى لَمْ يَبْعَثْ نَبِيًّا وَلَا إِمَامًا إِلَّا وَهُوَ أَعْلَمُ النَّاسِ بِأَمْرِ اللَّهِ، وَأَحْسَنُهُمْ فِيهِ، وَأَبْصَرُهُمْ لَهُ»",
            "chunk_type": "isnad",
            "word_end": 47,
            "word_start": 0
          },
          {
            "arabic_text": "قَالَ: «وَلَمْ يَجْعَلْهُ إِلَّا فِي نَسَبٍ يَسْتَحِقُّهُ، وَلَا يَجْعَلُ الْعِلْمَ إِلَّا فِي مَنْ يَسْتَحِقُّهُ»",
            "chunk_type": "body",
            "word_end": 61,
            "word_start": 47
          },
          {
            "arabic_text": "قَالَ: «فَإِنْ كَانَ ذَلِكَ كَذَلِكَ، فَإِنَّ اللَّهَ تَبَارَكَ وَتَعَالَى قَدْ جَعَلَ لَكُمْ فِي كِتَابِهِ آيَةً تُدْرِكُونَ بِهَا أَمْرَكُمْ، وَتَعْرِفُونَ بِهَا حَلَالَنَا وَحَرَامَنَا»",
            "chunk_type": "body",
            "word_end": 83,
            "word_start": 61
          },
          {
            "arabic_text": "قَالَ: «فَإِنَّهُ لَيْسَ شَيْءٌ مِنْ أَمْرِ اللَّهِ إِلَّا قَدْ بَيَّنَهُ رَسُولُهُ صَلَّى اللَّهُ عَلَيْهِ وَآلِهِ وَسَلَّمَ، ثُمَّ أَدَّاَهُ إِلَى الْأَئِمَّةِ مِنْ بَعْدِهِ»",
            "chunk_type": "body",
            "word_end": 105,
            "word_start": 83
          },
          {
            "arabic_text": "قَالَ: «فَإِنَّهُمْ أَعْلَمُ النَّاسِ بِهِ، وَأَحْفَظُ النَّاسِ لَهُ، وَأَبْصَرُ النَّاسِ بِهِ»",
            "chunk_type": "body",
            "word_end": 116,
            "word_start": 105
          },
          {
            "arabic_text": "قَالَ: «فَمَنْ أَدْرَكَهُمُ الْإِمَامُ مِنْهُمْ، فَلْيَعْتَمِدْ عَلَيْهِمْ، وَلْيَأْخُذْ عَنْهُمْ»",
            "chunk_type": "closing",
