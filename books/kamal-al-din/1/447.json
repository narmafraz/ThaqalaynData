        "chunks": [
          {
            "arabic_text": "حَدَّثَنَا مُحَمَّدُ بْنُ يَحْيَى، عَنِ الْأَشْعَرِيِّ، عَنْ سَمَاكَةَ بْنِ مِهْرَانَ، عَنْ أَبِي بَصِيرٍ، عَنْ أَبِي عَبْدِ اللَّهِ عَلَيْهِ السَّلَامِ قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَآلِهِ وَسَلَّمَ: «إِنَّ اللَّهَ تَبَارَكَ وَتَعَالَى لَمْ يَجْعَلْ شَيْئًا مِنْ أَعْمَالِ ابْنِ آدَمَ أَكْبَرَ مِنْ أَنْ يُقَاتِلَ فِي سَبِيلِهِ»",
            "chunk_type": "isnad",
            "word_end": 45,
            "word_start": 0
          },
          {
            "arabic_text": "قَالَ: «وَلَا شَيْئًا أَقْرَبَ مِنْ الْجَنَّةِ مِنْ أَنْ يُقَاتِلَ فِي سَبِيلِهِ، وَلَا شَيْئًا أَبْعَدَ مِنَ النَّارِ مِنْ أَنْ يُقَاتِلَ فِي سَبِيلِهِ»",
            "chunk_type": "body",
