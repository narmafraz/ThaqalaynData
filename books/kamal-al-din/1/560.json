        "chunks": [
          {
            "arabic_text": "حَدَّثَنَا مُحَمَّدُ بْنُ يَحْيَى، عَنِ الْأَشْعَرِيِّ، عَنْ سَمَاكَةَ بْنِ مِهْرَانَ، عَنْ أَبِي بَصِيرٍ، عَنْ أَبِي عَبْدِ اللَّهِ عَلَيْهِ السَّلَامِ قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَآلِهِ وَسَلَّمَ: «إِنَّ اللَّهَ تَبَارَكَ وَتَعَالَى لَمْ يَبْعَثْ نَبِيًّا وَلَا إِمَامًا إِلَّا وَهُوَ أَعْلَمُ النَّاسِ بِأَمْرِ اللَّهِ، وَأَحْسَنُهُمْ فِيهِ، وَأَبْصَرُهُمْ لَهُ»",
            "chunk_type": "isnad",
            "word_end": 47,
            "word_start": 0
          },
          {
            "arabic_text": "قَالَ: «وَلَا يَكُونُ لَهُمْ فِي ذَلِكَ شُكٌّ وَلَا رَيْبٌ، إِلَّا أَنَّهُمْ يَخَافُونَ أَنْ يُفْتَنُوا بِهِ، أَوْ يُبْتَلَى بِهِ النَّاسُ»",
            "chunk_type": "body",
            "word_end": 66,
            "word_start": 47
          },
          {
            "arabic_text": "قَالَ: «فَإِنَّ اللَّهَ تَبَارَكَ وَتَعَالَى قَدْ جَعَلَ فِيهِمْ الْعِلْمَ وَالْحِكْمَةَ، وَجَعَلَ لَهُمْ الْوِلَايَةَ عَلَى النَّاسِ»",
            "chunk_type": "body",
            "word_end": 81,
            "word_start": 66
          },
          {
            "arabic_text": "قَالَ: «وَهُمْ أَعْلَمُ بِمَا نَزَلَ مِنْ السَّمَاءِ، وَأَحْفَظُ لِمَا أُنْزِلَ إِلَيْهِمْ، وَأَبْصَرُ بِمَا خُلِقَ فِي الْأَرْضِ»",
            "chunk_type": "body",
            "word_end": 97,
            "word_start": 81
          },
          {
            "arabic_text": "قَالَ: «وَهُمْ أَعْلَمُ بِأَحْكَامِ اللَّهِ فِي الْأَرْضِ وَالسَّمَاءِ، وَأَحْسَبُ لَهُمْ عِنْدَ اللَّهِ مَقَامًا»",
            "chunk_type": "body",
            "word_end": 110,
            "word_start": 97
          },
          {
            "arabic_text": "قَالَ: «فَإِنْ كُنْتُمْ فِي شَكٍّ مِنْهُمْ، فَكُونُوا فِي شَكٍّ مِنْ اللَّهِ، وَإِنْ كُنْتُمْ فِي رَيْبٍ مِنْهُمْ، فَكُونُوا فِي رَيْبٍ مِنْ اللَّهِ»",
            "chunk_type": "closing",
