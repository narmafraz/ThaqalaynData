        "chunks": [
          {
            "arabic_text": "حَدَّثَنَا مُحَمَّدُ بْنُ يَحْيَى، عَنِ الْأَشْعَرِيِّ، عَنْ مُحَمَّدِ بْنِ سَعْدٍ، عَنْ أَبِي بَصِيرٍ، عَنِ imāmِ جَعْفَرِ بْنِ مُحَمَّدٍ عَلَيْهِ السَّلَامِ قَالَ: قَالَ imāmُ عَلِيٍّ عَلَيْهِ السَّلَامُ: «إِنَّ اللَّهَ تَبَارَكَ وَتَعَالَى لَمْ يَجْعَلْ لِلشَّيْطَانِ سُلْطَانًا عَلَى الْمُؤْمِنِينَ»",
            "chunk_type": "isnad",
            "word_end": 36,
            "word_start": 0
          },
          {
            "arabic_text": "قَالَ: «إِلَّا مَا اسْتَحَلَّهُمْ مِنْهُ بِطَاعَتِهِمْ لَهُ فِي أُمُورِ اللَّهِ»",
            "chunk_type": "body",
            "word_end": 46,
            "word_start": 36
          },
          {
            "arabic_text": "قَالَ: «وَلَا يَسُطُّونَ عَلَيْهِمْ إِلَّا بِإِذْنِهِ»",
            "chunk_type": "body",
            "word_end": 52,
            "word_start": 46
          },
          {
            "arabic_text": "قَالَ: «فَمَنِ اسْتَحَلَّهُ اللَّهُ مِنْهُمْ بِطَاعَتِهِ لَهُ فِي أُمُورِهِ، فَهُوَ لَهُ سُلْطَانٌ»",
            "chunk_type": "body",
            "word_end": 64,
            "word_start": 52
          },
          {
            "arabic_text": "قَالَ: «وَمَنْ لَمْ يَسْتَحِلْهُ اللَّهُ مِنْهُمْ بِطَاعَتِهِ لَهُ، فَلَا سُلْطَانَ لَهُ عَلَيْهِ»",
            "chunk_type": "body",
            "word_end": 76,
            "word_start": 64
          },
          {
            "arabic_text": "قَالَ: «وَهَذَا هُوَ الْقَوْلُ الْفَصْلُ»",
