        "chunks": [
          {
            "arabic_text": "حَدَّثَنَا مُحَمَّدُ بْنُ يَحْيَى، عَنِ الْأَشْعَرِيِّ، عَنْ سَمَاكَةَ بْنِ مِهْرَانَ، عَنْ أَبِي بَصِيرٍ، عَنْ أَبِي عَبْدِ اللَّهِ عَلَيْهِ السَّلَامِ قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَآلِهِ وَسَلَّمَ: «إِنَّ اللَّهَ تَبَارَكَ وَتَعَالَى لَمْ يَخْلُقْ شَيْئًا إِلَّا وَهُوَ لَهُ عَاقِلٌ»",
            "chunk_type": "isnad",
            "word_end": 39,
            "word_start": 0
          },
          {
            "arabic_text": "قَالَ: «وَمَا مِنْ شَيْءٍ إِلَّا لَهُ عَاقِلٌ، إِلَّا الْجِنَّ وَالْإِنْسَ، فَإِنَّهُمَا لَهُمَا عَاقِلَانِ: عَاقِلٌ يَدُلُّهُمَا عَلَى الْخَيْرِ، وَعَاقِلٌ يَدُلُّهُمَا عَلَى الشَّرِّ»",
            "chunk_type": "body",
