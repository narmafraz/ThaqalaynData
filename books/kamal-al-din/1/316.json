        "chunks": [
          {
            "arabic_text": "حَدَّثَنَا مُحَمَّدُ بْنُ يَحْيَى، عَنْ أَحْمَدَ بْنِ مُحَمَّدٍ، عَنْ عَلِيِّ بْنِ الْحَكَمِ، عَنْ أَبِي بَصِيرٍ، عَنْ أَبِي عَبْدِ اللَّهِ عَلَيْهِ السَّلَامِ قَالَ",
            "chunk_type": "isnad",
            "word_end": 22,
            "word_start": 0
          },
          {
            "arabic_text": "قَالَ: إِنَّ اللَّهَ تَبَارَكَ وَتَعَالَى لَمْ يَخْلُقْ شَيْئًا إِلَّا وَهُوَ يُرِيدُ أَنْ يُعْبَدَ بِهِ، وَلَمْ يَخْلُقْ شَيْئًا إِلَّا وَهُوَ يُرِيدُ أَنْ يُتَقَرَّبَ بِهِ إِلَيْهِ، وَلَمْ يَخْلَقْ شَيْئًا إِلَّا وَهُوَ يُرِيدُ أَنْ يُتَعَلَّمَ عِلْمُهُ، وَلَمْ يَخْلُقْ شَيْئًا إِلَّا وَهُوَ يُرِيدُ أَنْ يُتَبَرَّكَ بِهِ",
            "chunk_type": "body",
            "word_end": 64,
            "word_start": 22
          },
          {
            "arabic_text": "فَالصَّلَاةُ قَدَّمَهَا عَلَى سَائِرِ الْأَشْيَاءِ، لِأَنَّهَا أَوَّلُ مَا يُحَاسَبُ بِهِ الْعَبْدُ، فَإِنْ قُبِلَتْ قُبِلَ مَا سِوَاهَا، وَإِنْ رُدَّتْ رُدَّ مَا سِوَاهَا",
            "chunk_type": "body",
            "word_end": 85,
            "word_start": 64
          },
          {
            "arabic_text": "وَالزَّكَاةُ قَدَّمَهَا عَلَى سَائِرِ الْأَمْوَالِ، لِأَنَّهَا تُطَهِّرُ الْمَالَ وَتُزَكِّيهِ",
            "chunk_type": "body",
            "word_end": 94,
            "word_start": 85
          },
          {
            "arabic_text": "وَالْحَجُّ قَدَّمَهُ عَلَى سَائِرِ الْأَعْمَالِ، لِأَنَّهُ رُكْنُ اللَّهِ فِي أَرْضِهِ",
            "chunk_type": "body",
            "word_end": 104,
            "word_start": 94
          },
          {
            "arabic_text": "وَالصَّوْمُ قَدَّمَهُ عَلَى سَائِرِ الْأَعْمَالِ، لِأَنَّهُ جُنَّةٌ مِنَ النَّارِ",
            "chunk_type": "body",
            "word_end": 113,
            "word_start": 104
          },
          {
            "arabic_text": "وَالْجِهَادُ قَدَّمَهُ عَلَى سَائِرِ الْأَعْمَالِ، لِأَنَّهُ بَابٌ مِنْ أَبْوَابِ الْجَنَّةِ",
            "chunk_type": "body",
            "word_end": 123,
            "word_start": 113
          },
          {
            "arabic_text": "قُلْتُ: كَيْفَ يُحَاسَبُ بِهِ؟ قَالَ: يُحَاسَبُ بِهِ يَوْمَ الْقِيَامَةِ",
