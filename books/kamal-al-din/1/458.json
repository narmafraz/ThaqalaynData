        "chunks": [
          {
            "arabic_text": "حَدَّثَنَا مُحَمَّدُ بْنُ يَحْيَى، عَنِ الْأَشْعَرِيِّ، عَنْ مُحَمَّدِ بْنِ سَعْدٍ، عَنْ أَبِي بَصِيرٍ، عَنِ imāmِ جَعْفَرِ بْنِ مُحَمَّدٍ عَلَيْهِ السَّلَامِ قَالَ: قَالَ imāmُ عَلِيٍّ عَلَيْهِ السَّلَامُ: «إِنَّ اللَّهَ تَبَارَكَ وَتَعَالَى لَمْ يَجْعَلْ لِلشَّيْطَانِ سُلْطَانًا عَلَى الْمُؤْمِنِينَ»",
            "chunk_type": "isnad",
            "word_end": 36,
            "word_start": 0
          },
          {
            "arabic_text": "قَالَ: «إِلَّا مَا جَعَلَ اللَّهُ لَهُمْ مِنْ طَاعَتِهِمْ لَهُ فِي الْأُمُورِ الَّتِي خَيَّرَهُمْ فِيهَا، كَالزَّكَاةِ وَالصِّيَامِ وَالْحَجِّ وَالْجِهَادِ»",
            "chunk_type": "body",
            "word_end": 54,
            "word_start": 36
          },
          {
            "arabic_text": "قَالَ: «فَأَمَّا الزَّكَاةُ فَإِنَّ الشَّيْطَانَ يُقَاتِلُ عَلَيْهِمْ، وَأَمَّا الصِّيَامُ فَإِنَّ الشَّيْطَانَ يُقَاتِلُ عَلَيْهِمْ، وَأَمَّا الْحَجُّ فَإِنَّ الشَّيْطَانَ يُقَاتِلُ عَلَيْهِمْ، وَأَمَّا الْجِهَادُ فَإِنَّ الشَّيْطَانَ يُقَاتِلُ عَلَيْهِمْ»",
            "chunk_type": "body",
            "word_end": 79,
            "word_start": 54
          },
          {
            "arabic_text": "قَالَ: «وَلَيْسَ لِلشَّيْطَانِ سُلْطَانٌ عَلَى الْمُؤْمِنِينَ فِي غَيْرِ هَذِهِ الْأُمُورِ»",
