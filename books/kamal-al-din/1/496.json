            "chunk_type": "body",
            "word_end": 23,
            "word_start": 9
          },
          {
            "arabic_text": "وَتَقْبَلَ مِنِّي صَلاَتِي وَصِيَامِي وَدُعَائِي وَذِكْرِي وَتَسْبِيحِي وَتَهْلِيلِي وَتَكْبِيرِي",
