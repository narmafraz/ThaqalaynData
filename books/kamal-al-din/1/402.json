        "chunks": [
          {
            "arabic_text": "حَدَّثَنَا مُحَمَّدُ بْنُ يَحْيَى، عَنِ الْأَشْعَرِيِّ، عَنْ سَمَاكَةَ بْنِ مِهْرَانَ، عَنْ أَبِي بَصِيرٍ، عَنْ أَبِي عَبْدِ اللَّهِ عَلَيْهِ السَّلَامِ قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَآلِهِ وَسَلَّمَ: «إِنَّ اللَّهَ تَبَارَكَ وَتَعَالَى لَمْ يَبْعَثْ نَبِيًّا وَلَا إِمَامًا إِلَّا وَهُوَ أَعْلَمُ النَّاسِ بِأَمْرِ اللَّهِ، وَأَحْسَنُهُمْ فِيهِ، وَأَبْصَرُهُمْ لَهُ»",
            "chunk_type": "isnad",
            "word_end": 47,
            "word_start": 0
          },
          {
            "arabic_text": "قَالَ: «وَلَا يَكُونُ لَهُمْ فِي ذَلِكَ شَكٌّ وَلَا رَيْبٌ، إِلَّا أَنَّهُمْ يَخَافُونَ أَنْ يُفْتَنُوا بِهِ، أَوْ يُقْتَلُوا فِيهِ، أَوْ يُنْصَبَ لَهُمْ فِيهِ عَدُوٌّ»",
            "chunk_type": "body",
            "word_end": 70,
            "word_start": 47
          },
          {
            "arabic_text": "قَالَ: «فَإِذَا كَانَ ذَلِكَ فَهُوَ أَوْلَى النَّاسِ بِأَمْرِ اللَّهِ، وَأَحَقُّهُمْ بِهِ»",
            "chunk_type": "body",
            "word_end": 81,
            "word_start": 70
          },
          {
            "arabic_text": "قَالَ: «وَهُوَ الَّذِي يَدْعُو إِلَى اللَّهِ، وَيُبَيِّنُ لَهُمْ دِينَهُمْ، وَيُعَلِّمُهُمْ كِتَابَهُ وَحِكْمَتَهُ»",
            "chunk_type": "closing",
