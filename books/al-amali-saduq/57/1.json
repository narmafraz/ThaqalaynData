        "parts": [
          {
            "kind": "plain",
            "text": "حَدَّثَنَا الشَّيْخُ الْجَلِيلُ أَبُو جَعْفَرٍ "
          },
          {
            "kind": "plain",
            "text": "مُحَمَّدُ بْنُ عَلِيِّ بْنِ الْحُسَيْنِ بْنِ مُوسَى ابْنِ بَابَوَيْهِ الْقُمِّيُّ"
          },
          {
            "kind": "plain",
            "text": " رَضِيَ اللَّهُ عَنْهُ قَالَ حَدَّثَنَا "
          },
          {
            "kind": "plain",
            "text": "مُحَمَّدُ بْنُ الْقَاسِمِ الْأَسْتَرَابَاذِيُّ"
          },
          {
            "kind": "plain",
            "text": " رَحِمَهُ اللَّهُ قَالَ حَدَّثَنَا "
          },
          {
            "kind": "plain",
            "text": "عَبْدُ الْمَلِكِ بْنُ أَحْمَدَ بْنِ هَارُونَ"
          },
          {
            "kind": "plain",
            "text": " قَالَ حَدَّثَنَا "
          },
          {
            "kind": "plain",
            "text": "عَمَّارُ بْنُ رَجَاءٍ"
          },
          {
            "kind": "plain",
            "text": " قَالَ حَدَّثَنَا "
          },
          {
            "kind": "plain",
            "text": "يَزِيدُ ابْنُ هَارُونَ"
          },
          {
            "kind": "plain",
            "text": " قَالَ أَخْبَرَنَا "
          },
