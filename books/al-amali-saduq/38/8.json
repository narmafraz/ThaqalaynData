      "narrator_chain": {
        "parts": [
          {
            "kind": "plain",
            "text": "8 - حدثنا "
          },
          {
            "kind": "plain",
            "text": "أحمد بن محمد بن يحيى العطار (رحمه الله)، قال"
          }
        ]
      },
      "part_type": "Hadith",
      "path": "/books/al-amali-saduq:38:8",
      "source_url": "https://thaqalayn.net/hadith/29/1/39/8",
      "text": [
        ": حدثنا أبي، عن أحمد بن محمد بن عيسى، عن عثمان بن عيسى، عن عبد الله بن مسكان، عن أبي عبد الله الصادق (عليه السلام)، قال: إن الله تبارك وتعالى خص رسوله (صلى الله عليه وآله) بمكارم الاخلاق، فامتحنوا أنفسكم، فإن كانت فيكم فاحمدوا الله عز وجل وارغبوا إليه في الزيادة منها، فذكرها عشرة: اليقين، والقناعة، والصبر، والشكر، والحلم، وحسن الخلق، والسخاء، والغيرة، والشجاعة، والمروءة (4)."
      ],
      "translations": {}
    },
