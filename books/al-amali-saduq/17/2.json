        "related_quran": [
          {
            "context": "Establish prayer at the decline of the sun till the darkness of the night, and the recitation of Fajr - directly parallels the five daily prayers and their merit described in this hadith",
            "ref": "17:78",
            "relationship": "thematic"
          },
          {
            "context": "Glorify the praises of your Lord before the rising of the sun and before its setting, and during the hours of the night glorify Him, and at the sides of the day - mirrors the five prayer times mentioned in the hadith",
            "ref": "20:130",
            "relationship": "thematic"
          },
          {
            "context": "Establish prayer at the two ends of the day and in the first hours of the night. Indeed, good deeds do away with misdeeds - directly parallels the Dhuhr writ's promise to convert evil deeds to good deeds",
            "ref": "11:114",
            "relationship": "thematic"
          },
          {
            "context": "Your Lord knows that you stand in prayer nearly two-thirds of the night or half of it or a third of it - directly relates to the night prayer section and its immense angelic reward",
            "ref": "73:20",
            "relationship": "thematic"
          }
