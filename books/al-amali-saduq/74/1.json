      "narrator_chain": {
        "parts": [
          {
            "kind": "plain",
            "text": "1 - حدثنا "
          },
          {
            "kind": "plain",
            "text": "الشيخ الجليل أبو جعفر محمد بن علي بن الحسين بن موسى ابن بابويه القمي (رضي الله عنه)، قال"
          }
        ]
      },
      "part_type": "Hadith",
      "path": "/books/al-amali-saduq:74:1",
      "source_url": "https://thaqalayn.net/hadith/29/1/75/1",
      "text": [
        ": حدثنا أبي (رضي الله عنه)، قال: حدثنا سعد بن عبد الله، قال: حدثنا أحمد بن محمد بن عيسى، عن أبيه، عن عبد الله بن المغيرة، عن طلحة بن زيد، عن أبي عبد الله الصادق جعفر بن محمد (عليهما السلام)، قال: مر عيسى بن مريم (عليه السلام) على قوم يبكون، فقال: على ما يبكي هؤلاء؟ فقيل: يبكون على ذنوبهم. قال: فليدعوها يغفر لهم (1)."
      ],
      "translations": {}
