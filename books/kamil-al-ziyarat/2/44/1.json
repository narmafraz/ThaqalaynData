            "chunk_type": "body",
            "word_end": 111,
            "word_start": 100
          },
          {
            "arabic_text": "وَ أَمِيرُ الْمُؤْمِنِينَ (ع) قَائِمٌ عَلَى الْحَوْضِ يُصَافِحُهُ وَ يُرَوِّيهِ مِنَ الْمَاءِ",
            "chunk_type": "body",
            "word_end": 123,
            "word_start": 111
          },
          {
            "arabic_text": "وَ مَا يَسْبِقُهُ أَحَدٌ إِلَى وُرُودِهِ الْحَوْضَ حَتَّى يَرْوَى ثُمَّ يَنْصَرِفُ إِلَى مَنْزِلِهِ مِنَ الْجَنَّةِ",
            "chunk_type": "body",
            "word_end": 138,
            "word_start": 123
          },
          {
            "arabic_text": "وَ مَعَهُ مَلَكٌ مِنْ قِبَلِ أَمِيرِ الْمُؤْمِنِينَ يَأْمُرُ الصِّرَاطَ أَنْ يَذِلَّ لَهُ وَ يَأْمُرُ النَّارَ أَنْ لَا يُصِيبَهُ مِنْ لَفْحِهَا شَيْءٌ حَتَّى يَجُوزَهَا",
