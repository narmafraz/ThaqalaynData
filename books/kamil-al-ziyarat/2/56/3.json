        "chunks": [
          {
            "arabic_text": "حَدَّثَنِي الْحَسَنُ بْنُ عَبْدِ اللَّهِ عَنْ أَبِيهِ عَنِ الْحَسَنِ بْنِ مَحْبُوبٍ عَنِ الْعَلَاءِ بْنِ رَزِينٍ عَنْ مُحَمَّدِ بْنِ مُسْلِمٍ عَنْ أَبِي جَعْفَرٍ (ع) قَالَ",
            "chunk_type": "isnad",
            "word_end": 24,
            "word_start": 0
          },
          {
            "arabic_text": "لَوْ يَعْلَمُ النَّاسُ مَا فِي زِيَارَةِ قَبْرِ الْحُسَيْنِ (ع) مِنَ الْفَضْلِ لَمَاتُوا شَوْقاً وَ تَقَطَّعَتْ أَنْفُسُهُمْ عَلَيْهِ حَسَرَاتٍ",
            "chunk_type": "body",
            "word_end": 42,
            "word_start": 24
          },
          {
            "arabic_text": "قُلْتُ وَ مَا فِيهِ قَالَ مَنْ أَتَاهُ تَشَوُّقاً كَتَبَ اللَّهُ لَهُ أَلْفَ حِجَّةٍ مُتَقَبَّلَةٍ وَ أَلْفَ عُمْرَةٍ مَبْرُورَةٍ",
            "chunk_type": "body",
            "word_end": 60,
            "word_start": 42
          },
          {
            "arabic_text": "وَ أَجْرَ أَلْفِ شَهِيدٍ مِنْ شُهَدَاءِ بَدْرٍ وَ أَجْرَ أَلْفِ صَائِمٍ وَ ثَوَابَ أَلْفِ صَدَقَةٍ مَقْبُولَةٍ",
            "chunk_type": "body",
            "word_end": 76,
            "word_start": 60
          },
          {
            "arabic_text": "وَ ثَوَابَ أَلْفِ نَسَمَةٍ أُرِيدَ بِهَا وَجْهُ اللَّهِ",
            "chunk_type": "body",
            "word_end": 84,
            "word_start": 76
          },
          {
            "arabic_text": "وَ لَمْ يَزَلْ مَحْفُوظاً سَنَتَهُ مِنْ كُلِّ آفَةٍ أَهْوَنُهَا الشَّيْطَانُ",
            "chunk_type": "body",
            "word_end": 94,
            "word_start": 84
          },
          {
            "arabic_text": "وَ وُكِّلَ بِهِ مَلَكٌ كَرِيمٌ يَحْفَظُهُ مِنْ بَيْنِ يَدَيْهِ وَ مِنْ خَلْفِهِ وَ عَنْ يَمِينِهِ وَ عَنْ شِمَالِهِ وَ مِنْ فَوْقِ رَأْسِهِ وَ مِنْ تَحْتِ قَدَمِهِ",
            "chunk_type": "body",
            "word_end": 120,
            "word_start": 94
          },
          {
            "arabic_text": "فَإِنْ مَاتَ سَنَتَهُ حَضَرَتْهُ مَلَائِكَةُ الرَّحْمَةِ",
            "chunk_type": "body",
            "word_end": 126,
            "word_start": 120
          },
          {
            "arabic_text": "يَحْضُرُونَ غُسْلَهُ وَ أَكْفَانَهُ وَ الِاسْتِغْفَارَ لَهُ وَ يُشَيِّعُونَهُ إِلَى قَبْرِهِ بِالاسْتِغْفَارِ لَهُ",
            "chunk_type": "body",
            "word_end": 139,
            "word_start": 126
          },
          {
            "arabic_text": "وَ يُفْسَحُ لَهُ فِي قَبْرِهِ مَدَّ بَصَرِهِ",
            "chunk_type": "body",
            "word_end": 146,
            "word_start": 139
          },
          {
            "arabic_text": "وَ يُؤْمِنُهُ اللَّهُ مِنْ ضَغْطَةِ الْقَبْرِ وَ مِنْ مُنْكَرٍ وَ نَكِيرٍ أَنْ يُرَوِّعَاهُ",
            "chunk_type": "body",
            "word_end": 159,
            "word_start": 146
          },
          {
            "arabic_text": "وَ يُفْتَحُ لَهُ بَابٌ إِلَى الْجَنَّةِ",
            "chunk_type": "body",
            "word_end": 165,
            "word_start": 159
          },
          {
            "arabic_text": "وَ يُعْطَى كِتَابَهُ بِيَمِينِهِ",
            "chunk_type": "body",
            "word_end": 169,
            "word_start": 165
          },
          {
            "arabic_text": "وَ يُعْطَى لَهُ يَوْمَ الْقِيَامَةِ نُورٌ يُضِيءُ لِنُورِهِ مَا بَيْنَ الْمَشْرِقِ وَ الْمَغْرِبِ",
            "chunk_type": "body",
            "word_end": 182,
            "word_start": 169
          },
          {
            "arabic_text": "وَ يُنَادِي مُنَادٍ هَذَا مَنْ زَارَ الْحُسَيْنَ شَوْقاً إِلَيْهِ",
            "chunk_type": "body",
            "word_end": 191,
            "word_start": 182
          },
          {
            "arabic_text": "فَلَا يَبْقَى أَحَدٌ يَوْمَ الْقِيَامَةِ إِلَّا تَمَنَّى يَوْمَئِذٍ أَنَّهُ كَانَ مِنْ زُوَّارِ الْحُسَيْنِ (ع)",
            "chunk_type": "closing",
            "word_end": 205,
            "word_start": 191
          }
        ],
