        "chunks": [
          {
            "arabic_text": "حَدَّثَنِي أَبُو عَبْدِ الرَّحْمَنِ مُحَمَّدُ بْنُ أَحْمَدَ بْنِ الْحُسَيْنِ الْعَسْكَرِيُّ بِالْعَسْكَرِ عَنِ الْحَسَنِ بْنِ عَلِيِّ بْنِ مَهْزِيَارَ عَنْ أَبِيهِ عَلِيِّ بْنِ مَهْزِيَارَ عَنْ مُحَمَّدِ بْنِ أَبِي عُمَيْرٍ عَنْ مُحَمَّدِ بْنِ مَرْوَانَ عَنْ أَبِي حَمْزَةَ الثُّمَالِيِّ عَنْ أَبِي عَبْدِ اللَّهِ (ع) قَالَ",
            "chunk_type": "isnad",
            "word_end": 41,
            "word_start": 0
          },
          {
            "arabic_text": "إِذَا وَدَّعْتَ الْعَبَّاسَ فَأْتِهِ وَ قُلْ أَسْتَوْدِعُكَ اللَّهَ وَ أَسْتَرْعِيكَ وَ أَقْرَأُ عَلَيْكَ السَّلَامَ",
            "chunk_type": "body",
            "word_end": 55,
            "word_start": 41
          },
          {
            "arabic_text": "آمَنَّا بِاللَّهِ وَ بِرَسُولِهِ وَ بِكِتَابِهِ وَ بِمَا جَاءَ بِهِ مِنْ عِنْدِ اللَّهِ",
            "chunk_type": "body",
            "word_end": 68,
            "word_start": 55
          },
          {
            "arabic_text": "اللَّهُمَّ اكْتُبْنَا مَعَ الشَّاهِدِينَ",
            "chunk_type": "body",
            "word_end": 72,
            "word_start": 68
          },
          {
            "arabic_text": "اللَّهُمَّ لَا تَجْعَلْهُ آخِرَ الْعَهْدِ مِنْ زِيَارَةِ قَبْرِ ابْنِ أَخِي نَبِيِّكَ وَ ارْزُقْنِي زِيَارَتَهُ أَبَداً مَا أَبْقَيْتَنِي",
            "chunk_type": "body",
            "word_end": 89,
            "word_start": 72
          },
          {
            "arabic_text": "وَ احْشُرْنِي مَعَهُ وَ مَعَ آبَائِهِ فِي الْجِنَانِ",
            "chunk_type": "body",
            "word_end": 97,
            "word_start": 89
          },
          {
            "arabic_text": "اللَّهُمَّ وَ عَرِّفْ بَيْنِي وَ بَيْنَهُ وَ بَيْنَ رَسُولِكَ وَ أَوْلِيَائِكَ",
            "chunk_type": "body",
            "word_end": 108,
            "word_start": 97
          },
          {
            "arabic_text": "اللَّهُمَّ صَلِّ عَلَى مُحَمَّدٍ وَ آلِ مُحَمَّدٍ",
            "chunk_type": "body",
            "word_end": 115,
            "word_start": 108
          },
          {
            "arabic_text": "وَ تَوَفَّنِي عَلَى الْإِيمَانِ بِكَ وَ التَّصْدِيقِ بِرَسُولِكَ وَ الْوَلَايَةِ لِعَلِيِّ بْنِ أَبِي طَالِبٍ وَ الْأَئِمَّةِ مِنْ وُلْدِهِ وَ الْبَرَاءَةِ مِنْ عَدُوِّهِمْ",
            "chunk_type": "body",
            "word_end": 137,
            "word_start": 115
          },
          {
            "arabic_text": "فَإِنِّي قَدْ رَضِيتُ بِذَلِكَ يَا رَبِّ",
            "chunk_type": "body",
            "word_end": 143,
            "word_start": 137
          },
          {
            "arabic_text": "وَ تَدْعُو لِنَفْسِكَ وَ لِوَالِدَيْكَ وَ الْمُؤْمِنِينَ وَ الْمُسْلِمِينَ وَ تَخَيَّرْ مِنَ الدُّعَاءِ",
            "chunk_type": "closing",
            "word_end": 156,
            "word_start": 143
          }
