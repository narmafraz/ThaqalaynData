        "chunks": [
          {
            "arabic_text": "مُحَمَّدُ بْنُ أَحْمَدَ بْنِ يَحْيَى عَنْ يُوسُفَ بْنِ الْحَارِثِ عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ الْعَزْرَمِيِّ عَنْ أَبِيهِ عَنْ جَعْفَرٍ عَنْ أَبِيهِ عَلَيْهِمَا السَّلَامُ: «أَنَّهُ جُعِلَ فِي",
            "chunk_type": "isnad",
            "translations": {
              "bn": "",
              "de": "",
              "en": "Muhammad ibn Ahmad ibn Yahya, from Yusuf ibn al-Harith, from Muhammad ibn Abd al-Rahman al-Azrami, from his father, from Ja'far, from his father, peace be upon them: “It was established concerning...”",
              "es": "",
              "fa": "",
              "fr": "",
              "id": "",
              "ru": "",
              "tr": "",
              "ur": "",
              "zh": ""
            },
            "word_end": 26,
            "word_start": 0
          },
          {
            "arabic_text": "السِّنِّ السَّوْدَاءِ ثُلُثُ دِيَتِهَا، وَفِي الْيَدِ الشَّلَّاءِ ثُلُثُ دِيَتِهَا، وَفِي الْعَيْنِ الْقَائِمَةِ إِذَا طَمَسَتْ ثُلُثُ دِيَتِهَا، وَفِي شَحْمَةِ الْأُذُنِ ثُلُثُ دِيَتِهَا، وَفِي الرِّجْلِ الْعَرْجَاءِ ثُلُثُ دِيَتِهَا، وَفِي خِشَاشِ الْأَنْفِ فِي كُلِّ وَاحِدٍ ثُلُثُ الدِّيَةِ».",
            "chunk_type": "body",
            "translations": {
              "bn": "",
              "de": "",
              "en": "For the blackened tooth, one-third of its diyah; for the paralyzed hand, one-third of its diyah; for the standing eye when its sight is effaced, one-third of its diyah; for the earlobe, one-third of its diyah; for the lame leg, one-third of its diyah; and for the soft parts of the nose, in each one there is one-third of the diyah.”",
              "es": "",
              "fa": "",
              "fr": "",
              "id": "",
              "ru": "",
              "tr": "",
              "ur": "",
              "zh": ""
            },
            "word_end": 60,
            "word_start": 26
          }
        ],
        "content_type": "legal_ruling",
        "diacritics_status": "corrected",
        "diacritized_text": "مُحَمَّدُ بْنُ أَحْمَدَ بْنِ يَحْيَى عَنْ يُوسُفَ بْنِ الْحَارِثِ عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ الْعَزْرَمِيِّ عَنْ أَبِيهِ عَنْ جَعْفَرٍ عَنْ أَبِيهِ عَلَيْهِمَا السَّلَامُ: «أَنَّهُ جُعِلَ فِي السِّنِّ السَّوْدَاءِ ثُلُثُ دِيَتِهَا، وَفِي الْيَدِ الشَّلَّاءِ ثُلُثُ دِيَتِهَا، وَفِي الْعَيْنِ الْقَائِمَةِ إِذَا طَمَسَتْ ثُلُثُ دِيَتِهَا، وَفِي شَحْمَةِ الْأُذُنِ ثُلُثُ دِيَتِهَا، وَفِي الرِّجْلِ الْعَرْجَاءِ ثُلُثُ دِيَتِهَا، وَفِي خِشَاشِ الْأَنْفِ فِي كُلِّ وَاحِدٍ ثُلُثُ الدِّيَةِ».",
