            "word_start": 20
          },
          {
            "arabic_text": "عَلِيٌّ عَنْ أَبِيهِ عَنْ آدَمَ بْنِ إِسْحَاقَ عَنْ عَبْدِ اللَّهِ بْنِ مُحَمَّدٍ الْجُعْفِيِّ قَالَ",
            "chunk_type": "isnad",
