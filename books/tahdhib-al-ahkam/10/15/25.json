            },
            "word_end": 12,
            "word_start": 0
          },
          {
            "arabic_text": "سَمِعْتُ أَبَا عَبْدِ اللَّهِ عَلَيْهِ السَّلَامُ يَقُولُ: «مَنْ بَدَأَ فَاعْتَدَى فَاعْتُدِيَ عَلَيْهِ فَلَا قَوَدَ لَهُ».",
            "chunk_type": "body",
            "translations": {
              "bn": "",
              "de": "",
              "en": "I heard Abā ʿAbdillāh عليه السلام saying: “Whoever initiates and commits aggression, then aggression is committed against him, there is no retaliation for him.”",
              "es": "",
              "fa": "",
              "fr": "",
              "id": "",
              "ru": "",
              "tr": "",
              "ur": "",
              "zh": ""
            },
            "word_end": 27,
