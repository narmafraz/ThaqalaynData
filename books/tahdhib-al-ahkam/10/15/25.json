            "chunk_type": "isnad",
            "translations": {
              "bn": "",
              "de": "",
              "en": "Al-Ḥusayn ibn Saʿīd, from Hishām ibn Sālim, from Sulaymān ibn Khālid, who said:",
              "es": "",
              "fa": "",
              "fr": "",
              "id": "",
