            "chunk_type": "isnad",
            "word_end": 15,
            "word_start": 0
          },
          {
            "arabic_text": "كُنْتُ عِنْدَ أَبِي عَبْدِ اللَّهِ عَلَيْهِ السَّلَامُ فَدَخَلَ عَلَيْهِ عَبَّادٌ الْبَصْرِيُّ وَمَعَهُ أُنَاسٌ مِنْ أَصْحَابِهِ.",
            "chunk_type": "opening",
            "word_end": 30,
            "word_start": 15
          },
          {
            "arabic_text": "فَقَالَ: حَدِّثْنِي إِذَا أُخِذَ الرَّجُلَانِ فِي لِحَافٍ وَاحِدٍ. فَقَالَ لَهُ: «كَانَ عَلِيٌّ عَلَيْهِ السَّلَامُ إِذَا أَخَذَ الرَّجُلَيْنِ فِي لِحَافٍ وَاحِدٍ ضَرَبَهُمَا الْحَدَّ».",
            "chunk_type": "body",
            "word_end": 52,
            "word_start": 30
          },
          {
            "arabic_text": "فَقَالَ عَبَّادٌ: إِنَّكَ قُلْتَ لِي غَيْرَ سَوْطٍ. فَأَعَادَ عَلَيْهِ ذِكْرَ الْحَدِّ حَتَّى أَعَادَ ذَلِكَ عَلَيْهِ مِرَارًا، فَقَالَ: «غَيْرَ سَوْطٍ». فَكَتَبَ الْقَوْمُ الْحُضُورُ عِنْدَ ذَلِكَ الْحَدِيثَ.",
