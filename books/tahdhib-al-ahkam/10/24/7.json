        "chunks": [
          {
            "arabic_text": "عَلِيٌّ عَنْ أَبِيهِ عَنِ ٱبْنِ فَضَّالٍ عَنْ سُلَيْمَانَ ٱلدَّهَّانِ عَنْ رِفَاعَةَ عَنْ أَبِي عَبْدِ ٱللَّهِ عَلَيْهِ ٱلسَّلَامُ قَالَ:",
            "chunk_type": "isnad",
            "word_end": 18,
            "word_start": 0
          },
          {
            "arabic_text": "«إِنَّ عُمَرَ أَتَاهُ رَجُلٌ مِنْ قَيْسٍ بِمَوْلًى لَهُ قَدْ لَطَمَ عَيْنَهُ فَأَنْزَلَ ٱلْمَاءَ فِيهَا وَهِيَ قَائِمَةٌ لَمْ يُبْصِرْ بِهَا شَيْئًا، فَقَالَ لَهُ: أُعْطِيكَ ٱلدِّيَةَ، فَأَبَى».",
            "chunk_type": "opening",
            "word_end": 43,
            "word_start": 18
          },
          {
            "arabic_text": "قَالَ: «فَأَرْسَلَ بِهِمَا إِلَى عَلِيٍّ عَلَيْهِ ٱلسَّلَامُ وَقَالَ: ٱحْكُمْ بَيْنَ هَذَيْنِ. فَأَعْطَاهُ ٱلدِّيَةَ فَأَبَى». قَالَ: «فَلَمْ يَزَالُوا يُعْطُونَهُ حَتَّى أَعْطَوْهُ دِيَتَيْنِ». قَالَ: «فَقَالَ: لَيْسَ أُرِيدُ إِلَّا ٱلْقِصَاصَ».",
            "chunk_type": "body",
            "word_end": 70,
            "word_start": 43
          },
          {
            "arabic_text": "قَالَ: «فَدَعَا عَلِيٌّ عَلَيْهِ ٱلسَّلَامُ بِمِرْآةٍ فَحَمَاهَا، ثُمَّ دَعَا بِكُرْسُفٍ فَبَلَّهُ، ثُمَّ جَعَلَهُ عَلَى أَشْفَارِ عَيْنَيْهِ عَلَى حَوَالَيْهَا، ثُمَّ ٱسْتَقْبَلَ بِعَيْنَيْهِ عَيْنَ ٱلشَّمْسِ».",
            "chunk_type": "body",
            "word_end": 93,
            "word_start": 70
          },
          {
            "arabic_text": "قَالَ: «وَجَاءَ بِٱلْمِرْآةِ فَقَالَ: ٱنْظُرْ. فَنَظَرَ، فَذَابَ ٱلشَّحْمُ وَبَقِيَتْ عَيْنُهُ قَائِمَةً، فَذَهَبَ ٱلْبَصَرُ».",
            "chunk_type": "closing",
            "word_end": 106,
            "word_start": 93
          }
