            "word_end": 27,
            "word_start": 18
          },
          {
            "arabic_text": "قَالَ قُلْتُ فَالنَّجَاشِيُّ لَمْ يُصَلِّ عَلَيْهِ - اَلنَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَ آلِهِ فَقَالَ «لاَ إِنَّمَا دَعَا لَهُ».",
            "chunk_type": "body",
            "word_end": 45,
