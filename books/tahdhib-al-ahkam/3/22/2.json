          {
            "arabic_text": "وَعَنْهُ عَنْ مُحَمَّدِ بْنِ يَحْيَى عَنْ أَحْمَدَ بْنِ مُحَمَّدٍ عَنِ الْحُسَيْنِ بْنِ سَعِيدٍ عَنِ الْقَاسِمِ بْنِ مُحَمَّدٍ عَنْ عَلِيِّ بْنِ أَبِي حَمْزَةَ عَنْ أَبِي بَصِيرٍ عَنْ أَبِي جَعْفَرٍ عَلَيْهِ السَّلَامُ قَالَ",
            "chunk_type": "isnad",
            "word_end": 31,
            "word_start": 0
          },
          {
            "arabic_text": "كَبَّرَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَآلِهِ عَلَى حَمْزَةَ سَبْعِينَ تَكْبِيرَةً وَكَبَّرَ عَلِيٌّ عَلَيْهِ السَّلَامُ عَلَى سَهْلِ بْنِ حُنَيْفٍ خَمْساً وَعِشْرِينَ تَكْبِيرَةً",
            "chunk_type": "body",
            "word_end": 53,
            "word_start": 31
          },
          {
            "arabic_text": "قَالَ «كَبَّرَ خَمْساً خَمْساً كُلَّمَا أَدْرَكَهُ النَّاسُ قَالُوا يَا أَمِيرَ الْمُؤْمِنِينَ لَمْ نُدْرِكِ الصَّلَاةَ عَلَى سَهْلٍ فَيَضَعُهُ فَيُكَبِّرُ عَلَيْهِ خَمْساً حَتَّى انْتَهَى إِلَى قَبْرِهِ خَمْسَ مَرَّاتٍ»",
            "chunk_type": "body",
            "word_end": 79,
            "word_start": 53
          },
          {
            "arabic_text": "يَا أَمِيرَ الْمُؤْمِنِينَ لَمْ نُدْرِكِ الصَّلَاةَ عَلَى سَهْلٍ فَيَضَعُهُ فَيُكَبِّرُ عَلَيْهِ خَمْساً حَتَّى انْتَهَى إِلَى قَبْرِهِ خَمْسَ مَرَّاتٍ»",
            "chunk_type": "body",
            "word_end": 97,
            "word_start": 79
          },
          {
            "arabic_text": "فَيَضَعُهُ فَيُكَبِّرُ عَلَيْهِ خَمْساً حَتَّى انْتَهَى إِلَى قَبْرِهِ خَمْسَ مَرَّاتٍ»",
            "chunk_type": "body",
            "word_end": 107,
