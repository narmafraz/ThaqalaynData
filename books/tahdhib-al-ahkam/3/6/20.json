          },
          {
            "arabic_text": "«صَلَاةُ الْعِيدَيْنِ مَعَ الْإِمَامِ سُنَّةٌ وَلَيْسَ قَبْلَهَا وَلَا بَعْدَهَا صَلَاةٌ ذَلِكَ الْيَوْمَ إِلَى الزَّوَالِ»",
            "chunk_type": "body",
            "word_end": 44,
            "word_start": 30
          },
          {
            "arabic_text": "لِأَنَّ الْمُرَادَ بِهَذَا الْخَبَرِ أَنَّ هَذِهِ الصَّلَاَةَ مِمَّا عُقِلَ فَرْضُهَا بِالسُّنَّةِ كَمَا عُقِلَ فَرَائِضُ كَثِيرَةٌ بِالسُّنَّةِ فَلِأَجْلِ هَذَا أُضِيفَتْ إِلَى السُّنَّةِ وَقَدْ بَيَّنَّا ذَلِكَ فِي غَيْرِ مَوْضِعٍ",
            "chunk_type": "body",
            "word_end": 71,
            "word_start": 44
          },
          {
            "arabic_text": "وَلَمْ يُرَدْ أَنَّهَا سُنَّةٌ فِي أَنَّهَا جَارِيَةٌ مَجْرَى سَائِرِ النَّوَافِلِ وَالسُّنَنِ",
            "chunk_type": "body",
            "word_end": 82,
            "word_start": 71
          },
          {
            "arabic_text": "وَمَنْ فَاتَتْهُ الصَّلَاَةُ يَوْمَ الْعِيدِ فَلَا يَجِبُ عَلَيْهِ الْقَضَاءُ وَيَجُوزُ لَهُ أَنْ يُصَلِّيَ إِنْ شَاءَ رَكْعَتَيْنِ أَوْ أَرْبَعًا مِنْ غَيْرِ أَنْ يَقْصِدَ بِهَا الْقَضَاءَ",
            "chunk_type": "body",
            "word_end": 106,
            "word_start": 82
          },
          {
            "arabic_text": "وَلِأَنَّ قُلْنَا ذَلِكَ لِمَا قَدَّمْنَاهُ مِنْ أَنَّهُ لَا قَضَاءَ عَلَى مَنْ فَاتَتْهُ صَلَاةُ الْعِيدِ",
