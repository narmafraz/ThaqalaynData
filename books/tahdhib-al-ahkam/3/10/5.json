            "chunk_type": "isnad",
            "word_end": 30,
            "word_start": 0
          },
          {
            "arabic_text": "«مَنْ أَدْرَكَ الْإِمَامَ يَوْمَ الْجُمُعَةِ وَ هُوَ يَتَشَهَّدُ فَلْيُصَلِّ أَرْبَعاً وَ مَنْ أَدْرَكَ رَكْعَةً فَلْيُضِفْ إِلَيْهَا أُخْرَى يَجْهَرُ فِيهَا».",
            "chunk_type": "body",
            "word_end": 49,
            "word_start": 30
          },
          {
            "arabic_text": "وَ الَّذِي رَوَاهُ - الْحُسَيْنُ بْنُ سَعِيدٍ عَنْ فَضَالَةَ وَ النَّضْرِ عَنِ ابْنِ سِنَانٍ عَنْ أَبِي عَبْدِ اللَّهِ عَلَيْهِ السَّلَامُ قَالَ : «الْجُمُعَةُ لَا تَكُونُ إِلَّا لِمَنْ أَدْرَكَ الْخُطْبَتَيْنِ».",
            "chunk_type": "body",
            "word_end": 78,
            "word_start": 49
          },
          {
            "arabic_text": "فَمَحْمُولٌ عَلَى أَنَّهُ لَا يَكُونُ لَهُ ثَوَابُ مَنْ أَدْرَكَ الْخُطْبَتَيْنِ دُونَ أَنْ تَجِبَ عَلَيْهِ إِعَادَةُ أَرْبَعِ رَكَعَاتٍ.",
            "chunk_type": "body",
            "word_end": 95,
            "word_start": 78
          },
          {
            "arabic_text": "أَلَا تَرَى إِلَى مَا رَوَاهُ - الْحُسَيْنُ عَنْ فَضَالَةَ عَنْ حَمَّادٍ عَنِ الْفَضْلِ بْنِ عَبْدِ الْمَلِكِ قَالَ قَالَ أَبُو عَبْدِ اللَّهِ عَلَيْهِ السَّلَامُ : «مَنْ أَدْرَكَ رَكْعَةً فَقَدْ أَدْرَكَ الْجُمُعَةَ».",
            "chunk_type": "body",
            "word_end": 125,
            "word_start": 95
          },
          {
            "arabic_text": "فَصُرِّحَ فِي هَذَا الْخَبَرِ أَنَّ مَنْ أَدْرَكَ رَكْعَةً فَقَدْ أَدْرَكَ الْجُمُعَةَ فَلَوْ لَمْ يَكُنِ الْمُرَادُ بِالْخَبَرِ الْأَوَّلِ مَا ذَكَرْنَاهُ لَتَنَاقَضَا وَ هَذَا فَاسِدٌ.",
            "chunk_type": "body",
            "word_end": 148,
            "word_start": 125
          },
          {
            "arabic_text": "وَ ذَلِكَ أَنَّهُ دَخَلَ وَقْتُ الصَّلَاةِ قَبْلَ أَنْ نَخْرُجَ ». قَالَ الشَّيْخُ رَحِمَهُ اللَّهُ : وَ إِنْ نَسِيَ الْمُسَافِرُ صَلَاةً فَذَكَرَهَا بَعْدَ تَقَضِّي وَقْتِهَا وَ هُوَ حَاضِرٌ قَضَاهَا عَلَى التَّقْصِيرِ.",
