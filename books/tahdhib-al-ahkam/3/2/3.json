        "chunks": [
          {
            "arabic_text": "ثَلَاثَةٌ - مُحَمَّدُ بْنُ يَعْقُوبَ عَنْ عَلِيِّ بْنِ إِبْرَاهِيمَ عَنْ أَبِيهِ وَ مُحَمَّدِ بْنِ إِسْمَاعِيلَ عَنِ الْفَضْلِ بْنِ شَاذَانَ جَمِيعًا عَنْ حَمَّادِ بْنِ عِيسَى عَنْ حَرِيزٍ عَنْ زُرَارَةَ قَالَ",
            "chunk_type": "isnad",
            "word_end": 29,
            "word_start": 0
          },
          {
            "arabic_text": "كُنْتُ جَالِسًا عِنْدَ أَبِي جَعْفَرٍ عَلَيْهِ السَّلَامُ ذَاتَ يَوْمٍ إِذْ جَاءَهُ رَجُلٌ فَدَخَلَ عَلَيْهِ فَقَالَ لَهُ جُعِلْتُ فِدَاكَ إِنِّي رَجُلٌ جَارُ مَسْجِدٍ لِقَوْمِي فَإِذَا أَنَا لَمْ أُصَلِّ مَعَهُمْ وَقَعُوا فِيَّ وَقَالُوا هُوَ كَذَا وَ كَذَا فَقَالَ «أَمَا لَئِنْ قُلْتَ ذَلِكَ لَقَدْ قَالَ أَمِيرُ الْمُؤْمِنِينَ عَلَيْهِ السَّلَامُ «مَنْ سَمِعَ النِّدَاءَ فَلَمْ يُجِبْهُ مِنْ غَيْرِ عِلَّةٍ فَلَا صَلَاةَ لَهُ»»",
            "chunk_type": "body",
            "word_end": 86,
            "word_start": 29
          },
          {
            "arabic_text": "فَخَرَجَ الرَّجُلُ فَقَالَ لَهُ «لَا تَدَعِ الصَّلَاةَ مَعَهُمْ وَخَلْفَ كُلِّ إِمَامٍ»",
            "chunk_type": "body",
            "word_end": 97,
            "word_start": 86
          },
          {
            "arabic_text": "فَلَمَّا خَرَجَ قُلْتُ لَهُ جُعِلْتُ فِدَاكَ كَبُرَ عَلَيَّ قَوْلُكَ لِهَذَا الرَّجُلِ حِينَ اسْتَفْتَاكَ فَإِنْ لَمْ يَكُونُوا مُؤِمِنِينَ",
            "chunk_type": "body",
            "word_end": 114,
            "word_start": 97
          },
          {
            "arabic_text": "فَضَحِكَ عَلَيْهِ السَّلَامُ فَقَالَ «مَا أَرَاكَ بَعْدُ إِلَّا هَاهُنَا يَا زُرَارَةُ فَأَيَّ عِلَّةٍ تُرِيدُ أَعْظَمَ مِنْ أَنَّهُ لَا يُؤْتَمُّ بِهِ»",
            "chunk_type": "body",
            "word_end": 134,
            "word_start": 114
          },
          {
            "arabic_text": "ثُمَّ قَالَ «يَا زُرَارَةُ مَا تَرَانِي» قُلْتُ صَلُّوا فِي مَسَاجِدِكُمْ وَ صَلُّوا مَعَ أَئِمَّتِكُمْ",
            "chunk_type": "closing",
            "word_end": 148,
            "word_start": 134
          }
        ],
