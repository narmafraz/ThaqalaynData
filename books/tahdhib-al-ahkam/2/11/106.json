            "chunk_type": "isnad",
            "translations": {
              "bn": "",
              "de": "",
              "en": "Sa'd, from Abī Ja'far, from his father, from 'Abd Allāh ibn al-Mughīrah, who said:",
              "es": "",
              "fa": "",
              "fr": "",
              "id": "",
              "ru": "",
