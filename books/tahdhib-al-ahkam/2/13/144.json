          {
            "arabic_text": "عَلِيٌّ عَنْ أَبِيهِ عَنْ حَمَّادِ بْنِ عِيسَى عَنْ حَرِيزٍ عَنْ زُرَارَةَ عَنْ أَبِي جَعْفَرٍ عَلَيْهِ السَّلَامُ قَالَ",
            "chunk_type": "isnad",
            "word_end": 17,
            "word_start": 0
          },
          {
            "arabic_text": "«إِذَا اجْتَمَعَ عَلَيْكَ وَتْرَانِ أَوْ ثَلَاثَةٌ أَوْ أَكْثَرُ مِنْ ذَلِكَ فَاقْضِ ذَلِكَ كَمَا فَاتَكَ، تَفْصِلُ بَيْنَ كُلِّ وَتْرَيْنِ بِصَلَاةٍ، لَا تُقَدِّمَنَّ شَيْئًا قَبْلَ أَوَّلِهِ، الْأَوَّلَ فَالْأَوَّلَ تَبْدَأُ، إِذَا أَنْتَ قَضَيْتَ صَلَاةَ لَيْلَتِكَ ثُمَّ الْوَتْرَ»",
            "chunk_type": "body",
            "word_end": 51,
            "word_start": 17
          },
          {
            "arabic_text": "قَالَ وَقَالَ أَبُو جَعْفَرٍ عَلَيْهِ السَّلَامُ: «لَا وَتْرَانِ فِي لَيْلَةٍ إِلَّا وَأَحَدُهُمَا قَضَاءٌ»",
            "chunk_type": "body",
            "word_end": 64,
            "word_start": 51
          },
          {
            "arabic_text": "وَقَالَ: «إِنْ أَوْتَرْتَ مِنْ أَوَّلِ اللَّيْلِ وَقُمْتَ فِي آخِرِ اللَّيْلِ، فَوِتْرُكَ الْأَوَّلُ قَضَاءٌ، وَمَا صَلَّيْتَ مِنْ صَلَاةٍ فِي لَيْلَتِكَ كُلِّهَا فَلْيَكُنْ قَضَاءً إِلَى آخِرِ صَلَاتِكَ، فَإِنَّهَا لِلَيْلَتِكَ، وَلْيَكُنْ آخِرُ صَلَاتِكَ وَتْرَ لَيْلَتِكَ».",
            "chunk_type": "closing",
            "word_end": 96,
            "word_start": 64
          }
