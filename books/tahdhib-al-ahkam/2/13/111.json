          },
          {
            "arabic_text": "صَعِدْتُ مَرَّةً جَبَلَ أَبِي قُبَيْسٍ وَالنَّاسُ يُصَلُّونَ الْمَغْرِبَ، فَرَأَيْتُ الشَّمْسَ لَمْ تَغِبْ، إِنَّمَا تَوَارَتْ خَلْفَ الْجَبَلِ عَنِ النَّاسِ.",
            "chunk_type": "body",
            "word_end": 37,
