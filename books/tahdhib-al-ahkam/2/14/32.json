            "chunk_type": "isnad",
            "word_end": 27,
            "word_start": 0
          },
          {
            "arabic_text": "قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَ آلِهِ: «لِلْمُؤَذِّنِ فِيمَا بَيْنَ الْأَذَانِ وَ الْإِقَامَةِ مِثْلُ أَجْرِ الشَّهِيدِ الْمُتَشَحِّطِ بِدَمِهِ فِي سَبِيلِ اللَّهِ»",
            "chunk_type": "body",
            "word_end": 49,
            "word_start": 27
          },
          {
            "arabic_text": "قَالَ: «قُلْتُ يَا رَسُولَ اللَّهِ إِنَّهُمْ يَجْتَلِدُونَ عَلَى الْأَذَانِ»",
            "chunk_type": "body",
            "word_end": 58,
            "word_start": 49
          },
          {
            "arabic_text": "قَالَ: «كَلَّا إِنَّهُ يَأْتِي عَلَى النَّاسِ زَمَانٌ يَطْرَحُونَ الْأَذَانَ عَلَى ضُعَفَائِهِمْ وَ تِلْكَ لُحُومٌ حَرَّمَهَا اللَّهُ عَلَى النَّارِ»",
            "chunk_type": "closing",
