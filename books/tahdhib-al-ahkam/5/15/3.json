        "chunks": [
          {
            "arabic_text": "مُحَمَّدُ بْنُ يَعْقُوبَ عَنْ عَلِيِّ بْنِ إِبْرَاهِيمَ عَنْ أَبِيهِ عَنِ اِبْنِ أَبِي عُمَيْرٍ عَنْ مُعَاوِيَةَ وَ حَمَّادٍ عَنِ اَلْحَلَبِيِّ عَنْ أَبِي عَبْدِ اَللَّهِ عَلَيْهِ اَلسَّلاَمُ قَالَ",
            "chunk_type": "isnad",
            "word_end": 26,
            "word_start": 0
          },
          {
            "arabic_text": "قَالَ: «لاَ تُصَلِّ اَلْمَغْرِبَ حَتَّى تَأْتِيَ جَمْعاً فَصَلِّ بِهَا اَلْمَغْرِبَ وَ اَلْعِشَاءَ اَلْآخِرَةَ بِأَذَانٍ وَاحِدٍ وَ إِقَامَتَيْنِ",
            "chunk_type": "body",
            "word_end": 43,
            "word_start": 26
          },
          {
            "arabic_text": "وَ اِنْزِلْ بَطْنَ اَلْوَادِي عَنْ يَمِينِ اَلطَّرِيقِ قَرِيباً مِنَ اَلْمَشْعَرِ",
            "chunk_type": "body",
            "word_end": 53,
            "word_start": 43
          },
          {
            "arabic_text": "وَيُسْتَحَبُّ لِلصَّرُورَةِ أَنْ يَقِفَ عَلَى اَلْمَشْعَرِ وَ يَطَأَهُ بِرِجْلِهِ",
            "chunk_type": "body",
            "word_end": 62,
            "word_start": 53
          },
          {
            "arabic_text": "وَلَا يُجَاوِزَ اَلْحِيَاضَ لَيْلَةَ اَلْمُزْدَلِفَةِ",
            "chunk_type": "body",
            "word_end": 67,
            "word_start": 62
          },
          {
            "arabic_text": "وَيَقُولُ: اَللَّهُمَّ هَذِهِ جَمْعٌ",
            "chunk_type": "body",
            "word_end": 71,
            "word_start": 67
          },
          {
            "arabic_text": "اَللَّهُمَّ إِنِّي أَسْأَلُكَ أَنْ تَجْمَعَ لِي فِيهَا جَوَامِعَ اَلْخَيْرِ",
            "chunk_type": "body",
            "word_end": 80,
            "word_start": 71
          },
          {
            "arabic_text": "اَللَّهُمَّ لَا تُؤْيِسْنِي مِنَ اَلْخَيْرِ اَلَّذِي سَأَلْتُكَ أَنْ تَجْمَعَهُ لِي فِي قَلْبِي",
            "chunk_type": "body",
            "word_end": 92,
            "word_start": 80
          },
          {
            "arabic_text": "ثُمَّ أَطْلُبُ إِلَيْكَ أَنْ تُعَرِّفَنِي مَا عَرَّفْتَ أَوْلِيَاءَكَ فِي مَنْزِلِي هَذَا",
            "chunk_type": "body",
            "word_end": 103,
            "word_start": 92
          },
          {
            "arabic_text": "وَأَنْ تَقِيَنِي جَوَامِعَ اَلشَّرِّ",
            "chunk_type": "body",
            "word_end": 107,
            "word_start": 103
          },
          {
            "arabic_text": "وَإِنِ اِسْتَطَعْتَ أَنْ تُحْيِيَ تِلْكَ اَللَّيْلَةَ فَافْعَلْ",
            "chunk_type": "body",
            "word_end": 114,
            "word_start": 107
          },
          {
            "arabic_text": "فَإِنَّهُ بَلَغَنَا أَنَّ أَبْوَابَ اَلسَّمَاءِ لَا تُغْلَقُ تِلْكَ اَللَّيْلَةَ لِأَصْوَاتِ اَلْمُؤْمِنِينَ",
            "chunk_type": "body",
            "word_end": 125,
            "word_start": 114
          },
          {
            "arabic_text": "لَهُمْ دَوِيٌّ كَدَوِيِّ اَلنَّحْلِ",
            "chunk_type": "body",
            "word_end": 129,
            "word_start": 125
          },
          {
            "arabic_text": "يَقُولُ اَللَّهُ جَلَّ ثَنَاؤُهُ: أَنَا رَبُّكُمْ وَ أَنْتُمْ عِبَادِي أَدَّيْتُمْ حَقِّي وَ حَقٌّ عَلَيَّ أَنْ أَسْتَجِيبَ لَكُمْ",
            "chunk_type": "body",
            "word_end": 146,
            "word_start": 129
          },
          {
            "arabic_text": "فَيَحُطُّ تِلْكَ اَللَّيْلَةَ عَمَّنْ أَرَادَ أَنْ يَحُطَّ عَنْهُ ذُنُوبَهُ وَ يَغْفِرُ لِمَنْ أَرَادَ أَنْ يَغْفِرَ لَهُ».",
            "chunk_type": "body",
            "word_end": 162,
            "word_start": 146
          }
        ],
