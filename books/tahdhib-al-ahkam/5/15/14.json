        "chunks": [
          {
            "arabic_text": "مُوسَى بْنُ الْقَاسِمِ عَنْ إِبْرَاهِيمَ الْأَسَدِيِّ عَنْ مُعَاوِيَةَ بْنِ عَمَّارٍ عَنْ أَبِي عَبْدِ اللَّهِ عَلَيْهِ السَّلَامُ قَالَ",
            "chunk_type": "isnad",
            "word_end": 17,
            "word_start": 0
          },
          {
            "arabic_text": "ثُمَّ أَفِضْ حِينَ يُشْرِقُ لَكَ ثَبِيرٌ وَ تَرَى الْإِبِلَ مَوَاضِعَ أَخْفَافِهَا",
            "chunk_type": "body",
            "word_end": 28,
            "word_start": 17
          },
          {
            "arabic_text": "قَالَ أَبُو عَبْدِ اللَّهِ عَلَيْهِ السَّلَامُ كَانَتْ أَهْلُ الْجَاهِلِيَّةِ يَقُولُونَ أَشْرِقْ ثَبِيرُ يَعْنُونَ الشَّمْسَ كَيْمَا نُغِيرَ",
            "chunk_type": "body",
            "word_end": 44,
            "word_start": 28
          },
          {
            "arabic_text": "وَ إِنَّمَا أَفَاضَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَ آلِهِ خِلَافَ أَهْلِ الْجَاهِلِيَّةِ كَانُوا يُفِيضُونَ بِإِيجَافِ الْخَيْلِ وَ إِيضَاعِ الْإِبِلِ",
            "chunk_type": "body",
            "word_end": 64,
            "word_start": 44
          },
          {
            "arabic_text": "فَأَفَاضَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَ آلِهِ خِلَافَ ذَلِكَ بِالسَّكِينَةِ وَ الْوَقَارِ وَ الدَّعَةِ",
            "chunk_type": "body",
            "word_end": 79,
            "word_start": 64
          },
          {
            "arabic_text": "فَأَفِضْ بِذِكْرِ اللَّهِ وَ الِاسْتِغْفَارِ وَ حَرِّكْ بِهِ لِسَانَكَ",
            "chunk_type": "body",
            "word_end": 88,
            "word_start": 79
          },
          {
            "arabic_text": "فَإِذَا مَرَرْتَ بِوَادِي مُحَسِّرٍ وَ هُوَ وَادٍ عَظِيمٌ بَيْنَ جَمْعٍ وَ مِنًى وَ هُوَ إِلَى مِنًى أَقْرَبُ فَاسْعَ فِيهِ حَتَّى تُجَاوِزَهُ",
            "chunk_type": "body",
            "word_end": 109,
            "word_start": 88
          },
          {
            "arabic_text": "فَإِنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَ آلِهِ حَرَّكَ نَاقَتَهُ وَ هُوَ يَقُولُ اللَّهُمَّ سَلِّمْ عَهْدِي وَ اقْبَلْ تَوْبَتِي وَ أَجِبْ دَعْوَتِي وَ اخْلُفْنِي فِيمَنْ تَرَكْتُ بَعْدِي",
            "chunk_type": "body",
            "word_end": 136,
            "word_start": 109
          },
          {
            "arabic_text": "وَ لَا بَأْسَ أَنْ يُفِيضَ الْإِنْسَانَ قَبْلَ طُلُوعِ الشَّمْسِ بِقَلِيلٍ إِلَّا أَنَّهُ لَا يَجُوزُ وَادِيَ مُحَسِّرٍ إِلَّا بَعْدَ طُلُوعِ الشَّمْسِ رَوَى",
