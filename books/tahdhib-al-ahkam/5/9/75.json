            "word_end": 25,
            "word_start": 0
          },
          {
            "arabic_text": "أَمَرَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَ آلِهِ أَنْ يُطَافَ عَنِ الْمَبْطُونِ وَ الْكَسِيرِ",
            "chunk_type": "body",
            "word_end": 39,
            "word_start": 25
          },
          {
            "arabic_text": "وَالَّذِي ذَكَرْنَاهُ مِنْ أَنَّ مَنْ هَذِهِ صِفَتُهُ يُنْتَظَرُ بِهِ الْبُرْءُ فَإِنْ بَرَأَ وَ إِلاَّ طِيفَ عَنْهُ فَقَدْ رَوَى ذَلِكَ",
            "chunk_type": "closing",
            "word_end": 58,
            "word_start": 39
          },
          {
            "arabic_text": "78 - مُوسَى بْنُ الْقَاسِمِ عَنْ أَبِي جَعْفَرٍ مُحَمَّدٍ الْأَحْمَسِيِّ عَنْ يُونُسَ بْنِ عَبْدِ الرَّحْمَنِ الْبَجَلِيِّ قَالَ",
            "chunk_type": "isnad",
            "word_end": 75,
            "word_start": 58
          },
          {
            "arabic_text": "سَأَلْتُ أَبَا الْحَسَنِ عَلَيْهِ السَّلَامُ أَوْ كَتَبْتُ إِلَيْهِ - عَنْ سَعِيدِ بْنِ يَسَارٍ أَنَّهُ سَقَطَ مِنْ جَمَلِهِ فَلاَ يَسْتَمْسِكُ بَطْنُهُ أَطُوفُ عَنْهُ وَ أَسْعَى قَالَ «لاَ وَ لَكِنْ دَعْهُ فَإِنْ بَرَأَ قَضَى هُوَ وَ إِلاَّ فَاقْضِ أَنْتَ عَنْهُ»",
