            "chunk_type": "isnad",
            "word_end": 18,
            "word_start": 0
          },
          {
            "arabic_text": "إِنَّ عَلِيّاً عَلَيْهِ السَّلَامُ طَافَ طَوَافَ الْفَرِيضَةِ ثَمَانِيَةً فَتَرَكَ سَبْعَةً وَ بَنَى عَلَى وَاحِدٍ وَ أَضَافَ إِلَيْهَا سِتّاً ثُمَّ صَلَّى رَكْعَتَيْنِ خَلْفَ الْمَقَامِ ثُمَّ خَرَجَ إِلَى الصَّفَا وَ الْمَرْوَةِ فَلَمَّا فَرَغَ مِنَ السَّعْيِ بَيْنَهُمَا رَجَعَ فَصَلَّى رَكْعَتَيْنِ لِلَّذِي تَرَكَ فِي الْمَقَامِ الْأَوَّلِ",
            "chunk_type": "body",
            "word_end": 60,
            "word_start": 18
