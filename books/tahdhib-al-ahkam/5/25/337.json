            "arabic_text": "رَوَى مُوسَى بْنُ اَلْقَاسِمِ عَنْ حَمَّادِ بْنِ عِيسَى عَنْ رِبْعِيٍّ عَنْ مُحَمَّدِ بْنِ مُسْلِمٍ عَنْ أَحَدِهِمَا عَلَيْهِمَا اَلسَّلَامُ قَالَ",
            "chunk_type": "isnad",
            "word_end": 19,
            "word_start": 0
          },
          {
            "arabic_text": "«لَا بَأْسَ أَنْ يَحُجَّ اَلصَّرُورَةُ عَنْ اَلصَّرُورَةِ»",
            "chunk_type": "body",
            "word_end": 26,
            "word_start": 19
          },
          {
            "arabic_text": "وَأَمَّا مَا رَوَاهُ مُحَمَّدُ بْنُ اَلْحَسَنِ اَلصَّفَّارُ عَنْ مُحَمَّدِ بْنِ عِيسَى عَنْ إِبْرَاهِيمَ بْنِ عُقْبَةَ قَالَ: كَتَبْتُ إِلَيْهِ أَسْأَلُهُ عَنْ رَجُلٍ حَجَّ عَنْ صَرُورَةٍ لَمْ يَحُجَّ قَطُّ أَ يُجْزِي كُلَّ وَاحِدٍ مِنْهُمَا تِلْكَ اَلْحَجَّةُ عَنْ حَجَّةِ اَلْإِسْلَامِ أَمْ لَا بَيِّنْ لِي ذَلِكَ يَا سَيِّدِي إِنْ شَاءَ اَللَّهُ فَكَتَبَ عَلَيْهِ اَلسَّلَامُ «لَا يُجْزِي ذَلِكَ»",
            "chunk_type": "body",
            "word_end": 79,
            "word_start": 26
          },
          {
            "arabic_text": "فَمَحْمُولٌ عَلَى أَنْ إِذَا كَانَ لِلصَّرُورَةِ مَالٌ لِأَنَّهُ مَتَى كَانَ اَلْأَمْرُ عَلَى مَا ذَكَرْنَاهُ لَمْ يُجْزِ عَنْهُ ذَلِكَ",
            "chunk_type": "body",
            "word_end": 97,
            "word_start": 79
          },
          {
            "arabic_text": "وَقَدْ رَوَيْنَاهُ فِي خَبَرِ سَعْدِ بْنِ أَبِي خَلَفٍ عَنْ أَبِي الْحَسَنِ مُوسَى عَلَيْهِ اَلسَّلَامُ",
            "chunk_type": "body",
            "word_end": 111,
            "word_start": 97
          },
          {
            "arabic_text": "وَيَحْتَمِلُ أَيْضًا أَنْ يَكُونَ قَوْلُهُ عَلَيْهِ اَلسَّلَامُ «لَا يُجْزِي ذَلِكَ» يَعْنِي عَنِ الَّذِي يَحُجُّ إِذَا أَيْسَرَ",
            "chunk_type": "body",
            "word_end": 127,
            "word_start": 111
          },
          {
            "arabic_text": "لِأَنَّ مَنْ حَجَّ عَنْ غَيْرِهِ ثُمَّ أَيْسَرَ وَجَبَ عَلَيْهِ اَلْحَجُّ",
            "chunk_type": "body",
            "word_end": 137,
            "word_start": 127
          },
          {
            "arabic_text": "يَدُلُّ عَلَى ذَلِكَ مَا رَوَاهُ",
