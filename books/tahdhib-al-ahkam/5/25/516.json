            "arabic_text": "عَلِيُّ بْنُ مَهْزِيَارَ عَنْ فَضَالَةَ عَنْ مُعَاوِيَةَ بْنِ عَمَّارٍ عَنْ أَبِي عَبْدِ اللَّهِ عَلَيْهِ السَّلَامُ قَالَ",
            "chunk_type": "isnad",
            "word_end": 16,
            "word_start": 0
          },
          {
            "arabic_text": "قُلْتُ لَهُ رَجُلٌ قَتَلَ رَجُلاً فِي الْحِلِّ ثُمَّ دَخَلَ الْحَرَمَ فَقَالَ «لَا يُقْتَلُ وَلَا يُطْعَمُ وَلَا يُسْقَى وَلَا يُبَايَعُ وَلَا يُؤْوَى حَتَّى يَخْرُجَ مِنَ الْحَرَمِ فَيُقَامَ عَلَيْهِ الْحَدُّ»",
            "chunk_type": "body",
            "word_end": 44,
            "word_start": 16
          },
          {
            "arabic_text": "قُلْتُ فَمَا تَقُولُ فِي رَجُلٍ قَتَلَ فِي الْحَرَمِ أَوْ سَرَقَ فَقَالَ «يُقَامُ عَلَيْهِ الْحَدُّ صَاغِرًا إِنَّهُ لَمْ يَرَ لِلْحَرَمِ حُرْمَةً»",
            "chunk_type": "body",
            "word_end": 64,
            "word_start": 44
          },
          {
            "arabic_text": "قَدْ قَالَ اللَّهُ تَعَالَى «فَمَنِ اعْتَدَى عَلَيْكُمْ فَاعْتَدُوا عَلَيْهِ بِمِثْلِ مَا اعْتَدَى عَلَيْكُمْ»",
            "chunk_type": "quran_quote",
            "word_end": 77,
            "word_start": 64
          },
          {
            "arabic_text": "يَقُولُ هَذَا فِي الْحَرَمِ",
