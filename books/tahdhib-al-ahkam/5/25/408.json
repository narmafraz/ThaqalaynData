          {
            "arabic_text": "مُوسَى بْنُ الْقَاسِمِ عَنْ حَمَّادِ بْنِ عِيسَى عَنْ عُمَرَ بْنِ أُذَيْنَةَ عَنْ زُرَارَةَ بْنِ أَعْيَنَ قَالَ",
            "chunk_type": "isnad",
            "word_end": 16,
            "word_start": 0
          },
          {
            "arabic_text": "قُلْتُ لِأَبِي جَعْفَرٍ عَلَيْهِ السَّلَامُ: الَّذِي يَلِي الْحَجَّ فِي الْفَضْلِ قَالَ: «الْعُمْرَةُ الْمُفْرَدَةُ ثُمَّ يَذْهَبُ حَيْثُ شَاءَ»",
            "chunk_type": "body",
            "word_end": 33,
            "word_start": 16
          },
          {
            "arabic_text": "وَقَالَ: «الْعُمْرَةُ وَاجِبَةٌ عَلَى الْخَلْقِ بِمَنْزِلَةِ الْحَجِّ لِأَنَّ اللَّهَ تَعَالَى يَقُولُ: «وَأَتِمُّوا الْحَجَّ وَالْعُمْرَةَ لِلَّهِ» وَإِنَّمَا نَزَلَتِ الْعُمْرَةُ بِالْمَدِينَةِ فَأَفْضَلُ الْعُمْرَةِ عُمْرَةُ رَجَبٍ»",
            "chunk_type": "body",
            "word_end": 56,
            "word_start": 33
          },
          {
            "arabic_text": "وَأَتِمُّوا الْحَجَّ وَالْعُمْرَةَ لِلَّهِ",
            "chunk_type": "quran_quote",
            "word_end": 60,
            "word_start": 56
          },
          {
            "arabic_text": "» وَإِنَّمَا نَزَلَتِ الْعُمْرَةُ بِالْمَدِينَةِ فَأَفْضَلُ الْعُمْرَةِ عُمْرَةُ رَجَبٍ»",
            "chunk_type": "body",
            "word_end": 69,
            "word_start": 60
          },
          {
            "arabic_text": "وَقَالَ: «الْمُفْرِدُ لِلْعُمْرَةِ إِنْ اعْتَمَرَ فِي رَجَبٍ ثُمَّ أَقَامَ إِلَى الْحَجِّ بِمَكَّةَ كَانَتْ عُمْرَتُهُ تَامَّةً وَحَجَّتُهُ نَاقِصَةً مَكِّيَّةً»",
            "chunk_type": "body",
            "word_end": 87,
            "word_start": 69
          },
          {
            "arabic_text": "وَمَنْ «تَمَتَّعَ بِالْعُمْرَةِ إِلَى الْحَجِّ» سَقَطَ عَنْهُ فَرْضُ الْعُمْرَةِ رَوَى",
