            "chunk_type": "isnad",
            "word_end": 19,
            "word_start": 0
          },
          {
            "arabic_text": "«سُئِلَ ابْنُ عَبَّاسٍ هَلْ كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَ آلِهِ يَتَطَيَّبُ قَبْلَ أَنْ يَزُورَ الْبَيْتَ قَالَ رَأَيْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَ آلِهِ يُضَمِّدُ رَأْسَهُ بِالْمِسْكِ قَبْلَ أَنْ يَزُورَ الْبَيْتَ»",
            "chunk_type": "body",
            "word_end": 52,
            "word_start": 19
          },
          {
            "arabic_text": "فَلَيْسَ فِي هَذَيْنِ الْخَبَرَيْنِ أَنَّهُ إِنَّمَا أَبَاحَ اسْتِعْمَالَ الطِّيبِ عِنْدَ الْفَرَاغِ مِنْ حَلْقِ الرَّأْسِ قَبْلَ الزِّيَارَةِ لِلْمُتَمَتِّعِ أَوْ لِلْحَاجِّ غَيْرِ الْمُتَمَتِّعِ",
            "chunk_type": "body",
            "word_end": 73,
            "word_start": 52
          },
          {
            "arabic_text": "وَإِذَا لَمْ يَكُنْ ذَلِكَ فِي ظَاهِرِ الْخَبَرَيْنِ حَمَلْنَاهُمَا عَلَى الْحَاجِّ غَيْرِ الْمُتَمَتِّعِ لِأَنَّهُ يَحِلُّ لَهُ اسْتِعْمَالُ كُلِّ شَيْءٍ عِنْدَ حَلْقِ الرَّأْسِ إِلَّا النِّسَاءَ فَقَطْ",
            "chunk_type": "body",
            "word_end": 97,
            "word_start": 73
          },
          {
            "arabic_text": "وَإِنَّمَا لَا يَحِلُّ اسْتِعْمَالُ الطِّيبِ مَعَ ذَلِكَ لِلْمُتَمَتِّعِ دُونَ غَيْرِهِ",
            "chunk_type": "body",
            "word_end": 107,
