            "arabic_text": "مُحَمَّدُ بْنُ يَعْقُوبَ عَنْ أَبِي عَلِيٍّ الْأَشْعَرِيِّ عَنْ مُحَمَّدِ بْنِ عَبْدِ الْجَبَّارِ عَنْ صَفْوَانَ عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْحَجَّاجِ قَالَ",
            "chunk_type": "isnad",
            "word_end": 20,
            "word_start": 0
          },
          {
            "arabic_text": "وُلِدَ لِأَبِي الْحَسَنِ عَلَيْهِ السَّلَامُ مَوْلُودٌ بِمِنًى فَأَرْسَلَ إِلَيْنَا يَوْمَ النَّحْرِ بِخَبِيصٍ فِيهِ زَعْفَرَانٌ وَ كُنَّا قَدْ حَلَقْنَا",
            "chunk_type": "body",
            "word_end": 38,
            "word_start": 20
          },
          {
            "arabic_text": "قَالَ عَبْدُ الرَّحْمَنِ فَأَكَلْتُ أَنَا وَ اِمْتَنَعَ الْكَاهِلِيُّ وَ مُرَازِمٌ أَنْ يَأْكُلاَ مِنْهُ وَ قَالاَ لَمْ نَزُرِ الْبَيْتَ",
            "chunk_type": "body",
            "word_end": 56,
            "word_start": 38
          },
          {
            "arabic_text": "فَسَمِعَ أَبُو الْحَسَنِ عَلَيْهِ السَّلَامُ كَلاَمَنَا فَقَالَ لِمُصَادِفٍ وَ كَانَ هُوَ الرَّسُولَ الَّذِي جَاءَنَا بِهِ «فِي أَيِّ شَيْءٍ كَانُوا يَتَكَمَّلُونَ»",
            "chunk_type": "body",
            "word_end": 76,
            "word_start": 56
          },
          {
            "arabic_text": "فَقَالَ أَكَلَ عَبْدُ الرَّحْمَنِ وَ أَبَى الْآخَرَانِ فَقَالاَ لَمْ نَزُرِ الْبَيْتَ بَعْدُ",
            "chunk_type": "body",
            "word_end": 88,
            "word_start": 76
          },
          {
            "arabic_text": "فَقَالَ «أَصَابَ عَبْدُ الرَّحْمَنِ» ثُمَّ قَالَ «أَمَا تَذْكُرُ حِينَ أُتِينَا بِهِ فِي مِثْلِ هَذَا الْيَوْمِ فَأَكَلْتُ أَنَا مِنْهُ وَ أَبَى عَبْدُ اللَّهِ أَخِي أَنْ يَأْكُلَ مِنْهُ",
            "chunk_type": "body",
            "word_end": 114,
            "word_start": 88
          },
          {
            "arabic_text": "فَلَمَّا جَاءَ أَبِي حَرَّشَهُ عَلَيَّ فَقَالَ يَا أَبَتِ إِنَّ مُوسَى أَكَلَ خَبِيصاً فِيهِ زَعْفَرَانٌ وَ لَمْ يَزُرْ بَعْدُ",
            "chunk_type": "body",
            "word_end": 132,
            "word_start": 114
          },
          {
            "arabic_text": "فَقَالَ أَبِي عَلَيْهِ السَّلَامُ «هُوَ أَفْقَهُ مِنْكَ أَلَيْسَ قَدْ حَلَقْتُمْ رُءُوسَكُمْ»",
