        "chunks": [
          {
            "arabic_text": "وَعَنْهُ عَنْ عَلِيِّ بْنِ إِبْرَاهِيمَ عَنْ أَبِيهِ عَنِ ابْنِ أَبِي عُمَيْرٍ عَنْ حَمَّادٍ عَنِ الْحَلَبِيِّ عَنْ أَبِي عَبْدِ اللَّهِ عَلَيْهِ السَّلَامُ قَالَ",
            "chunk_type": "isnad",
            "word_end": 22,
            "word_start": 0
          },
          {
            "arabic_text": "مَرَّ أَبُو جَعْفَرٍ عَلَيْهِ السَّلَامُ بِامْرَأَةٍ مُتَنَقِّبَةٍ وَهِيَ مُحْرِمَةٌ فَقَالَ «أَحْرِمِي وَ أَسْفِرِي وَ أَرْخِي ثَوْبَكِ مِنْ فَوْقِ رَأْسِكِ فَإِنَّكِ إِنْ تَنَقَّبْتِ لَمْ يَتَغَيَّرْ لَوْنُكِ»",
            "chunk_type": "body",
            "word_end": 47,
            "word_start": 22
          },
          {
            "arabic_text": "فَقَالَ رَجُلٌ إِلَى أَيْنَ تُرْخِيهِ قَالَ «إِلَى أَنْ تُغَطِّيَ عَيْنَيْهَا» قَالَ قُلْتُ يَبْلُغُ فَمَهَا قَالَ «نَعَمْ»",
            "chunk_type": "body",
            "word_end": 63,
            "word_start": 47
          },
          {
            "arabic_text": "وَقَالَ أَبُو عَبْدِ اللَّهِ عَلَيْهِ السَّلَامُ «الْمُحْرِمَةُ لاَ تَلْبَسُ الْحُلِيَّ وَ لاَ الثِّيَابَ الْمَصْبُوغَاتِ إِلاَّ صِبْغاً لاَ يَرْدَعُ»",
