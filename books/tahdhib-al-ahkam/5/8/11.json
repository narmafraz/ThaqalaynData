        "chunks": [
          {
            "arabic_text": "مُحَمَّدُ بْنُ يَعْقُوبَ عَنْ عَلِيِّ بْنِ إِبْرَاهِيمَ عَنْ أَبِيهِ وَ مُحَمَّدِ بْنِ إِسْمَاعِيلَ عَنِ الْفَضْلِ بْنِ شَاذَانَ عَنْ صَفْوَانَ وَ ابْنِ أَبِي عُمَيْرٍ عَنْ مُعَاوِيَةَ بْنِ عَمَّارٍ عَنْ أَبِي عَبْدِ اللَّهِ عَلَيْهِ السَّلَامُ قَالَ",
            "chunk_type": "isnad",
            "word_end": 34,
            "word_start": 0
          },
          {
            "arabic_text": "إِذَا دَخْتَ الْمَسْجِدَ الْحَرَامَ فَادْخُلْهُ حَافِيًا عَلَى السَّكِينَةِ وَالْوَقَارِ وَالْخُشُوعِ",
            "chunk_type": "body",
            "word_end": 44,
            "word_start": 34
          },
          {
            "arabic_text": "وَقَالَ مَنْ دَخَلَ بِخُشُوعٍ غُفِرَ لَهُ إِنْ شَاءَ اللَّهُ",
            "chunk_type": "body",
            "word_end": 53,
            "word_start": 44
          },
          {
            "arabic_text": "قُلْتُ مَا الْخُشُوعُ قَالَ السَّكِينَةُ لَا تَدْخُلْهُ بِتَكَبُّرٍ",
            "chunk_type": "body",
            "word_end": 61,
            "word_start": 53
          },
          {
            "arabic_text": "فَإِذَا انْتَهَيْتَ إِلَى بَابِ الْمَسْجِدِ فَقُمْ وَقُلِ السَّلَامُ عَلَيْكَ أَيُّهَا النَّبِيُّ وَرَحْمَةُ اللَّهِ وَبَرَكَاتُهُ بِسْمِ اللَّهِ وَبِاللَّهِ وَمِنَ اللَّهِ وَمَا شَاءَ اللَّهُ وَالسَّلَامُ عَلَى أَنْبِيَاءِ اللَّهِ وَرُسُلِهِ وَالسَّلَامُ عَلَى رَسُولِ اللَّهِ وَالسَّلَامُ عَلَى إِبْرَاهِيمَ",
            "chunk_type": "body",
            "word_end": 95,
            "word_start": 61
          },
          {
            "arabic_text": "وَالْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ",
            "chunk_type": "quran_quote",
            "word_end": 99,
            "word_start": 95
          },
          {
            "arabic_text": "فَإِذَا دَخَلْتَ الْمَسْجِدَ فَارْفَعْ يَدَيْكَ وَاسْتَقْبِلِ الْبَيْتَ وَقُلِ اللَّهُمَّ إِنِّي أَسْأَلُكَ فِي مَقَامِي هَذَا فِي أَوَّلِ مَنَاسِكِي أَنْ تَقْبَلَ تَوْبَتِي وَأنْ تَجَاوَزَ عَنْ خَطِيئَتِي وَتَضَعَ عَنِّي وِزْرِي",
            "chunk_type": "body",
            "word_end": 126,
            "word_start": 99
          },
          {
            "arabic_text": "الْحَمْدُ لِلَّهِ الَّذِي بَلَّغَنِي بَيْتَهُ الْحَرَامَ",
            "chunk_type": "body",
            "word_end": 132,
            "word_start": 126
          },
          {
            "arabic_text": "اللَّهُمَّ إِنِّي أُشْهِدُكَ أَنَّ هَذَا بَيْتُكَ الْحَرَامُ الَّذِي جَعَلْتَهُ مَثَابَةً لِلنَّاسِ وَأَمْناً",
            "chunk_type": "body",
            "word_end": 144,
            "word_start": 132
          },
          {
            "arabic_text": "مُبارَكاً وَهُدىً لِلْعَالَمِينَ",
            "chunk_type": "quran_quote",
            "word_end": 147,
            "word_start": 144
          },
          {
            "arabic_text": "اللَّهُمَّ إِنَّ الْعَبْدَ عَبْدُكَ وَالْبَلَدَ بَلَدُكَ وَالْبَيْتَ بَيْتُكَ جِئْتُ أَطْلُبُ رَحْمَتَكَ وَأُؤَمُّ طَاعَتَكَ مُطِيعاً لِأَمْرِكَ رَاضِياً بِقَدَرِكَ",
            "chunk_type": "body",
            "word_end": 164,
            "word_start": 147
          },
          {
            "arabic_text": "أَسْأَلُكَ مَسْأَلَةَ الْفَقِيرِ إِلَيْكَ الْخَائِفِ مِنْ عُقُوبَتِكَ",
            "chunk_type": "body",
            "word_end": 171,
            "word_start": 164
          },
          {
            "arabic_text": "اللَّهُمَّ افْتَحْ لِي أَبْوَابَ رَحْمَتِكَ وَاسْتَعْمِلْنِي بِطَاعَتِكَ وَمَرْضَاتِكَ",
            "chunk_type": "closing",
            "word_end": 179,
            "word_start": 171
          }
        ],
