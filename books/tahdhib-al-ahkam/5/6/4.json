            "arabic_text": "مُوسَى بْنُ الْقَاسِمِ عَنْ حَنَانِ بْنِ سَدِيرٍ قَالَ",
            "chunk_type": "isnad",
            "word_end": 8,
            "word_start": 0
          },
          {
            "arabic_text": "كُنْتُ أَنَا وَ أَبِي وَ أَبُو حَمْزَةَ الثُّمَالِيُّ وَ عَبْدُ الرَّحِيمِ الْقَصِيرُ وَ زِيَادُ الْأَحْلَامِ فَدَخَلْنَا عَلَى أَبِي جَعْفَرٍ عَلَيْهِ السَّلَامُ",
            "chunk_type": "body",
            "word_end": 29,
            "word_start": 8
          },
          {
            "arabic_text": "فَرَأَى زِيَادًا قَدْ تَسَلَّخَ جَسَدُهُ فَقَالَ لَهُ «مِنْ أَيْنَ أَحْرَمْتَ» قَالَ مِنَ الْكُوفَةِ",
            "chunk_type": "body",
            "word_end": 42,
            "word_start": 29
          },
          {
            "arabic_text": "فَقَالَ «وَ لِمَ أَحْرَمْتَ مِنَ الْكُوفَةِ» فَقَالَ بَلَغَنِي عَنْ بَعْضِكُمْ أَنَّهُ قَالَ مَا بَعُدَ مِنَ الْإِحْرَامِ فَهُوَ أَعْظَمُ لِلْأَجْرِ",
            "chunk_type": "body",
            "word_end": 61,
            "word_start": 42
          },
          {
            "arabic_text": "فَقَالَ «مَا بَلَّغَكَ هَذَا إِلَّا كَذَّابٌ»",
            "chunk_type": "body",
            "word_end": 67,
            "word_start": 61
          },
          {
            "arabic_text": "ثُمَّ قَالَ لِأَبِي حَمْزَةَ «مِنْ أَيْنَ أَحْرَمْتَ» قَالَ مِنَ الرَّبَذَةِ",
            "chunk_type": "body",
            "word_end": 77,
            "word_start": 67
          },
          {
            "arabic_text": "فَقَالَ لَهُ «وَ لِمَ» قَالَ «لِأَنَّكَ سَمِعْتَ أَنَّ قَبْرَ أَبِي ذَرٍّ بِهَا فَأَحْبَبْتَ أَنْ لَا تَجُوزَهُ»",
            "chunk_type": "body",
            "word_end": 93,
            "word_start": 77
          },
          {
            "arabic_text": "ثُمَّ قَالَ لِأَبِي وَ لِعَبْدِ الرَّحِيمِ «مِنْ أَيْنَ أَحْرَمْتُمَا» فَقَالَا مِنَ الْعَقِيقِ",
            "chunk_type": "body",
            "word_end": 105,
            "word_start": 93
          },
          {
            "arabic_text": "فَقَالَ «أَصَبْتُمَا الرُّخْصَةَ وَ اتَّبَعْتُمَا السُّنَّةَ»",
            "chunk_type": "body",
            "word_end": 111,
            "word_start": 105
          },
          {
            "arabic_text": "وَ لَا يَعْرِضُ لِي بَابَانِ كِلَاهُمَا حَلَالٌ إِلَّا أَخَذْتُ بِالْيَسِيرِ",
            "chunk_type": "body",
            "word_end": 121,
            "word_start": 111
          },
          {
            "arabic_text": "وَ ذَلِكَ أَنَّ اللَّهَ يَسِيرٌ وَ يُحِبُّ الْيَسِيرَ وَ يُعْطِي عَلَى الْيَسِيرِ مَا لَا يُعْطِي عَلَى الْعُنْفِ",
