            "chunk_type": "isnad",
            "word_end": 25,
            "word_start": 0
          },
          {
            "arabic_text": "لَا بُدَّ لِلصَّرُورَةِ أَنْ يَدْخُلَ الْبَيْتَ قَبْلَ أَنْ يَرْجِعَ فَإِذَا دَخَلْتَهُ فَادْخُلْهُ بِسَكِينَةٍ وَوَقَارٍ ثُمَّ ائْتِ كُلَّ زَاوِيَةٍ مِنْ زَوَايَاهُ",
            "chunk_type": "body",
            "word_end": 45,
            "word_start": 25
          },
          {
            "arabic_text": "ثُمَّ قُلِ اللَّهُمَّ إِنَّكَ قُلْتَ وَمَنْ دَخَلَهُ كَانَ آمِنًا فَآمِنِّي مِنْ عَذَابِكَ يَوْمَ الْقِيَامَةِ",
            "chunk_type": "body",
            "word_end": 59,
            "word_start": 45
