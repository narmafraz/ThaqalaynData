        "chunks": [
          {
            "arabic_text": "وَعَنْهُ عَنْ عِدَّةٍ مِنْ أَصْحَابِنَا عَنْ أَحْمَدَ بْنِ مُحَمَّدٍ عَنْ أَحْمَدَ بْنِ مُحَمَّدٍ عَنْ عَلِيِّ بْنِ الْحَكَمِ عَنْ دَاوُدَ بْنِ النُّعْمَانِ عَنْ أَبِي أَيُّوبَ قَالَ",
            "chunk_type": "isnad",
            "word_end": 25,
            "word_start": 0
          },
          {
            "arabic_text": "قُلْتُ لِأَبِي عَبْدِ اللَّهِ عَلَيْهِ السَّلَامُ إِنَّا نُرِيدُ أَنْ نَتَعَجَّلَ السَّيْرَ وَكَانَتْ لَيْلَةَ النَّفْرِ حِينَ سَأَلْتُهُ فَأَيَّ سَاعَةٍ نَنْفِرُ فَقَالَ لِي «أَمَّا الْيَوْمَ الثَّانِيَ فَلَا تَنْفِرْ حَتَّى تَزُولَ الشَّمْسُ وَكَانَتْ لَيْلَةَ النَّفْرِ",
            "chunk_type": "body",
            "word_end": 57,
            "word_start": 25
          },
          {
            "arabic_text": "فَأَمَّا الْيَوْمَ الثَّالِثَ فَإِذَا ابْيَضَّتِ الشَّمْسُ فَانْفِرْ عَلَى كِتَابِ اللَّهِ فَإِنَّ اللَّهَ عَزَّ وَجَلَّ يَقُولُ",
            "chunk_type": "body",
            "word_end": 72,
            "word_start": 57
          },
          {
            "arabic_text": "فَمَنْ تَعَجَّلَ فِي يَوْمَيْنِ فَلَا إِثْمَ عَلَيْهِ وَمَنْ تَأَخَّرَ فَلَا إِثْمَ عَلَيْهِ",
            "chunk_type": "quran_quote",
            "word_end": 84,
            "word_start": 72
          },
          {
            "arabic_text": "فَلَوْ سَكَتَ لَمْ يَبْقَ أَحَدٌ إِلَّا تَعَجَّلَ وَلَكِنَّهُ قَالَ «وَمَنْ تَأَخَّرَ فَلَا إِثْمَ عَلَيْهِ»",
            "chunk_type": "closing",
            "word_end": 98,
            "word_start": 84
          }
