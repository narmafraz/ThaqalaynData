            "word_start": 0
          },
          {
            "arabic_text": "أَنَّهُ اِشْتَكَى عَيْنَهُ فَعَادَهُ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَ آلِهِ فَإِذَا عَلِيٌّ عَلَيْهِ السَّلَامُ يَصِيحُ فَقَالَ لَهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَ آلِهِ «أَ جَزَعاً أَمْ وَجَعاً يَا عَلِيُّ» قَالَ «يَا رَسُولَ اللَّهِ مَا وَجِعْتُ وَجَعاً قَطُّ أَشَدَّ مِنْهُ»",
            "chunk_type": "body",
            "word_end": 57,
            "word_start": 17
          },
          {
            "arabic_text": "قَالَ «يَا عَلِيُّ إِنَّ مَلَكَ الْمَوْتِ إِذَا نَزَلَ لِيَقْبِضَ رُوحَ الْفَاجِرِ نَزَلَ مَعَهُ بِسَفُّودٍ مِنْ نَارٍ فَيَنْزِعُ رُوحَهُ بِهِ فَتَصِيحُ جَهَنَّمُ»",
            "chunk_type": "body",
            "word_end": 78,
            "word_start": 57
          },
          {
            "arabic_text": "فَاسْتَوَى عَلِيٌّ عَلَيْهِ السَّلَامُ جَالِساً فَقَالَ «يَا رَسُولَ اللَّهِ أَعِدْ عَلَيَّ حَدِيثَكَ فَقَدْ أَنْسَانِي وَجَعِي مَا قُلْتَ فَهَلْ يُصِيبُ ذَلِكَ أَحَداً مِنْ أُمَّتِكَ»",
            "chunk_type": "body",
            "word_end": 101,
            "word_start": 78
          },
          {
            "arabic_text": "قَالَ «نَعَمْ حُكَّاماً جَائِرِينَ وَ آكِلَ مَالَ الْيَتِيمِ وَ شَاهِدَ الزُّورِ»",
