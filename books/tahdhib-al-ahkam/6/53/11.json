            "word_start": 0
          },
          {
            "arabic_text": "قَالَ أَمِيرُ الْمُؤْمِنِينَ عَلَيْهِ السَّلَامُ : «إِنَّ الْجِهَادَ بَابٌ فَتَحَهُ اللَّهُ لِخَاصَّةِ أَوْلِيَائِهِ وَ سَوَّغَهُمْ كَرَامَةً مِنْهُ لَهُمْ وَ نِعْمَةً ذَخَرَهَا",
            "chunk_type": "body",
            "word_end": 69,
            "word_start": 48
          },
          {
            "arabic_text": "وَالْجِهَادُ لِبَاسُ التَّقْوَى وَ دِرْعُ اللَّهِ الْحَصِينَةُ وَ حِصْنُهُ (1) الْوَثِيقَةُ",
            "chunk_type": "body",
            "word_end": 80,
            "word_start": 69
          },
          {
            "arabic_text": "فَمَنْ تَرَكَهُ رَغْبَةً عَنْهُ أَلْبَسَهُ اللَّهُ ثَوْبَ الْمَذَلَّةِ وَ شَمْلَةَ الْبَلاَءِ وَ فَارَقَ الرَّخَاءَ وَ ضُرَ عَلَى قَلْبِهِ بِالْأَشْبَاهِ وَ دُيِّثَ بِالصَّغَارِ وَالْقَمَاءِ (2) وَ سِيمَ الْخَسْفَ وَ مُنِعَ النَّصَفَ وَ أُدِيلَ الْحَقُّ مِنْهُ بِتَضْيِيعِهِ الْجِهَادَ",
            "chunk_type": "body",
            "word_end": 116,
            "word_start": 80
          },
          {
            "arabic_text": "وَ غَضِبَ اللَّهُ عَلَيْهِ بِتَرْكِهِ نُصْرَتَهُ",
            "chunk_type": "body",
            "word_end": 122,
            "word_start": 116
