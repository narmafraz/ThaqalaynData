          {
            "arabic_text": "أُتِيَ عُمَرُ بِامْرَأَةٍ وَ زَوْجُهَا شَيْخٌ فَلَمَّا أَنْ وَاقَعَهَا مَاتَ عَلَى بَطْنِهَا فَجَاءَتْ بِوَلَدٍ فَادَّعَى بَنُوهُ أَنَّهَا فَجَرَتْ وَ تَشَاهَدُوا عَلَيْهَا فَأَمَرَ بِهَا عُمَرُ أَنْ تُرْجَمَ",
            "chunk_type": "body",
            "word_end": 50,
            "word_start": 24
          },
          {
            "arabic_text": "فَمَرَّ بِهَا عَلِيٌّ عَلَيْهِ اَلسَّلاَمُ فَقَالَتْ يَا اِبْنَ عَمِّ رَسُولِ اَللَّهِ إِنَّ لِيَ حُجَّةً فَقَالَ «هَاتِي حُجَّتَكِ»",
            "chunk_type": "body",
            "word_end": 67,
            "word_start": 50
          },
          {
            "arabic_text": "فَدَفَعَتْ إِلَيْهِ كِتَاباً فَقَرَأَهُ فَقَالَ «هَذِهِ اَلْمَرْأَةُ تُعْلِمُكُمْ بِيَوْمِ تَزَوَّجَهَا وَ يَوْمِ وَاقَعَهَا كَيْفَ كَانَ جِمَاعُهُ لَهَا رُدُّوا اَلْمَرْأَةَ»",
            "chunk_type": "body",
            "word_end": 86,
            "word_start": 67
          },
          {
            "arabic_text": "فَلَمَّا أَنْ كَانَ مِنَ اَلْغَدِ دَعَا بِصِبْيَانٍ أَتْرَابٍ وَ دَعَا بِالصَّبِيِّ مَعَهُمْ فَقَالَ لَهُمُ «اِلْعَبُوا» حَتَّى إِذَا أَلْهَاهُمُ اَللَّعِبُ قَالَ لَهُمُ «اِجْلِسُوا»",
            "chunk_type": "body",
            "word_end": 108,
            "word_start": 86
          },
          {
            "arabic_text": "فَجَلَسُوا حَتَّى إِذَا تَمَكَّنُوا صَاحَ بِهِمْ فَقَامَ اَلصِّبْيَانُ وَ قَامَ اَلْغُلاَمُ فَاتَّكَى عَلَى رَاحَتَيْهِ فَدَعَا بِهِ عَلِيٌّ عَلَيْهِ اَلسَّلاَمُ",
            "chunk_type": "body",
            "word_end": 127,
            "word_start": 108
          },
          {
            "arabic_text": "فَوَرَّثَهُ مِنْ أَبِيهِ وَ جَلَدَ إِخْوَتَهُ حَدَّ اَلْمُارِي فَقَالَ لَهُ عُمَرُ كَيْفَ صَنَعْتَ",
            "chunk_type": "body",
            "word_end": 140,
            "word_start": 127
          },
          {
            "arabic_text": "قَالَ «عَرَفْتُ ضَعْفَ اَلشَّيْخِ فِي اِتِّكَاءِ اَلْغُلاَمِ عَلَى رَاحَتَيْهِ»",
