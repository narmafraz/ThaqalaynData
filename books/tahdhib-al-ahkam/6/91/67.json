            "chunk_type": "isnad",
            "word_end": 14,
            "word_start": 0
          },
          {
            "arabic_text": "قِيلَ لِأَبِي عَبْدِ اللَّهِ عَلَيْهِ السَّلَامُ إِنَّا نَدْخُلُ عَلَى أَخٍ لَنَا فِي بَيْتِ أَيْتَامٍ وَمَعَهُمْ خَادِمٌ لَهُمْ فَنَقْعُدُ عَلَى بِسَاطِهِمْ وَنَشْرَبُ مِنْ مَائِهِمْ وَيَخْدُمُنَا خَادِمُهُمْ وَرُبَّمَا طَعِمْنَا فِيهِ الطَّعَامَ مِنْ عِنْدِ صَاحِبِنَا وَفِيهِ مِنْ طَعَامِهِمْ فَمَا تَرَى فِي ذَلِكَ",
            "chunk_type": "body",
            "word_end": 53,
            "word_start": 14
          },
          {
            "arabic_text": "فَقَالَ «إِنْ كَانَ دُخُولُكُمْ عَلَيْهِمْ مَنْفَعَةً لَهُمْ فَلَا بَأْسَ وَإِنْ كَانَ فِيهِ ضَرَرٌ لَهُمْ فَلَا»",
            "chunk_type": "body",
            "word_end": 68,
            "word_start": 53
          },
          {
            "arabic_text": "وَقَالَ «بَلِ الْإِنْسَانُ عَلَى نَفْسِهِ بَصِيرَةٌ» فَأَنْتُمْ لَا يَخْفَى عَلَيْكُمْ",
            "chunk_type": "body",
            "word_end": 78,
            "word_start": 68
          },
          {
            "arabic_text": "وَقَدْ قَالَ اللَّهُ عَزَّ وَجَلَّ «وَإِنْ تُخَالِطُوهُمْ فَإِخْوَانُكُمْ وَاللَّهُ يَعْلَمُ الْمُفْسِدَ مِنَ الْمُصْلِحِ»",
