          },
          {
            "arabic_text": "دَخَلْتُ عَلَى أَبِي عَبْدِ اللَّهِ عَلَيْهِ السَّلَامُ فَسَأَلَنَا عَنْ عُمَرَ بْنِ مُسْلِمٍ «مَا فَعَلَ» فَقُلْنَا صَالِحٌ وَ لَكِنَّهُ قَدْ تَرَكَ التِّجَارَةَ",
            "chunk_type": "body",
            "word_end": 33,
            "word_start": 12
          },
          {
            "arabic_text": "فَقَالَ أَبُو عَبْدِ اللَّهِ عَلَيْهِ السَّلَامُ «عَمَلُ الشَّيْطَانِ ثَلَاَثاً أَ مَا عَلِمَ أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَ آلِهِ اِشْتَرَى عِيرًا أَتَتْ مِنَ الشَّامِ فَاسْتَفْضَلَ فِيهَا مَا قَضَى دَيْنَهُ وَ قَسَمَ فِي قَرَابَتِهِ",
            "chunk_type": "body",
            "word_end": 67,
            "word_start": 33
          },
          {
            "arabic_text": "يَقُولُ اللَّهُ عَزَّ وَ جَلَّ «رِجَالٌ لَا تُلْهِيهِمْ تِجَارَةٌ وَ لَا بَيْعٌ عَنْ ذِكْرِ اللَّهِ وَ إِقَامِ الصَّلَاةِ» إِلَى آخِرِ الْآيَةِ",
            "chunk_type": "quran_quote",
            "word_end": 88,
            "word_start": 67
          },
          {
            "arabic_text": "يَقُولُ الْقُصَّاصُ إِنَّ الْقَوْمَ لَمْ يَكُونُوا يَتَّجِرُونَ كَذَبُوا وَ لَكِنَّهُمْ لَمْ يَكُونُوا يَدَعُونَ الصَّلَاةَ فِي مِيقَاتِهَا وَ هُمْ أَفْضَلُ مِمَّنْ حَضَرَ الصَّلَاةَ وَ لَمْ يَتَّجِرْ",
