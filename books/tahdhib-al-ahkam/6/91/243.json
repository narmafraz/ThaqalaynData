            "word_end": 11,
            "word_start": 0
          },
          {
            "arabic_text": "سَأَلْتُهُ عَنْ تُرَابِ اَلصَّوَّاغِينَ وَ أَنَّا نَبِيعُهُ قَالَ «أَ مَا تَسْتَطِيعُ أَنْ تَسْتَحِلَّهُ مِنْ صَاحِبِهِ»",
            "chunk_type": "body",
