            "chunk_type": "body",
            "word_end": 39,
            "word_start": 19
          },
          {
            "arabic_text": "فَقَالَ «وَيْحَهُ أَ مَا عَلِمَ أَنَّ تَارِكَ الطَّلَبِ لَا يُسْتَجَابُ لَهُ",
            "chunk_type": "body",
            "word_end": 50,
            "word_start": 39
          },
          {
            "arabic_text": "إِنَّ قَوْمًا مِنْ أَصْحَابِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَ آلِهِ لَمَّا نَزَلَتْ «وَمَنْ يَتَّقِ اللَّهَ يَجْعَلْ لَهُ مَخْرَجًا وَ يَرْزُقْهُ مِنْ حَيْثُ لَا يَحْتَسِبُ»",
            "chunk_type": "body",
            "word_end": 75,
            "word_start": 50
          },
          {
            "arabic_text": "«وَمَنْ يَتَّقِ اللَّهَ يَجْعَلْ لَهُ مَخْرَجًا وَ يَرْزُقْهُ مِنْ حَيْثُ لَا يَحْتَسِبُ»",
