            "word_start": 0
          },
          {
            "arabic_text": "سَمِعْتُهُ يَقُولُ: «صَامَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَآلِهِ حَتَّى قِيلَ مَا يُفْطِرُ ثُمَّ أَفْطَرَ حَتَّى قِيلَ مَا يَصُومُ ثُمَّ صَامَ صَوْمَ دَاوُدَ عَلَيْهِ السَّلَامُ يَوْمًا وَ يَوْمًا لَا ثُمَّ قُبِضَ عَلَيْهِ السَّلَامُ عَلَى صِيَامِ ثَلَاثَةِ أَيَّامٍ فِي الشَّهْرِ وَ قَالَ: «يَعْدِلُنَ صَوْمَ الدَّهْرِ وَ يَذْهَبُنَ بِوَحَرِ الصَّدْرِ»»",
            "chunk_type": "body",
            "word_end": 72,
            "word_start": 24
          },
          {
            "arabic_text": "قَالَ حَمَّادٌ فَقُلْتُ: فَمَا الْوَحَرُ؟ فَقَالَ: «الْوَحَرُ الْوَسْوَسَةُ»",
            "chunk_type": "body",
            "word_end": 80,
            "word_start": 72
          },
          {
            "arabic_text": "قَالَ حَمَّادٌ فَقُلْتُ: أَيُّ الْأَيَّامِ هِيَ؟ قَالَ: «أَوَّلُ خَمِيسٍ فِي الشَّهْرِ وَ أَوَّلُ أَرْبَعَاءَ بَعْدَ الْعَشْرِ وَ آخِرُ خَمِيسٍ فِيهِ»",
            "chunk_type": "body",
            "word_end": 100,
            "word_start": 80
          },
          {
            "arabic_text": "فَقُلْتُ: لِمَ صَارَتْ هَذِهِ الْأَيَّامُ الَّتِي تُصَامُ؟ فَقَالَ: «إِنَّ مَنْ قَبْلَنَا مِنَ الْأُمَمِ كَانَ إِذَا نَزَلَ عَلَى أَحَدِهِمُ الْعَذَابُ نَزَلَ فِي هَذِهِ الْأَيَّامِ الْمَخُوفَةِ»",
