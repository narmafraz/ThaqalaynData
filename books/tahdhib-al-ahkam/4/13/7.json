            "chunk_type": "isnad",
            "word_end": 18,
            "word_start": 0
          },
          {
            "arabic_text": "قَالَ لِي شِهَابُ بْنُ عَبْدِ رَبِّهِ أَقْرِئْ أَبَا عَبْدِ اَللَّهِ عَلَيْهِ اَلسَّلاَمُ عَنِّي اَلسَّلاَمَ وَ أَعْلِمْهُ أَنَّهُ يُصِيبُنِي فَزَعٌ فِي مَنَامِي",
            "chunk_type": "body",
            "word_end": 39,
            "word_start": 18
          },
          {
            "arabic_text": "قَالَ فَقُلْتُ لَهُ إِنَّ شِهَاباً يُقْرِئُكَ اَلسَّلاَمَ وَ يَقُولُ إِنَّهُ يُصِيبُنِي فَزَعٌ فِي مَنَامِي",
            "chunk_type": "body",
            "word_end": 53,
            "word_start": 39
