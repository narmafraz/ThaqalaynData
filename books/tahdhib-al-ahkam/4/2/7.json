            "arabic_text": "مُحَمَّدُ بْنُ عَلِيِّ بْنِ مَحْبُوبٍ عَنْ مُحَمَّدِ بْنِ عِيسَى الْكُوفِيِّ عَنْ حَمَّادِ بْنِ عِيسَى عَنْ حَرِيزٍ عَنْ عَلِيِّ بْنِ يَقْطِينٍ عَنْ أَبِي إِبْرَاهِيمَ عَلَيْهِ السَّلَامُ قَالَ",
            "chunk_type": "isnad",
            "word_end": 26,
            "word_start": 0
          },
          {
            "arabic_text": "قُلْتُ لَهُ إِنَّهُ يَجْتَمِعُ عِنْدِيَ الشَّيْءُ الْكَثِيرُ قِيمَتُهُ فَيَبْقَى نَحْوَ سَنَةٍ أَزَكِّيهِ فَقَالَ «لَا كُلُّ مَا لَمْ يَحُلْ عِنْدَكَ عَلَيْهِ حَوْلٌ فَلَيْسَ عَلَيْكَ فِيهِ زَكَاةٌ وَكُلُّ مَا لَمْ يَكُنْ رِكَازًا فَلَيْسَ عَلَيْكَ فِيهِ شَيْءٌ»",
            "chunk_type": "body",
            "word_end": 60,
            "word_start": 26
          },
          {
            "arabic_text": "قُلْتُ وَمَا الرِّكَازُ قَالَ «الصَّامِتُ الْمَنْقُوشُ»",
            "chunk_type": "body",
            "word_end": 66,
            "word_start": 60
          },
          {
            "arabic_text": "ثُمَّ قَالَ «إِذَا أَرَدْتَ ذَلِكَ فَاسْبِكْهُ فَإِنَّهُ لَيْسَ فِي سَبَائِكِ الذَّهَبِ وَنِقَارِ الْفِضَّةِ زَكَاةٌ»",
            "chunk_type": "body",
            "word_end": 80,
            "word_start": 66
          },
          {
            "arabic_text": "فَأَمَّا الْحُلِيُّ فَإِنَّهُ لَيْسَ فِي شَيْءٍ مِنْهَا زَكَاةٌ يَدُلُّ عَلَى ذَلِكَ مَا رَوَاهُ",
