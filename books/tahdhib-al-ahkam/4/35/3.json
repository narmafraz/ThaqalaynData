            "word_start": 35
          },
          {
            "arabic_text": "قَالَ اللَّهُ تَعَالَى «إِنْ كُنْتُمْ آمَنْتُمْ بِاللَّهِ وَمَا أَنْزَلْنَا عَلَى عَبْدِنَا يَوْمَ الْفُرْقَانِ يَوْمَ الْتَقَى الْجَمْعَانِ»",
            "chunk_type": "quran_quote",
            "word_end": 65,
            "word_start": 49
          },
          {
            "arabic_text": "نَحْنُ وَ اللَّهِ عُنيَ بِذِي الْقُرْبَى وَ هُمُ الَّذِينَ قَرَنَهُمُ اللَّهُ بِنَفْسِهِ وَ بِنَبِيِّهِ صَلَّى اللَّهُ عَلَيْهِ وَ آلِهِ فَقَالَ «فَإِنَّ لِلَّهِ خُمُسَهُ وَ لِلرَّسُولِ وَ لِذِي الْقُرْبَى وَالْيَتَامَى وَالْمَسَاكِينِ وَ ابْنِ السَّبِيلِ»",
            "chunk_type": "body",
            "word_end": 98,
            "word_start": 65
          },
          {
            "arabic_text": "مِنَّا خَاصَّةً",
