        "chunks": [
          {
            "arabic_text": "مُحَمَّدُ بْنُ الْحَسَنِ الصَّفَّارُ عَنْ عِمْرَانَ بْنِ مُوسَى عَنْ مُوسَى بْنِ جَعْفَرٍ عَنْ مُحَمَّدِ بْنِ الْحُسَيْنِ عَنِ الْحَسَنِ بْنِ عَلِيِّ بْنِ فَضَّالٍ عَنِ ابْنِ بُكَيْرٍ عَنْ عَبْدِ الْأَعْلَى مَوْلَى آلِ سَامٍ : فِي الرَّجُلِ يُرِيدُ السَّفَرَ فِي شَهْرِ رَمَضَانَ",
            "chunk_type": "isnad",
            "word_end": 39,
            "word_start": 0
          },
          {
            "arabic_text": "قَالَ «يُفْطِرُ وَإِنْ خَرَجَ قَبْلَ أَنْ تَغِيبَ الشَّمْسُ بِقِيلٍ».",
            "chunk_type": "body",
            "word_end": 48,
            "word_start": 39
          },
          {
            "arabic_text": "فَأَوَّلُ مَا فِيهِ أَنَّهُ مَوْقُوفٌ غَيْرُ مُسْنَدٍ إِلَى أَحَدٍ مِنَ الْأَئِمَّةِ عَلَيْهِمُ السَّلَامُ",
            "chunk_type": "body",
            "word_end": 61,
            "word_start": 48
          },
          {
            "arabic_text": "وَمَا يَكُونُ هَذَا حُكْمَهُ لَا يَعْتَرِضُ بِهِ الْأَخْبَارُ الْمُسْنَدَةُ",
            "chunk_type": "body",
            "word_end": 70,
            "word_start": 61
          },
          {
            "arabic_text": "وَلَوْ صَحَّ كَانَ الْوَجْهُ فِيهِ مَا ذَكَرْنَاهُ مِنْ أَنَّ مَنْ خَرَجَ قَبْلَ مَغِيبِ الشَّمْسِ وَكَانَ قَدْ بَيَّتَ نِيَّةَ السَّفَرِ يَجُوزُ لَهُ الْإِفْطَارُ",
            "chunk_type": "body",
            "word_end": 92,
            "word_start": 70
          },
          {
            "arabic_text": "وَإِنْ كَانَ يَكُونُ بِهِ تَارِكًا فَضْلًا وَمُهْمِلًا مَا هُوَ أَوْلَى بِهِ إِلَّا أَنَّهُ لَا يَكُونُ بِذَلِكَ عَاصِيًا يَسْتَحِقُّ بِهِ الْعِقَابَ.",
            "chunk_type": "body",
            "word_end": 112,
            "word_start": 92
          },
          {
            "arabic_text": "قَالَ الشَّيْخُ رَحِمَهُ اللَّهُ : وَمَنْ وَجَبَ عَلَيْهِ التَّقْصِيرُ لَا يَجُوزُ لَهُ أَنْ يُفْطِرَ وَيُقَصِّرَ حَتَّى يَغِيبَ عَنْهُ أَذَانُ مِصْرِهِ.",
            "chunk_type": "closing",
