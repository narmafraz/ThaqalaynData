            "word_end": 21,
            "word_start": 0
          },
          {
            "arabic_text": "بَعَثَ اللَّهُ مُحَمَّدًا صَلَّى اللَّهُ عَلَيْهِ وَ آلِهِ «رَحْمَةً لِلْعَالَمِينَ» فِي سَبْعَةٍ وَ عِشْرِينَ مِنْ رَجَبٍ فَمَنْ صَامَ ذَلِكَ الْيَوْمَ كَتَبَ اللَّهُ عَزَّ وَ جَلَّ لَهُ صِيَامَ سِتِّينَ شَهْرًا",
            "chunk_type": "body",
            "word_end": 50,
            "word_start": 21
          },
          {
            "arabic_text": "وَفِي خَمْسَةٍ وَ عِشْرِينَ مِنْ ذِي الْقَعْدَةِ وَضَعَ اللَّهُ الْبَيْتَ وَ هُوَ أَوَّلُ رَحْمَةٍ وُضِعَتْ عَلَى وَجْهِ الْأَرْضِ فَجَعَلَهُ اللَّهُ عَزَّ وَ جَلَّ «مَثَابَةً لِلنَّاسِ وَ أَمْنًا» فَمَنْ صَامَ ذَلِكَ الْيَوْمَ كَتَبَ اللَّهُ لَهُ صِيَامَ سِتِّينَ شَهْرًا",
            "chunk_type": "body",
            "word_end": 87,
            "word_start": 50
