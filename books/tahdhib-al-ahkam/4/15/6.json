            "chunk_type": "isnad",
            "word_end": 24,
            "word_start": 0
          },
          {
            "arabic_text": "مَوَالِيهِمْ مِنْهُمْ وَ لَا تَحِلُّ الصَّدَقَةُ مِنَ الْغَرِيبِ لِمَوَالِيهِمْ وَ لَا بَأْسَ بِصَدَقَاتِ مَوَالِيهِمْ عَلَيْهِمْ",
            "chunk_type": "body",
            "word_end": 39,
            "word_start": 24
          },
          {
            "arabic_text": "ثُمَّ قَالَ «إِنَّهُ لَوْ كَانَ الْعَدْلُ مَا احْتَاجَ هَاشِمِيٌّ وَلَا مُطَّلِبِيٌّ إِلَى صَدَقَةٍ إِنَّ اللَّهَ جَعَلَ لَهُمْ فِي كِتَابِهِ مَا كَانَ فِيهِ سَعَتُهُمْ»",
            "chunk_type": "body",
            "word_end": 62,
            "word_start": 39
          },
          {
            "arabic_text": "ثُمَّ قَالَ «إِنَّ الرَّجُلَ إِذَا لَمْ يَجِدْ شَيْئًا حَلَّتْ لَهُ الْمَيْتَةُ وَالصَّدَقَةُ وَلَا تَحِلُّ لِأَحَدٍ مِنْهُمْ إِلَّا أَنْ لَا يَجِدَ شَيْئًا وَكَانَ مِمَّنْ تَحِلُّ لَهُ الْمَيْتَةُ»",
            "chunk_type": "body",
            "word_end": 88,
            "word_start": 62
          },
          {
            "arabic_text": "قَوْلُهُ عَلَيْهِ السَّلَامُ وَ لَا تَحِلُّ الصَّدَقَةُ مِنَ الْغَرِيبِ لِمَوَالِيهِمْ فَالْمُرَادُ بِهِ إِذَا كَانَ الْمَوَالِي مَمَالِكَ لَهُمْ وَيَلْزَمُهُمُ الْقِيَامُ بِنَفَقَاتِهِمْ لَا يَجُوزُ لَهُمْ أَنْ يُعْطَوُ الزَّكَاةَ لِأَنَّ الْمَمْلُوكَ لَا يَجُوزُ أَنْ يُعْطَى الزَّكَاةَ فَأَمَّا مَوَالِيهِمُ الَّذِينَ لَيْسُوا مَمَالِكَ فَلَيْسَ بِمُحَرَّمٍ ذَلِكَ عَلَيْهِمْ وَالَّذِي يَدُلُّ عَلَى ذَلِكَ مَا رَوَاهُ",
