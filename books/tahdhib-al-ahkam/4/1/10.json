            "chunk_type": "isnad",
            "word_end": 18,
            "word_start": 0
          },
          {
            "arabic_text": "سَمِعْتُهُ يَقُولُ: «وَضَعَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَآلِهِ الزَّكَاةَ عَلَى تِسْعَةِ أَشْيَاءَ وَعَفَا عَمَّا سِوَى ذَلِكَ عَلَى الْفِضَّةِ وَالذَّهَبِ وَالْحِنْطَةِ وَالشَّعِيرِ وَالتَّمْرِ وَالزَّبِيبِ وَالْإِبِلِ وَالْبَقَرِ وَالْغَنَمِ»",
            "chunk_type": "body",
            "word_end": 45,
            "word_start": 18
          },
          {
            "arabic_text": "فَقَالَ لَهُ الطَّيَّارُ وَ أَنَا حَاضِرٌ إِنَّ عِنْدَنَا حَبًّا كَثِيرًا يُقَالُ لَهُ الْأَرُزُّ",
            "chunk_type": "body",
            "word_end": 58,
            "word_start": 45
          },
          {
            "arabic_text": "فَقَالَ لَهُ أَبُو عَبْدِ اللَّهِ عَلَيْهِ السَّلَامُ: «وَعِنْدَنَا حَبٌّ كَثِيرٌ»",
            "chunk_type": "body",
            "word_end": 68,
            "word_start": 58
          },
          {
            "arabic_text": "قَالَ: فَعَلَيْهِ شَيْءٌ؟",
            "chunk_type": "body",
            "word_end": 71,
            "word_start": 68
          },
          {
            "arabic_text": "قَالَ: «لَا، قَدْ أَعْلَمْتُكَ أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَآلِهِ عَفَا عَمَّا سِوَى ذَلِكَ»",
