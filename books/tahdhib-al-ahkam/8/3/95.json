          {
            "arabic_text": "وَعَنْهُ عَنِ ابْنِ أَبِي عُمَيْرٍ عَنْ حَمَّادٍ عَنِ الْحَلَبِيِّ عَنْ أَبِي عَبْدِ اللَّهِ عَلَيْهِ السَّلَامُ قَالَ",
            "chunk_type": "isnad",
            "word_end": 16,
            "word_start": 0
          },
          {
            "arabic_text": "مَنْ طَلَّقَ امْرَأَتَهُ ثَلَاثًا فِي مَجْلِسٍ وَهِيَ حَائِضٌ فَلَيْسَ بِشَيْءٍ",
            "chunk_type": "body",
            "word_end": 26,
            "word_start": 16
          },
          {
            "arabic_text": "وَقَدْ رَدَّ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَآلِهِ طَلَاقَ عَبْدِ اللَّهِ بْنِ عُمَرَ إِذْ طَلَّقَ امْرَأَتَهُ ثَلَاثًا وَهِيَ حَائِضٌ",
            "chunk_type": "body",
            "word_end": 45,
            "word_start": 26
          },
          {
            "arabic_text": "فَأَبْطَلَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَآلِهِ ذَلِكَ الطَّلَاقَ",
            "chunk_type": "body",
            "word_end": 54,
            "word_start": 45
          },
          {
            "arabic_text": "وَقَالَ «كُلُّ شَيْءٍ خَالَفَ كِتَابَ اللَّهِ فَهُوَ رَدٌّ إِلَى كِتَابِ اللَّهِ»",
            "chunk_type": "body",
            "word_end": 65,
            "word_start": 54
          },
          {
            "arabic_text": "وَقَالَ «لَا طَلَاقَ إِلَّا فِي عِدَّةٍ»",
            "chunk_type": "body",
            "word_end": 71,
            "word_start": 65
          },
          {
            "arabic_text": "وَيَحْتَمِلُ أَيْضًا أَنْ يَكُونَ قَوْلُهُ فَلَيْسَ بِشَيْءٍ فِي كَوْنِهِ طَلَاقًا ثَلَاثًا لِأَنَّ ذَلِكَ قَدْ بَيَّنَّا أَنَّهُ يُرَدُّ إِلَى الْوَاحِدَةِ",
            "chunk_type": "closing",
            "word_end": 90,
            "word_start": 71
          },
          {
            "arabic_text": "وَالَّذِي يَكْشِفُ عَمَّا ذَكَرْنَاهُ مَا رَوَاهُ",
            "chunk_type": "closing",
