            "arabic_text": "مُحَمَّدُ بْنُ يَعْقُوبَ عَنْ حُمَيْدِ بْنِ زِيَادٍ عَنِ ابْنِ سَمَاعَةَ عَنْ مُحَمَّدِ بْنِ زِيَادٍ وَ صَفْوَانَ عَنْ رِفَاعَةَ عَنْ أَبِي عَبْدِ اللَّهِ عَلَيْهِ السَّلَامُ قَالَ",
            "chunk_type": "isnad",
            "word_end": 25,
            "word_start": 0
          },
          {
            "arabic_text": "سَأَلْتُهُ عَنْ رَجُلٍ طَلَّقَ امْرَأَتَهُ حَتَّى بَانَتْ مِنْهُ وَ انْقَضَتْ عِدَّتُهَا ثُمَّ تَزَوَّجَتْ زَوْجاً آخَرَ فَطَلَّقَهَا أَيْضاً ثُمَّ تَزَوَّجَتْ زَوْجَهَا الْأَوَّلَ أَ يَهْدِمُ ذَلِكَ الطَّلَاقَ الْأَوَّلَ قَالَ «نَعَمْ»",
            "chunk_type": "body",
            "word_end": 53,
            "word_start": 25
          },
          {
            "arabic_text": "قَالَ ابْنُ سَمَاعَةَ وَ كَانَ ابْنُ بُكَيْرٍ يَقُولُ الْمُطَلَّقَةُ إِذَا طَلَّقَهَا زَوْجُهَا ثُمَّ تَرَكَهَا حَتَّى تَبِينَ ثُمَّ تَزَوَّجَهَا فَإِنَّمَا هِيَ عِنْدَهُ عَلَى طَلَقٍ مُسْتَأْنَفٍ",
            "chunk_type": "body",
            "word_end": 77,
            "word_start": 53
          },
          {
            "arabic_text": "قَالَ ابْنُ سَمَاعَةَ وَ ذَكَرَ الْحُسَيْنُ بْنُ هَاشِمٍ أَنَّهُ سَأَلَ ابْنَ بُكَيْرٍ عَنْهَا فَأَجَابَهُ بِهَذَا الْجَوَابِ فَقَالَ لَهُ سَمِعْتَ فِي هَذَا شَيْئاً فَقَالَ رِوَايَةَ رِفَاعَةَ",
            "chunk_type": "body",
            "word_end": 102,
            "word_start": 77
          },
          {
            "arabic_text": "فَقَالَ إِنَّ رِفَاعَةَ رَوَى أَنَّهُ إِذَا دَخَلَ بَيْنَهُمَا زَوْجٌ فَقَالَ زَوْجٌ وَ غَيْرُ زَوْجٍ عِنْدِي سَوَاءٌ",
            "chunk_type": "body",
            "word_end": 118,
            "word_start": 102
          },
          {
            "arabic_text": "فَقُلْتُ سَمِعْتَ فِي هَذَا شَيْئاً فَقَالَ لَا هَذَا مِمَّا رَزَقَهُ اللَّهُ مِنَ الرَّأْيِ",
            "chunk_type": "body",
            "word_end": 131,
            "word_start": 118
          },
          {
            "arabic_text": "قَالَ ابْنُ سَمَاعَةَ وَ لَيْسَ نَأْخُذُ بِقَوْلِ ابْنِ بُكَيْرٍ فَإِنَّ الرَّوَايَةَ إِذَا دَخَلَ بَيْنَهُمَا زَوْجٌ",
