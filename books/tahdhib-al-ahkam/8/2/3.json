            "chunk_type": "isnad",
            "word_end": 16,
            "word_start": 0
          },
          {
            "arabic_text": "قُلْتُ لِأَبِي عَبْدِ اللَّهِ عَلَيْهِ السَّلَامُ الرَّجُلُ يَقُولُ لِامْرَأَتِهِ أَنْتَ عَلَيَّ كَظَهْرِ عَمَّتِهِ أَوْ خَالَتِهِ قَالَ «هُوَ الظِّهَارُ»",
            "chunk_type": "body",
            "word_end": 34,
            "word_start": 16
          },
          {
            "arabic_text": "وَسَأَلْتُهُ عَنِ الظِّهَارِ مَتَى يَقَعُ عَلَى صَاحِبِهِ الْكَفَّارَةُ فَقَالَ «إِذَا أَرَادَ أَنْ يُوَاقِعَ امْرَأَتَهُ»",
            "chunk_type": "body",
            "word_end": 48,
            "word_start": 34
          },
          {
            "arabic_text": "قُلْتُ فَإِنْ طَلَّقَهَا قَبْلَ أَنْ يُوَاقِعَهَا أَ عَلَيْهِ كَفَّارَةٌ قَالَ «لَا سَقَطَتِ الْكَفَّارَةُ عَنْهُ»",
            "chunk_type": "body",
            "word_end": 62,
            "word_start": 48
          },
          {
            "arabic_text": "قُلْتُ فَإِنْ صَامَ بَعْضًا فَمَرِضَ فَأَفْطَرَ أَ يَسْتَقْبِلُ أَمْ يُتِمُّ مَا بَقِيَ عَلَيْهِ قَالَ «إِنْ صَامَ شَهْرًا فَمَرِضَ اسْتَقْبَلَ وَإِنْ زَادَ عَلَى الشَّهْرِ الْآخَرِ يَوْمًا أَوْ يَوْمَيْنِ بَنَى عَلَيْهِ مَا بَقِيَ»",
            "chunk_type": "body",
            "word_end": 93,
            "word_start": 62
          },
          {
            "arabic_text": "قَالَ وَقَالَ «الْحُرُّ وَالْمَمْلُوكُ سَوَاءٌ غَيْرَ أَنَّ عَلَى الْمَمْلُوكِ نِصْفَ مَا عَلَى الْحُرِّ مِنَ الْكَفَّارَةِ وَلَيْسَ عَلَيْهِ عِتْقٌ وَلَا صَدَقَةٌ إِنَّمَا عَلَيْهِ صِيَامُ شَهْرٍ»",
