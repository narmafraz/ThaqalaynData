          {
            "arabic_text": "وَعَنْهُ عَنْ أَحْمَدَ بْنِ إِدْرِيسَ عَنْ أَحْمَدَ بْنِ مُحَمَّدٍ عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِي نَجْرَانَ عَنْ عَاصِمِ بْنِ حُمَيْدٍ عَنْ مُحَمَّدِ بْنِ قَيْسٍ عَنْ أَبِي جَعْفَرٍ عَلَيْهِ السَّلَامُ قَالَ",
            "chunk_type": "isnad",
            "word_end": 29,
            "word_start": 0
          },
          {
            "arabic_text": "قَضَى أَمِيرُ الْمُؤْمِنِينَ عَلَيْهِ السَّلَامُ فِي مُكَاتَبٍ تَحْتَهُ حُرَّةٌ فَأَوْصَتْ لَهُ عِنْدَ مَوْتِهَا بِوَصِيَّةٍ فَقَالَ «أَهْلُ الْمَرْأَةِ لَا تَجُوزُ وَصِيَّتُهَا لَهُ لِأَنَّهُ مُكَاتَبٌ لَمْ يُعْتَقْ وَلَا يَرِثُ»",
            "chunk_type": "body",
            "word_end": 56,
            "word_start": 29
          },
          {
            "arabic_text": "فَقَضَى أَنَّهُ يَرِثُ بِحِسَابِ مَا أُعْتِقَ مِنْهُ وَيَجُوزُ لَهُ مِنَ الْوَصِيَّةِ بِحِسَابِ مَا أُعْتِقَ مِنْهُ",
            "chunk_type": "body",
            "word_end": 71,
            "word_start": 56
          },
          {
            "arabic_text": "وَقَضَى فِي مُكَاتَبٍ قَضَى رُبُعَ مَا عَلَيْهِ فَأُوصِيَ لَهُ بِوَصِيَّةٍ فَأَجَازَ لَهُ رُبُعَ الْوَصِيَّةِ",
            "chunk_type": "body",
            "word_end": 85,
            "word_start": 71
          },
          {
            "arabic_text": "وَقَضَى فِي رَجُلٍ حُرٍّ أَوْصَى لِمُكَاتَبَتِهِ وَقَدْ قَضَتْ سُدُسَ مَا كَانَ عَلَيْهَا فَأَجَازَ بِحِسَابِ مَا أُعْتِقَ مِنْهَا",
            "chunk_type": "body",
            "word_end": 102,
            "word_start": 85
          },
          {
            "arabic_text": "وَقَضَى فِي وَصِيَّةِ مُكَاتَبٍ قَدْ قَضَى بَعْضَ مَا كُوتِبَ عَلَيْهِ أَنْ يُجَازَ مِنْ وَصِيَّتِهِ بِحِسَابِ مَا أُعْتِقَ مِنْهُ",
