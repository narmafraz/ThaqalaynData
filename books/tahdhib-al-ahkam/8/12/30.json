        "chunks": [
          {
            "arabic_text": "اَلْبَزَوْفَرِيُّ عَنْ أَحْمَدَ بْنِ إِدْرِيسَ عَنْ أَحْمَدَ بْنِ مُحَمَّدٍ عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِي نَجْرَانَ عَنْ عَاصِمِ بْنِ حُمَيْدٍ عَنْ مُحَمَّدِ بْنِ قَيْسٍ عَنْ أَبِي عَبْدِ اللَّهِ عَلَيْهِ السَّلَامُ قَالَ",
            "chunk_type": "isnad",
            "word_end": 30,
            "word_start": 0
          },
          {
            "arabic_text": "قَضَى أَمِيرُ الْمُؤْمِنِينَ عَلَيْهِ السَّلَامُ فِي مُكَاتَبٍ تُوُفِّيَ وَ لَهُ مَالٌ قَالَ «يُقْسَمُ مَالُهُ عَلَى قَدْرِ مَا أُعْتِقَ مِنْهُ لِوَرَثَتِهِ وَ مَا لَمْ يُعْتَقْ يُحْتَسَبُ مِنْهُ لِأَرْبَابِهِ الَّذِينَ كَاتَبُوهُ هُوَ مَالُهُ»",
            "chunk_type": "body",
            "word_end": 61,
            "word_start": 30
          },
          {
            "arabic_text": "الْوَجْهُ تَسْلَمُ الْأَخْبَارُ كُلُّهَا مِنَ الْمُنَافَاةِ",
