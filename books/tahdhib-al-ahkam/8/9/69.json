            "chunk_type": "isnad",
            "word_end": 21,
            "word_start": 0
          },
          {
            "arabic_text": "إِذَا أَعْتَقَ رَجُلٌ جَارِيَةً ثُمَّ أَرَادَ أَنْ يَتَزَوَّجَهَا مَكَانَهُ فَلَا بَأْسَ وَلَا تَعْتَدُّ مِنْ مَائِهِ وَإِنْ أَرَادَتْ أَنْ تَتَزَوَّجَ مِنْ غَيْرِهِ فَلَهَا مِثْلُ عِدَّةِ الْحُرَّةِ",
            "chunk_type": "body",
            "word_end": 46,
            "word_start": 21
          },
          {
            "arabic_text": "وَأَيُّ رَجُلٍ اشْتَرَى جَارِيَةً فَوَلَدَتْ مِنْهُ وَلَدًا فَمَاتَ إِنْ شَاءَ أَنْ يَبِيعَهَا بَاعَهَا فِي الدَّيْنِ الَّذِي يَكُونُ عَلَى مَوْلاَهَا مِنْ ثَمَنِهَا",
            "chunk_type": "body",
            "word_end": 67,
            "word_start": 46
          },
          {
            "arabic_text": "وَإِنْ كَانَ لَهَا وَلَدٌ قُوِّمَتْ عَلَى ابْنِهَا مِنْ نَصِيبِهِ وَإِنْ كَانَ ابْنُهَا صَغِيرًا اُنْتُظِرَ بِهِ حَتَّى يَكْبَرَ ثُمَّ يُجْبَرَ عَلَى ثَمِنِهَا",
            "chunk_type": "body",
            "word_end": 88,
