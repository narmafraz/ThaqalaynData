        "chunks": [
          {
            "arabic_text": "مُحَمَّدُ بْنُ يَعْقُوبَ عَنْ عَلِيِّ بْنِ إِبْرَاهِيمَ عَنْ أَبِيهِ عَنِ الْحُسَيْنِ بْنِ سَيْفٍ عَنْ مُحَمَّدِ بْنِ سُلَيْمَانَ عَنْ أَبِي جَعْفَرٍ الثَّانِي عَلَيْهِ السَّلَامُ قَالَ",
            "chunk_type": "isnad",
            "word_end": 24,
            "word_start": 0
          },
          {
            "arabic_text": "قُلْتُ لَهُ جُعِلْتُ فِدَاكَ كَيْفَ صَارَ عِدَّةُ الْمُطَلَّقَةِ ثَلَاثَ حِيَضٍ أَوْ ثَلَاثَةَ أَشْهُرٍ وَ صَارَ عِدَّةُ الْمُتَوَفَّى عَنْهَا زَوْجُهَا أَرْبَعَةَ أَشْهُرٍ وَعَشْرًا",
            "chunk_type": "body",
            "word_end": 46,
            "word_start": 24
          },
          {
            "arabic_text": "فَقَالَ «أَمَّا عِدَّةُ الْمُطَلَّقَةِ ثَلَاثَةَ قُرُوءٍ فَلِاسْتِبْرَاءِ الرَّحِمِ مِنَ الْوَلَدِ",
            "chunk_type": "body",
            "word_end": 56,
            "word_start": 46
          },
          {
            "arabic_text": "وَأَمَّا عِدَّةُ الْمُتَوَى عَنْهَا زَوْجُهَا فَإِنَّ اللَّهَ تَعَالَى شَرَطَ لِلنِّسَاءِ شَرْطًا وَ شَرَطَ عَلَيْهِنَّ شَرْطًا فَلَمْ يُحَابِهِنَّ فِيمَا شَرَطَ لَهُنَّ وَ لَمْ يَجُرْ فِيمَا شَرَطَ عَلَيْهِنَّ",
            "chunk_type": "body",
            "word_end": 82,
            "word_start": 56
          },
          {
            "arabic_text": "أَمَّا مَا شَرَطَ لَهُنَّ فِي الْإِيلَاءِ أَرْبَعَةُ أَشْهُرٍ إِذْ يَقُولُ «لِلَّذِينَ يُؤْلُونَ مِنْ نِسَائِهِمْ تَرَبُّصُ أَرْبَعَةِ أَشْهُرٍ»",
            "chunk_type": "body",
            "word_end": 99,
            "word_start": 82
          },
          {
            "arabic_text": "لِلَّذِينَ يُؤْلُونَ مِنْ نِسَائِهِمْ تَرَبُّصُ أَرْبَعَةِ أَشْهُرٍ",
            "chunk_type": "quran_quote",
            "word_end": 106,
            "word_start": 99
          },
          {
            "arabic_text": "فَلَمْ يُجِزْ لِأَحَدٍ أَكْثَرَ مِنْ أَرْبَعَةِ أَشْهُرٍ فِي الْإِيلَاءِ لِعِلْمِهِ تَعَالَى أَنَّهُ غَايَةُ صَبْرِ الْمَرْأَةِ عَنِ الرَّجُلِ",
            "chunk_type": "body",
            "word_end": 123,
            "word_start": 106
          },
          {
            "arabic_text": "وَأَمَّا مَا شَرَطَ عَلَيْهِنَّ فَإِنَّهُ أَمَرَهَا أَنْ تَعْتَدَّ إِذَا مَاتَ زَوْجُهَا أَرْبَعَةَ أَشْهُرٍ وَعَشْرًا",
            "chunk_type": "body",
            "word_end": 137,
            "word_start": 123
          },
          {
            "arabic_text": "فَأَخَذَ مِنْهَا لَهُ عِنْدَ مَوْتِهِ مَا أَخَذَ لَهَا مِنْهُ فِي حَيَاتِهِ عِنْدَ إِيلَائِهِ",
            "chunk_type": "body",
            "word_end": 150,
            "word_start": 137
          },
          {
            "arabic_text": "قَالَ اللَّهُ تَعَالَى فَعِدَّتُهُنَّ أَرْبَعَةُ أَشْهُرٍ وَعَشْرًا",
            "chunk_type": "body",
            "word_end": 157,
            "word_start": 150
          },
          {
            "arabic_text": "فَعِدَّتُهُنَّ أَرْبَعَةُ أَشْهُرٍ وَعَشْرًا",
            "chunk_type": "quran_quote",
            "word_end": 161,
            "word_start": 157
          },
          {
            "arabic_text": "وَلَمْ يَذْكُرِ الْعَشْرَةَ الْأَيَّامِ فِي الْعِدَّةِ إِلَّا مَعَ الْأَرْبَعَةِ أَشْهُرٍ",
            "chunk_type": "body",
            "word_end": 171,
            "word_start": 161
          },
          {
            "arabic_text": "وَعَلِمَ أَنَّ غَايَةَ صَبْرِ الْمَرْأَةِ أَرْبَعَةُ أَشْهُرٍ فِي تَرْكِ الْجِمَاعِ",
            "chunk_type": "body",
            "word_end": 181,
            "word_start": 171
          },
          {
            "arabic_text": "فَمِنْ ثَمَّ أَوْجَبَهُ عَلَيْهَا وَ لَهَا",
            "chunk_type": "body",
            "word_end": 187,
            "word_start": 181
          }
