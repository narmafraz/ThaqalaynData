        "chunks": [
          {
            "arabic_text": "مُحَمَّدُ بْنُ يَعْقُوبَ عَنْ حُمَيْدِ بْنِ زِيَادٍ عَنِ ابْنِ سَمَاعَةَ عَنْ مُحَمَّدِ بْنِ زِيَادٍ عَنْ عَبْدِ اللَّهِ بْنِ سِنَانٍ وَعَلِيِّ بْنِ إِبْرَاهِيمَ عَنْ أَبِيهِ عَنْ عُثْمَانَ بْنِ عِيسَى عَنْ سَمَاعَةَ جَمِيعاً عَنْ أَبِي عَبْدِ اللَّهِ عَلَيْهِ السَّلَامُ أَنَّهُ قَالَ",
            "chunk_type": "isnad",
            "word_end": 39,
            "word_start": 0
          },
          {
            "arabic_text": "فِي قَوْلِ اللَّهِ عَزَّ وَ جَلَّ «وَلِلْمُطَلَّقاتِ مَتَاعٌ بِالْمَعْرُوفِ حَقًّا عَلَى الْمُتَّقِينَ»",
            "chunk_type": "body",
            "word_end": 51,
            "word_start": 39
          },
          {
            "arabic_text": "قَالَ «مَتَاعُهَا بَعْدَ مَا تَنْقَضِي عِدَّتُهَا عَلَى الْمُوسِعِ قَدَرُهُ وَعَلَى الْمُقْتِرِ قَدَرُهُ»",
            "chunk_type": "body",
            "word_end": 63,
            "word_start": 51
          },
          {
            "arabic_text": "وَقَالَ «كَيْفَ يُمَتِّعُهَا فِي عِدَّتِهَا وَ هِيَ تَرْجُوهُ وَ يَرْجُوهَا وَ يُحْدِثُ اللَّهُ مَا يَشَاءُ»",
            "chunk_type": "body",
            "word_end": 78,
            "word_start": 63
          },
          {
            "arabic_text": "أَمَا إِنَّ الرَّجُلَ الْمُوسِعَ يُمَتِّعُ الْمَرْأَةَ بِالْعَبْدِ وَ الْأَمَةِ وَ يُمَتِّعُ الْفَقِيرُ بِالْحِنْطَةِ وَ الزَّبِيبِ وَ الثَّوْبِ وَ الدَّرَاهِمِ",
            "chunk_type": "body",
            "word_end": 97,
            "word_start": 78
          },
          {
            "arabic_text": "وَ إِنَّ الْحَسَنَ بْنَ عَلِيٍّ عَلَيْهِ السَّلَامُ مَتَّعَ امْرَأَةً طَلَّقَهَا بِأَمَةٍ وَ لَمْ يَكُنْ يُطَلِّقُ امْرَأَةً إِلَّا مَتَّعَهَا",
            "chunk_type": "closing",
            "word_end": 115,
            "word_start": 97
          }
