          },
          {
            "arabic_text": "قَالَ وَ قَالَ فِي قَوْلِ اللَّهِ عَزَّ وَ جَلَّ «أَوْ يَعْفُوَا الَّذِي بِيَدِهِ عُقْدَةُ النِّكَاحِ»",
            "chunk_type": "body",
            "word_end": 68,
            "word_start": 53
