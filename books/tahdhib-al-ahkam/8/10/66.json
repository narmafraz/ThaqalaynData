            "arabic_text": "عَنْهُ عَنْ عَلِيِّ بْنِ إِبْرَاهِيمَ عَنْ أَبِيهِ عَنْ دَاوُدَ النَّهْدِيِّ عَنْ بَعْضِ أَصْحَابِنَا قَالَ",
            "chunk_type": "isnad",
            "word_end": 14,
            "word_start": 0
          },
          {
            "arabic_text": "دَخَلَ ابْنُ أَبِي سَعِيدٍ الْمُكَارِي عَلَى أَبِي الْحَسَنِ الرِّضَا عَلَيْهِ السَّلَامُ فَقَالَ لَهُ أَسْأَلُكَ عَنْ مَسْأَلَةٍ فَقَالَ «لَا أُخَالُكَ تَقْبَلُ مِنِّي وَلَسْتَ مِنْ غَنَمِي وَلَكِنْ هَلُمَّهَا»",
            "chunk_type": "body",
            "word_end": 40,
            "word_start": 14
          },
          {
            "arabic_text": "فَقَالَ رَجُلٌ قَالَ عِنْدَ مَوْتِهِ كُلُّ مَمْلُوكٍ لِي قَدِيمٌ فَهُوَ حُرٌّ لِوَجْهِ اللَّهِ تَعَالَى",
            "chunk_type": "body",
            "word_end": 54,
            "word_start": 40
          },
          {
            "arabic_text": "حَتَّىٰ عَادَ كَالْعُرْجُونِ الْقَدِيمِ",
