          {
            "arabic_text": "وَقَالَ يَمْلِكُ اَلذُّكُورَ مَا خَلاَ وَالِداً وَ وَلَداً وَ لاَ يَمْلِكُ مِنَ اَلنِّسَاءِ ذَوَاتِ رَحِمٍ مُحَرَّمٍ",
            "chunk_type": "body",
            "word_end": 103,
