            "arabic_text": "مُحَمَّدُ بْنُ عَلِيِّ بْنِ مَحْبُوبٍ عَنْ مُحَمَّدِ بْنِ أَحْمَدَ الْعَلَوِيِّ عَنِ الْعَمْرَكِيِّ عَنْ عَلِيِّ بْنِ جَعْفَرٍ عَنْ أَخِيهِ مُوسَى بْنِ جَعْفَرٍ عَلَيْهِمَا السَّلَامُ قَالَ",
            "chunk_type": "isnad",
            "word_end": 24,
            "word_start": 0
          },
          {
            "arabic_text": "سَأَلْتُهُ عَنْ رَجُلٍ مُسْلِمٍ تَحْتَهُ يَهُودِيَّةٌ أَوْ نَصْرَانِيَّةٌ أَوْ أَمَةٌ فَأَوْلَدَهَا وَقَذَفَهَا فَهَلْ عَلَيْهِ لِعَانٌ قَالَ «لاَ»",
            "chunk_type": "body",
            "word_end": 41,
            "word_start": 24
          },
          {
            "arabic_text": "فَالْوَجْهُ فِي هَذَا الْخَبَرِ أَنَّهُ لاَ لِعَانَ بَيْنَهُمَا إِذَا كَانَ قَدْ أَقَرَّ بِالْوَلَدِ ثُمَّ نَفَاهُ بَعْدَ ذَلِكَ فَإِنَّهُ لاَ يُلْتَفَتُ إِلَى نَفْيِهِ وَ لاَ يَجُوزُ لَهُ الْلِّعَانُ وَ يُلْحَقُ بِهِ الْوَلَدُ حَسَبَ مَا قَدَّمْنَاهُ",
            "chunk_type": "body",
            "word_end": 75,
            "word_start": 41
          },
          {
            "arabic_text": "أَوْ لاَ يَدَّعِي فِي الْقَذْفِ الْمُشَاهَدَةَ كَمَا بَيَّنَّاهُ فِي الْحُرَّةِ فَإِنَّهُ لاَ يَثْبُتُ أَيْضاً بَيْنَهُمَا لِعَانٌ",
            "chunk_type": "body",
            "word_end": 91,
            "word_start": 75
          },
          {
            "arabic_text": "أَمَّا الْمُتَمَتِّعُ بِهَا فَلاَ لِعَانَ بَيْنَهُمَا حَسَبَ مَا تَضَمَّنَهُ الْخَبَرُ",
            "chunk_type": "body",
            "word_end": 101,
            "word_start": 91
          },
          {
            "arabic_text": "وَ الَّذِي يُؤَكِّدُ ذَلِكَ أَيْضاً مَا رَوَاهُ",
