            "word_end": 15,
            "word_start": 0
          },
          {
            "arabic_text": "سَأَلْتُهُ عَنِ امْرَأَةٍ أَوْصَتْ إِلَيَّ بِمَالٍ أَنْ يُجْعَلَ فِي سَبِيلِ اللَّهِ فَقِيلَ لَهَا يُحَجُّ بِهِ فَقَالَتْ اجْعَلْهُ فِي سَبِيلِ اللَّهِ فَقَالُوا لَهَا فَنُعْطِيهِ آلَ مُحَمَّدٍ صَلَّى اللَّهُ عَلَيْهِ وَ آلِهِ قَالَتْ اجْعَلْهُ فِي سَبِيلِ اللَّهِ",
            "chunk_type": "body",
            "word_end": 50,
            "word_start": 15
          },
          {
            "arabic_text": "فَقَالَ أَبُو عَبْدِ اللَّهِ عَلَيْهِ السَّلَامُ «اجْعَلْهُ فِي سَبِيلِ اللَّهِ كَمَا أَمَرَتْ»",
            "chunk_type": "body",
            "word_end": 62,
            "word_start": 50
          },
          {
            "arabic_text": "قُلْتُ مُرْنِي كَيْفَ أَجْعَلُهُ قَالَ «اجْعَلْهُ كَمَا أَمَرَتْكَ إِنَّ اللَّهَ تَعَالَى يَقُولُ «فَمَنْ بَدَّلَهُ بَعْدَ مَا سَمِعَهُ فَإِنَّما إِثْمُهُ عَلَى الَّذِينَ يُبَدِّلُونَهُ إِنَّ اللَّهَ سَمِيعٌ عَلِيمٌ» أَرَأَيْتَكَ لَوْ أَمَرَتْكَ أَنْ تُعْطِيَهُ يَهُودِيّاً كُنْتَ تُعْطِيهِ نَصْرَانِيّاً»",
            "chunk_type": "body",
            "word_end": 97,
            "word_start": 62
          },
          {
            "arabic_text": "قَالَ فَمَكَثْتُ بَعْدَ ذَلِكَ ثَلاَثَ سِنِينَ ثُمَّ دَخَلْتُ عَلَيْهِ فَقُلْتُ لَهُ مِثْلَ الَّذِي قُلْتُهُ لَهُ أَوَّلَ مَرَّةٍ فَسَكَتَ هُنَيْئَةً ثُمَّ قَالَ «هَاتِهَا» قُلْتُ مَنْ أُعْطِيهَا قَالَ «عِيسَى شَلَقَانَ».",
