            "arabic_text": "أَحْمَدُ بْنُ مُحَمَّدٍ عَنِ الْحَسَنِ بْنِ مَحْبُوبٍ عَنْ عَلِيِّ بْنِ رِئَابٍ عَنْ زُرَارَةَ عَنْ أَبِي عَبْدِ اللَّهِ عَلَيْهِ السَّلَامُ قَالَ",
            "chunk_type": "isnad",
            "word_end": 20,
            "word_start": 0
          },
          {
            "arabic_text": "إِنَّمَا الصَّدَقَةُ مُحْدَثَةٌ إِنَّمَا كَانَ النَّاسُ عَلَى عَهْدِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَ آلِهِ يَنْحَلُونَ وَ يَهَبُونَ وَ لاَ يَنْبَغِي لِمَنْ أَعْطَى لِلَّهِ عَزَّ وَ جَلَّ شَيْئاً أَنْ يَرْجِعَ فِيهِ",
            "chunk_type": "body",
            "word_end": 51,
            "word_start": 20
          },
          {
            "arabic_text": "قَالَ «وَ مَا لَمْ يُعْطِ لِلَّهِ وَ فِي اللَّهِ فَإِنَّهُ يَرْجِعُ فِيهِ نِحْلَةً كَانَتْ أَوْ هِبَةً حِيزَتْ أَوْ لَمْ تُحَزْ",
            "chunk_type": "body",
            "word_end": 71,
            "word_start": 51
          },
          {
            "arabic_text": "وَ لاَ يَرْجِعْ يَرْجِعُ الرَّجُلُ فِيمَا يَهَبُ لِامْرَأَتِهِ وَ لاَ الْمَرْأَةُ فِيمَا تَهَبُ لِزَوْجِهَا حِيزَتْ أَوْ لَمْ تُحَزْ",
            "chunk_type": "body",
            "word_end": 89,
            "word_start": 71
          },
          {
            "arabic_text": "أَلَيْسَ اللَّهُ تَعَالَى يَقُولُ وَ لاَ تَأْخُذُوا مِمَّا آتَيْتُمُوهُنَّ شَيْئاً",
            "chunk_type": "quran_quote",
            "word_end": 99,
            "word_start": 89
          },
          {
            "arabic_text": "وَ قَالَ «فَإِنْ طِبْنَ لَكُمْ عَنْ شَيْءٍ مِنْهُ نَفْساً فَكُلُوهُ هَنِيئاً مَرِيئاً»",
            "chunk_type": "quran_quote",
            "word_end": 111,
