            "chunk_type": "isnad",
            "word_end": 16,
            "word_start": 0
          },
          {
            "arabic_text": "سَأَلْتُهُ عَنِ الرَّجُلِ يَكُونُ لَهُ الْوُلْدُ مِنْ غَيْرِ أُمٍّ أَ يُفَضِّلُ بَعْضَهُمْ عَلَى بَعْضٍ فَقَالَ «لَا بَأْسَ»",
            "chunk_type": "body",
            "word_end": 33,
