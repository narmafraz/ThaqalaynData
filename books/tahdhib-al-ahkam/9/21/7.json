            "arabic_text": "أَحْمَدُ بْنُ مُحَمَّدِ بْنِ عِيسَى عَنْ عَلِيِّ بْنِ الْحَكَمِ عَنْ مُوسَى بْنِ بَكْرٍ عَنْ زُرَارَةَ عَنْ حُمْرَانَ بْنِ أَعْيَنَ عَنْ أَبِي جَعْفَرٍ عَلَيْهِ السَّلَامُ",
            "chunk_type": "isnad",
            "word_end": 24,
            "word_start": 0
          },
          {
            "arabic_text": "فِي رَجُلٍ تَرَكَ ابْنَتَهُ وَأُمَّهُ أَنَّ الْفَرِيضَةَ مِنْ أَرْبَعَةِ أَسْهُمٍ لِأَنَّ لِلْبِنْتِ ثَلَاثَةَ أَسْهُمٍ وَلِلْأُمِّ السُّدُسَ سَهْمٌ وَبَقِيَ سَهْمَانِ فَهُمَا أَحَقُّ بِهِمَا مِنَ الْعَمِّ وَابْنِ الْأَخِ وَالْعَصَبَةِ لِأَنَّ الْبِنْتَ وَالْأُمَّ سُمِّيَ لَهُمَا وَلَمْ يُسَمَّ لَهُمْ فَيُرَدُّ عَلَيْهِمَا بِقَدْرِ سِهَامِهِمَا",
            "chunk_type": "body",
            "word_end": 63,
            "word_start": 24
          },
          {
            "arabic_text": "عَنْهُ عَنْ مُحَمَّدِ بْنِ الْحَسَنِ الْأَشْعَرِيِّ قَالَ",
            "chunk_type": "isnad",
            "word_end": 70,
            "word_start": 63
          },
          {
            "arabic_text": "وَقَعَ بَيْنَ رَجُلَيْنِ مِنْ بَنِي عَمِّي مُنَازَعَةٌ فِي مِيرَاثٍ فَأَشَرْتُ عَلَيْهِمَا بِالْكِتَابِ إِلَيْهِ فِي ذَلِكَ لِيَصْدُرَا عَنْ رَأْيِهِ فَكَتَبَا إِلَيْهِ جَمِيعًا جَعَلَنَا اللَّهُ فِدَاكَ مَا تَقُولُ فِي امْرَأَةٍ تَرَكَتْ زَوْجَهَا وَابْنَتَهَا وَأُخْتَهَا لِأَبِيهَا وَأُمِّهَا",
            "chunk_type": "body",
            "word_end": 104,
            "word_start": 70
          },
          {
            "arabic_text": "وَقُلْتُ لَهُ جُعِلْتُ فِدَاكَ إِنْ رَأَيْتَ أَنْ تُجِيبَنَا بِمُرِّ الْحَقِّ فَجَرَّدَ إِلَيْهِمَا كِتَابًا",
            "chunk_type": "body",
            "word_end": 117,
            "word_start": 104
          },
          {
