            "chunk_type": "body",
            "word_end": 62,
            "word_start": 50
          },
          {
            "arabic_text": "قُلْتُ فَخَمْرٌ أَوْ نَبِيذٌ قَطَرَ فِي عَجِينٍ أَوْ دَمٌ قَالَ فَقَالَ «فَسَدَ»",
