            "chunk_type": "isnad",
            "word_end": 22,
            "word_start": 0
          },
          {
            "arabic_text": "فِي مُكَاتَبٍ كَانَتْ تَحْتَهُ اِمْرَأَةٌ حُرَّةٌ فَأَوْصَتْ لَهُ عِنْدَ مَوْتِهَا بِوَصِيَّةٍ فَقَالَ أَهْلُ اَلْمِيرَاثِ لاَ نُجِيزُ وَصِيَّتَهَا إِنَّهُ مُكَاتَبٌ لَمْ يُعْتَقْ وَ لاَ يَرِثُ فَقَضَى «أَنَّهُ يَرِثُ بِحِسَابِ مَا أُعْتِقَ مِنْهُ وَ يَجُوزُ لَهُ مِنَ اَلْوَصِيَّةِ بِحِسَابِ مَا أُعْتِقَ مِنْهُ»",
            "chunk_type": "body",
            "word_end": 62,
            "word_start": 22
          },
          {
            "arabic_text": "وَقَضَى فِي مُكَاتَبٍ أُوصِيَ لَهُ بِوَصِيَّةٍ وَ قَدْ قَضَى نِصْفَ مَا عَلَيْهِ فَأَجَازَ نِصْفَ اَلْوَصِيَّةِ",
            "chunk_type": "body",
            "word_end": 77,
            "word_start": 62
          },
          {
            "arabic_text": "وَقَضَى فِي مُكَاتَبٍ قَضَى رُبُعَ مَا عَلَيْهِ فَأُوصِيَ لَهُ بِوَصِيَّةٍ فَأَجَازَ رُبُعَ اَلْوَصِيَّةِ",
