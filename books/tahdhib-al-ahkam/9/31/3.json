            "word_end": 21,
            "word_start": 0
          },
          {
            "arabic_text": "فِي الْمُلاَعَنِ إِِنْ أَكْذَبَ نَفْسَهُ قَبْلَ اللَّعَانِ رُدَّتْ إِلَيْهِ امْرَأَتُهُ وَضُرِبَ الْحَدَّ فَإِنْ أَبَى لَاعَنَ وَلَمْ تَحِلَّ لَهُ أَبَدًا",
            "chunk_type": "body",
            "word_end": 40,
            "word_start": 21
          },
          {
            "arabic_text": "وَإِنْ قَذَفَ رَجُلٌ امْرَأَتَهُ كَانَ عَلَيْهِ الْحَدُّ وَإِنْ مَاتَ وَلَدُهُ وَرِثَهُ أَخْوَالُهُ فَإِنِ ادَّعَاهُ أَبُوهُ لَحِقَ بِهِ",
