        "chunks": [
          {
            "arabic_text": "عَلِيُّ بْنُ إِبْرَاهِيمَ عَنْ أَبِيهِ عَنِ اِبْنِ أَبِي عُمَيْرٍ عَنْ عُمَرَ بْنِ أُذَيْنَةَ عَنْ زُرَارَةَ وَ بُكَيْرٍ وَ فُضَيْلٍ وَ مُحَمَّدٍ وَ بُرَيْدٍ عَنْ أَحَدِهِمَا عَلَيْهِمَا اَلسَّلَامُ قَالَ",
            "chunk_type": "isnad",
            "word_end": 28,
            "word_start": 0
          },
          {
            "arabic_text": "«إِنَّ اَلْجَدَّ مَعَ اَلْإِخْوَةِ مِنَ اَلْأَبِ يَصِيرُ مِثْلَ وَاحِدٍ مِنَ اَلْإِخْوَةِ مَا بَلَغُوا»",
            "chunk_type": "body",
            "word_end": 41,
            "word_start": 28
          },
          {
            "arabic_text": "قَالَ قُلْتُ رَجُلٌ تَرَكَ أَخَاهُ لِأَبِيهِ وَ أُمَّهُ وَ جَدَّتَهُ أَوْ قُلْتُ جَدَّهُ وَ أَخَاهُ لِأَبِيهِ أَوْ أَخَاهُ لِأَبِيهِ وَ أُمَّهُ قَالَ «اَلْمَالُ بَيْنَهُمَا وَ إِنْ كَانَا أَخَوَيْنِ أَوْ مِائَةَ أَلْفٍ فَلَهُ مِثْلُ نَصِيبِ وَاحِدٍ مِنَ اَلْإِخْوَةِ»",
            "chunk_type": "body",
            "word_end": 78,
            "word_start": 41
          },
          {
            "arabic_text": "قَالَ قُلْتُ رَجُلٌ تَرَكَ جَدَّهُ وَ أُخْتَهُ فَقَالَ «لِلذَّكَرِ مِثْلُ حَظِّ اَلْأُنْثَيَيْنِ» وَ إِنْ كَانَتَا أُخْتَيْنِ فَالنِّصْفُ لِلْجَدِّ وَ اَلنِّصْفُ اَلْآخَرُ لِلْأُخْتَيْنِ وَ إِنْ كُنَّ أَكْثَرَ مِنْ ذَلِكَ فَعَلَى هَذَا اَلْحِسَابِ",
            "chunk_type": "body",
            "word_end": 109,
            "word_start": 78
          },
          {
            "arabic_text": "وَ إِنْ تَرَكَ إِخْوَةً وَ أَخَوَاتٍ لِأَبٍ وَ أُمٍّ أَوْ لِأَبٍ وَ جَدّاً فَالْجَدُّ أَحَدُ اَلْإِخْوَةِ فَالْمَالُ بَيْنَهُمْ «لِلذَّكَرِ مِثْلُ حَظِّ اَلْأُنْثَيَيْنِ»",
            "chunk_type": "body",
            "word_end": 131,
            "word_start": 109
          },
          {
            "arabic_text": "وَقَالَ زُرَارَةُ هَذَا مِمَّا لَمْ يُؤْخَذْ عَلَيَّ فِيهِ قَدْ سَمِعْتُهُ مِنْ أَبِيهِ وَ مِنْهُ قَبْلَ ذَلِكَ وَ لَيْسَ عِنْدَنَا فِي ذَلِكَ شَكٌّ وَ لاَ اِخْتِلاَفٌ",
            "chunk_type": "closing",
            "word_end": 156,
            "word_start": 131
          }
        ],
