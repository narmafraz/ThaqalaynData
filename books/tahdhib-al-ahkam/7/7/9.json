            "chunk_type": "body",
            "word_end": 38,
            "word_start": 27
          },
          {
            "arabic_text": "فَقُلْتُ أَصْلَحَكَ اللَّهُ إِنَّ مَنْ بَيْنَنَا يُفْسِدُونَ عَلَيْنَا هَذَا كُلَّهُ",
            "chunk_type": "body",
            "word_end": 48,
            "word_start": 38
          },
          {
            "arabic_text": "فَقَالَ «أَظُنُّهُمْ سَمِعُوا حَدِيثَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَ آلِهِ فِي النَّخْلِ»",
            "chunk_type": "body",
            "word_end": 61,
            "word_start": 48
          },
          {
            "arabic_text": "ثُمَّ حَالَ بَيْنِي وَ بَيْنَهُ رَجُلٌ فَسَكَتَ",
            "chunk_type": "body",
            "word_end": 68,
            "word_start": 61
          },
          {
            "arabic_text": "فَأَمَرْتُ مُحَمَّدَ بْنَ مُسْلِمٍ أَنْ يَسْأَلَ أَبَا جَعْفَرٍ عَلَيْهِ السَّلَامُ عَنْ قَوْلِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَ آلِهِ فِي النَّخْلِ",
            "chunk_type": "body",
            "word_end": 89,
            "word_start": 68
          },
          {
            "arabic_text": "فَقَالَ أَبُو جَعْفَرٍ عَلَيْهِ السَّلَامُ «خَرَجَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَ آلِهِ فَسَمِعَ ضَوْضَاءً فَقَالَ «مَا هَذَا»",
            "chunk_type": "body",
            "word_end": 107,
            "word_start": 89
          },
          {
            "arabic_text": "فَقِيلَ تَبَايَعَ النَّاسُ فِي النَّخْلِ فَقَعَدَ النَّخْلُ الْعَامَ",
            "chunk_type": "body",
            "word_end": 115,
            "word_start": 107
          },
          {
            "arabic_text": "فَقَالَ صَلَّى اللَّهُ عَلَيْهِ وَ آلِهِ «أَمَّا إِذَا فَعَلُوا فَلَا تَشْتَرُوا النَّخْلَ الْعَامَ حَتَّى يَطْلُعَ فِيهِ شَيْءٌ وَ لَمْ يُحَرِّمْهُ»»",
