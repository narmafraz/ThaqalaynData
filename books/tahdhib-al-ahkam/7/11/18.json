            "chunk_type": "quran_quote",
            "word_end": 34,
            "word_start": 23
          },
          {
            "arabic_text": "أَنَا وَ أَهْلُ بَيْتِيَ اَلَّذِينَ أَوْرَثَنَا اَلْأَرْضَ وَ نَحْنُ اَلْمُتَّقُونَ وَ اَلْأَرْضُ كُلُّهَا لَنَا",
            "chunk_type": "body",
            "word_end": 48,
            "word_start": 34
          },
          {
            "arabic_text": "فَمَنْ أَحْيَا أَرْضاً مِنَ اَلْمُسْلِمِينَ فَلْيَعْمُرْهَا وَ لْيُؤَدِّ خَرَاجَهَا إِلَى اَلْإِمَامِ مِنْ أَهْلِ بَيْتِي",
            "chunk_type": "body",
            "word_end": 62,
            "word_start": 48
          },
          {
            "arabic_text": "وَلَهُ مَا أَكَلَ مِنْهَا",
