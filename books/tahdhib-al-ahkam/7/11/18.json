            "word_end": 66,
            "word_start": 62
          },
          {
            "arabic_text": "وَإِنْ تَرَكَهَا وَ أَخْرَبَهَا فَأَخَذَهَا رَجُلٌ مِنَ اَلْمُسْلِمِينَ مِنْ بَعْدِهِ فَعَمَرَهَا وَ أَحْيَاهَا فَهُوَ أَحَقُّ بِهَا مِنَ اَلَّذِي تَرَكَهَا",
            "chunk_type": "body",
            "word_end": 85,
            "word_start": 66
          },
          {
            "arabic_text": "فَلْيُؤَدِّ خَرَاجَهَا إِلَى اَلْإِمَامِ مِنْ أَهْلِ بَيْتِي",
            "chunk_type": "body",
            "word_end": 92,
            "word_start": 85
          },
          {
            "arabic_text": "وَلَهُ مَا أَكَلَ حَتَّى يَظْهَرَ اَلْقَائِمُ عَلَيْهِ اَلسَّلاَمُ مِنْ أَهْلِ بَيْتِي بِالسَّيْفِ",
            "chunk_type": "body",
            "word_end": 104,
            "word_start": 92
          },
          {
            "arabic_text": "فَيَحْوِيَهَا فَيَمْنَعَهَا وَ يُخْرِجَهُمْ مِنْهَا كَمَا حَوَاهَا رَسُولُ اَللَّهِ صَلَّى اَللَّهُ عَلَيْهِ وَ آلِهِ",
            "chunk_type": "body",
            "word_end": 118,
            "word_start": 104
          },
          {
            "arabic_text": "إِلَّا مَا كَانَ فِي أَيْدِي شِيعَتِنَا فَيُقَاطِعَهُمْ عَلَى مَا كَانَ فِي أَيْدِيهِمْ وَ يَتْرُكُ اَلْأَرْضَ فِي أَيْدِيهِمْ»",
