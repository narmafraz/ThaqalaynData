        "chunks": [
          {
            "arabic_text": "وَعَنْهُ عَنْ عَلِيٍّ عَنْ أَبِيهِ عَنِ ابْنِ أَبِي عُمَيْرٍ عَنْ عُمَرَ بْنِ أُذَيْنَةَ عَنْ زُرَارَةَ قَالَ",
            "chunk_type": "isnad",
            "word_end": 16,
            "word_start": 0
          },
          {
            "arabic_text": "جَاءَ عَبْدُ اللَّهِ بْنُ عُمَيْرٍ اللَّيْثِيُّ إِلَى أَبِي جَعْفَرٍ عَلَيْهِ السَّلَامُ فَقَالَ لَهُ مَا تَقُولُ فِي مُتْعَةِ النِّسَاءِ",
            "chunk_type": "body",
            "word_end": 34,
            "word_start": 16
          },
          {
            "arabic_text": "فَقَالَ «أَحَلَّهَا اللَّهُ فِي كِتَابِهِ عَلَى لِسَانِ نَبِيِّهِ صَلَّى اللَّهُ عَلَيْهِ وَ آلِهِ فَهِيَ حَلَالٌ إِلَى يَوْمِ الْقِيَامَةِ»",
            "chunk_type": "body",
            "word_end": 52,
            "word_start": 34
          },
          {
            "arabic_text": "فَقَالَ يَا أَبَا جَعْفَرٍ مِثْلُكَ يَقُولُ هَذَا وَقَدْ حَرَّمَهَا عُمَرُ وَ نَهَى عَنْهَا",
            "chunk_type": "body",
            "word_end": 65,
            "word_start": 52
          },
          {
            "arabic_text": "فَقَالَ «وَ إِنْ كَانَ فَعَلَ»",
            "chunk_type": "body",
            "word_end": 70,
            "word_start": 65
          },
          {
            "arabic_text": "قَالَ وَ إِنِّي أُعِيذُكَ بِاللَّهِ مِنْ ذَلِكَ أَنْ تُحِلَّ شَيْئاً حَرَّمَهُ عُمَرُ",
            "chunk_type": "body",
            "word_end": 82,
            "word_start": 70
          },
          {
            "arabic_text": "فَقَالَ لَهُ «فَأَنْتَ عَلَى قَوْلِ صَاحِبِكَ وَ أَنَا عَلَى قَوْلِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَ آلِهِ فَهَلُمَّ أُلاَعِنَكَ أَنَّ الْقَوْلَ مَا قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَ آلِهِ وَ أَنَّ الْبَاطِلَ مَا قَالَ صَاحِبُكَ»",
            "chunk_type": "body",
            "word_end": 118,
            "word_start": 82
          },
          {
            "arabic_text": "قَالَ فَأَقْبَلَ عَبْدُ اللَّهِ بْنُ عُمَيْرٍ فَقَالَ يَسُرُّكَ أَنْ نِسَاءَكَ وَ بَنَاتَكَ وَ أَخَوَاتِكَ وَ بَنَاتِ عَمِّكَ يَفْعَلْنَ ذَلِكَ",
            "chunk_type": "body",
            "word_end": 137,
            "word_start": 118
          },
          {
            "arabic_text": "فَأَعْرَضَ أَبُو جَعْفَرٌ عَلَيْهِ السَّلَامُ حِينَ ذَكَرَ نِسَاءَهُ وَ بَنَاتِ عَمِّهِ",
            "chunk_type": "closing",
            "word_end": 148,
            "word_start": 137
          }
