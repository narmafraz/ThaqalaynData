            "word_start": 0
          },
          {
            "arabic_text": "قَالَ أَبُو جَعْفَرٍ عَلَيْهِ السَّلَامُ: «إِذَا حَدَّثْتُكُمْ بِشَيْءٍ فَسَلُونِي عَنْ كِتَابِ اللَّهِ عَزَّ وَ جَلَّ»",
            "chunk_type": "opening",
            "word_end": 36,
            "word_start": 21
          },
          {
            "arabic_text": "ثُمَّ قَالَ فِي حَدِيثِهِ «إِنَّ اللَّهَ تَعَالَى نَهَى عَنِ الْقِيلِ وَ الْقَالِ وَ فَسَادِ الْمَالِ وَ كَثْرَةِ السُّؤَالِ»",
            "chunk_type": "body",
            "word_end": 54,
            "word_start": 36
          },
          {
            "arabic_text": "فَقَالُوا يَا ابْنَ رَسُولِ اللَّهِ أَيْنَ هَذَا مِنْ كِتَابِ اللَّهِ عَزَّ وَ جَلَّ",
            "chunk_type": "body",
            "word_end": 67,
            "word_start": 54
          },
          {
            "arabic_text": "قَالَ «إِنَّ اللَّهَ عَزَّ وَ جَلَّ يَقُولُ فِي كِتَابِهِ «لَا خَيْرٍ فِي كَثِيرٍ مِنْ نَجْوَاهُمْ إِلَّا مَنْ أَمَرَ بِصَدَقَةٍ أَوْ مَعْرُوفٍ أَوْ إِصْلَاحٍ بَيْنَ النَّاسِ» (1)» الْآيَةَ",
            "chunk_type": "body",
            "word_end": 94,
            "word_start": 67
          },
          {
            "arabic_text": "وَقَالَ اللَّهُ تَعَالَى «وَلَا تُؤْتُوا السُّفَهَاءَ أَمْوَالَكُمُ الَّتِي جَعَلَ اللَّهُ لَكُمْ قِيَامًا» (2)",
            "chunk_type": "body",
            "word_end": 107,
            "word_start": 94
          },
          {
            "arabic_text": "وَقَالَ «لَا تَسْأَلُوا عَنْ أَشْيَاءَ إِنْ تُبْدَ لَكُمْ تَسُؤْكُمْ» (3)",
            "chunk_type": "body",
            "word_end": 117,
