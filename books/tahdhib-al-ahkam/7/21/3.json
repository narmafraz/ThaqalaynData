            "chunk_type": "isnad",
            "word_end": 30,
            "word_start": 0
          },
          {
            "arabic_text": "جَاءَ رَجُلٌ إِلَى أَبِي عَلَيْهِ السَّلَامُ فَقَالَ لَهُ «هَلْ لَكَ مِنْ زَوْجَةٍ» فَقَالَ لَا فَقَالَ «إِنِّي مَا أُحِبُّ أَنْ لِيَ الدُّنْيَا وَمَا فِيهَا وَإِنِّي بِتُّ لَيْلَةً لَيْسَتْ لِي زَوْجَةٌ» ثُمَّ قَالَ «الرَّكْعَتَانِ يُصَلِّيهِمَا رَجُلٌ مُتَزَوِّجٌ أَفْضَلُ مِنْ رَجُلٍ أَعْزَبَ يَقُومُ لَيْلَهُ وَيَصُومُ نَهَارَهُ»",
            "chunk_type": "body",
            "word_end": 73,
            "word_start": 30
          },
          {
            "arabic_text": "ثُمَّ أَعْطَاهُ أَبِي سَبْعَةَ دَنَانِيرَ قَالَ لَهُ «تَزَوَّجْ بِهَذِهِ»",
            "chunk_type": "body",
            "word_end": 82,
