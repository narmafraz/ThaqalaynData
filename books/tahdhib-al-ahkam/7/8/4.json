            "chunk_type": "isnad",
            "word_end": 18,
            "word_start": 0
          },
          {
            "arabic_text": "«لاَ يَصْلُحُ اَلتَّمْرُ اَلْيَابِسُ بِالرُّطَبِ مِنْ أَجْلِ أَنَّ اَلْيَابِسَ يَابِسٌ وَ اَلرُّطَبَ رَطْبٌ فَإِذَا يَبِسَ نَقَصَ»",
            "chunk_type": "body",
            "word_end": 34,
            "word_start": 18
          },
          {
            "arabic_text": "قَالَ «وَ لاَ يَصْلُحُ اَلشَّعِيرُ بِالْحِنْطَةِ إِلاَّ وَاحِداً بِوَِاحِدَةٍ»",
            "chunk_type": "body",
            "word_end": 43,
            "word_start": 34
          },
          {
            "arabic_text": "وَ قَالَ «اَلْكَيْلُ يَجْرِي مَجْرًى وَاحِداً»",
            "chunk_type": "body",
            "word_end": 49,
            "word_start": 43
          },
          {
            "arabic_text": "قَالَ «وَ يُكْرَهُ قَفِيزُ لَوْزٍ بِقَفِيزَيْنِ وَ قَفِيزُ تَمْرٍ بِقَفِيزَيْنِ»",
            "chunk_type": "body",
            "word_end": 59,
            "word_start": 49
          },
          {
            "arabic_text": "وَ لَكِنْ صَاعُ حِنْطَةٍ بِصَاعَيْنِ مِنْ تَمْرٍ وَ صَاعُ تَمْرٍ بِصَاعَيْنِ مِنْ زَبِيبٍ",
            "chunk_type": "body",
            "word_end": 72,
            "word_start": 59
          },
          {
            "arabic_text": "إِذَا اِخْتَلَفَ هَذَا وَ اَلْفَاكِهَةُ اَلْيَابِسَةُ تَجْرِي مَجْرًى وَاحِداً",
            "chunk_type": "body",
            "word_end": 81,
            "word_start": 72
          },
          {
            "arabic_text": "قَالَ «لاَ بَأْسَ بِمُعَاوَضَةِ اَلْمَتَاعِ مَا لَمْ يَكُنْ كَيْلاً وَ لاَ وَزْناً»",
