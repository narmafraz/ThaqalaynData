            "chunk_type": "isnad",
            "word_end": 16,
            "word_start": 0
          },
          {
            "arabic_text": "سَأَلْتُ أَبَا جَعْفَرٍ عَلَيْهِ السَّلَامُ عَنْ رَجُلٍ تَزَوَّجَ امْرَأَةً عَلَى حُكْمِهَا قَالَ «لَا يُجَاوِزُ بِحُكْمِهَا مُهُورَ نِسَاءِ آلِ مُحَمَّدٍ اثْنَتَيْ عَشْرَةَ أُوقِيَّةً وَ نَشًّا وَ هُوَ وَزْنُ خَمْسِمِائَةِ دِرْهَمٍ مِنَ الْفِضَّةِ»",
            "chunk_type": "body",
            "word_end": 47,
            "word_start": 16
          },
          {
            "arabic_text": "قُلْتُ أَ رَأَيْتَ إِنْ تَزَوَّجَهَا عَلَى حُكْمِهِ وَ رَضِيَتْ قَالَ «مَا حَكَمَ بِهِ مِنْ شَيْءٍ فَهُوَ جَائِزٌ لَهَا قَلِيلًا كَانَ أَوْ كَثِيرًا»",
            "chunk_type": "body",
            "word_end": 69,
            "word_start": 47
          },
          {
            "arabic_text": "قُلْتُ كَيْفَ لَمْ تُجِزْ حُكْمَهَا عَلَيْهِ وَ أَجَزْتَ حُكْمَهُ عَلَيْهَا قَالَ فَقَالَ «لِأَنَّهُ حَكَّمَهَا فَلَمْ يَكُنْ لَهَا أَنْ تَجُوزَ مَا سَنَّ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَ آلِهِ وَ تَزَوَّجَ عَلَيْهِ نِسَاءَهُ فَرَدَدْتُهَا إِلَى السُّنَّةِ",
            "chunk_type": "body",
            "word_end": 104,
            "word_start": 69
          },
          {
            "arabic_text": "وَلِأَنَّهَا هِيَ حَكَّمَتْهُ وَ جَعَلَتِ الْأَمْرَ فِي الْمَهْرِ إِلَيْهِ وَ رَضِيَتْ بِحُكْمِهِ فِي ذَلِكَ فَعَلَيْهَا أَنْ تَقْبَلَ حُكْمَهُ قَلِيلًا كَانَ أَوْ كَثِيرًا».",
