            "chunk_type": "isnad",
            "word_end": 16,
            "word_start": 0
          },
          {
            "arabic_text": "سُئِلَ أَبُو عَبْدِ اللَّهِ عَلَيْهِ السَّلَامُ عَنِ الرَّجُلِ يَكُونُ لَهُ أَرْبَعُ نِسْوَةٍ فَتَمُوتُ إِحْدَاهُنَّ فَهَلْ يَحِلُّ لَهُ أَنْ يَتَزَوَّجَ أُخْرَى مَكَانَهَا قَالَ «لَا حَتَّى يَأْتِيَ عَلَيْهَا أَرْبَعَةُ أَشْهُرٍ وَعَشْرًا»",
            "chunk_type": "body",
            "word_end": 45,
