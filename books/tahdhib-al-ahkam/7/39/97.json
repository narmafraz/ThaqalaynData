            "chunk_type": "isnad",
            "word_end": 19,
            "word_start": 0
          },
          {
            "arabic_text": "قُلْتُ لِأَبِي عَبْدِ اللَّهِ عَلَيْهِ السَّلَامُ الرَّجُلُ تَصُبُّ عَلَيْهِ جَارِيَةُ امْرَأَتِهِ إِذَا اغْتَسَلَ وَ تَمْسَحُهُ بِالْدُهْنِ قَالَ «يَسْتَحِلُّ ذَلِكَ مِنْ مَوْلاَتِهَا»",
            "chunk_type": "body",
            "word_end": 40,
