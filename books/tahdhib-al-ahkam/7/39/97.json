          },
          {
            "arabic_text": "قُلْتُ جُعِلْتُ فِدَاكَ إِذَا أَحَلَّتْ لَهُ هَلْ يَحِلُّ لَهُ مَا مَضَى قَالَ «نَعَمْ»",
            "chunk_type": "body",
            "word_end": 53,
            "word_start": 40
          },
          {
            "arabic_text": "وَ عَنِ الرَّجُلِ يَبْتَاعُ الْجَارِيَةَ وَ لَهَا زَوْجٌ حُرٌّ قَالَ «لاَ يَحِلُّ لِأَحَدٍ أَنْ يَمَسَّهَا حَتَّى يُطَلِّقَهَا زَوْجُهَا الْحُرُّ».",
            "chunk_type": "body",
            "word_end": 72,
            "word_start": 53
          },
