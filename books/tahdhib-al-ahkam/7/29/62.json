          {
            "arabic_text": "رَوَى مُحَمَّدُ بْنُ يَعْقُوبَ عَنْ عَلِيِّ بْنِ إِبْرَاهِيمَ عَنْ أَبِيهِ عَنِ اِبْنِ أَبِي عُمَيْرٍ عَنْ عُمَرَ بْنِ أُذَيْنَةَ عَنْ زُرَارَةَ عَنْ أَبِي جَعْفَرٍ عَلَيْهِ السَّلَامُ قَالَ",
            "chunk_type": "isnad",
            "word_end": 26,
            "word_start": 0
          },
          {
            "arabic_text": "سَأَلْتُهُ عَنِ مَمْلُوكٍ تَزَوَّجَ بِغَيْرِ إِذْنِ سَيِّدِهِ فَقَالَ «إِنَّ ذَلِكَ إِلَى سَيِّدِهِ إِنْ شَاءَ أَجَازَهُ وَإِنْ شَاءَ فَرَّقَ بَيْنَهُمَا»",
            "chunk_type": "body",
            "word_end": 45,
            "word_start": 26
          },
          {
            "arabic_text": "فَقُلْتُ أَصْلَحَكَ اللَّهُ إِنَّ الْحَكَمَ بْنَ عُتَيْبَةَ وَإِبْرَاهِيمَ النَّخَعِيَّ وَأَصْحَابَهُمَا يَقُولُونَ إِنَّ أَصْلَ النِّكَاحِ بَاطِلٌ فَلَا تُحِلُّ إِجَازَةُ السَّيِّدِ لَهُ",
            "chunk_type": "body",
            "word_end": 65,
            "word_start": 45
          },
          {
            "arabic_text": "فَقَالَ أَبُو جَعْفَرٌ عَلَيْهِ السَّلَامُ «إِنَّهُ لَمْ يَعْصِ اللَّهَ إِنَّمَا عَصَى سَيِدَهُ فَإِذَا أَجَازَهُ فَهُوَ لَهُ جَائِزٌ»",
            "chunk_type": "body",
            "word_end": 82,
            "word_start": 65
          },
          {
            "arabic_text": "وَمَتَى رَضِيَ الْمَوْلَى بِالْعَقْدِ لَمْ يَكُنْ لَهُ بَعْدَ ذَلِكَ فَسْخُهُ",
            "chunk_type": "closing",
            "word_end": 92,
            "word_start": 82
          }
