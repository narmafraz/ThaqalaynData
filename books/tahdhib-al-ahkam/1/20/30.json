          },
          {
            "arabic_text": "«الْغُسْلُ فِي سَبْعَةَ عَشَرَ مَوْطِنًا",
            "chunk_type": "opening",
            "word_end": 40,
            "word_start": 35
          },
          {
            "arabic_text": "لَيْلَةِ سَبْعَ عَشْرَةَ مِنْ شَهْرِ رَمَضَانَ وَهِيَ لَيْلَةُ",
            "chunk_type": "body",
            "word_end": 48,
