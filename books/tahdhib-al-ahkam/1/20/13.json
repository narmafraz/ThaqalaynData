            "arabic_text": "وَ بِهَذَا الْإِسْنَادِ عَنْ مُحَمَّدِ بْنِ يَعْقُوبَ عَنْ مُحَمَّدِ بْنِ يَحْيَى عَنْ أَحْمَدَ بْنِ مُحَمَّدٍ عَنِ الْحُسَيْنِ بْنِ سَعِيدٍ وَ مُحَمَّدِ بْنِ خَالِدٍ عَنِ النَّضْرِ بْنِ سُوَيْدٍ عَنِ ابْنِ مُسْكَانَ عَنْ أَبِي عَبْدِ اللَّهِ عَلَيْهِ السَّلَامُ قَالَ",
            "chunk_type": "isnad",
            "word_end": 37,
            "word_start": 0
          },
          {
            "arabic_text": "سَأَلْتُهُ عَنْ غُسْلِ الْمَيِّتِ فَقَالَ «اغْسِلْهُ بِمَاءٍ وَ سِدْرٍ ثُمَّ اغْسِلْهُ عَلَى أَثَرِ ذَلِكَ غَسْلَةً أُخْرَى بِمَاءٍ وَ كَافُورٍ وَ ذَرِيرَةٍ إِنْ كَانَتْ وَ اغْسِلْهُ الثَّالِثَةَ بِمَاءٍ قَرَاحٍ»",
            "chunk_type": "body",
            "word_end": 65,
            "word_start": 37
          },
          {
            "arabic_text": "قُلْتُ ثَلَاثُ غَسَلَاتٍ لِجَسَدِهِ كُلِّهِ قَالَ «نَعَمْ»",
            "chunk_type": "body",
            "word_end": 72,
            "word_start": 65
          },
          {
            "arabic_text": "قُلْتُ يَكُونُ عَلَيْهِ ثَوْبٌ إِذَا غُسِّلَ فَقَالَ «إِنِ اسْتَطَعْتَ أَنْ يَكُونَ عَلَيْهِ قَمِيصٌ تُغَسِّلُهُ مِنْ تَحْتِهِ»",
            "chunk_type": "body",
            "word_end": 88,
            "word_start": 72
          },
          {
            "arabic_text": "وَ قَالَ «أُحِبُّ لِمَنْ غَسَّلَ الْمَيِّتَ أَنْ يَلُفَّ عَلَى يَدِهِ الْخِرْقَةَ حِينَ يُغَسِّلُهُ».",
            "chunk_type": "closing",
