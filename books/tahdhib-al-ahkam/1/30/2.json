        "chunks": [
          {
            "arabic_text": "عَنْهُ، عَنْ مُحَمَّدِ بْنِ إِسْمَاعِيلَ، عَنِ الْفَضْلِ بْنِ شَاذَانَ، عَنْ صَفْوَانَ بْنِ يَحْيَى، عَنِ ابْنِ مُسْكَانَ، عَنْ مُحَمَّدٍ الْحَلَبِيِّ قَالَ:",
            "chunk_type": "isnad",
            "word_end": 20,
            "word_start": 0
          },
          {
            "arabic_text": "سَأَلْتُ أَبَا عَبْدِ اللَّهِ عَلَيْهِ السَّلَامُ عَنِ الرَّجُلِ يَكُونُ عَلَى طُهْرٍ فَيَأْخُذُ مِنْ أَظْفَارِهِ أَوْ شَعْرِهِ، أَيُعِيدُ الْوُضُوءَ؟",
            "chunk_type": "opening",
            "word_end": 38,
            "word_start": 20
          },
          {
            "arabic_text": "فَقَالَ: «لَا، وَلَكِنْ يَمْسَحُ رَأْسَهُ وَأَظْفَارَهُ بِالْمَاءِ».",
            "chunk_type": "body",
            "word_end": 45,
            "word_start": 38
          },
          {
            "arabic_text": "قَالَ قُلْتُ: فَإِنَّهُمْ يَزْعُمُونَ أَنَّ فِيهِ الْوُضُوءَ.",
            "chunk_type": "body",
            "word_end": 52,
            "word_start": 45
          },
          {
            "arabic_text": "فَقَالَ: «إِنْ خَاصَمُوكُمْ فَلَا تُخَاصِمُوهُمْ، قُولُوا هَكَذَا السُّنَّةُ».",
            "chunk_type": "closing",
            "word_end": 60,
            "word_start": 52
          }
