          {
            "arabic_text": "عَلِيُّ بْنُ مَهْزِيَارَ عَنِ الْحَسَنِ عَنِ الْقَاسِمِ بْنِ مُحَمَّدٍ عَنِ الْحُسَيْنِ بْنِ أَحْمَدَ عَنْ يُونُسَ بْنِ ظَبْيَانَ قَالَ:",
            "chunk_type": "isnad",
            "word_end": 18,
            "word_start": 0
          },
          {
            "arabic_text": "كُنْتُ عِنْدَ أَبِي عَبْدِ اللَّهِ عَلَيْهِ السَّلَامُ جَالِسًا فَقَالَ: «مَا يَقُولُ النَّاسُ فِي أَرْوَاحِ الْمُؤْمِنِينَ؟»",
            "chunk_type": "opening",
            "word_end": 33,
            "word_start": 18
          },
          {
            "arabic_text": "قُلْتُ: يَقُولُونَ تَكُونُ فِي حَوَاصِلِ طُيُورٍ خُضْرٍ فِي قَنَادِيلَ تَحْتَ الْعَرْشِ.",
            "chunk_type": "body",
            "word_end": 44,
            "word_start": 33
          },
          {
            "arabic_text": "فَقَالَ أَبُو عَبْدِ اللَّهِ عَلَيْهِ السَّلَامُ: «سُبْحَانَ اللَّهِ، الْمُؤْمِنُ أَكْرَمُ عَلَى اللَّهِ مِنْ ذَلِكَ، أَنْ يَجْعَلَ رُوحَهُ فِي حَوْصَلَةِ طَائِرٍ أَخْضَرَ.",
            "chunk_type": "body",
            "word_end": 65,
            "word_start": 44
          },
          {
            "arabic_text": "يَا يُونُسُ، الْمُؤْمِنُ إِذَا قَبَضَهُ اللَّهُ تَعَالَى صَيَّرَ رُوحَهُ فِي قَالَبٍ كَقَالَبِهِ فِي الدُّنْيَا، فَيَأْكُلُونَ وَيَشْرَبُونَ، فَإِذَا قَدِمَ عَلَيْهِمُ الْقَادِمُ عَرَفُوهُ بِتِلْكَ الصُّورَةِ الَّتِي كَانَتْ فِي الدُّنْيَا».",
            "chunk_type": "closing",
            "word_end": 92,
            "word_start": 65
          }
