        "chunks": [
          {
            "arabic_text": "عَنْهُ عَنْ أَحْمَدَ بْنِ يَحْيَى بْنِ زَكَرِيَّا عَنْ أَبِيهِ عَنْ حُمَيْدِ بْنِ الْمُثَنَّى عَنْ أَبِي عَبْدِ الرَّحْمَنِ الْحَذَّاءِ عَنْ أَبِي عَبْدِ اللَّهِ عَلَيْهِ السَّلَامُ قَالَ",
            "chunk_type": "isnad",
            "word_end": 25,
            "word_start": 0
          },
          {
            "arabic_text": "أَوَّلُ نَعْشٍ أُحْدِثَ فِي الْإِسْلَامِ نَعْشُ فَاطِمَةَ عَلَيْهَا السَّلَامُ.",
            "chunk_type": "opening",
            "word_end": 34,
            "word_start": 25
          },
          {
            "arabic_text": "إِنَّهَا اشْتَكَتْ شَكْوَتَهَا الَّتِي قُبِضَتْ فِيهَا وَقَالَتْ لِأَسْمَاءَ: «إِنِّي نَحَلْتُ وَذَهَبَ لَحْمِي، أَلَا تَجْعَلِينَ لِي شَيْئًا يَسْتُرُنِي؟»",
            "chunk_type": "body",
            "word_end": 51,
            "word_start": 34
          },
          {
            "arabic_text": "قَالَتْ أَسْمَاءُ: إِنِّي كُنْتُ بِأَرْضِ الْحَبَشَةِ، رَأَيْتُهُمْ يَصْنَعُونَ شَيْئًا، أَفَلَا أَصْنَعُ لَكِ؟ فَإِنْ أَعْجَبَكِ صَنَعْتُ لَكِ.",
            "chunk_type": "body",
            "word_end": 67,
            "word_start": 51
          },
          {
            "arabic_text": "قَالَتْ: «نَعَمْ». فَدَعَتْ بِسَرِيرٍ فَأَكَبَّتْهُ لِوَجْهِهِ، ثُمَّ دَعَتْ بِجَرَائِدَ فَشَدَّتْهُ عَلَى قَوَائِمِهِ، ثُمَّ جَلَّلَتْهُ ثَوْبًا، فَقَالَتْ: هَكَذَا رَأَيْتُهُمْ يَصْنَعُونَ.",
            "chunk_type": "body",
            "word_end": 86,
            "word_start": 67
          },
          {
            "arabic_text": "فَقَالَتْ: «اصْنَعِي لِي مِثْلَهُ، اسْتُرِينِي سَتَرَكِ اللَّهُ مِنَ النَّارِ».",
            "chunk_type": "closing",
            "word_end": 95,
            "word_start": 86
          }
        ],
