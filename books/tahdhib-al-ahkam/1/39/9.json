        "chunks": [
          {
            "arabic_text": "اَلْحُسَيْنُ بْنُ سَعِيدٍ عَنْ صَفْوَانَ بْنِ يَحْيَى وَفَضَالَةَ عَنِ اَلْعَلَاءِ عَنْ مُحَمَّدِ بْنِ مُسْلِمٍ عَنْ أَحَدِهِمَا عَلَيْهِمَا السَّلَامُ قَالَ",
            "chunk_type": "isnad",
            "word_end": 19,
            "word_start": 0
          },
          {
            "arabic_text": "قُلْتُ: اَلرَّجُلُ يُغَمِّضُ اَلْمَيِّتَ، أَ عَلَيْهِ غُسْلٌ؟ فَقَالَ: «إِذَا مَسَّهُ بِحَرَارَتِهِ فَلَا، وَلَكِنْ إِذَا مَسَّهُ بَعْدَ مَا يَبْرُدُ فَلْيَغْتَسِلْ».",
            "chunk_type": "body",
            "word_end": 38,
            "word_start": 19
          },
          {
            "arabic_text": "قُلْتُ: فَالَّذِي يُغَسِّلُهُ يَغْتَسِلُ؟ قَالَ: «نَعَمْ».",
            "chunk_type": "body",
            "word_end": 44,
            "word_start": 38
          },
          {
            "arabic_text": "قُلْتُ: فَيُغَسِّلُهُ ثُمَّ يُلْبِسُهُ أَكْفَانَهُ قَبْلَ أَنْ يَغْتَسِلَ؟ قَالَ: «يُغَسِّلُهُ ثُمَّ يَغْسِلُ يَدَيْهِ مِنَ اَلْعَاتِقِ ثُمَّ يُلْبِسُهُ أَكْفَانَهُ ثُمَّ يَغْتَسِلُ».",
            "chunk_type": "body",
            "word_end": 64,
            "word_start": 44
          },
          {
            "arabic_text": "قُلْتُ: فَمَنْ حَمَلَهُ، أَ عَلَيْهِ غُسْلٌ؟ قَالَ: «لَا».",
            "chunk_type": "body",
            "word_end": 72,
            "word_start": 64
          },
          {
            "arabic_text": "قُلْتُ: فَمَنْ أَدْخَلَهُ اَلْقَبْرَ، أَ عَلَيْهِ وُضُوءٌ؟ قَالَ: «لَا إِلَّا أَنْ يَتَوَضَّأَ مِنْ تُرَابِ اَلْقَبْرِ إِنْ شَاءَ».",
            "chunk_type": "closing",
            "word_end": 89,
            "word_start": 72
          }
        ],
