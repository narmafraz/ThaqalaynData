          {
            "arabic_text": "سَعْدُ بْنُ عَبْدِ اللَّهِ عَنْ يَعْقُوبَ بْنِ يَزِيدَ عَنِ ابْنِ أَبِي عُمَيْرٍ عَنْ بَعْضِ أَصْحَابِهِ عَنْ أَبِي عَبْدِ اللَّهِ عَلَيْهِ السَّلَامُ قَالَ",
            "chunk_type": "isnad",
            "word_end": 22,
            "word_start": 0
          },
          {
            "arabic_text": "حَدُّ الْقَبْرِ إِلَى التَّرْقُوَةِ، وَقَالَ بَعْضُهُمْ إِلَى الثَّدْيِ، وَقَالَ بَعْضُهُمْ قَامَةُ الرَّجُلِ حَتَّى يُمَدَّ الثَّوْبُ عَلَى رَأْسِ مَنْ فِي الْقَبْرِ، وَأَمَّا اللَّحْدُ فَبِقَدْرِ مَا يُمْكِنُ فِيهِ الْجُلُوسُ.",
            "chunk_type": "opening",
            "word_end": 49,
            "word_start": 22
          },
          {
            "arabic_text": "وَلَمَّا حَضَرَ عَلِيَّ بْنَ الْحُسَيْنِ عَلَيْهِمَا السَّلَامُ الْوَفَاةُ أُغْمِيَ عَلَيْهِ، فَبَقِيَ سَاعَةً، ثُمَّ رُفِعَ عَنْهُ الثَّوْبُ، ثُمَّ قَالَ: الْحَمْدُ لِلَّهِ الَّذِي أَوْرَثَنَا الْجَنَّةَ نَتَبَوَّأُ مِنْهَا",
            "chunk_type": "body",
            "word_end": 74,
            "word_start": 49
          },
          {
            "arabic_text": "حَيْثُ نَشَاءُ فَنِعْمَ أَجْرُ الْعَامِلِينَ",
            "chunk_type": "quran_quote",
            "word_end": 79,
            "word_start": 74
          },
          {
            "arabic_text": "ثُمَّ قَالَ: احْفِرُوا لِي حَتَّى يَبْلُغَ الرَّشْحَ. قَالَ: ثُمَّ مُدَّ الثَّوْبُ عَلَيْهِ فَمَاتَ عَلَيْهِ السَّلَامُ.",
            "chunk_type": "closing",
