            "chunk_type": "isnad",
            "word_end": 23,
            "word_start": 0
          },
          {
            "arabic_text": "ذُكِرَ أَبُو سَعِيدٍ الْخُدْرِيُّ فَقَالَ: «كَانَ مِنْ أَصْحَابِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَآلِهِ وَكَانَ مُسْتَقِيمًا».",
            "chunk_type": "opening",
            "word_end": 39,
            "word_start": 23
          },
          {
            "arabic_text": "قَالَ: «فَنَزَعَ ثَلَاثَةَ أَيَّامٍ فَغَسَّلَهُ أَهْلُهُ ثُمَّ حَمَلُوهُ إِلَى مُصَلَّاهُ فَمَاتَ فِيهِ».",
            "chunk_type": "body",
            "word_end": 51,
            "word_start": 39
          },
          {
            "arabic_text": "قَالَ: «وَإِذَا وَجَّهْتَ الْمَيِّتَ لِلْقِبْلَةِ فَاسْتَقْبِلْ بِوَجْهِهِ الْقِبْلَةَ، لَا تَجْعَلْهُ مُعْتَرِضًا كَمَا يَجْعَلُ النَّاسُ، فَإِنِّي رَأَيْتُ أَصْحَابَنَا يَفْعَلُونَ ذَلِكَ، وَقَدْ كَانَ أَبُو بَصِيرٍ يَأْمُرُ بِالِاعْتِرَاضِ، أَخْبَرَنِي بِذَلِكَ عَلِيُّ بْنُ أَبِي حَمْزَةَ».",
            "chunk_type": "body",
            "word_end": 82,
            "word_start": 51
          },
          {
            "arabic_text": "قَالَ: «فَإِذَا مَاتَ الْمَيِّتُ فَخُذْ فِي جَهَازِهِ وَعَجِّلْهُ».",
            "chunk_type": "closing",
