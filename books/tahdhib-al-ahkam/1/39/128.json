            "chunk_type": "isnad",
            "word_end": 20,
            "word_start": 0
          },
          {
            "arabic_text": "كُنْتُ عِنْدَ أَبِي جَعْفَرٍ عَلَيْهِ السَّلَامُ وَعِنْدَهُ رَجُلٌ مِنَ الْأَنْصَارِ، فَمَرَّتْ بِهِ جَنَازَةٌ، فَقَامَ الْأَنْصَارِيُّ وَلَمْ يَقُمْ أَبُو جَعْفَرٍ عَلَيْهِ السَّلَامُ، فَقَعَدْتُ مَعَهُ، وَلَمْ يَزَلِ الْأَنْصَارِيُّ قَائِمًا حَتَّى مَضَوْا بِهَا، ثُمَّ جَلَسَ.",
            "chunk_type": "body",
            "word_end": 52,
            "word_start": 20
          },
          {
            "arabic_text": "فَقَالَ لَهُ أَبُو جَعْفَرٍ عَلَيْهِ السَّلَامُ: «مَا أَقَامَكَ؟» قَالَ: رَأَيْتُ الْحُسَيْنَ بْنَ عَلِيٍّ عَلَيْهِ السَّلَامُ يَفْعَلُ ذَلِكَ.",
            "chunk_type": "body",
            "word_end": 69,
            "word_start": 52
          },
          {
            "arabic_text": "فَقَالَ أَبُو جَعْفَرٍ عَلَيْهِ السَّلَامُ: «وَاللَّهِ مَا فَعَلَهُ الْحُسَيْنُ وَلَا قَامَ أَحَدٌ مِنَّا أَهْلَ الْبَيْتِ قَطُّ».",
            "chunk_type": "body",
            "word_end": 85,
            "word_start": 69
          },
          {
            "arabic_text": "فَقَالَ الْأَنْصَارِيُّ: شَكَّكْتَنِي أَصْلَحَكَ اللَّهُ، قَدْ كُنْتُ أَظُنُّ أَنِّي رَأَيْتُ.",
            "chunk_type": "closing",
            "word_end": 95,
