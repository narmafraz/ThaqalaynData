              "fa": "",
              "fr": "",
              "id": "",
              "ru": "",
              "tr": "",
              "ur": "",
              "zh": ""
            },
            "word_end": 20,
            "word_start": 0
          },
          {
            "arabic_text": "يُشَقُّ الْكَفَنُ إِذَا أُدْخِلَ الْمَيِّتُ فِي قَبْرِهِ مِنْ عِنْدِ رَأْسِهِ.",
            "chunk_type": "body",
            "translations": {
              "bn": "",
              "de": "",
              "en": "The shroud is torn when the deceased is placed into his grave, from the side of his head.",
