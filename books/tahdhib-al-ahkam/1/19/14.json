          {
            "arabic_text": "مَا أَخْبَرَنَا بِهِ الشَّيْخُ أَيَّدَهُ اللَّهُ تَعَالَى عَنْ أَبِي الْقَاسِمِ جَعْفَرِ بْنِ مُحَمَّدٍ عَنْ مُحَمَّدِ بْنِ يَعْقُوبَ عَنْ عَلِيِّ بْنِ إِبْرَاهِيمَ عَنْ أَبِيهِ وَمُحَمَّدِ بْنِ إِسْمَاعِيلَ عَنِ الْفَضْلِ بْنِ شَاذَانَ جَمِيعًا عَنْ حَمَّادِ بْنِ عِيسَى عَنْ حَرِيزٍ عَنْ زُرَارَةَ قَالَ",
            "chunk_type": "isnad",
            "word_end": 40,
            "word_start": 0
          },
          {
            "arabic_text": "قُلْتُ لِأَبِي جَعْفَرٍ عَلَيْهِ السَّلَامُ أَلَا تُخْبِرُنِي مِنْ أَيْنَ عَلِمْتَ وَقُلْتَ «إِنَّ الْمَسْحَ بِبَعْضِ الرَّأْسِ وَبَعْضِ الرِّجْلَيْنِ» فَضَحِكَ ثُمَّ قَالَ «يَا زُرَارَةُ قَالَهُ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَآلِهِ وَنَزَلَ بِهِ الْكِتَابُ مِنَ اللَّهِ تَعَالَى",
            "chunk_type": "opening",
            "word_end": 75,
            "word_start": 40
          },
          {
            "arabic_text": "لِأَنَّ اللَّهَ تَعَالَى يَقُولُ «فَاغْسِلُوا وُجُوهَكُمْ»",
            "chunk_type": "quran_quote",
            "word_end": 81,
            "word_start": 75
          },
          {
            "arabic_text": "فَعَرَفْنَا أَنَّ الْوَجْهَ كُلَّهُ يَنْبَغِي لَهُ أَنْ يُغْسَلَ ثُمَّ قَالَ",
            "chunk_type": "body",
            "word_end": 91,
            "word_start": 81
          },
          {
            "arabic_text": "«وَأَيْدِيَكُمْ إِلَى الْمَرَافِقِ»",
            "chunk_type": "quran_quote",
            "word_end": 94,
            "word_start": 91
          },
          {
            "arabic_text": "ثُمَّ فَصَّلَ بَيْنَ الْكَلَامَيْنِ فَقَالَ",
            "chunk_type": "body",
            "word_end": 99,
            "word_start": 94
          },
          {
            "arabic_text": "«وَامْسَحُوا بِرُءُوسِكُمْ»",
            "chunk_type": "quran_quote",
            "word_end": 101,
            "word_start": 99
          },
          {
            "arabic_text": "فَعَرَفْنَا حِينَ قَالَ «بِرُءُوسِكُمْ» أَنَّ الْمَسْحَ بِبَعْضِ الرَّأْسِ لِمَكَانِ الْبَاءِ ثُمَّ وَصَلَ الرِّجْلَيْنِ بِالرَّأْسِ كَمَا وَصَلَ الْيَدَيْنِ بِالْوَجْهِ فَقَالَ",
            "chunk_type": "body",
            "word_end": 120,
            "word_start": 101
          },
          {
            "arabic_text": "«وَأَرْجُلَكُمْ إِلَى الْكَعْبَيْنِ»",
            "chunk_type": "quran_quote",
            "word_end": 123,
            "word_start": 120
          },
          {
            "arabic_text": "فَعَرَفْنَا حِينَ وَصَلَهُمَا بِالرَّأْسِ أَنَّ الْمَسْحَ عَلَى بَعْضِهِمَا ثُمَّ فَسَّرَ ذَلِكَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَآلِهِ لِلنَّاسِ فَضَيَّعُوهُ ثُمَّ قَالَ",
            "chunk_type": "body",
            "word_end": 144,
            "word_start": 123
          },
          {
            "arabic_text": "«فَلَمْ تَجِدُوا مَاءً فَتَيَمَّمُوا صَعِيدًا طَيِّبًا فَامْسَحُوا بِوُجُوهِكُمْ وَأَيْدِيكُمْ»",
            "chunk_type": "quran_quote",
            "word_end": 153,
            "word_start": 144
          },
          {
            "arabic_text": "فَلَمَّا وَضَعَ الْوُضُوءَ عَمَّنْ لَمْ يَجِدِ الْمَاءَ أَثْبَتَ بِعِوَضِ الْغَسْلِ مَسْحًا لِأَنَّهُ قَالَ «بِوُجُوهِكُمْ» ثُمَّ وَصَلَ بِهَا «وَأَيْدِيكُمْ» ثُمَّ قَالَ «مِنْهُ» أَيْ مِنْ ذَلِكَ التَّيَمُّمِ لِأَنَّهُ عَلِمَ أَنَّ ذَلِكَ أَجْمَعَ لَا يَجْرِي عَلَى الْوَجْهِ لِأَنَّهُ يَعْلَقُ مِنْ ذَلِكَ الصَّعِيدِ بِبَعْضِ الْكَفِّ وَلَا يَعْلَقُ بِبَعْضِهَا ثُمَّ قَالَ",
            "chunk_type": "body",
            "word_end": 199,
            "word_start": 153
          },
          {
            "arabic_text": "«مَا يُرِيدُ اللَّهُ لِيَجْعَلَ عَلَيْكُمْ مِنْ حَرَجٍ»",
            "chunk_type": "quran_quote",
            "word_end": 206,
            "word_start": 199
