        "seo_questions": {
          "bn": "",
          "de": "",
          "en": "Can tayammum be performed with dust from a saddle or with clay when snow prevents access to normal earth?",
          "es": "",
          "fa": "",
          "fr": "",
          "id": "",
          "ru": "",
          "tr": "",
          "ur": "",
          "zh": ""
        },
        "summaries": {
          "bn": "",
          "de": "",
          "en": "This hadith gives a legal ruling for tayammum when ordinary earth or dust is not readily available due to snow or difficult conditions. It permits using the dust on the felt of a saddle or, if nothing else is found, even clay, showing facilitation in acts of ritual purity.",
