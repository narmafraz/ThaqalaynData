        "chunks": [
          {
            "arabic_text": "وَأَخْبَرَنِي الشَّيْخُ أَيَّدَهُ اللَّهُ تَعَالَى عَنْ أَبِي الْقَاسِمِ جَعْفَرِ بْنِ مُحَمَّدٍ عَنْ مُحَمَّدِ بْنِ يَعْقُوبَ عَنْ مُحَمَّدِ بْنِ يَحْيَى عَنِ الْعَمْرَكِيِّ بْنِ عَلِيٍّ عَنْ عَلِيِّ بْنِ جَعْفَرٍ عَنْ أَخِيهِ مُوسَى بْنِ جَعْفَرٍ عَلَيْهِمَا السَّلَامُ قَالَ",
            "chunk_type": "isnad",
            "word_end": 35,
            "word_start": 0
          },
          {
            "arabic_text": "سَأَلْتُهُ عَنِ الرَّجُلِ يُصِيبُ ثَوْبَهُ خِنْزِيرٌ فَلَمْ يَغْسِلْهُ فَذَكَرَ وَهُوَ فِي صَلَاتِهِ كَيْفَ يَصْنَعُ بِهِ قَالَ: «إِنْ كَانَ دَخَلَ فِي صَلَاتِهِ فَلْيَمْضِ، وَإِنْ لَمْ يَكُنْ دَخَلَ فِي صَلَاتِهِ فَلْيَنْضِحْ مَا أَصَابَ مِنْ ثَوْبِهِ إِلَّا أَنْ يَكُونَ فِيهِ أَثَرٌ فَيَغْسِلَهُ».",
            "chunk_type": "body",
            "word_end": 74,
            "word_start": 35
          },
          {
            "arabic_text": "وَسَأَلْتُهُ عَنْ خِنْزِيرٍ شَرِبَ مِنْ إِنَاءٍ كَيْفَ يُصْنَعُ بِهِ قَالَ: «يُغْسَلُ سَبْعَ مَرَّاتٍ».",
            "chunk_type": "body",
            "word_end": 87,
            "word_start": 74
          },
          {
            "arabic_text": "قَالَ الشَّيْخُ أَيَّدَهُ اللَّهُ تَعَالَى: وَكَذَلِكَ الْحُكْمُ فِي الْفَأْرَةِ وَالْوَزَغَةِ، يُرَشُّ الْمَوْضِعُ الَّذِي مَسَّاهُ مِنَ الثَّوْبِ إِذَا لَمْ يُؤَثِّرَا فِيهِ، وَإِنْ رَطَّبَاهُ وَأَثَّرَا فِيهِ غُسِلَ بِالْمَاءِ. يَدُلُّ عَلَيْهِ.",
            "chunk_type": "closing",
            "word_end": 115,
            "word_start": 87
          }
