      "translations": {
        "en.bab-ul-qaim-publications": [
          "Hadith.1991 - It was narrated from Abdul Rahman bin Al-Hajjaj:\n\"I asked Abu Al-Hasan (as) about a woman who gives birth after Asr (afternoon prayer). Should she complete her fast for that day, or should she break it?\nImam (as) said: 'She should break her fast and then make up for that day later.'\""
        ]
      }
