      "translations": {
        "en.bab-ul-qaim-publications": [
          "Hadith.2978 - Mu'awiyah ibn Ammar and Abu Basir narrated from Abu Abdullah (as), who said:\n\"The boundary of Mina extends from Al-Aqabah to the Valley of Muhassir, and the boundary of Arafat extends from Al-Mazameen to the farthest point of the standing area (Mawqif).\""
        ]
      }
