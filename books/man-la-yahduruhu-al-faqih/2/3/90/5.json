      "translations": {
        "en.bab-ul-qaim-publications": [
          "Hadith.2890 - Ishaq ibn Ammar narrated:\nI asked Abu Ibrahim (as) about a concubine (umm walad) of a man whom he had sent for Hajj. \"Does that suffice for her as the Hajj of Islam?\"\nImam (as) said: \"No.\"\nI asked: \"Does she have any reward for her Hajj?\"\nImam (as) said: \"Yes.\""
        ]
      }
