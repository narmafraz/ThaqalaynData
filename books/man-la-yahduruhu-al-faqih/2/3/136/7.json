            "chunk_type": "quran_quote",
            "word_end": 27,
            "word_start": 17
          },
          {
            "arabic_text": "إِلَى قَوْلِهِ تَعَالَى:",
            "chunk_type": "body",
            "word_end": 30,
            "word_start": 27
          },
          {
            "arabic_text": "«وَمِنَ الْإِبِلِ اثْنَيْنِ وَمِنَ الْبَقَرِ اثْنَيْنِ»",
            "chunk_type": "quran_quote",
            "word_end": 36,
            "word_start": 30
          },
          {
            "arabic_text": "مَا الَّذِي أَحَلَّ اللَّهُ عَزَّ وَجَلَّ مِنْ ذَلِكَ وَمَا الَّذِي حَرَّمَ فَلَمْ يَكُنْ عِنْدِي فِيهِ شَيْءٌ فَدَخَلْتُ عَلَى أَبِي عَبْدِ اللَّهِ عَلَيْهِ السَّلَامُ وَأَنَا حَاجٌّ فَأَخْبَرْتُهُ بِمَا كَانَ فَقَالَ",
            "chunk_type": "body",
            "word_end": 65,
            "word_start": 36
          },
          {
            "arabic_text": "«إِنَّ اللَّهَ تَبَارَكَ وَتَعَالَى أَحَلَّ فِي الْأُضْحِيَّةِ بِمِنًى الضَّأْنَ وَالْمَعْزَ الْأَهْلِيَّةَ وَحَرَّمَ أَنْ يُضَحَّى فِيهِ بِالْجَبَلِيَّةِ وَأَمَّا قَوْلُهُ عَزَّ وَجَلَّ",
            "chunk_type": "body",
            "word_end": 85,
            "word_start": 65
          },
          {
            "arabic_text": "«وَمِنَ الْإِبِلِ اثْنَيْنِ وَمِنَ الْبَقَرِ اثْنَيْنِ»",
            "chunk_type": "quran_quote",
            "word_end": 91,
            "word_start": 85
          },
          {
            "arabic_text": "فَإِنَّ اللَّهَ تَبَارَكَ وَتَعَالَى أَحَلَّ فِي الْأُضْحِيَّةِ بِمِنًى الْإِبِلَ الْعِرَابَ وَحَرَّمَ فِيهَا الْبَخَاتِيَّ وَأَحَلَّ الْبَقَرَ الْأَهْلِيَّةَ أَنْ يُضَحَّى بِهَا وَحَرَّمَ الْجَبَلِيَّةَ»",
