      "translations": {
        "en.bab-ul-qaim-publications": [
          "Hadith.2434 - Ibrahim ibn Abdul-Hamid narrated from Abu al-Hasan Imam Musa ibn Jafar Al-Kadhim (as), who said:\n\"The Messenger of Allah (swt) (peace and blessings of Allah (swt) be upon him and his family) cursed three: the one who eats their provisions alone, the one who sleeps alone in a house, and the one who travels alone in the wilderness.\""
        ]
      }
