      "translations": {
        "en.bab-ul-qaim-publications": [
          "Hadith.2387 - Al-Sakuni narrated through his chain that the Messenger of Allah (swt), peace and blessings be upon him and his family, said:\n\"Travel, and you will gain health; strive in the way of Allah (swt), and you will attain victory; and perform Hajj, and you will become self-sufficient.\""
        ]
