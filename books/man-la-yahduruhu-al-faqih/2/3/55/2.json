      "translations": {
        "en.bab-ul-qaim-publications": [
          "Hadith.2648 - Muhammad ibn Muslim narrated from Abu Ja'far (as), who said:\n\"A Muhrim may apply kohl to his eyes if he wishes, provided it is made with sabr (aloe) and does not contain saffron (za'faran) or turmeric (wars).\""
        ]
      }
