            "arabic_text": "وَلَا تَبِتْ لَيَالِيَ التَّشْرِيقِ إِلَّا بِمِنًى، فَإِنْ بِتَّ فِي غَيْرِهَا فَعَلَيْكَ دَمُ شَاةٍ لِكُلِّ لَيْلَةٍ",
            "chunk_type": "opening",
            "word_end": 15,
            "word_start": 0
          },
          {
            "arabic_text": "وَإِنْ خَرَجْتَ أَوَّلَ اللَّيْلِ مِنْ مِنًى فَلَا يَنْتَصِفُ اللَّيْلُ إِلَّا وَأَنْتَ بِمِنًى، أَوْ قَدْ خَرَجْتَ مِنْ مَكَّةَ",
            "chunk_type": "body",
            "word_end": 32,
            "word_start": 15
          },
          {
            "arabic_text": "إِلَّا أَنْ تَكُونَ فِي شُغْلٍ مِنْ طَوَافِكَ وَسَعْيِكَ وَأَصْبَحْتَ بِمَكَّةَ فَلَا شَيْءَ عَلَيْكَ",
            "chunk_type": "body",
            "word_end": 45,
