      "translations": {
        "en.bab-ul-qaim-publications": [
          "Hadith.3151 - Abu Basir narrates from Abu Abdullah (as):\n\"The boundaries of what the Messenger of Allah (swt) (peace be upon him and his family) declared sacred from Medina are from Rabab to Waqim, and from al-‘Urays to an-Naqb, in the direction of Mecca.\""
        ]
      }
