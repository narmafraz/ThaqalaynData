      ],
      "translations": {
        "en.bab-ul-qaim-publications": [
          "Hadith.2940 - Mu'awiyah ibn Ammar narrated:\nAbu Abdullah (as) was asked about a man who performed Hajj as Ifrad (Hajj without Umrah). Can he perform Umrah after completing Hajj?\nImam (as) said: \"Yes, if the razor has touched his head (he has completed the rites of Hajj), then it is good.\""
        ]
      }
