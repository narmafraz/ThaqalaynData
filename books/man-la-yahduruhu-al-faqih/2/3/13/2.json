      "translations": {
        "en.bab-ul-qaim-publications": [
          "Hadith.2421 - Al-Ala’ narrated from Abu ‘Ubaydah, from one of the Imams (as), who said:\n\"When you are on a journey, say: 'O Allah (swt), make my traveling a source of lessons, my silence a form of reflection, and my speech a means of remembrance.'\""
        ]
