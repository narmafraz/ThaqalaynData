      "translations": {
        "en.bab-ul-qaim-publications": [
          "Hadith.4797 - Muhammad ibn Hakim narrated from Muhammad ibn Muslim who said:\nI heard Abu Ja'far Imam Muhammad ibn Ali Al-Baqir (as) say regarding a woman who has reached menopause and her husband divorces her:\n\"She is separated from him, and there is no waiting period ('iddah) upon her.\""
        ]
      }
