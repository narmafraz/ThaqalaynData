      "translations": {
        "en.bab-ul-qaim-publications": [
          "Hadith.4840 - Abdullah ibn Bukayr narrated from Humran who said:\nI asked Abu Abdullah (as) about a man who said to his female slave, \"You are to me as the back of my mother,\" intending by this statement to please his wife.\nImam (as) replied: \"He may approach her (the slave), and there is nothing upon her or upon him.\""
        ]
      }
