      "translations": {
        "en.bab-ul-qaim-publications": [
          "Hadith.3346 - It is narrated from Ali ibn Yaqtin, from Abu al-Hasan al-Awwal (as), who said:\n\"There is no issue with bearing witness to a woman's acknowledgment (confession) without her unveiling her face, as long as she is identified either by her specific features or in the presence of someone who recognizes her.\""
        ]
      }
