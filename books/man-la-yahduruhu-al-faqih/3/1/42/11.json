          {
            "arabic_text": "سَأَلْتُهُ عَنْ مَوْلُودٍ لَيْسَ لَهُ مَا لِلرِّجَالِ وَ لَيْسَ لَهُ مَا لِلنِّسَاءِ قَالَ",
            "chunk_type": "opening",
            "word_end": 31,
            "word_start": 18
          },
          {
            "arabic_text": "هَذَا يُقْرَعُ عَلَيْهِ الْإِمَامُ يَكْتُبُ عَلَى سَهْمٍ عَبْدُ اللَّهِ وَ عَلَى سَهْمٍ آخَرَ أَمَةُ اللَّهِ ثُمَّ يَقُولُ الْإِمَامُ أَوِ الْمُقْرِعُ اللَّهُمَّ أَنْتَ اللَّهُ لَا إِلَهَ إِلَّا أَنْتَ",
            "chunk_type": "body",
            "word_end": 58,
            "word_start": 31
          },
          {
            "arabic_text": "عَالِمَ الْغَيْبِ وَ الشَّهَادَةِ أَنْتَ تَحْكُمُ بَيْنَ عِبَادِكَ فِي مَا كَانُوا فِيهِ يَخْتَلِفُونَ",
            "chunk_type": "quran_quote",
            "word_end": 71,
            "word_start": 58
          },
          {
            "arabic_text": "بَيِّنْ لَنَا أَمْرَ هَذَا الْمَوْلُودِ حَتَّى يُوَرَّثَ مَا فَرَضْتَ لَهُ فِي كِتَابِكَ",
            "chunk_type": "body",
            "word_end": 83,
            "word_start": 71
          },
          {
            "arabic_text": "ثُمَّ يَطْرَحُ السَّهْمَيْنِ فِي سِهَامٍ مُبْهَمَةٍ ثُمَّ تُجَالُ فَأَيُّهُمَا خَرَجَ وُرِّثَ عَلَيْهِ",
