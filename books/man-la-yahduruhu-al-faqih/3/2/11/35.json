      ],
      "translations": {
        "en.bab-ul-qaim-publications": [
          "Hadith.3600 - Imam Jafar ibn Muhammad Al-Sadiq (as) said to Al-Walid ibn Subayh:\n\"O Walid, do not buy anything for me from one who is engaged in unlawful earnings (Muharif), for there is no blessing in associating with him.\""
        ]
      }
