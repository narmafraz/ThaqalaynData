      "translations": {
        "en.bab-ul-qaim-publications": [
          "Hadith.3657 - Abdullah bin Muhammad Al-Ju'fi narrated from Abu Ja'far Imam Muhammad ibn Ali Al-Baqir (as), who said:\n'Whoever hires himself out has restricted his sustenance. And how could he not restrict his sustenance when whatever he earns belongs to the master who hired him?'"
        ]
      }
