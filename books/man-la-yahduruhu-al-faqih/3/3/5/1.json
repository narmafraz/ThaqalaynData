      ],
      "translations": {
        "en.bab-ul-qaim-publications": [
          "Hadith.4350 - Abu Malik al-Hadrami narrated from Abu al-Abbas, who said that he heard Imam Jafar ibn Muhammad Al-Sadiq (as) say: \"The more love a servant has for women, the greater he increases in faith and virtue.\""
        ]
      }
