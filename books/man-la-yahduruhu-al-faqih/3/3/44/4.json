          {
            "arabic_text": "سَأَلْتُ أَبَا عَبْدِ اللَّهِ عَلَيْهِ السَّلَامُ عَنِ الْمُتْعَةِ فَقَالَ: «نَعَمْ إِذَا كَانَتْ عَارِفَةً».",
            "chunk_type": "opening",
            "word_end": 23,
            "word_start": 10
          },
          {
            "arabic_text": "قُلْتُ: جُعِلْتُ فِدَاكَ فَإِنْ لَمْ تَكُنْ عَارِفَةً قَالَ: «فَاعْرِضْ عَلَيْهَا وَ قُلْ لَهَا فَإِنْ قَبِلَتْ فَتَزَوَّجْهَا وَ إِنْ أَبَتْ وَ لَمْ تَرْضَ بِقَوْلِكَ فَدَعْهَا وَ إِيَّاكُمْ وَ الْكَوَاشِفَ وَ الدَّوَاعِيَ وَ الْبَغَايَا وَ ذَوَاتَ الْأَزْوَاجِ».",
            "chunk_type": "body",
            "word_end": 58,
            "word_start": 23
          },
          {
            "arabic_text": "فَقُلْتُ: مَا الْكَوَاشِفُ فَقَالَ: «اللَّوَاتِي يُكَاشِفْنَ وَ بُيُوتُهُنَّ مَعْلُومَةٌ وَ يُؤْتَيْنَ».",
            "chunk_type": "body",
            "word_end": 69,
            "word_start": 58
          },
          {
            "arabic_text": "قُلْتُ: فَالدَّوَاعِي قَالَ: «اللَّوَاتِي يَدْعُونَ إِلَى أَنْفُسِهِنَّ وَ قَدْ عُرِفْنَ بِالْفَسَادِ».",
            "chunk_type": "body",
            "word_end": 80,
            "word_start": 69
          },
          {
            "arabic_text": "قُلْتُ: فَالْبَغَايَا قَالَ: «الْمَعْرُوفَاتُ بِالزِّنَا».",
