      "translations": {
        "en.bab-ul-qaim-publications": [
          "Hadith.4431 - Amr ibn Shimr reported from Jabir, who said:\nI asked Abu Jafar Imam Muhammad ibn Ali Al-Baqir (as), about the midwife, whether it is permissible for the child she delivered to marry her.\nImam (as) replied: \"No, nor her daughter. She is like one of his mothers.\""
        ]
      }
