      ],
      "translations": {
        "en.bab-ul-qaim-publications": [
          "Everything in this book that is narrated from Muhammad ibn Hurman and Jamil ibn Darraj has been transmitted by me from my father - may Allah (swt) be pleased with him - from Sa'd ibn Abdullah, from Ya'qub ibn Yazid, from Muhammad ibn Abi 'Umayr, from Muhammad ibn Hurman and Jamil ibn Darraj."
        ]
      }
