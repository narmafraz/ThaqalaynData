      ],
      "translations": {
        "en.bab-ul-qaim-publications": [
          "Hadith.770 - Ismail ibn Muslim narrated from Imam Jafar ibn Muhammad Al-Sadiq (as) that He said: \"Allah (swt), the Mighty and Majestic, revealed to one of His prophets, saying:\n'Tell the believers not to wear the attire of My enemies, not to eat the foods of My enemies, and not to follow the paths of My enemies, lest they become My enemies as they are My enemies.'\"."
        ]
      }
