      "translations": {
        "en.bab-ul-qaim-publications": [
          "Hadith.785 - Al-Ays ibn Al-Qasim asked Imam Jafar ibn Muhammad Al-Sadiq (as) about a man praying in a woman's garment or her waist wrap, or wrapping himself with her headcover.\nImam (as) said: \"Yes, if it is clean (from any impurity)”."
        ]
      }
