      "translations": {
        "en.bab-ul-qaim-publications": [
          "Hadith.481 - Hisham ibn Salim asked Imam Jafar ibn Muhammad Al-Sadiq (as) about whether the funeral prayer should be offered for one who drinks alcohol, commits adultery (zina), or steals if they pass away.\nImam (as) replied: \"Yes.\""
        ]
      }
