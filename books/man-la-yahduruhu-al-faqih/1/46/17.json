      "translations": {
        "en.bab-ul-qaim-publications": [
          "Hadith.931 - Abu Basir asked Imam Jafar ibn Muhammad Al-Sadiq (as) about the reason for why the prayer consists of two units (rak'ahs) with four prostrations (Sujood).\nImam (as) replied: \"Because one unit of standing (qiyam) is equivalent to two units of sitting.\""
        ]
      }
