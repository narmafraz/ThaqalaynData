      "translations": {
        "en.bab-ul-qaim-publications": [
          "Hadith.544 - Safwan ibn Yahya said to Abu Al-Hasan Imam Musa ibn Jafar Al-Kadhim (as):\n\"I have heard that when a believer is visited by someone (at their grave), they are comforted by their presence, but when the visitor leaves, they feel lonely.\"\nImam (as) replied: \"They do not feel lonely.\""
        ]
      }
