      "translations": {
        "en.bab-ul-qaim-publications": [
          "Hadith.992 - Imam Jafar ibn Muhammad Al-Sadiq (as) said to Ammar ibn Musa:\n\"O’ Ammar, I will sum up all forgetfulness for you in two words: Whenever you are in doubt, follow the majority (the greater number). When you finish your prayer, complete what you thought you may have missed”."
        ]
      }
