      "translations": {
        "en.bab-ul-qaim-publications": [
          "Hadith.1202 - Ali ibn Ja'far was asked about his brother Imam Musa ibn Jafar Al-Kadhim (as) about a woman leading other women in prayer:\n\"What is the limit of raising her voice in the takbir (saying 'Allahu Akbar') and in recitation?\"\nImam (as) replied: \"To the extent that they can hear her.\""
        ]
      }
