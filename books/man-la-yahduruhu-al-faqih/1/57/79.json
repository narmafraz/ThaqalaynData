      "translations": {
        "en.bab-ul-qaim-publications": [
          "Hadith.1171 - Ammar al-Sabati asked Imam Jafar ibn Muhammad Al-Sadiq (as) about a man who arrives at the mosque just as the Imam is concluding the prayer with the taslim (final salutation).\nImam (as) replied: \"He should give the adhan (call to prayer), make the iqamah (call to commence the prayer), and then begin his prayer.\""
        ]
      }
