      "translations": {
        "en.bab-ul-qaim-publications": [
          "Hadith.430 - Mansour ibn Hazim asked Imam Jafar ibn Muhammad Al-Sadiq (as) about a man traveling with his wife, and She dies. Should he wash her?\nImam (as) replied: \"Yes, as well as his mother, sister, and similar relatives. He should cover her private parts with a cloth and then perform the washing.\""
        ]
      }
