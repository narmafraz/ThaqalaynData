      "translations": {
        "en.bab-ul-qaim-publications": [
          "Hadith.561 – Imam Jafar ibn Muhammad Al-Sadiq (as) was asked about the Allah’s (swt) words:\n\"Did We not grant you life enough for whoever would remember therein to remember?\" (Surah Fatir 35:37)\nImam (as) said: \"It is a reproach for one who reaches eighteen years of age”."
        ]
      }
