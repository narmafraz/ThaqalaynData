      "translations": {
        "en.bab-ul-qaim-publications": [
          "Hadith.1518 - t is narrated from Kamil, who said:\n\"I was with Imam Muhammad ibn Ali Al-Baqir (as) in al-‘Urayd when a strong wind blew. Abu Ja'far (as) began to say 'Allahu Akbar' (Allah (swt) is the Greatest) repeatedly, and then said: 'Indeed, saying Takbir (Allahu Akbar) repels the wind.'\""
        ]
      }
