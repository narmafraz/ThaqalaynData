      "translations": {
        "en.bab-ul-qaim-publications": [
          "Hadith.1321 - Jamil ibn Darraj asked him (Abu Abdullah (as)):\n\"The ship is close to the shore ; should I disembark and pray?\"\nHe (as) replied: \"Pray on it (the ship). Are you not content with the prayer of Noah (as)?\""
        ]
      }
