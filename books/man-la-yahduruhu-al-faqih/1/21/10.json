      "translations": {
        "en.bab-ul-qaim-publications": [
          "Hadith.200 - It is reported (from Imam Jafar ibn Muhammad Al-Sadiq (as) ) narrated:\n'If a man has intercourse with a woman while She is menstruating, he should give charity to a needy person in an amount sufficient to satisfy their hunger.'."
        ]
      }
