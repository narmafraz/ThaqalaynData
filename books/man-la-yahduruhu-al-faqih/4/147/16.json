      "translations": {
        "en.bab-ul-qaim-publications": [
          "Hadith.5638 - Ibn Mahbub narrated from Khalid ibn Jarir from Abu Al-Rabi from Abu Abdullah (as) who said: \"Imam Ali ibn Abi Talib (as) used to make the paternal brother inherit alongside the grandfather, placing him in the same position as the grandfather.\""
        ]
      }
