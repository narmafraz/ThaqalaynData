          {
            "arabic_text": "رَوَى عَاصِمُ بْنُ حُمَيْدٍ عَنْ مُحَمَّدِ بْنِ قَيْسٍ عَنْ أَبِي جَعْفَرٍ عَلَيْهِ السَّلَامُ قَالَ:",
            "chunk_type": "isnad",
            "word_end": 14,
            "word_start": 0
          },
          {
            "arabic_text": "قَضَى أَمِيرُ الْمُؤْمِنِينَ عَلَيْهِ السَّلَامُ فِي مُكَاتَبٍ كَانَتْ تَحْتَهُ امْرَأَةٌ حُرَّةٌ فَأَوْصَتْ لَهُ عِنْدَ مَوْتِهَا بِوَصِيَّةٍ فَقَالَ: أَهْلُ الْمِيرَاثِ لَا تَجُوزُ وَصِيَّتُهَا لَهُ إِنَّهُ مُكَاتَبٌ لَمْ يُعْتَقْ.",
            "chunk_type": "opening",
            "word_end": 41,
            "word_start": 14
          },
          {
            "arabic_text": "فَقَضَى عَلَيْهِ السَّلَامُ أَنَّهُ يَرِثُ بِحِسَابِ مَا أُعْتِقَ مِنْهُ وَيَجُوزُ لَهُ مِنَ الْوَصِيَّةِ بِحِسَابِ مَا أُعْتِقَ مِنْهُ.",
            "chunk_type": "body",
            "word_end": 58,
            "word_start": 41
          },
          {
            "arabic_text": "وَقَضَى عَلَيْهِ السَّلَامُ فِي مُكَاتَبٍ أُوصِيَ لَهُ بِوَصِيَّةٍ وَقَدْ قَضَى نِصْفَ مَا عَلَيْهِ فَأَجَازَ لَهُ نِصْفَ الْوَصِيَّةِ.",
            "chunk_type": "body",
            "word_end": 75,
            "word_start": 58
          },
          {
            "arabic_text": "وَقَضَى فِي مُكَاتَبٍ قَضَى رُبُعَ مَا عَلَيْهِ فَأُوصِيَ لَهُ بِوَصِيَّةٍ فَأَجَازَ لَهُ رُبُعَ الْوَصِيَّةِ.",
            "chunk_type": "body",
            "word_end": 89,
            "word_start": 75
          },
          {
            "arabic_text": "وَقَالَ عَلَيْهِ السَّلَامُ فِي رَجُلٍ أَوْصَى لِمُكَاتَبَتِهِ وَقَدْ قَضَتْ سُدُسَ مَا كَانَ عَلَيْهَا فَأَجَازَ لَهَا بِحِسَابِ مَا أُعْتِقَ مِنْهَا.",
