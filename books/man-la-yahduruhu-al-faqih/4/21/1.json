      "translations": {
        "en.bab-ul-qaim-publications": [
          "Hadith.5182 - Hammad ibn Isa narrated from Abu Abdullah (as), who said:\n\"While the Messenger of Allah (swt) (peace be upon him and his family) was in one of his rooms, a man peeked through a crack in the door.\nThe Messenger of Allah (swt) (peace be upon him and his family) had a combing stick in his hand and said: 'If I were close to you, I would have gouged out your eye with it.'\""
        ]
      }
