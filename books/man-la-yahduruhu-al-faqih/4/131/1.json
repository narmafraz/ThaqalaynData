        "chunks": [
          {
            "arabic_text": "إِذَا تَرَكَ الرَّجُلُ ابْنًا وَلَمْ يَتْرُكْ زَوْجَةً وَلَا أَبَوَيْنِ فَالْمَالُ كُلُّهُ لِلِابْنِ، وَكَذَٰلِكَ إِنْ كَانَا اثْنَيْنِ أَوْ أَكْثَرَ مِنْ ذَٰلِكَ فَالْمَالُ بَيْنَهُمْ بِالسَّوِيَّةِ. وَكَذَٰلِكَ إِنْ تَرَكَ ابْنَةً وَلَمْ يَتْرُكْ زَوْجًا وَلَا أَبَوَيْنِ فَالْمَالُ كُلُّهُ لِلِابْنَةِ لِأَنَّ اللَّهَ عَزَّ وَجَلَّ جَعَلَ الْمَالَ لِلْوَلَدِ وَلَمْ يُسَمِّ لِلِابْنَةِ النِّصْفَ إِلَّا مَعَ الْأَبَوَيْنِ، وَكَذَٰلِكَ إِنْ كَانَتَا اثْنَتَيْنِ أَوْ أَكْثَرَ فَالْمَالُ كُلُّهُ لَهُنَّ بِالسَّوِيَّةِ.",
            "chunk_type": "opening",
            "word_end": 59,
            "word_start": 0
          },
          {
            "arabic_text": "وَإِنْ تَرَكَ ابْنَةً وَابْنَةَ ابْنٍ وَابْنَ ابْنٍ وَلَمْ يَكُنْ زَوْجٌ وَلَا أَبَوَانِ فَالْمَالُ كُلُّهُ لِلِابْنَةِ، وَلَيْسَ لِوَلَدِ الْوَلَدِ مَعَ وَلَدِ الصُّلْبِ شَيْءٌ، لِأَنَّ مَنْ تَقَرَّبَ بِنَفْسِهِ كَانَ أَوْلَى وَأَحَقَّ بِالْمَالِ مِمَّنْ تَقَرَّبَ بِغَيْرِهِ، وَمَنْ كَانَ أَقْرَبَ إِلَى الْمَيِّتِ بِبَطْنٍ كَانَ أَحَقَّ بِالْمَالِ مِمَّنْ كَانَ أَبْعَدَ بِبَطْنٍ.",
            "chunk_type": "body",
            "word_end": 105,
            "word_start": 59
          },
          {
            "arabic_text": "فَإِنْ تَرَكَ ابْنًا وَابْنَةً أَوْ بَنِينَ وَبَنَاتٍ فَالْمَالُ كُلُّهُ لَهُمْ لِلذَّكَرِ مِثْلُ حَظِّ الْأُنْثَيَيْنِ إِذَا لَمْ يَكُنْ مَعَهُمْ زَوْجٌ وَلَا وَالِدَانِ.",
            "chunk_type": "body",
            "word_end": 126,
            "word_start": 105
          },
          {
            "arabic_text": "فَإِنْ تَرَكَ ابْنَةً وَأَخًا وَأُخْتًا وَجَدًّا فَالْمَالُ كُلُّهُ لِلِابْنَةِ، وَلَا يَرِثُ مَعَ الِابْنَةِ أَحَدٌ إِلَّا الِابْنُ وَالزَّوْجُ وَالْوَالِدَانِ، وَكَذَٰلِكَ لَا يَرِثُ مَعَ الْوَلَدِ الذَّكَرِ أَحَدٌ إِلَّا الزَّوْجُ وَالْأَبَوَانِ عَلَى مَا ذَكَرَهُ اللَّهُ عَزَّ وَجَلَّ فِي كِتَابِهِ.",
            "chunk_type": "closing",
            "word_end": 162,
