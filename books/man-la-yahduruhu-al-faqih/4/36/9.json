      ],
      "translations": {
        "en.bab-ul-qaim-publications": [
          "Hadith.5324 - Al-Husayn ibn Saʿid narrated from Muhammad ibn Al-Fuḍayl who said:\nI asked Abu Al-Hasan (as) about a thief who entered upon a pregnant woman, assaulted her, and caused her to miscarry. The woman then attacked the thief and killed him.\nImam (as) replied: \"The blood of the thief is not avenged (yutallu), but the diyyah (blood money) for her miscarried fetus is due upon her.\""
        ]
      }
