      "translations": {
        "en.bab-ul-qaim-publications": [
          "Hadith.5197 - Muawiyah ibn Wahb asked Abu Abdullah (as) about the blood money (diyyah) for intentional killing.\nImam (as) said: \"It is one hundred mature male camels. If they are not available, then for each camel, twenty mature male sheep are to be given in its place.\""
        ]
      }
