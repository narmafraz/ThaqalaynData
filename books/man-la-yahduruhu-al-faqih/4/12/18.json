          {
            "arabic_text": "٥١١٥ - وَرَوَى الْحَسَنُ بْنُ مَحْبُوبٍ عَنْ عَلِيِّ بْنِ رِئَابٍ عَنْ زُرَارَةَ عَنْ أَبِي جَعْفَرٍ عَلَيْهِ السَّلَامُ:",
            "chunk_type": "isnad",
            "word_end": 17,
            "word_start": 0
          },
          {
            "arabic_text": "فِي رَجُلٍ سَرَقَ فَقُطِعَتْ يَدُهُ الْيُمْنَى ثُمَّ سَرَقَ فَقُطِعَتْ رِجْلُهُ الْيُسْرَى ثُمَّ سَرَقَ الثَّالِثَةَ قَالَ",
            "chunk_type": "opening",
            "word_end": 32,
            "word_start": 17
          },
          {
            "arabic_text": "«كَانَ أَمِيرُ الْمُؤْمِنِينَ عَلَيْهِ السَّلَامُ يُخَلِّدُهُ فِي السِّجْنِ وَيَقُولُ: إِنِّي لَأَسْتَحْيِي مِنْ رَبِّي أَنْ أَدَعَهُ بِلَا يَدٍ يَسْتَنْظِفُ بِهَا وَلَا رِجْلٍ يَمْشِي بِهَا إِلَى حَاجَتِهِ»",
            "chunk_type": "body",
            "word_end": 57,
            "word_start": 32
          },
          {
            "arabic_text": "قَالَ: «وَكَانَ إِذَا قَطَعَ الْيَدَ قَطَعَهَا دُونَ الْمَفْصِلِ وَإِذَا قَطَعَ الرِّجْلَ قَطَعَهَا مِنَ الْكَعْبِ»",
            "chunk_type": "body",
            "word_end": 71,
            "word_start": 57
          },
          {
            "arabic_text": "قَالَ: «وَكَانَ لَا يَرَى أَنْ يُعْفَى، عَنْ شَيْءٍ مِنَ الْحُدُودِ».",
            "chunk_type": "closing",
            "word_end": 81,
            "word_start": 71
