      "translations": {
        "en.bab-ul-qaim-publications": [
          "Hadith.5852 - Ibn Abi Umayr narrated from Mu'awiyah ibn Wahb, from Abu Abdullah Imam Jafar ibn Muhammad Al-Sadiq (as), peace be upon him, who said:\n\"Be patient with those who are envious of your blessings, for you cannot repay one who disobeys Allah (swt) regarding you with anything better than obeying Allah (swt) concerning him.\""
        ]
      }
