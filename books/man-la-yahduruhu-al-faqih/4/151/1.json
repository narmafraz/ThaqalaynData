      ],
      "translations": {
        "en.bab-ul-qaim-publications": [
          "Hadith.5656 - Ibn Mahbub narrated from Abdur Rahman who said: I asked Abu Abdullah (as) about a group of people who drown in a ship or a house collapses on them, causing their death, and it is not known who among them died first.\nImam (as) said: \"They inherit from one another.\""
        ]
      }
