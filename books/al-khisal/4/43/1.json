        "chunks": [
          {
            "arabic_text": "حَدَّثَنَا مُحَمَّدُ بْنُ عَلِيٍّ مَاجِيلُويْهَ رَضِيَ اللَّهُ عَنْهُ، عَنْ عَمِّهِ مُحَمَّدِ بْنِ أَبِي الْقَاسِمِ، عَنْ أَحْمَدَ بْنِ أَبِي عَبْدِ اللَّهِ، عَنْ عَلِيِّ بْنِ مُحَمَّدٍ، عَنْ أَبِي أَيُّوبَ الْمَدَنِيِّ، عَنْ سُلَيْمَانَ بْنِ جَعْفَرٍ الْجَعْفَرِيِّ، عَنِ الرِّضَا، عَنْ آبَائِهِ، عَنْ عَلِيٍّ عَلَيْهِمُ السَّلَامُ قَالَ",
            "chunk_type": "isnad",
            "word_end": 42,
            "word_start": 0
