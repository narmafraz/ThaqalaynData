        "chunks": [
          {
            "arabic_text": "حَدَّثَنَا مُحَمَّدُ بْنُ عَلِيٍّ مَجِيلَوَيْهِ رَضِيَ اللَّهُ عَنْهُ، عَنْ عَمِّهِ مُحَمَّدِ بْنِ أَبِي الْقَاسِمِ عَنْ أَحْمَدَ بْنِ أَبِي عَبْدِ اللَّهِ الْبَرْقِيِّ، عَنْ أَبِيهِ، عَنْ عَبْدِ اللَّهِ بْنِ الْمُغِيرَةِ، عَنْ أَبِي الصَّبَاحِ الْكِنَانِيِّ، عَنْ أَبِي بَصِيرٍ، عَنْ أَبِي جَعْفَرٍ عَلَيْهِ السَّلَامُ قَالَ",
            "chunk_type": "isnad",
            "word_end": 41,
            "word_start": 0
          },
          {
            "arabic_text": "ثَلَاثٌ مِنْ أَشَدِّ مَا عَمِلَ الْعِبَادُ: أَنْصَافُ الْمُؤْمِنِ مِنْ نَفْسِهِ، وَمَوَاسَاةُ الْمَرْءِ أَخَاهُ، وَذِكْرُ اللَّهِ عَلَى كُلِّ حَالٍ",
            "chunk_type": "body",
            "word_end": 59,
            "word_start": 41
          },
          {
            "arabic_text": "وَهُوَ أَنْ يَذْكُرَ اللَّهُ عَزَّ وَجَلَّ عِنْدَ الْمَعْصِيَةِ يَهْمُ بِهَا فِيَحُولُ ذِكْرُ اللَّهِ بَيْنَهُ وَبَيْنَ تِلْكَ الْمَعْصِيَةِ",
            "chunk_type": "body",
            "word_end": 76,
            "word_start": 59
          },
          {
            "arabic_text": "إِنَّ الَّذِينَ اتَّقَوْا إِذَا مَسَّهُمْ طَائِفٌ مِنَ الشَّيْطَانِ تَذَكَّرُوا فَإِذَا هُمْ مُبْصِرُونَ",
            "chunk_type": "quran_quote",
