      "translations": {
        "en.dr-ali-peiravi": [
          "3-49 Ahmad ibn Muhammad ibn Yahya al-Attar - may God be pleased with him - narrated that his father Muhammad ibn Yahya quoted Muhammad ibn Ahmad, on the authority of Yaqoob ibn Yazid, on the authority of some companions who linked up the tradition to the Prophet (MGB) having said, “The right of an ill traveler upon his travel companions is to stay with him for three days. ”"
        ]
      }
