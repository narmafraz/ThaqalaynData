        "chunks": [
          {
            "arabic_text": "حَدَّثَنَا جَعْفَرُ بْنُ عَلِيٍّ بْنِ الْحُسَيْنِ بْنِ عَلِيٍّ بْنِ عَبْدِ اللَّهِ بْنِ الْمُغِيرَةِ الْكُوفِيُّ رَضِيَ اللَّهُ عَنْهُ، عَنْ جَدِّهِ الْحَسَنِ بْنِ عَلِيٍّ، عَنْ جَدِّهِ، عَنْ جَدِّهِ عَبْدِ اللَّهِ بْنِ الْمُغِيرَةِ، عَنْ إِسْمَاعِيلَ بْنِ أَبِي زِيَادٍ (السَّكُونِيُّ)، عَنْ جَعْفَرِ بْنِ مُحَمَّدٍ، عَنْ أَبِيهِ، عَنْ آبَائِهِ، عَنْ عَلِيٍّ عَلَيْهِمُ السَّلَامُ قَالَ",
            "chunk_type": "isnad",
            "word_end": 49,
            "word_start": 0
          },
          {
            "arabic_text": "قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَآلِهِ: النِّسَاءُ أَرْبَعٌ: جَامِعٌ مُجَمَّعٌ، وَرَبِيعٌ مُرَبَّعٌ، وَكَرْبٌ مُقْمَعٌ، وَغَلٌّ قَمَلٌ.",
            "chunk_type": "body",
            "word_end": 66,
            "word_start": 49
          },
          {
            "arabic_text": "قَالَ مُصَنِّفُ هَذَا الْكِتَابِ رَضِيَ اللَّهُ عَنْهُ: جَامِعٌ مُجَمَّعٌ أَيُ كَثِيرُ الْخَيْرِ مُخْصَبَةٌ، وَرَبِيعٌ مُرَبَّعٌ الَّتِي فِي حِجْرِهَا وَلَدٌ وَفِي بَطْنِهَا آخَرُ، وَكَرْبٌ مُقْمَعٌ أَيُ سَيِّئَةُ الْخُلُقِ مَعَ زَوْجِهَا، وَغَلٌّ قَمَلٌ أَيُ هِيَ عِنْدَ زَوْجِهَا كَالْغَلِّ الْقَمَلِ، وَهُوَ غَلٌّ مِنْ جِلْدٍ يَقَعُ فِيهِ الْقَمَلُ فِي أَكْلِهِ فَلَا يَتَهَيَّأُ أَنْ يُحَلَّ (مِنْهُ شَيْءٌ، وَهُوَ مَثَلٌ لِلْعَرَبِ).",
            "chunk_type": "closing",
            "word_end": 121,
