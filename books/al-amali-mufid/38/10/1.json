        "key_phrases": [
          {
            "category": "well_known_saying",
            "phrase_ar": "أَرَى أُمَيَّةَ مَعْذُورِينَ إِنْ قَتَلُوا وَلَا أَرَى لِبَنِي الْعَبَّاسِ مِنْ عُذْرٍ",
            "phrase_en": "I find the Umayyads excused if they killed, but I find no excuse for the sons of al-Abbas"
          },
          {
            "category": "well_known_saying",
            "phrase_ar": "أَرْبِعْ بِطُوسٍ عَلَى قَبْرِ الزَّكِيَّ",
            "phrase_en": "Pause at Tus upon the grave of the pure one"
          },
          {
            "category": "well_known_saying",
            "phrase_ar": "هَيْهَاتَ كُلُّ امْرِئٍ رَهْنٌ بِمَا كَسَبَتْ لَهُ يَدَاهُ",
            "phrase_en": "Alas! Every person is mortgaged by what his two hands earned"
          }
