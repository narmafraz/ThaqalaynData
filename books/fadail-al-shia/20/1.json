          },
          {
            "arabic_text": "قُلْتُ: فَإِنِّي مَعَهُ يَوْمًا فِي الطَّوَافِ إِذْ قَالَ لِي: يَا مَيْسَرُ الْيَوْمَ أُذِنَ لِي فِي جَوَابِكَ عَنْ مَسْأَلَتِكَ كَذَا.",
            "chunk_type": "body",
            "word_end": 65,
            "word_start": 46
          },
          {
            "arabic_text": "قُلْتُ: فَأَيْنَ هُوَ مِنَ الْقُرْآنِ؟",
            "chunk_type": "body",
            "word_end": 70,
            "word_start": 65
          },
          {
            "arabic_text": "فَقَالَ: فِي سُورَةِ \"الرَّحْمَنِ\" وَهُوَ قَوْلُ اللَّهِ عَزَّ وَجَلَّ: (فَيَوْمَئِذٍ لَا يُسْأَلُ عَنْ ذَنْبِهِ ـ مِنْكُمْ ـ إِنْسٌ وَلَا جَانٌّ).",
            "chunk_type": "body",
            "word_end": 90,
            "word_start": 70
          },
          {
            "arabic_text": "قُلْتُ لَهُ: لَيْسَ فِيهَا \"مِنْكُمْ\"!",
            "chunk_type": "body",
            "word_end": 95,
