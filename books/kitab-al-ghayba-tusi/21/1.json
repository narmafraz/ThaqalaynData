            "chunk_type": "body",
            "word_end": 48,
            "word_start": 37
          },
          {
            "arabic_text": "فَمَنْ أَحْوَجَهُ إِلَى الِاسْتِتَارِ أَتَى مِنْ قِبَلِ نَفْسِهِ فِي فُوتِ مَا يَفُوتُهُ مِنَ الشَّرِيعَةِ",
            "chunk_type": "body",
            "word_end": 62,
            "word_start": 48
