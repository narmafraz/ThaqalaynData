            "arabic_text": "غَيْرَ أَنَّ هَذَا وَإِنْ كَانَ عَلَى مَا قُلْنَاهُ",
            "chunk_type": "opening",
            "word_end": 8,
            "word_start": 0
          },
          {
            "arabic_text": "فَالْحَاجَةُ إِلَى الْإِمَامِ قَدْ بَيَّنَا ثُبُوتَهَا لِأَنَّ جِهَةَ الْحَاجَةِ إِلَيْهِ الْمُسْتَمِرَّةُ فِي كُلِّ حَالٍ وَزَمَانٍ كَوْنُهُ لُطْفًا لَنَا عَلَى مَا تَقَدَّمَ الْقَوْلُ فِيهِ وَلَا يَقُومُ غَيْرُهُ مَقَامَهُ",
            "chunk_type": "body",
            "word_end": 35,
            "word_start": 8
          },
          {
            "arabic_text": "فَالْحَاجَةُ الْمُتَعَلِّقَةُ بِالسَّمْعِ أَيْضًا ظَاهِرَةٌ",
            "chunk_type": "body",
            "word_end": 40,
            "word_start": 35
          },
          {
            "arabic_text": "لِأَنَّ النَّقْلَ وَإِنْ كَانَ وَارِدًا عَنِ الرَّسُولِ صَلَّى اللَّهُ عَلَيْهِ وَآلِهِ وَسَلَّمَ وَعَنْ آبَاءِ الْإِمَامِ عَلَيْهِمُ السَّلَامُ بِجَمِيعِ مَا يَحْتَاجُ إِلَيْهِ فِي الشَّرِيعَةِ",
            "chunk_type": "body",
            "word_end": 63,
            "word_start": 40
          },
          {
            "arabic_text": "فَجَائِزٌ عَلَى النَّاقِلِينَ الْعَدُولُ عَنْهُ إِمَّا تَعَمُّدًا وَإِمَّا لَشُبْهَةٍ",
            "chunk_type": "body",
            "word_end": 72,
            "word_start": 63
