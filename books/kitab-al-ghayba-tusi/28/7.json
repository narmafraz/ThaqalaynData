        "chunks": [
          {
            "arabic_text": "مُحَمَّدُ بْنُ إِسْحَاقَ الْمَقْرِيُّ، عَنِ الْمَقَانِعِيِّ، عَنْ بَكَّارِ بْنِ أَحْمَدَ، عَنِ الْحَسَنِ بْنِ الْحُسَيْنِ، عَنِ الْمَعْلَى بْنِ زِيَادٍ، عَنِ الْعَلَاءِ بْنِ بَشِيرٍ الْمُرَادِيِّ، عَنْ أَبِي الصِّدِّيقِ النَّاجِيِّ، عَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ، قَالَ",
            "chunk_type": "isnad",
            "word_end": 32,
            "word_start": 0
          },
          {
            "arabic_text": "قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهِ عَلَيْهِ وَآلِهِ وَسَلَّمَ: أَبْشِرُوا بِالْمَهْدِي؛ يَبْعَثُ فِي أُمَّتِي عَلَى اخْتِلَافٍ مِنَ النَّاسِ وَزَلْزَالٍ. يَمْلَأُ الْأَرْضَ عَدْلًا وَقِسْطًا كَمَا مَلَأَتْ جُورًا وَظُلْمًا. يَرْضَى عَنْهُ سَاكِنُ السَّمَاءِ وَسَاكِنُ الْأَرْضِ.",
            "chunk_type": "body",
