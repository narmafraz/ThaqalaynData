          {
            "arabic_text": "قُلْنَا: الْحُدُودُ الْمُسْتَحَقَّةُ بَاقِيَةٌ فِي جُنُوبِ مُسْتَحِقِّيهَا،",
            "chunk_type": "opening",
            "word_end": 7,
            "word_start": 0
          },
          {
            "arabic_text": "فَإِنْ ظَهَرَ الْإِمَامُ وَمُسْتَحِقُّوهَا بَاقُونَ أَقَامَهَا عَلَيْهِمْ بِالْبَيِّنَةِ أَوِ الْإِقْرَارِ،",
            "chunk_type": "body",
            "word_end": 17,
            "word_start": 7
          },
          {
            "arabic_text": "وَإِنْ كَانَ فَاتَ ذَلِكَ بِمَوْتِهِ كَانَ الْإِثْمُ فِي تَفْوِيتِهَا عَلَى مَنْ أَخَافَ الْإِمَامَ وَأَلْجَأَهُ إِلَى الْغَيْبَةِ.",
            "chunk_type": "body",
            "word_end": 33,
            "word_start": 17
          },
          {
            "arabic_text": "وَلَيْسَ هَذَا نَسْخًا لإِقَامَةِ الْحُدُودِ،",
            "chunk_type": "body",
            "word_end": 38,
            "word_start": 33
          },
          {
            "arabic_text": "لِأَنَّ الْحَدَّ إِنَّمَا يَجِبُ إِقَامَتُهُ مَعَ التَّمَكُّنِ وَزَوَالِ الْمَنْعِ وَيَسْقُطُ مَعَ الْحِيلُولَةِ،",
            "chunk_type": "body",
            "word_end": 50,
            "word_start": 38
          },
          {
            "arabic_text": "وَلَا يَكُونُ ذَلِكَ نَسْخًا لَوْ سَقَطَ إِقَامَتُهَا مَعَ الْإِمكَانِ وَزَوَالِ الْمَوَانِعِ.",
