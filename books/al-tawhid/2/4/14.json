            "word_end": 80,
            "word_start": 55
          },
          {
            "arabic_text": "وَإِذَا سَأَلُوكَ عَنِ الْكَيْفِيَّةِ فَقُلْ كَمَا قَالَ اللَّهُ عَزَّ وَجَلَّ: (لَيْسَ كَمِثْلِهِ شَيْءٌ)",
            "chunk_type": "body",
            "word_end": 93,
            "word_start": 80
