        "chunks": [
          {
            "arabic_text": "حَدَّثَنَا مُحَمَّدُ بْنُ الْحَسَنِ بْنِ أَحْمَدَ الْوَلِيدِ رَضِيَ اللَّهُ عَنْهُ، قَالَ: حَدَّثَنَا مُحَمَّدُ بْنُ الْحَسَنِ الصَّفَّارُ، عَنْ أَحْمَدَ بْنِ مُحَمَّدِ بْنِ عِيسَى، عَنْ عَلِيِّ بْنِ سَيْفِ بْنِ عُمَيْرَةَ، عَنْ مُحَمَّدِ بْنِ عُبَيْدٍ، قَالَ: دَخَلْتُ عَلَى الرِّضَا عَلَيْهِ السَّلَامُ",
            "chunk_type": "isnad",
            "word_end": 38,
            "word_start": 0
          },
          {
            "arabic_text": "فَقَالَ لِي: قُلْ لِلْعَبَّاسِيِّ: يَكُفُّ عَنِ الْكَلَامِ فِي التَّوْحِيدِ وَغَيْرِهِ، وَيُكَلِّمُ النَّاسَ بِمَا يَعْرِفُونَ، وَيَكُفُّ عَمَّا يُنْكِرُونَ،",
            "chunk_type": "body",
            "word_end": 55,
            "word_start": 38
          },
          {
            "arabic_text": "وَإِذَا سَأَلُوكَ عَنِ التَّوْحِيدِ فَقُلْ كَمَا قَالَ اللَّهُ عَزَّ وَجَلَّ: (قُلْ هُوَ اللَّهُ أَحَدٌ اللَّهُ الصَّمَدُ لَمْ يَلِدْ وَلَمْ يُولَدْ وَلَمْ يَكُنْ لَهُ كُفُوًا أَحَدٌ)",
