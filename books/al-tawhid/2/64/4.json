        "chunks": [
          {
            "arabic_text": "حَدَّثَنَا مُحَمَّدُ بْنُ عَلِيٍّ مَاجِيلَوَيْهَ رَحِمَهُ اللَّهُ، عَن عَمِّهِ مُحَمَّدِ بْنِ أَبِي الْقَاسِمِ، عَن أَحْمَدَ بْنِ أَبِي عَبْدِ اللَّهِ، عَنِ ابْنِ فَضَالٍ، عَن ثَعْلَبَةَ بْنِ مَيْمُونَ، عَن حَمَّزَةَ بْنِ الطَّيَّارِ، عَن أَبِي عَبْدِ اللَّهِ عَلَيْهِ السَّلَامُ",
            "chunk_type": "isnad",
            "word_end": 36,
            "word_start": 0
          },
          {
            "arabic_text": "فِي قَوْلِهِ تَعَالَى: ﴿وَمَا كَانَ اللَّهُ لِيُضِلَّ قَوْمًا بَعْدَ إِذْ هَدَاهُمْ حَتَّىٰ يُبَيِّنَ لَهُمْ مَا يَتَّقُونَ﴾ قَالَ: حَتَّىٰ يَعْرِفَهُمْ مَا يُرْضِيهِ وَمَا يُسْخِطُهُ",
            "chunk_type": "body",
            "word_end": 59,
            "word_start": 36
          },
          {
            "arabic_text": "وَقَالَ: ﴿فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَاهَا﴾ قَالَ: بَيَّنَ لَهَا مَا تَأْتِي وَمَا تَدَعُ",
            "chunk_type": "body",
            "word_end": 70,
            "word_start": 59
          },
          {
            "arabic_text": "وَقَالَ: ﴿إِنَّا هَدَيْنَاهُ السَّبِيلَ إِمَّا شَاكِرًا وَإِمَّا كَفُورًا﴾ قَالَ: عَرَّفْنَاهُ إِمَّا آخِذًا وَإِمَّا تَارِكًا",
            "chunk_type": "body",
            "word_end": 84,
            "word_start": 70
          },
          {
            "arabic_text": "وَفِي قَوْلِهِ عَزَّ وَجَلَّ: ﴿وَأَمَّا ثَمُودُ فَهَدَيْنَاهُمْ فَاسْتَحَبُّوا الْعَمَىٰ عَلَى الْهُدَىٰ﴾ قَالَ: عَرَفْنَاهُمْ فَاسْتَحَبُّوا الْعَمَىٰ عَلَى الْهُدَىٰ وَهُمْ يَعْرِفُونَ",
            "chunk_type": "body",
            "word_end": 103,
            "word_start": 84
          }
