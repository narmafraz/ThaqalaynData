        "chunks": [
          {
            "arabic_text": "حَدَّثَنَا جَعْفَرُ بْنُ مُحَمَّدِ بْنِ مَسْرُورٍ رَحِمَهُ اللَّهُ قَالَ : حَدَّثَنَا الْحُسَيْنُ بْنُ مُحَمَّدِ بْنِ عَامِرٍ ، عَن مَعْلَى بْنِ مُحَمَّدٍ الْبَصْرِيِّ ، عَنِ الْحَسَنِ بْنِ عَلِيٍّ الْوَشَّاءِ ، عَن أَبِي الْحَسَنِ الرِّضَا عَلَيْهِ السَّلَامِ ، قَالَ",
            "chunk_type": "isnad",
            "word_end": 37,
            "word_start": 0
          },
          {
            "arabic_text": "سَأَلْتُهُ فَقُلْتُ لَهُ : اللَّهُ فَوَّضَ الْأَمْرَ إِلَى الْعِبَادِ ؟ قَالَ : اللَّهُ أَعَزُّ مِنْ ذَلِكَ ، قُلْتُ : فَأَجْبَرَهُمْ عَلَى الْمَعَاصِي ؟ قَالَ : اللَّهُ أَعْدَلُ وَأَحْكَمُ مِنْ ذَلِكَ ،",
            "chunk_type": "body",
            "word_end": 68,
            "word_start": 37
          },
          {
            "arabic_text": "ثُمَّ قَالَ : قَالَ اللَّهُ عَزَّ وَجَلَّ : يَا ابْنَ آدَمَ أَنَا أَوْلَى بِحَسَنَاتِكَ مِنْكَ ، وَأَنْتَ أَوْلَى بِسَيِّئَاتِكَ مِنِّي ، عَمِلْتَ الْمَعَاصِي بِقُوَّتِي الَّتِي جَعَلْتُهَا فِيكَ",
