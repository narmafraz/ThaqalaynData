            "chunk_type": "isnad",
            "word_end": 24,
            "word_start": 0
          },
          {
            "arabic_text": "قُلْتُ لِأَبِي عَبْدِ اللَّهِ (عَلَيْهِ السَّلَامُ) إِنِّي رَجُلٌ مِنَ الْعَرَبِ وَ لِيَ بِالطِّبِّ بَصَرٌ وَ طِبِّي طِبٌّ عَرَبِيٌّ وَ لَسْتُ آخُذُ عَلَيْهِ صَفَدًا فَقَالَ لَا بَأْسَ",
            "chunk_type": "body",
            "word_end": 50,
            "word_start": 24
          },
          {
            "arabic_text": "قُلْتُ إِنَّا نَبُطُّ الْجُرْحَ وَ نَكْوِي بِالنَّارِ قَالَ لَا بَأْسَ",
            "chunk_type": "body",
            "word_end": 60,
            "word_start": 50
          },
          {
            "arabic_text": "قُلْتُ وَ نَسْقِي هَذِهِ السُّمُومَ الْأَسْمَحِيقُونَ وَ الْغَارِيقُونَ قَالَ لَا بَأْسَ",
            "chunk_type": "body",
            "word_end": 71,
            "word_start": 60
          },
          {
            "arabic_text": "قُلْتُ إِنَّهُ رُبَّمَا مَاتَ قَالَ وَ إِنْ مَاتَ",
            "chunk_type": "body",
            "word_end": 79,
            "word_start": 71
          },
          {
            "arabic_text": "قُلْتُ نَسْقِي عَلَيْهِ النَّبِيذَ قَالَ لَيْسَ فِي حَرَامٍ شِفَاءٌ",
