            "word_end": 40,
            "word_start": 12
          },
          {
            "arabic_text": "قُلْتُ كَيْفَ عَلِمَ قَالَ إِنَّهُ دَعَا فِي السَّحَرِ وَ سَأَلَ اللَّهَ عَزَّ وَ جَلَّ أَنْ يَهْبِطَ عَلَيْهِ مَلَكُ الْمَوْتِ فَهَبَطَ عَلَيْهِ بُرَيْزَاءُ وَ هُوَ مَلَكُ الْمَوْتِ",
            "chunk_type": "body",
            "word_end": 66,
            "word_start": 40
          },
          {
            "arabic_text": "فَقَالَ لَهُ بُرَيْزَاءُ مَا حَاجَتُكَ يَا يَعْقُوبُ قَالَ أَخْبِرْنِي عَنِ الْأَرْوَاحِ تَقْبِضُهَا مُجْتَمِعَةً أَوْ مُتَفَرِّقَةً قَالَ بَلْ أَقْبِضُهَا مَُتَفَرِّقَةً رُوحاً رُوحاً",
            "chunk_type": "body",
            "word_end": 87,
            "word_start": 66
          },
          {
            "arabic_text": "قَالَ لَهُ فَأَخْبِرْنِي هَلْ مَرَّ بِكَ رُوحُ يُوسُفَ فِيمَا مَرَّ بِكَ قَالَ لَا",
            "chunk_type": "body",
            "word_end": 100,
            "word_start": 87
          },
          {
            "arabic_text": "فَعَلِمَ يَعْقُوبُ أَنَّهُ حَيٌّ فَعِنْدَ ذَلِكَ قَالَ لِوُلْدِهِ اذْهَبُوا فَتَحَسَّسُوا مِنْ يُوسُفَ وَ أَخِيهِ",
