          {
            "arabic_text": "أَبُو عَلِيٍّ الْأَشْعَرِيُّ عَنْ مُحَمَّدِ بْنِ عَبْدِ الْجَبَّارِ عَنْ صَفْوَانَ بْنِ يَحْيَى عَنِ ابْنِ مُسْكَانَ عَنْ أَبِي بَصِيرٍ عَنْ أَحَدِهِمَا (عَلَيْهِمَا السَّلَامُ) قَالَ",
            "chunk_type": "isnad",
            "word_end": 23,
            "word_start": 0
          },
          {
            "arabic_text": "سَأَلْتُهُ عَنْ قَوْلِ اللَّهِ عَزَّ وَ جَلَّ: ﴿وَمَنْ أَظْلَمُ مِمَّنِ افْتَرَىٰ عَلَى اللَّهِ كَذِبًا أَوْ قَالَ أُوحِيَ إِلَيَّ وَلَمْ يُوحَ إِلَيْهِ شَيْءٌ﴾",
            "chunk_type": "body",
            "word_end": 45,
            "word_start": 23
          },
          {
            "arabic_text": "قَالَ: نَزَلَتْ فِي ابْنِ أَبِي سَرْحٍ، الَّذِي كَانَ عُثْمَانُ اسْتَعْمَلَهُ عَلَى مِصْرَ، وَهُوَ مِمَّنْ كَانَ رَسُولُ اللَّهِ (صَلَّى اللَّهِ عَلَيْهِ وَآلِهِ) يَوْمَ فَتْحِ مَكَّةَ هَدَرَ دَمَهُ، وَكَانَ يَكْتُبُ لِرَسُولِ اللَّهِ (صَلَّى اللَّهِ عَلَيْهِ وَآلِهِ).",
            "chunk_type": "body",
            "word_end": 79,
            "word_start": 45
          },
          {
            "arabic_text": "فَإِذَا أَنْزَلَ اللَّهُ عَزَّ وَ جَلَّ: ﴿إِنَّ اللَّهَ عَزِيزٌ حَكِيمٌ﴾، كَتَبَ: ﴿إِنَّ اللَّهَ عَلِيمٌ حَكِيمٌ﴾، فَيَقُولُ لَهُ رَسُولُ اللَّهِ (صَلَّى اللَّهِ عَلَيْهِ وَآلِهِ): دَعْهَا، فَإِنَّ اللَّهَ عَلِيمٌ حَكِيمٌ.",
            "chunk_type": "body",
            "word_end": 107,
            "word_start": 79
          },
          {
            "arabic_text": "وَكَانَ ابْنُ أَبِي سَرْحٍ يَقُولُ لِلْمُنَافِقِينَ: إِنِّي لَأَقُولُ مِنْ نَفْسِي مِثْلَ مَا يَجِيءُ بِهِ، فَمَا يُغَيِّرُ عَلَيَّ.",
            "chunk_type": "body",
            "word_end": 124,
            "word_start": 107
          },
          {
            "arabic_text": "فَأَنْزَلَ اللَّهُ تَبَارَكَ وَ تَعَالَى فِيهِ الَّذِي أَنْزَلَ.",
            "chunk_type": "closing",
            "word_end": 132,
            "word_start": 124
          }
