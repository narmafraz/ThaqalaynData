            "word_end": 74,
            "word_start": 53
          },
          {
            "arabic_text": "فَأُولَئِكَ الَّذِينَ يَجْعَلُ اللَّهُ عَزَّ ذِكْرُهُ لَهُمْ مَخْرَجاً وَ يَرْزُقُهُمْ مِنْ حَيْثُ لَا يَحْتَسِبُونَ",
            "chunk_type": "body",
            "word_end": 88,
            "word_start": 74
          },
          {
            "arabic_text": "وَ فِي قَوْلِ اللَّهِ عَزَّ وَ جَلَّ هَلْ أَتاكَ حَدِيثُ الْغاشِيَةِ قَالَ الَّذِينَ يَغْشَوْنَ الْإِمَامَ",
            "chunk_type": "body",
            "word_end": 103,
            "word_start": 88
          },
          {
            "arabic_text": "إِلَى قَوْلِهِ عَزَّ وَ جَلَّ لَا يُسْمِنُ وَ لَا يُغْنِي مِنْ جُوعٍ",
            "chunk_type": "body",
            "word_end": 115,
