        "chunks": [
          {
            "arabic_text": "عِدَّةٌ مِنْ أَصْحَابِنَا عَنْ سَهْلِ بْنِ زِيَادٍ عَنْ مُحَمَّدِ بْنِ الْحَسَنِ بْنِ شَمُّونٍ عَنْ عَبْدِ اللَّهِ بْنِ عَبْدِ الرَّحْمَنِ الْأَصَمِّ عَنْ عَبْدِ اللَّهِ بْنِ الْقَاسِمِ الْبَطَلِ عَنْ أَبِي عَبْدِ اللَّهِ (عَلَيْهِ السَّلَامُ)",
            "chunk_type": "isnad",
            "word_end": 32,
            "word_start": 0
          },
          {
            "arabic_text": "فِي قَوْلِهِ تَعَالَى وَ قَضَيْنَا إِلَى بَنِي إِسْرَائِيلَ فِي الْكِتَابِ لَتُفْسِدُنَّ فِي الْأَرْضِ مَرَّتَيْنِ",
            "chunk_type": "body",
            "word_end": 46,
            "word_start": 32
          },
          {
            "arabic_text": "قَالَ قَتْلُ عَلِيِّ بْنِ أَبِي طَالِبٍ (عَلَيْهِ السَّلَامُ) وَ طَعْنُ الْحَسَنِ (عَلَيْهِ السَّلَامُ)",
            "chunk_type": "body",
            "word_end": 59,
            "word_start": 46
          },
          {
            "arabic_text": "وَلَتَعْلُنَّ عُلُوًّا كَبِيرًا",
            "chunk_type": "body",
            "word_end": 62,
            "word_start": 59
          },
          {
            "arabic_text": "قَالَ قَتْلُ الْحُسَيْنِ (عَلَيْهِ السَّلَامُ)",
            "chunk_type": "body",
            "word_end": 67,
            "word_start": 62
          },
          {
            "arabic_text": "فَإِذَا جَاءَ وَعْدُ أُولَاهُمَا فَإِذَا جَاءَ نَصْرُ دَمِ الْحُسَيْنِ (عَلَيْهِ السَّلَامُ)",
            "chunk_type": "body",
            "word_end": 78,
            "word_start": 67
          },
          {
            "arabic_text": "بَعَثْنَا عَلَيْكُمْ عِبَادًا لَنَا أُولِي بَأْسٍ شَدِيدٍ فَجَاسُوا خِلَالَ الدِّيَارِ",
            "chunk_type": "body",
            "word_end": 88,
            "word_start": 78
          },
          {
            "arabic_text": "قَوْمٌ يَبْعَثُهُمُ اللَّهُ قَبْلَ خُرُوجِ الْقَائِمِ (عَلَيْهِ السَّلَامُ)",
            "chunk_type": "body",
            "word_end": 96,
            "word_start": 88
          },
          {
            "arabic_text": "فَلَا يَدَعُونَ وَتْرًا لآلِ مُحَمَّدٍ إِلَّا قَتَلُوهُ",
            "chunk_type": "body",
            "word_end": 103,
            "word_start": 96
          },
          {
            "arabic_text": "وَكَانَ وَعْدًا مَفْعُولًا",
            "chunk_type": "body",
            "word_end": 106,
            "word_start": 103
          },
          {
            "arabic_text": "خُرُوجُ الْقَائِمِ (عَلَيْهِ السَّلَامُ)",
            "chunk_type": "body",
            "word_end": 110,
            "word_start": 106
          },
          {
            "arabic_text": "ثُمَّ رَدَدْنَا لَكُمُ الْكَرَّةَ عَلَيْهِمْ",
            "chunk_type": "body",
            "word_end": 115,
            "word_start": 110
          },
          {
            "arabic_text": "خُرُوجُ الْحُسَيْنِ (عَلَيْهِ السَّلَامُ) فِي سَبْعِينَ مِنْ أَصْحَابِهِ",
            "chunk_type": "body",
            "word_end": 123,
            "word_start": 115
          },
          {
            "arabic_text": "عَلَيْهِمُ الْبَيْضُ الْمُذَهَّبُ لِكُلِّ بَيْضَةٍ وَجْهَانِ",
            "chunk_type": "body",
            "word_end": 129,
            "word_start": 123
          },
          {
            "arabic_text": "لِلْمُؤَدَّدِينَ إِلَى النَّاسِ أَنَّ هَذَا الْحُسَيْنَ قَدْ خَرَجَ",
            "chunk_type": "body",
            "word_end": 137,
            "word_start": 129
          },
          {
            "arabic_text": "حَتَّى لَا يَشُكَّ الْمُؤْمِنُونَ فِيهِ",
            "chunk_type": "body",
            "word_end": 142,
            "word_start": 137
          },
          {
            "arabic_text": "وَأَنَّهُ لَيْسَ بِدَجَّالٍ وَلَا شَيْطَانٍ",
            "chunk_type": "body",
            "word_end": 147,
            "word_start": 142
          },
          {
            "arabic_text": "وَالْحُجَّةُ الْقَائِمُ بَيْنَ أَظْهُرِهِمْ",
            "chunk_type": "body",
            "word_end": 151,
            "word_start": 147
          },
          {
            "arabic_text": "فَإِذَا اسْتَقَرَّتِ الْمَعْرِفَةُ فِي قُلُوبِ الْمُؤْمِنِينَ أَنَّهُ الْحُسَيْنُ (عَلَيْهِ السَّلَامُ)",
            "chunk_type": "body",
            "word_end": 161,
            "word_start": 151
          },
          {
            "arabic_text": "جَاءَ الْحُجَّةَ الْمَوْتُ",
            "chunk_type": "body",
            "word_end": 164,
            "word_start": 161
          },
          {
            "arabic_text": "فَيَكُونُ الَّذِي يُغَسِّلُهُ وَيُكَفِّنُهُ وَيُحَنِّطُهُ وَيُلْحِدُهُ فِي حُفْرَتِهِ الْحُسَيْنُ بْنُ عَلِيٍّ (عَلَيْهِ السَّلَامُ)",
            "chunk_type": "body",
            "word_end": 177,
            "word_start": 164
          },
          {
            "arabic_text": "وَلَا يَلِي الْوَصِيَّ إِلَّا الْوَصِيُّ",
            "chunk_type": "closing",
            "word_end": 182,
            "word_start": 177
          }
        ],
