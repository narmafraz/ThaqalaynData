        "chunks": [
          {
            "arabic_text": "ابْنُ مَحْبُوبٍ عَنْ جَمِيلِ بْنِ صَالِحٍ عَنِ الْوَلِيدِ بْنِ صَبِيحٍ عَنْ صَبِيحٍ عَنْ أَبِي عَبْدِ اللَّهِ (عَلَيْهِ السَّلَامُ) قَالَ",
            "chunk_type": "isnad",
            "word_end": 19,
            "word_start": 0
          },
          {
            "arabic_text": "إِنَّ اللَّهَ عَزَّ وَ جَلَّ أَوْحَى إِلَى سُلَيْمَانَ بْنِ دَاوُدَ (عَلَيْهِمَا السَّلَامُ) أَنَّ آيَةَ مَوْتِكَ أَنَّ شَجَرَةً تَخْرُجُ مِنْ بَيْتِ الْمَقْدِسِ يُقَالُ لَهَا الْخُرْنُوبَةُ",
            "chunk_type": "body",
            "word_end": 43,
            "word_start": 19
          },
          {
            "arabic_text": "فَنَظَرَ سُلَيْمَانُ يَوْمَاً فَإِذَا الشَّجَرَةُ الْخُرْنُوبَةُ قَدْ طَلَعَتْ مِنْ بَيْتِ الْمَقْدِسِ فَقَالَ لَهَا مَا اسْمُكِ قَالَتِ الْخُرْنُوبَةُ",
            "chunk_type": "body",
            "word_end": 60,
            "word_start": 43
          },
          {
            "arabic_text": "فَوَلَّى سُلَيْمَانُ مُدْبِراً إِلَى مِحْرَابِهِ فَقَامَ فِيهِ مُتَّكِئاً عَلَى عَصَاهُ فَقُبِضَ رُوحُهُ مِنْ سَاعَتِهِ",
            "chunk_type": "body",
            "word_end": 74,
            "word_start": 60
          },
          {
            "arabic_text": "فَجَعَلَتِ الْجِنُّ وَ الْإِنْسُ يَخْدُمُونَهُ وَ يَسْعَوْنَ فِي أَمْرِهِ كَمَا كَانُوا وَ هُمْ يَظُنُّ أَنَّهُ حَيٌّ لَمْ يَمُتْ يَغْدُونَ وَ يَرُوحُونَ وَ هُوَ قَائِمٌ ثَابِتٌ",
            "chunk_type": "body",
            "word_end": 99,
            "word_start": 74
          },
          {
            "arabic_text": "حَتَّى دَبَّتِ الْأَرَضَةُ مِنْ عَصَاهُ فَأَكَلَتْ مِنْسَأَتَهُ فَانْكَسَرَتْ وَ خَرَّ سُلَيْمَانُ إِلَى الْأَرْضِ",
            "chunk_type": "body",
            "word_end": 112,
            "word_start": 99
          },
          {
            "arabic_text": "أَفَلَا تَسْمَعُ لِقَوْلِهِ عَزَّ وَ جَلَّ فَلَمَّا خَرَّ تَبَيَّنَتِ الْجِنُّ أَنْ لَوْ كانُوا يَعْلَمُونَ الْغَيْبَ مَا لَبِثُوا فِي الْعَذابِ الْمُهِينِ",
