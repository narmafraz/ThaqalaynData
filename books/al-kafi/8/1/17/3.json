        "chunks": [
          {
            "arabic_text": "عَنْهُمْ عَنْ سَهْلِ بْنِ زِيَادٍ عَنِ الْحَسَنِ بْنِ عَلِيِّ بْنِ فَضَّالٍ عَنْ عَلِيِّ بْنِ عُقْبَةَ وَ ثَعْلَبَةَ بْنِ مَيْمُونٍ وَ غَالِبِ بْنِ عُثْمَانَ وَ هَارُونَ بْنِ مُسْلِمٍ عَنْ بُرَيْدِ بْنِ مُعَاوِيَةَ قَالَ",
            "chunk_type": "isnad",
            "word_end": 32,
            "word_start": 0
          },
          {
            "arabic_text": "كُنْتُ عِنْدَ أَبِي جَعْفَرٍ ( عَلَيْهِ السَّلَامُ ) فِي فُسْطَاطٍ لَهُ بِمِنًى فَنَظَرَ إِلَى زِيَادٍ الْأَسْوَدِ مُنْقَلِعَ الرِّجْلِ فَرَثَى لَهُ فَقَالَ لَهُ مَا لِرِجْلَيْكَ هَكَذَا قَالَ جِئْتُ عَلَى بَكْرٍ لِي نِضْوٌ فَكُنْتُ أَمْشِي عَنْهُ عَامَّةَ الطَّرِيقِ",
            "chunk_type": "body",
            "word_end": 68,
            "word_start": 32
          },
          {
            "arabic_text": "فَرَثَى لَهُ وَ قَالَ لَهُ عِنْدَ ذَلِكَ زِيَادٌ إِنِّي أُلِمُّ بِالذُّنُوبِ حَتَّى إِذَا ظَنَنْتُ أَنِّي قَدْ هَلَكْتُ ذَكَرْتُ حُبَّكُمْ فَرَجَوْتُ النَّجَاةَ وَ تَجَلَّى عَنِّي",
            "chunk_type": "body",
            "word_end": 92,
            "word_start": 68
          },
          {
            "arabic_text": "فَقَالَ أَبُو جَعْفَرٍ ( عَلَيْهِ السَّلَامُ ) وَ هَلِ الدِّينُ إِلَّا الْحُبُّ",
            "chunk_type": "body",
            "word_end": 104,
            "word_start": 92
          },
          {
            "arabic_text": "حَبَّبَ إِلَيْكُمُ الْإِيمَانَ وَ زَيَّنَهُ فِي قُلُوبِكُمْ",
            "chunk_type": "quran_quote",
            "word_end": 111,
            "word_start": 104
          },
          {
            "arabic_text": "وَ قَالَ إِنْ كُنْتُمْ تُحِبُّونَ اللَّهَ فَاتَّبِعُونِي يُحْبِبْكُمُ اللَّهُ",
            "chunk_type": "quran_quote",
            "word_end": 120,
            "word_start": 111
          },
          {
            "arabic_text": "وَ قَالَ يُحِبُّونَ مَنْ هَاجَرَ إِلَيْهِمْ",
            "chunk_type": "quran_quote",
            "word_end": 126,
            "word_start": 120
          },
          {
            "arabic_text": "إِنَّ رَجُلًا أَتَى النَّبِيَّ ( صَلَّى اللَّهِ عَلَيْهِ وَآلِهِ ) فَقَالَ يَا رَسُولَ اللَّهِ أُحِبُّ الْمُصَلِّينَ وَ لَا أُصَلِّي وَ أُحِبُّ الصَّوَّامِينَ وَ لَا أَصُومُ فَقَالَ لَهُ رَسُولُ اللَّهِ أَنْتَ مَعَ مَنْ أَحْبَبْتَ وَ لَكَ مَا اكْتَسَبْتَ",
            "chunk_type": "body",
            "word_end": 163,
            "word_start": 126
          },
          {
            "arabic_text": "وَ قَالَ مَا تَبْغُونَ وَ مَا تُرِيدُونَ أَمَا إِنَّهَا لَوْ كَانَ فَزْعَةٌ مِنَ السَّمَاءِ فَزِعَ كُلُّ قَوْمٍ إِلَى مَأْمَنِهِمْ وَ فَزِعْنَا إِلَى نَبِيِّنَا وَ فَزِعْتُمْ إِلَيْنَا",
            "chunk_type": "closing",
            "word_end": 189,
            "word_start": 163
          }
        ],
