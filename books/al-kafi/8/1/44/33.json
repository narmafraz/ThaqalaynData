        "chunks": [
          {
            "arabic_text": "عَلِيُّ بْنُ إِبْرَاهِيمَ عَنْ أَبِيهِ عَنْ أَحْمَدَ بْنِ مُحَمَّدِ بْنِ أَبِي نَصْرٍ عَنْ أَبَانِ بْنِ عُثْمَانَ عَنْ إِسْمَاعِيلَ الْجُعْفِيِّ عَنْ أَبِي جَعْفَرٍ (عَلَيْهِ السَّلَامُ) قَالَ",
            "chunk_type": "isnad",
            "word_end": 25,
            "word_start": 0
          },
          {
            "arabic_text": "كَانَتْ شَرِيعَةُ نُوحٍ (عَلَيْهِ السَّلَامُ) أَنْ يُعْبَدَ اللَّهُ بِالتَّوْحِيدِ وَ الْإِخْلَاصِ وَ خَلْعِ الْأَنْدَادِ وَ هِيَ الْفِطْرَةُ الَّتِي فَطَرَ النَّاسَ عَلَيْهَا",
            "chunk_type": "body",
            "word_end": 46,
            "word_start": 25
          },
          {
            "arabic_text": "وَأَخَذَ اللَّهُ مِيثَاقَهُ عَلَى نُوحٍ (عَلَيْهِ السَّلَامُ) وَعَلَى النَّبِيِّينَ (عَلَيْهِم السَّلَامُ) أَنْ يَعْبُدُوا اللَّهَ تَبَارَكَ وَ تَعَالَى وَلَا يُشْرِكُوا بِهِ شَيْئًا",
            "chunk_type": "body",
            "word_end": 67,
            "word_start": 46
          },
          {
            "arabic_text": "وَأَمَرَ بِالصَّلَاةِ وَالْأَمْرِ بِالْمَعْرُوفِ وَالنَّهْيِ عَنِ الْمُنْكَرِ وَالْحَلَالِ وَالْحَرَامِ",
            "chunk_type": "body",
            "word_end": 76,
            "word_start": 67
          },
          {
            "arabic_text": "وَلَمْ يَفْرِضْ عَلَيْهِ أَحْكَامَ حُدُودٍ وَلَا فَضَلَ مَوَارِيثَ فَهَذِهِ شَرِيعَتُهُ",
            "chunk_type": "body",
            "word_end": 86,
            "word_start": 76
          },
          {
            "arabic_text": "فَلَبِثَ فِيهِمْ نُوحٌ أَلْفَ سَنٍ إِلَّا خَمْسِينَ عَامًا يَدْعُوهُمْ سِرًّا وَعَلَانِيَةً",
            "chunk_type": "body",
            "word_end": 97,
            "word_start": 86
          },
          {
            "arabic_text": "فَلَمَّا أَبَوْا وَعَتَوْا قَالَ رَبَّهُ أَنِّي مَغْلُوبٌ فَانْتَصِرْ",
            "chunk_type": "body",
            "word_end": 105,
            "word_start": 97
          },
          {
            "arabic_text": "فَأَوْحَى اللَّهُ جَلَّ وَعَزَّ إِلَيْهِ أَنَّهُ لَنْ يُؤْمِنَ مِنْ قَوْمِكَ إِلَّا مَنْ قَدْ آمَنَ فَلَا تَبْتَئِسْ بِمَا كَانُوا يَفْعَلُونَ [يَعْمَلُونَ]",
            "chunk_type": "body",
            "word_end": 125,
            "word_start": 105
          },
          {
            "arabic_text": "فَلِذَلِكَ قَالَ نُوحٌ (عَلَيْهِ السَّلَامُ) وَلَا يَلِدُوا إِلَّا فَاجِرًا كَفَّارًا",
            "chunk_type": "body",
            "word_end": 135,
            "word_start": 125
          },
          {
            "arabic_text": "فَأَوْحَى اللَّهُ عَزَّ وَ جَلَّ إِلَيْهِ أَنِ اصْنَعِ الْفُلْكَ",
            "chunk_type": "body",
            "word_end": 144,
            "word_start": 135
          }
        ],
