        "chunks": [
          {
            "arabic_text": "عِدَّةٌ مِنْ أَصْحَابِنَا عَنْ أَحْمَدَ بْنِ مُحَمَّدِ بْنِ عِيسَى عَنْ عَلِيِّ بْنِ الْحَكَمِ عَنْ أَبِي الْمَغْرَاءِ عَنْ زَيْدٍ الشَّحَّامِ عَنْ عَمْرِو بْنِ سَعِيدِ بْنِ هِلَالٍ قَالَ",
            "chunk_type": "isnad",
            "word_end": 26,
            "word_start": 0
          },
          {
            "arabic_text": "قُلْتُ لِأَبِي عَبْدِ اللَّهِ (عَلَيْهِ السَّلَامُ) إِنِّي لَا أَكَادُ أَلْقَاكَ إِلَّا فِي السِّنِينَ فَأَوْصِنِي بِشَيْ‏ءٍ آخُذُ بِهِ",
            "chunk_type": "opening",
            "word_end": 43,
            "word_start": 26
          },
          {
            "arabic_text": "قَالَ أُوصِيكَ بِتَقْوَى اللَّهِ وَ صِدْقِ الْحَدِيثِ وَ الْوَرَعِ وَ الِاجْتِهَادِ وَ اعْلَمْ أَنَّهُ لَا يَنْفَعُ اجْتِهَادٌ لَا وَرَعَ مَعَهُ",
            "chunk_type": "body",
            "word_end": 63,
            "word_start": 43
          },
          {
            "arabic_text": "وَ إِيَّاكَ أَنْ تُطْمِحَ نَفْسَكَ إِلَى مَنْ فَوْقَكَ وَ كَفَى بِمَا قَالَ اللَّهُ عَزَّ وَ جَلَّ لِرَسُولِهِ (صَلَّى اللَّهِ عَلَيْهِ وَآلِهِ) فَلَا تُعْجِبْكَ أَمْوالُهُمْ وَ لَا أَوْلَادُهُمْ",
            "chunk_type": "body",
            "word_end": 90,
            "word_start": 63
          },
          {
            "arabic_text": "وَ لَا تَمُدَّنَّ عَيْنَيْكَ إِلى مَا مَتَّعْنا بِهِ أَزْواجاً مِنْهُمْ زَهْرَةَ الْحَياةِ الدُّنْيا",
            "chunk_type": "quran_quote",
            "word_end": 103,
            "word_start": 90
          },
          {
            "arabic_text": "فَإِنْ خِفْتَ شَيْئاً مِنْ ذَلِكَ فَاذْكُرْ عَيْشَ رَسُولِ اللَّهِ (صَلَّى اللَّهِ عَلَيْهِ وَآلِهِ) فَإِنَّمَا كَانَ قُوتُهُ الشَّعِيرَ وَ حَلْوَاهُ التَّمْرَ وَ وَقُودُهُ السَّعَفَ إِذَا وَجَدَهُ",
            "chunk_type": "body",
            "word_end": 128,
            "word_start": 103
          },
          {
            "arabic_text": "وَ إِذَا أُصِبْتَ بِمُصِيبَةٍ فَاذْكُرْ مُصَابَكَ بِرَسُولِ اللَّهِ (صَلَّى اللَّهِ عَلَيْهِ وَآلِهِ) فَإِنَّ الْخَلْقَ لَمْ يُصَابُوا بِمِثْلِهِ (عَلَيْهِ السَّلَامُ) قَطُّ",
            "chunk_type": "body",
