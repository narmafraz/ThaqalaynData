            "word_start": 0
          },
          {
            "arabic_text": "زَامَلْتُ أَبَا عَبْدِ اللَّهِ (عَلَيْهِ السَّلَامُ) قَالَ فَقَالَ لِيَ اقْرَأْ قَالَ فَافْتَتَحْتُ سُورَةً مِنَ الْقُرْآنِ فَقَرَأْتُهَا فَرَقَّ وَ بَكَى",
            "chunk_type": "body",
            "word_end": 37,
            "word_start": 18
          },
          {
            "arabic_text": "ثُمَّ قَالَ يَا أَبَا أُسَامَةَ ارْعَوْا قُلُوبَكُمْ بِذِكْرِ اللَّهِ عَزَّ وَ جَلَّ وَ احْذَرُوا النَّكْتَ فَإِنَّهُ يَأْتِي عَلَى الْقَلْبِ تَارَاتٌ أَوْ سَاعَاتٌ الشَّكُّ مِنْ صَبَّاحٍ لَيْسَ فِيهِ إِيمَانٌ وَ لَا كُفْرٌ شِبْهَ الْخِرْقَةِ الْبَالِيَةِ أَوِ الْعَظْمِ النَّخِرِ",
            "chunk_type": "body",
            "word_end": 74,
            "word_start": 37
          },
          {
            "arabic_text": "يَا أَبُوا أُسَامَةَ أَ لَيْسَ رُبَّمَا تَفَقَّدْتَ قَلْبَكَ فَلَا تَذْكُرُ بِهِ خَيْراً وَ لَا شَرّاً وَ لَا تَدْرِي أَيْنَ هُوَ قَالَ قُلْتُ لَهُ بَلَى إِنَّهُ لَيُصِيبُنِي وَ أَرَاهُ يُصِيبُ النَّاسَ قَالَ أَجَلْ لَيْسَ يَعْرَى مِنْهُ أَحَدٌ",
            "chunk_type": "body",
            "word_end": 110,
            "word_start": 74
          },
          {
            "arabic_text": "فَإِذَا كَانَ ذَلِكَ فَاذْكُرُوا اللَّهَ عَزَّ وَ جَلَّ وَ احْذَرُوا النَّكْتَ فَإِنَّهُ إِذَا أَرَادَ بِعَبْدٍ خَيْراً نَكَتَ إِيمَاناً وَ إِذَا أَرَادَ بِهِ غَيْرَ ذَلِكَ نَكَتَ غَيْرَ ذَلِكَ",
            "chunk_type": "body",
            "word_end": 137,
            "word_start": 110
          },
          {
            "arabic_text": "قُلْتُ مَا غَيْرُ ذَلِكَ جُعِلْتُ فِدَاكَ [مَا هُوَ] قَالَ إِذَا أَرَادَ كُفْراً نَكَتَ كُفْراً",
