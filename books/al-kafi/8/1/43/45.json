            "arabic_text": "مُحَمَّدُ بْنُ يَحْيَى عَنْ مُحَمَّدِ بْنِ الْحُسَيْنِ عَنْ إِسْحَاقَ بْنِ يَزِيدَ عَنْ مِهْرَانَ عَنْ أَبَانِ بْنِ تَغْلِبَ وَ عِدَّةٍ قَالُوا",
            "chunk_type": "isnad",
            "word_end": 20,
            "word_start": 0
          },
          {
            "arabic_text": "كُنَّا عِنْدَ أَبِي عَبْدِ اللَّهِ (عَلَيْهِ السَّلَامُ) جُلُوساً فَقَالَ (عَلَيْهِ السَّلَامُ)",
            "chunk_type": "opening",
            "word_end": 31,
            "word_start": 20
          },
          {
            "arabic_text": "لَا يَسْتَحِقُّ عَبْدٌ حَقِيقَةَ الْإِيمَانِ حَتَّى يَكُونَ الْمَوْتُ أَحَبَّ إِلَيْهِ مِنَ الْحَيَاةِ وَ يَكُونَ الْمَرَضُ أَحَبَّ إِلَيْهِ مِنَ الصِّحَّةِ وَ يَكُونَ الْفَقْرُ أَحَبَّ إِلَيْهِ مِنَ الْغِنَى فَأَنْتُمْ كَذَا",
            "chunk_type": "body",
            "word_end": 59,
            "word_start": 31
          },
          {
            "arabic_text": "فَقَالُوا لَا وَ اللَّهِ جَعَلَنَا اللَّهُ فِدَاكَ وَ سُقِطَ فِي أَيْدِيهِمْ وَ وَقَعَ الْيَأْسُ فِي قُلُوبِهِمْ",
            "chunk_type": "body",
            "word_end": 75,
            "word_start": 59
          },
          {
            "arabic_text": "فَلَمَّا رَأَى مَا دَاخَلَهُمْ مِنْ ذَلِكَ قَالَ أَ يَسُرُّ أَحَدَكُمْ أَنَّهُ عُمِّرَ مَا عُمِّرَ ثُمَّ يَمُوتُ عَلَى غَيْرِ هَذَا الْأَمْرِ أَوْ يَمُوتُ عَلَى مَا هُوَ عَلَيْهِ",
            "chunk_type": "body",
            "word_end": 101,
            "word_start": 75
          },
          {
            "arabic_text": "قَالُوا بَلْ يَمُوتُ عَلَى مَا هُوَ عَلَيْهِ السَّاعَةَ",
            "chunk_type": "body",
            "word_end": 109,
            "word_start": 101
          },
          {
            "arabic_text": "قَالَ فَأَرَى الْمَوْتَ أَحَبَّ إِلَيْكُمْ مِنَ الْحَيَاةِ",
            "chunk_type": "body",
            "word_end": 116,
            "word_start": 109
          },
          {
            "arabic_text": "ثُمَّ قَالَ أَ يَسُرُّ أَحَدَكُمْ أَنْ بَقِيَ مَا بَقِيَ لَا يُصِيبُهُ شَيْ‏ءٌ مِنْ هَذِهِ الْأَمْرَاضِ وَ الْأَوْجَاعِ حَتَّى يَمُوتَ عَلَى غَيْرِ هَذَا الْأَمْرِ",
            "chunk_type": "body",
            "word_end": 139,
            "word_start": 116
          },
          {
            "arabic_text": "قَالُوا لَا يَا ابْنَ رَسُولِ اللَّهِ",
