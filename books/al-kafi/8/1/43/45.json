            "word_end": 145,
            "word_start": 139
          },
          {
            "arabic_text": "قَالَ فَأَرَى الْمَرَضَ أَحَبَّ إِلَيْكُمْ مِنَ الصِّحَّةِ",
            "chunk_type": "body",
            "word_end": 152,
            "word_start": 145
          },
          {
