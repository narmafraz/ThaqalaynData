            "word_end": 28,
            "word_start": 0
          },
          {
            "arabic_text": "سَأَلْتُهُ عَنْ قَوْلِ اللَّهِ عَزَّ وَ جَلَّ شَهْرُ رَمَضانَ الَّذِي أُنْزِلَ فِيهِ الْقُرْآنُ وَ إِنَّمَا أُنْزِلَ فِي عِشْرِينَ سَنَةً بَيْنَ أَوَّلِهِ وَ آخِرِهِ",
            "chunk_type": "body",
