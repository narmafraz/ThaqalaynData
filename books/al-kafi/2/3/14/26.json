        "chunks": [
          {
            "arabic_text": "عِدَّةٌ مِنْ أَصْحَابِنَا عَنْ سَهْلِ بْنِ زِيَادٍ وَ مُحَمَّدُ بْنُ يَحْيَى عَنْ أَحْمَدَ بْنِ مُحَمَّدِ بْنِ عِيسَى جَمِيعاً عَنِ ابْنِ مَحْبُوبٍ عَنْ جَمِيلٍ عَنْ سَدِيرٍ عَنْ أَبِي جَعْفَرٍ ( عَلَيْهِ السَّلَامُ ) قَالَ",
            "chunk_type": "isnad",
            "word_end": 33,
            "word_start": 0
          },
          {
            "arabic_text": "سُورَةُ الْمُلْكِ هِيَ الْمَانِعَةُ تَمْنَعُ مِنْ عَذَابِ الْقَبْرِ وَ هِيَ مَكْتُوبَةٌ فِي التَّوْرَاةِ سُورَةَ الْمُلْكِ وَ مَنْ قَرَأَهَا فِي لَيْلَتِهِ فَقَدْ أَكْثَرَ وَ أَطَابَ وَ لَمْ يُكْتَبْ بِهَا مِنَ الْغَافِلِينَ",
            "chunk_type": "body",
            "word_end": 63,
            "word_start": 33
          },
          {
            "arabic_text": "وَ إِنِّي لَأَرْكَعُ بِهَا بَعْدَ عِشَاءِ الْآخِرَةِ وَ أَنَا جَالِسٌ وَ إِنَّ وَالِدِي ( عَلَيْهِ السَّلَامُ ) كَانَ يَقْرَأُهَا فِي يَوْمِهِ وَ لَيْلَتِهِ",
            "chunk_type": "body",
            "word_end": 86,
            "word_start": 63
          },
          {
            "arabic_text": "وَ مَنْ قَرَأَهَا إِذَا دَخَلَ عَلَيْهِ فِي قَبْرِهِ نَاكِرٌ وَ نَكِيرٌ مِنْ قِبَلِ رِجْلَيْهِ قَالَتْ رِجْلَاهُ لَهُمَا لَيْسَ لَكُمَا إِلَى مَا قِبَلِي سَبِيلٌ قَدْ كَانَ هَذَا الْعَبْدُ يَقُومُ عَلَيَّ فَيَقْرَأُ سُورَةَ الْمُلْكِ فِي كُلِّ يَوْمٍ وَ لَيْلَتِهِ",
            "chunk_type": "body",
            "word_end": 123,
            "word_start": 86
          },
          {
            "arabic_text": "وَ إِذَا أَتَيَاهُ مِنْ قِبَلِ جَوْفِهِ قَالَ لَهُمَا لَيْسَ لَكُمَا إِلَى مَا قِبَلِي سَبِيلٌ قَدْ كَانَ هَذَا الْعَبْدُ أَوْعَانِي سُورَةَ الْمُلْكِ",
            "chunk_type": "body",
            "word_end": 144,
            "word_start": 123
          },
          {
            "arabic_text": "وَ إِذَا أَتَيَاهُ مِنْ قِبَلِ لِسَانِهِ قَالَ لَهُمَا لَيْسَ لَكُمَا إِلَى مَا قِبَلِي سَبِيلٌ قَدْ كَانَ هَذَا الْعَبْدُ يَقْرَأُ بِي فِي كُلِّ يَوْمٍ وَ لَيْلَةٍ سُورَةَ الْمُلْكِ",
