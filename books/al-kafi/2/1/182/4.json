          },
          {
            "arabic_text": "قَالَ وَ فِيهِمْ جَرَتْ فَمُسْتَقِرٌّ وَ مُسْتَوْدَعٌ",
            "chunk_type": "body",
            "word_end": 62,
            "word_start": 55
