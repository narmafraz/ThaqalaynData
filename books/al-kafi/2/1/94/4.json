            "chunk_type": "body",
            "word_end": 58,
            "word_start": 49
          },
          {
            "arabic_text": "إِنَّكَ لَا تَهْدِي مَنْ أَحْبَبْتَ وَ لكِنَّ اللَّهَ يَهْدِي مَنْ يَشاءُ",
            "chunk_type": "quran_quote",
            "word_end": 69,
            "word_start": 58
          },
          {
            "arabic_text": "أَفَأَنْتَ تُكْرِهُ النَّاسَ حَتَّى يَكُونُوا مُؤْمِنِينَ",
            "chunk_type": "quran_quote",
            "word_end": 75,
            "word_start": 69
          },
          {
            "arabic_text": "ذَرُوا النَّاسَ فَإِنَّ النَّاسَ أَخَذُوا عَنِ النَّاسِ وَ إِنَّكُمْ أَخَذْتُمْ عَنْ رَسُولِ اللَّهِ ( صَلَّى اللَّهِ عَلَيْهِ وَآلِهِ ) وَ عَلِيٍّ ( عَلَيْهِ السَّلَامُ ) وَ لَا سَوَاءٌ",
