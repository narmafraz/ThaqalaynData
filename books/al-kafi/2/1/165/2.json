          {
            "arabic_text": "فَالْكُفْرُ أَعْظَمُ مِنَ الشِّرْكِ",
            "chunk_type": "body",
            "word_end": 50,
            "word_start": 46
          },
          {
            "arabic_text": "فَمَنِ اخْتَارَ عَلَى اللَّهِ عَزَّ وَ جَلَّ وَ أَبَى الطَّاعَةَ وَ أَقَامَ عَلَى الْكَبَائِرِ فَهُوَ كَافِرٌ",
            "chunk_type": "body",
            "word_end": 66,
            "word_start": 50
          },
          {
            "arabic_text": "و مَنْ نَصَبَ دِيناً غَيْرَ دِينِ الْمُؤْمِنِينَ فَهُوَ مُشْرِكٌ",
