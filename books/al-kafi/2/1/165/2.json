            "arabic_text": "عَلِيُّ بْنُ إِبْرَاهِيمَ عَنْ أَبِيهِ عَنْ حَمَّادِ بْنِ عِيسَى عَنْ حَرِيزٍ عَنْ زُرَارَةَ عَنْ أَبِي جَعْفَرٍ ( عَلَيْهِ السَّلَامُ ) قَالَ",
            "chunk_type": "isnad",
            "word_end": 21,
            "word_start": 0
          },
          {
            "arabic_text": "وَ اللَّهِ إِنَّ الْكُفْرَ لَأَقْدَمُ مِنَ الشِّرْكِ وَ أَخْبَثُ وَ أَعْظَمُ",
            "chunk_type": "body",
            "word_end": 32,
            "word_start": 21
          },
          {
            "arabic_text": "قَالَ ثُمَّ ذَكَرَ كُفْرَ إِبْلِيسَ حِينَ قَالَ اللَّهُ لَهُ اسْجُدْ لِآدَمَ فَأَبَى أَنْ يَسْجُدَ",
            "chunk_type": "body",
            "word_end": 46,
            "word_start": 32
