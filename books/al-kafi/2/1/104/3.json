    "chapter_title": {
      "ar": "<span class=\"first-scene-phrase\"><span class=\"first-in-scene\">ب</span>َابٌ فِي أَنَّ الْمُؤْمِنَ</span> صِنْفَانِ",
      "en": "Chapter 104 – Regarding that the Momin is of two types"
    },
    "nav": {
      "prev": "/books/al-kafi:2:1:104:2",
