          },
          {
            "arabic_text": "فَكَتَبَ ( عَلَيْهِ السَّلَامُ ) إِنَّ إِبْرَاهِيمَ كَانَ مُؤْمِناً وَ أَحَبَّ أَنْ يَزْدَادَ إِيمَاناً وَ أَنْتَ شَاكٌّ وَ الشَّاكُّ لَا خَيْرَ فِيهِ",
            "chunk_type": "body",
            "word_end": 66,
            "word_start": 44
          },
          {
            "arabic_text": "وَ كَتَبَ إِنَّمَا الشَّكُّ مَا لَمْ يَأْتِ الْيَقِينُ فَإِذَا جَاءَ الَْقِينُ لَمْ يَجُزِ الشَّكُّ",
            "chunk_type": "body",
            "word_end": 80,
