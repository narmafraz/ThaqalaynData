            "chunk_type": "isnad",
            "word_end": 19,
            "word_start": 0
          },
          {
            "arabic_text": "سَمِعْتُهُ يَقُولُ إِنَّ اللَّهَ عَزَّ وَ جَلَّ لَا يُوصَفُ وَ كَيْفَ يُوصَفُ",
            "chunk_type": "body",
            "word_end": 31,
            "word_start": 19
          },
          {
            "arabic_text": "وَ قَالَ فِي كِتَابِهِ وَ مَا قَدَرُوا اللَّهَ حَقَّ قَدْرِهِ فَلَا يُوصَفُ بِقَدَرٍ إِلَّا كَانَ أَعْظَمَ مِنْ ذَلِكَ",
            "chunk_type": "body",
            "word_end": 49,
            "word_start": 31
          },
          {
            "arabic_text": "وَ إِنَّ النَّبِيَّ ( صَلَّى اللَّهِ عَلَيْهِ وَآلِهِ ) لَا يُوصَفُ وَ كَيْفَ يُوصَفُ عَبْدٌ احْتَجَبَ اللَّهُ عَزَّ وَ جَلَّ بِسَبْعٍ وَ جَعَلَ طَاعَتَهُ فِي الْأَرْضِ كَطَاعَتِهِ فِي السَّمَاءِ",
            "chunk_type": "body",
            "word_end": 78,
            "word_start": 49
          },
          {
            "arabic_text": "فَقَالَ وَ مَا آتاكُمُ الرَّسُولُ فَخُذُوهُ وَ مَا نَهاكُمْ عَنْهُ فَانْتَهُوا وَ مَنْ أَطَاعَ هَذَا فَقَدْ أَطَاعَنِي وَ مَنْ عَصَاهُ فَقَدْ عَصَانِي وَ فَوَّضَ إِلَيْهِ",
            "chunk_type": "body",
            "word_end": 103,
            "word_start": 78
          },
          {
            "arabic_text": "وَ إِنَّا لَا نُوصَفُ وَ كَيْفَ يُوصَفُ قَوْمٌ رَفَعَ اللَّهُ عَنْهُمُ الرِّجْسَ وَ هُوَ الشَّكُّ",
            "chunk_type": "body",
            "word_end": 118,
            "word_start": 103
          },
          {
            "arabic_text": "وَ الْمُؤْمِنُ لَا يُوصَفُ وَ إِنَّ الْمُؤْمِنَ لَيَلْقَى أَخَاهُ فَيُصَافِحُهُ فَلَا يَزَالُ اللَّهُ يَنْظُرُ إِلَيْهِمَا وَ الذُّنُوبُ تَتَحَاتُّ عَنْ وُجُوهِهِمَا كَمَا يَتَحَاتُّ الْوَرَقُ عَنِ الشَّجَرِ",
