        "chunks": [
          {
            "arabic_text": "عَنْهُ عَنْ أَحْمَدَ بْنِ مُحَمَّدٍ عَنْ مُحَمَّدِ بْنِ خَالِدٍ عَنْ فَضَالَةَ بْنِ أَيُّوبَ عَنْ عُمَرَ بْنِ أَبَانٍ وَسَيْفِ بْنِ عَمِيرَةَ عَنْ فُضَيْلِ بْنِ يَسَارٍ قَالَ",
            "chunk_type": "isnad",
            "word_end": 25,
            "word_start": 0
          },
          {
            "arabic_text": "دَخَلْتُ عَلَى أَبِي عَبْدِ اللَّهِ (عَلَيْهِ السَّلَامُ) فِي مَرْضَةٍ مَرِضَهَا لَمْ يَبْقَ مِنْهُ إِلَّا رَأْسُهُ فَقَالَ يَا فُضَيْلُ إِنَّنِي كَثِيراً مَا أَقُولُ مَا عَلَى رَجُلٍ عَرَّفَهُ اللَّهُ هَذَا الْأَمْرَ لَوْ كَانَ فِي رَأْسِ جَبَلٍ حَتَّى يَأْتِيَهُ الْمَوْتُ",
            "chunk_type": "opening",
            "word_end": 62,
            "word_start": 25
          },
          {
            "arabic_text": "يَا فُضَيْلَ بْنَ يَسَارٍ إِنَّ النَّاسَ أَخَذُوا يَمِيناً وَشِمَالًا وَإِنَّا وَشِيعَتَنَا هُدِينَا الصِّرَاطَ الْمُسْتَقِيمَ",
            "chunk_type": "body",
            "word_end": 76,
            "word_start": 62
          },
          {
            "arabic_text": "يَا فُضَيْلَ بْنَ يَسَارٍ إِنَّ الْمُؤْمِنَ لَوْ أَصْبَحَ لَهُ مَا بَيْنَ الْمَشْرِقِ وَالْمَغْرِبِ كَانَ ذَلِكَ خَيْراً لَهُ وَلَوْ أَصْبَحَ مُقَطَّعاً أَعْضَاؤُهُ كَانَ ذَلِكَ خَيْراً لَهُ يَا فُضَيْلَ بْنَ يَسَارٍ إِنَّ اللَّهَ لَا يَفْعَلُ بِالْمُؤْمِنِ إِلَّا مَا هُوَ خَيْرٌ لَهُ",
            "chunk_type": "body",
            "word_end": 115,
            "word_start": 76
          },
          {
            "arabic_text": "يَا فُضَيْلَ بْنَ يَسَارٍ لَوْ عَدَلَتِ الدُّنْيَا عِنْدَ اللَّهِ عَزَّ وَجَلَّ جَنَاحَ بَعُوضَةٍ مَا سَقَى عَدُوَّهُ مِنْهَا شَرْبَةَ مَاءٍ",
            "chunk_type": "body",
            "word_end": 134,
            "word_start": 115
          },
          {
            "arabic_text": "يَا فُضَيْلَ بْنَ يَسَارٍ إِنَّهُ مَنْ كَانَ هَمُّهُ هَمّاً وَاحِداً كَفَاهُ اللَّهُ هَمَّهُ وَمَنْ كَانَ هَمُّهُ فِي كُلِّ وَادٍ لَمْ يُبَالِ اللَّهُ بِأَيِّ وَادٍ هَلَكَ",
