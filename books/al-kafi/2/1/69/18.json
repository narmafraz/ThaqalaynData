        "chunks": [
          {
            "arabic_text": "الْوَشَّاءُ عَنْ أَحْمَدَ بْنِ عَائِذٍ عَنْ أَبِي خَدِيجَةَ عَنْ أَبِي عَبْدِ اللَّهِ ( عَلَيْهِ السَّلَامُ ) قَالَ",
            "chunk_type": "isnad",
            "word_end": 17,
            "word_start": 0
          },
          {
            "arabic_text": "جَاءَ رَجُلٌ إِلَى النَّبِيِّ ( صَلَّى اللَّهِ عَلَيْهِ وَآلِهِ ) فَقَالَ إِنِّي قَدْ وَلَدْتُ بِنْتاً وَ رَبَّيْتُهَا حَتَّى إِذَا بَلَغَتْ فَأَلْبَسْتُهَا وَ حَلَّيْتُهَا ثُمَّ جِئْتُ بِهَا إِلَى قَلِيبٍ فَدَفَعْتُهَا فِي جَوْفِهِ وَ كَانَ آخِرُ مَا سَمِعْتُ مِنْهَا وَ هِيَ تَقُولُ يَا أَبَتَاهْ فَمَا كَفَّارَةُ ذَلِكَ",
            "chunk_type": "body",
            "word_end": 62,
            "word_start": 17
          },
          {
            "arabic_text": "قَالَ أَ لَكَ أُمٌّ حَيَّةٌ قَالَ لَا قَالَ فَلَكَ خَالَةٌ حَيَّةٌ قَالَ نَعَمْ قَالَ فَابْرَرْهَا فَإِنَّهَا بِمَنْزِلَةِ الْأُمِّ يُكَفِّرْ عَنْكَ مَا صَنَعْتَ",
            "chunk_type": "body",
            "word_end": 84,
            "word_start": 62
          },
          {
            "arabic_text": "قَالَ أَبُو خَدِيجَةَ فَقُلْتُ لِأَبِي عَبْدِ اللَّهِ ( عَلَيْهِ السَّلَامُ ) مَتَى كَانَ هَذَا فَقَالَ كَانَ فِي الْجَاهِلِيَّةِ وَ كَانُوا يَقْتُلُونَ الْبَنَاتِ مَخَافَةَ أَنْ يُسْبَيْنَ فَيَلِدْنَ فِي قَوْمٍ آخَرِينَ",
            "chunk_type": "body",
