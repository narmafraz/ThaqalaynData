        "chunks": [
          {
            "arabic_text": "عِدَّةٌ مِنْ أَصْحَابِنَا عَنْ أَحْمَدَ بْنِ مُحَمَّدِ بْنِ خَالِدٍ عَنْ أَبِيهِ عَنْ عَبْدِ اللَّهِ بْنِ بَحْرٍ عَنْ عَبْدِ اللَّهِ بْنِ مُسْكَانَ عَمَّنْ رَوَاهُ عَنْ أَبِي عَبْدِ اللَّهِ ( عَلَيْهِ السَّلَامُ ) قَالَ",
            "chunk_type": "isnad",
            "word_end": 32,
            "word_start": 0
          },
          {
            "arabic_text": "قَالَ وَ أَنَا عِنْدَهُ لِعَبْدِ الْوَاحِدِ الْأَنْصَارِيِّ فِي بِرِّ الْوَالِدَيْنِ فِي قَوْلِ اللَّهِ عَزَّ وَ جَلَّ وَ بِالْوالِدَيْنِ إِحْساناً فَظَنَنَّا أَنَّهَا الْآيَةُ الَّتِي فِي بَنِي إِسْرَائِيلَ وَ قَضى رَبُّكَ أَلَّا تَعْبُدُوا إِلَّا إِيَّاهُ وَ بِالْوالِدَيْنِ إِحْساناً",
            "chunk_type": "body",
            "word_end": 68,
            "word_start": 32
          },
          {
            "arabic_text": "فَلَمَّا كَانَ بَعْدُ سَأَلْتُهُ فَقَالَ هِيَ الَّتِي فِي لُقْمَانَ وَ وَصَّيْنَا الْإِنْسانَ بِوالِدَيْهِ حُسْناً وَ إِنْ جاهَداكَ عَلى أَنْ تُشْرِكَ بِي مَا لَيْسَ لَكَ بِهِ عِلْمٌ فَلَا تُطِعْهُمَا",
            "chunk_type": "body",
            "word_end": 96,
            "word_start": 68
          },
          {
            "arabic_text": "فَقَالَ إِنَّ ذَلِكَ أَعْظَمُ مِنْ أَنْ يَأْمُرَ بِصِلَتِهِمَا وَ حَقِّهِمَا عَلَى كُلِّ حَالٍ وَ إِنْ جاهَداكَ عَلى أَنْ تُشْرِكَ بِي مَا لَيْسَ لَكَ بِهِ عِلْمٌ فَقَالَ لَا بَلْ يَأْمُرُ بِصِلَتِهِمَا وَ إِنْ جَاهَدَاهُ عَلَى الشِّرْكِ مَا زَادَ حَقَّهُمَا إِلَّا عِظَمَاً",
