            "arabic_text": "عِدَّةٌ مِنْ أَصْحَابِنَا عَنْ سَهْلِ بْنِ زِيَادٍ عَنْ عَلِيِّ بْنِ أَسْبَاطٍ عَنْ سُلَيْمٍ مَوْلَى طِرْبَالٍ قَالَ حَدَّثَنِي هِشَامٌ عَنْ حَمْزَةَ بْنِ الطَّيَّارِ قَالَ",
            "chunk_type": "isnad",
            "word_end": 23,
            "word_start": 0
          },
          {
            "arabic_text": "قَالَ لِي أَبُو عَبْدِ اللَّهِ ( عَلَيْهِ السَّلَامُ ) النَّاسُ عَلَى سِتَّةِ أَصْنَافٍ",
            "chunk_type": "opening",
            "word_end": 36,
            "word_start": 23
          },
          {
            "arabic_text": "قَالَ قُلْتُ أَ تَأْذَنُ لِي أَنْ أَكْتُبَهَا قَالَ نَعَمْ قُلْتُ مَا أَكْتُبُ قَالَ اكْتُبْ أَهْلَ الْوَعِيدِ مِنْ أَهْلِ الْجَنَّةِ وَ أَهْلِ النَّارِ",
            "chunk_type": "body",
            "word_end": 58,
            "word_start": 36
          },
          {
            "arabic_text": "وَ اكْتُبْ وَ آخَرُونَ اعْتَرَفُوا بِذُنُوبِهِمْ خَلَطُوا عَمَلًا صالِحاً وَ آخَرَ سَيِّئاً",
            "chunk_type": "body",
            "word_end": 70,
            "word_start": 58
          },
          {
            "arabic_text": "قَالَ قُلْتُ مَنْ هَؤُلَاءِ قَالَ وَحْشِيٌّ مِنْهُمْ",
            "chunk_type": "body",
            "word_end": 77,
            "word_start": 70
          },
          {
            "arabic_text": "وَ اكْتُبْ وَ آخَرُونَ مُرْجَوْنَ لِأَمْرِ اللَّهِ إِمَّا يُعَذِّبُهُمْ وَ إِمَّا يَتُوبُ عَلَيْهِمْ",
            "chunk_type": "body",
            "word_end": 90,
            "word_start": 77
          },
          {
            "arabic_text": "قَالَ وَ اكْتُبْ إِلَّا الْمُسْتَضْعَفِينَ مِنَ الرِّجالِ وَ النِّساءِ وَ الْوِلْدانِ لَا يَسْتَطِيعُونَ حِيلَةً وَ لَا يَهْتَدُونَ سَبِيلًا",
            "chunk_type": "body",
            "word_end": 108,
            "word_start": 90
          },
          {
            "arabic_text": "لَا يَسْتَطِيعُونَ حِيلَةً إِلَى الْكُفْرِ وَ لَا يَهْتَدُونَ سَبِيلًا إِلَى الْإِيمَانِ فَأُولئِكَ عَسَى اللَّهُ أَنْ يَعْفُوَ عَنْهُمْ",
            "chunk_type": "body",
            "word_end": 125,
            "word_start": 108
          },
          {
            "arabic_text": "قَالَ وَ اكْتُبْ أَصْحَابَ الْأَعْرَافِ",
            "chunk_type": "body",
            "word_end": 130,
            "word_start": 125
          },
          {
            "arabic_text": "قُلْتُ وَ مَا أَصْحَابُ الْأَعْرَافِ قَالَ قَوْمٌ اسْتَوَتْ حَسَنَاتُهُمْ وَ سَيِّئَاتُهُمْ فَإِنْ أَدْخَلَهُمُ النَّارَ فَبِذُنُوبِهِمْ وَ إِنْ أَدْخَلَهُمُ الْجَنَّةَ فَبِرَحْمَتِهِ",
