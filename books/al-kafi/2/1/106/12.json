            "chunk_type": "body",
            "word_end": 61,
            "word_start": 35
          },
          {
            "arabic_text": "ثُمَّ قَالَ إِنَّ الْمُؤْمِنَ يُبْتَلَى بِكُلِّ بَلِيَّةٍ وَيَمُوتُ بِكُلِّ مِيتَةٍ إِلَّا أَنَّهُ لَا يَقْتُلُ نَفْسَهُ.",
