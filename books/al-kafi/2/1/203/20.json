        "chunks": [
          {
            "arabic_text": "مُحَمَّدُ بْنُ يَحْيَى عَنْ أَحْمَدَ بْنِ مُحَمَّدٍ عَنْ بَعْضِ أَصْحَابِهِ عَنِ الْحَسَنِ بْنِ عَلِيِّ بْنِ أَبِي عُثْمَانَ عَنْ وَاصِلٍ عَنْ عَبْدِ اللَّهِ بْنِ سِنَانٍ عَنْ أَبِي عَبْدِ اللَّهِ ( عَلَيْهِ السَّلَامُ ) قَالَ",
            "chunk_type": "isnad",
            "word_end": 33,
            "word_start": 0
          },
          {
            "arabic_text": "جَاءَ رَجُلٌ إِلَى أَبِي ذَرٍّ فَقَالَ يَا أَبَا ذَرٍّ مَا لَنَا نَكْرَهُ الْمَوْتَ فَقَالَ لِأَنَّكُمْ عَمَرْتُمُ الدُّنْيَا وَ أَخْرَبْتُمُ الْآخِرَةَ فَتَكْرَهُونَ أَنْ تُنْقَلُوا مِنْ عُمْرَانٍ إِلَى خَرَابٍ",
            "chunk_type": "body",
            "word_end": 60,
            "word_start": 33
          },
          {
            "arabic_text": "فَقَالَ لَهُ فَكَيْفَ تَرَى قُدُومَنَا عَلَى اللَّهِ فَقَالَ أَمَّا الْمُحْسِنُ مِنْكُمْ فَكَالْغَائِبِ يَقْدَمُ عَلَى أَهْلِهِ وَ أَمَّا الْمُسِي‏ءُ مِنْكُمْ فَكَالْآبِقِ يُرَدُّ عَلَى مَوْلَاهُ",
            "chunk_type": "body",
            "word_end": 83,
            "word_start": 60
          },
          {
            "arabic_text": "قَالَ فَكَيْفَ تَرَى حَالَنَا عِنْدَ اللَّهِ قَالَ اعْرِضُوا أَعْمَالَكُمْ عَلَى الْكِتَابِ إِنَّ اللَّهَ يَقُولُ إِنَّ الْأَبْرارَ لَفِي نَعِيمٍ وَ إِنَّ الْفُجَّارَ لَفِي جَحِيمٍ",
            "chunk_type": "body",
            "word_end": 106,
            "word_start": 83
          },
          {
            "arabic_text": "قَالَ فَقَالَ الرَّجُلُ فَأَيْنَ رَحْمَةُ اللَّهِ قَالَ رَحْمَةُ اللَّهِ قَرِيبٌ مِنَ الْمُحْسِنِينَ",
            "chunk_type": "body",
            "word_end": 118,
            "word_start": 106
          },
          {
            "arabic_text": "قَالَ أَبُو عَبْدِ اللَّهِ ( عَلَيْهِ السَّلَامُ ) وَ كَتَبَ رَجُلٌ إِلَى أَبِي ذَرٍّ رَضِيَ اللَّهُ عَنْهُ يَا أَبَا ذَرٍّ أَطْرِفْنِي بِشَيْ‏ءٍ مِنَ الْعِلْمِ فَكَتَبَ إِلَيْهِ أَنَّ الْعِلْمَ كَثِيرٌ وَ لَكِنْ إِنْ قَدَرْتَ أَنْ لَا تُسِي‏ءَ إِلَى مَنْ تُحِبُّهُ فَافْعَلْ",
            "chunk_type": "body",
            "word_end": 158,
            "word_start": 118
          },
          {
            "arabic_text": "قَالَ فَقَالَ لَهُ الرَّجُلُ وَ هَلْ رَأَيْتَ أَحَداً يُسِي‏ءُ إِلَى مَنْ يُحِبُّهُ فَقَالَ لَهُ نَعَمْ نَفْسُكَ أَحَبُّ الْأَنْفُسِ إِلَيْكَ فَإِذَا أَنْتَ عَصَيْتَ اللَّهَ فَقَدْ أَسَأْتَ إِلَيْهَا",
            "chunk_type": "body",
