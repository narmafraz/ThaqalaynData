          {
            "arabic_text": "عَلِيُّ بْنُ إِبْرَاهِيمَ عَنْ أَبِيهِ وَ عَلِيِّ بْنِ مُحَمَّدٍ الْقَاسَانِيِّ جَمِيعاً عَنِ الْقَاسِمِ بْنِ مُحَمَّدٍ عَنْ سُلَيْمَانَ الْمِنْقَرِيِّ عَنْ حَفْصِ بْنِ غِيَاثٍ قَالَ",
            "chunk_type": "isnad",
            "word_end": 23,
            "word_start": 0
          },
          {
            "arabic_text": "سَمِعْتُ أَبَا عَبْدِ اللَّهِ يَقُولُ إِنْ قَدَرْتَ أَنْ لَا تُعْرَفَ فَافْعَلْ وَ مَا عَلَيْكَ أَلَّا يُثْنِيَ عَلَيْكَ النَّاسُ وَ مَا عَلَيْكَ أَنْ تَكُونَ مَذْمُومَاً عِنْدَ النَّاسِ إِذَا إِذَا كُنْتَ مَحْمُوداً عِنْدَ اللَّهِ",
            "chunk_type": "body",
            "word_end": 55,
            "word_start": 23
          },
          {
            "arabic_text": "ثُمَّ قَالَ قَالَ أَبِي عَلِيُّ بْنُ أَبِي طَالِبٍ ( عَلَيْهِ السَّلَامُ ) لَا خَيْرَ فِي الْعَيْشِ إِلَّا لِرَجُلَيْنِ رَجُلٍ يَزْدَادُ كُلَّ يَوْمٍ خَيْراً وَ رَجُلٍ يَتَدَارَكُ مَنِيَّتَهُ بِالتَّوْبَةِ وَ أَنَّى لَهُ بِالتَّوْبَةِ",
            "chunk_type": "body",
            "word_end": 87,
            "word_start": 55
          },
          {
            "arabic_text": "وَ اللَّهِ لَوْ سَجَدَ حَتَّى يَنْقَطِعَ عُنُقُهُ مَا قَبِلَ اللَّهُ تَبَارَكَ وَ تَعَالَى مِنْهُ إِلَّا بِوَلَايَتِنَا أَهْلَ الْبَيْتِ",
            "chunk_type": "body",
            "word_end": 105,
            "word_start": 87
          },
          {
            "arabic_text": "أَلَا وَ مَنْ عَرَفَ حَقَّنَا وَ رَجَا الثَّوَابَ فِينَا وَ رَضِيَ بِقُوتِهِ نِصْفِ مُدٍّ فِي كُلِّ يَوْمٍ وَ مَا سَتَرَ عَوْرَتَهُ وَ مَا أَكَنَّ رَأْسَهُ وَ هُمْ وَ اللَّهِ فِي ذَلِكَ خَائِفُونَ وَجِلُونَ وَدُّوا أَنَّهُ حَظُّهُمْ مِنَ الدُّنْيَا",
            "chunk_type": "body",
            "word_end": 143,
            "word_start": 105
          },
          {
            "arabic_text": "وَ كَذَلِكَ وَصَفَهُمُ اللَّهُ عَزَّ وَ جَلَّ فَقَالَ وَ الَّذِينَ يُؤْتُونَ مَا آتَوْا وَ قُلُوبُهُمْ وَجِلَةٌ أَنَّهُمْ إِلى رَبِّهِمْ راجِعُونَ",
            "chunk_type": "quran_quote",
            "word_end": 163,
            "word_start": 143
          },
          {
            "arabic_text": "ثُمَّ قَالَ مَا الَّذِي آتَوْا آتَوْا وَ اللَّهِ مَعَ الطَّاعَةِ الْمَحَبَّةَ وَ الْوَلَايَةَ وَ هُمْ فِي ذَلِكَ خَائِفُونَ لَيْسَ خَوْفُهُمْ خَوْفَ شَكٍّ وَ لَكِنَّهُمْ خَافُوا أَنْ يَكُونُوا مُقَصِّرِينَ فِي مَحَبَّتِنَا وَ طَاعَتِنَا",
            "chunk_type": "closing",
