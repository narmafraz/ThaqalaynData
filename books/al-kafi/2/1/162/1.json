          {
            "arabic_text": "عَلِيُّ بْنُ إِبْرَاهِيمَ عَنْ أَبِيهِ وَ عِدَّةٌ مِنْ أَصْحَابِنَا عَنْ أَحْمَدَ بْنِ مُحَمَّدٍ جَمِيعاً عَنْ أَحْمَدَ بْنِ مُحَمَّدِ بْنِ أَبِي نَصْرٍ عَنْ أَبَانٍ عَنْ رَجُلٍ عَنْ أَبِي جَعْفَرٍ ( عَلَيْهِ السَّلَامُ ) قَالَ",
            "chunk_type": "isnad",
            "word_end": 33,
            "word_start": 0
          },
          {
            "arabic_text": "قَالَ رَسُولُ اللَّهِ ( صَلَّى اللَّهِ عَلَيْهِ وَآلِهِ ) خَمْسٌ إِنْ أَدْرَكْتُمُوهُنَّ فَتَعَوَّذُوا بِاللَّهِ مِنْهُنَّ لَمْ تَظْهَرِ الْفَاحِشَةُ فِي قَوْمٍ قَطُّ حَتَّى يُعْلِنُوهَا إِلَّا ظَهَرَ فِيهِمُ الطَّاعُونُ وَ الْأَوْجَاعُ الَّتِي لَمْ تَكُنْ فِي أَسْلَافِهِمُ الَّذِينَ مَضَوْا",
            "chunk_type": "body",
            "word_end": 69,
            "word_start": 33
          },
          {
            "arabic_text": "وَ لَمْ يَنْقُصُوا الْمِكْيَالَ وَ الْمِيزَانَ إِلَّا أُخِذُوا بِالسِّنِينَ وَ شِدَّةِ الْمَئُونَةِ وَ جَوْرِ السُّلْطَانِ",
            "chunk_type": "body",
            "word_end": 84,
            "word_start": 69
          },
          {
            "arabic_text": "وَ لَمْ يَمْنَعُوا الزَّكَاةَ إِلَّا مُنِعُوا الْقَطْرَ مِنَ السَّمَاءِ وَ لَوْ لَا الْبَهَائِمُ لَمْ يُمْطَرُوا",
            "chunk_type": "body",
            "word_end": 99,
            "word_start": 84
          },
          {
            "arabic_text": "وَ لَمْ يَنْقُضُوا عَهْدَ اللَّهِ وَ عَهْدَ رَسُولِهِ إِلَّا سَلَّطَ اللَّهُ عَلَيْهِمْ عَدُوَّهُمْ وَ أَخَذُوا بَعْضَ مَا فِي أَيْدِيهِمْ",
            "chunk_type": "body",
            "word_end": 118,
            "word_start": 99
          },
          {
            "arabic_text": "وَ لَمْ يَحْكُمُوا بِغَيْرِ مَا أَنْزَلَ اللَّهُ عَزَّ وَ جَلَّ إِلَّا جَعَلَ اللَّهُ عَزَّ وَ جَلَّ بَأْسَهُمْ بَيْنَهُمْ",
