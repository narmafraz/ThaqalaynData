            "arabic_text": "مُحَمَّدُ بْنُ يَحْيَى عَنْ أَحْمَدَ بْنِ مُحَمَّدٍ عَنْ مُحَمَّدِ بْنِ خَالِدٍ عَنِ النَّضْرِ بْنِ سُوَيْدٍ عَنْ يَحْيَى بْنِ عِمْرَانَ الْحَلَبِيِّ عَنْ أَبِي خَالِدٍ الْقَمَّاطِ عَنْ حُمْرَانَ قَالَ",
            "chunk_type": "isnad",
            "word_end": 27,
            "word_start": 0
          },
          {
            "arabic_text": "قُلْتُ لِأَبِي عَبْدِ اللَّهِ ( عَلَيْهِ السَّلَامُ ) أَسْأَلُكَ أَصْلَحَكَ اللَّهُ فَقَالَ نَعَمْ",
            "chunk_type": "opening",
            "word_end": 40,
            "word_start": 27
          },
          {
            "arabic_text": "فَقُلْتُ كُنْتُ عَلَى حَالٍ وَ أَنَا الْيَوْمَ عَلَى حَالٍ أُخْرَى كُنْتُ أَدْخُلُ الْأَرْضَ فَأَدْعُو الرَّجُلَ وَ الِاثْنَيْنِ وَ الْمَرْأَةَ فَيُنْقِذُ اللَّهُ مَنْ شَاءَ وَ أَنَا الْيَوْمَ لَا أَدْعُو أَحَداً",
            "chunk_type": "body",
            "word_end": 69,
            "word_start": 40
          },
          {
            "arabic_text": "فَقَالَ وَ مَا عَلَيْكَ أَنْ تُخَلِّيَ بَيْنَ النَّاسِ وَ بَيْنَ رَبِّهِمْ فَمَنْ أَرَادَ اللَّهُ أَنْ يُخْرِجَهُ مِنْ ظُلْمَةٍ إِلَى نُورٍ أَخْرَجَهُ",
            "chunk_type": "body",
            "word_end": 90,
            "word_start": 69
          },
          {
            "arabic_text": "ثُمَّ قَالَ وَ لَا عَلَيْكَ إِنْ آنَسْتَ مِنْ أَحَدٍ خَيْراً أَنْ تَنْبِذَ إِلَيْهِ الشَّيْ‏ءَ نَبْذاً",
            "chunk_type": "body",
            "word_end": 105,
            "word_start": 90
          },
          {
            "arabic_text": "قُلْتُ أَخْبِرْنِي عَنْ قَوْلِ اللَّهِ عَزَّ وَ جَلَّ وَ مَنْ أَحْيَاهَا فَكَأَنَّمَا أَحْيَا النَّاسَ جَمِيعاً",
            "chunk_type": "body",
            "word_end": 120,
            "word_start": 105
          },
          {
            "arabic_text": "قَالَ مِنْ حَرَقٍ أَوْ غَرَقٍ ثُمَّ سَكَتَ ثُمَّ قَالَ تَأْوِيلُهَا الْأَعْظَمُ أَنْ دَعَاهَا فَاسْتَجَابَتْ لَهُ",
            "chunk_type": "body",
