          },
          {
            "arabic_text": "اعْلَمُوا أَنَّ الْقُرْآنَ هُدَى اللَّيْلِ وَ النَّهَارِ وَ نُورُ اللَّيْلِ الْمُظْلِمِ عَلَى مَا كَانَ مِنْ جَهْدٍ وَ فَاقَةٍ",
            "chunk_type": "body",
            "word_end": 49,
            "word_start": 31
          },
          {
            "arabic_text": "فَإِذَا حَضَرَتْ بَلِيَّةٌ فَاجْعَلُوا أَمْوَالَكُمْ دُونَ أَنْفُسِكُمْ وَ إِذَا نَزَلَتْ نَازِلَةٌ فَاجْعَلُوا أَنْفُسَكُمْ دُونَ دِينِكُمْ",
            "chunk_type": "body",
            "word_end": 64,
            "word_start": 49
          },
          {
            "arabic_text": "وَ اعْلَمُوا أَنَّ الْهَالِكَ مَنْ هَلَكَ دِينُهُ وَ الْحَرِيبَ مَنْ حُرِبَ دِينُهُ",
