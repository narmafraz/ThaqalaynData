          {
            "arabic_text": "عَنْهُ عَنْ أَحْمَدَ بْنِ مُحَمَّدٍ عَنْ عَلِيِّ بْنِ الْحَكَمِ عَنْ أَبِي أَيُّوبَ عَنْ إِبْرَاهِيمَ الْكَرْخِيِّ قَالَ",
            "chunk_type": "isnad",
            "word_end": 16,
            "word_start": 0
          },
          {
            "arabic_text": "عَلَّمَنَا أَبُو عَبْدِ اللَّهِ ( عَلَيْهِ السَّلَامُ ) دُعَاءً وَ أَمَرَنَا أَنْ نَدْعُوَ بِهِ يَوْمَ الْجُمُعَةِ",
            "chunk_type": "body",
            "word_end": 32,
            "word_start": 16
          },
          {
            "arabic_text": "اللَّهُمَّ إِنِّي تَعَمَّدْتُ إِلَيْكَ بِحَاجَتِي وَ أَنْزَلْتُ بِكَ الْيَوْمَ فَقْرِي وَ مَسْكَنَتِي",
            "chunk_type": "body",
            "word_end": 44,
            "word_start": 32
          },
          {
            "arabic_text": "فَأَنَا الْيَوْمَ لِمَغْفِرَتِكَ أَرْجَى مِنِّي لِعَمَلِي وَ لَمَغْفِرَتُكَ وَ رَحْمَتُكَ أَوْسَعُ مِنْ ذُنُوبِي",
            "chunk_type": "body",
            "word_end": 57,
            "word_start": 44
          },
          {
            "arabic_text": "فَتَوَلَّ قَضَاءَ كُلِّ حَاجَةٍ هِيَ لِي بِقُدْرَتِكَ عَلَيْهَا وَ تَيْسِيرِ ذَلِكَ عَلَيْكَ وَ لِفَقْرِي إِلَيْكَ",
            "chunk_type": "body",
            "word_end": 72,
            "word_start": 57
          },
          {
            "arabic_text": "فَإِنِّي لَمْ أُصِبْ خَيْراً قَطُّ إِلَّا مِنْكَ وَ لَمْ يَصْرِفْ عَنِّي أَحَدٌ شَرّاً قَطُّ غَيْرُكَ",
            "chunk_type": "body",
            "word_end": 87,
            "word_start": 72
          },
          {
            "arabic_text": "وَ لَيْسَ أَرْجُو لِآخِرَتِي وَ دُنْيَايَ سِوَاكَ وَ لَا لِيَوْمِ فَقْرِي وَ يَوْمِ يُفْرِدُنِي النَّاسُ فِي حُفْرَتِي",
            "chunk_type": "body",
            "word_end": 104,
            "word_start": 87
          },
          {
            "arabic_text": "وَ أُفْضِي إِلَيْكَ يَا رَبِّ بِفَقْرِي",
            "chunk_type": "body",
