            "word_end": 58,
            "word_start": 39
          },
          {
            "arabic_text": "قُلْتُ لَهُ إِنَّهُ يَأْتِينِي مِنْ كُلِّ صِنْفٍ مِنَ الْأَصْنَافِ أَ فَأَرْوِي لَهُمْ هَذَا الْحَدِيثَ",
            "chunk_type": "body",
            "word_end": 72,
            "word_start": 58
          },
          {
            "arabic_text": "قَالَ نَعَمْ يَا أَبَانُ إِنَّهُ إِذَا كَانَ يَوْمُ الْقِيَامَةِ وَ جَمَعَ اللَّهُ الْأَوَّلِينَ وَ الْآخِرِينَ فَتُسْلَبُ لَا إِلَهَ إِلَّا اللَّهُ مِنْهُمْ إِلَّا مَنْ كَانَ عَلَى هَذَا الْأَمْرِ",
