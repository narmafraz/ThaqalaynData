            "word_end": 27,
            "word_start": 0
          },
          {
            "arabic_text": "جَاءَ رَجُلٌ إِلَى النَّبِيِّ ( صَلَّى اللَّهِ عَلَيْهِ وَآلِهِ ) فَقَالَ يَا رَسُولَ اللَّهِ قَدْ لَقِيتُ شِدَّةً مِنْ وَسْوَسَةِ الصَّدْرِ وَ أَنَا رَجُلٌ مَدِينٌ مُعِيلٌ مُحْوِجٌ",
            "chunk_type": "body",
            "word_end": 53,
            "word_start": 27
          },
          {
            "arabic_text": "فَقَالَ لَهُ كَرِّرْ هَذِهِ الْكَلِمَاتِ تَوَكَّلْتُ عَلَى الْحَيِّ الَّذِي لَا يَمُوتُ وَ الْحَمْدُ لِلَّهِ الَّذِي لَمْ يَتَّخِذْ صَاحِبَةً وَ لَا وَلَداً وَ لَمْ يَكُنْ لَهُ شَرِيكٌ فِي الْمُلْكِ وَ لَمْ يَكُنْ لَهُ وَلِيٌّ مِنَ الذُّلِّ وَ كَبِّرْهُ تَكْبِيراً",
            "chunk_type": "body",
            "word_end": 91,
            "word_start": 53
          },
          {
            "arabic_text": "تَوَكَّلْتُ عَلَى الْحَيِّ الَّذِي لَا يَمُوتُ وَ الْحَمْدُ لِلَّهِ الَّذِي لَمْ يَتَّخِذْ صَاحِبَةً وَ لَا وَلَداً وَ لَمْ يَكُنْ لَهُ شَرِيكٌ فِي الْمُلْكِ وَ لَمْ يَكُنْ لَهُ وَلِيٌّ مِنَ الذُّلِّ وَ كَبِّرْهُ تَكْبِيراً",
            "chunk_type": "body",
            "word_end": 124,
