          {
            "arabic_text": "عَلِيُّ بْنُ إِبْرَاهِيمَ عَنْ أَبِيهِ عَنِ ابْنِ أَبِي عُمَيْرٍ عَنْ مُحَمَّدِ بْنِ أَعْيَنَ عَنْ بِشْرِ بْنِ مَسْلَمَةَ عَنْ أَبِي عَبْدِ اللَّهِ ( عَلَيْهِ السَّلَامُ ) قَالَ",
            "chunk_type": "isnad",
            "word_end": 26,
            "word_start": 0
          },
          {
            "arabic_text": "كَانَ عَلِيُّ بْنُ الْحُسَيْنِ ( عَلَيْهِ السَّلَامُ ) يَقُولُ مَا أُبَالِي إِذَا قُلْتُ هَذِهِ الْكَلِمَاتِ لَوِ اجْتَمَعَ عَلَيَّ الْإِنْسُ وَ الْجِنُّ",
            "chunk_type": "body",
            "word_end": 47,
            "word_start": 26
          },
          {
            "arabic_text": "بِسْمِ اللَّهِ وَ بِاللَّهِ وَ مِنَ اللَّهِ وَ إِلَى اللَّهِ وَ فِي سَبِيلِ اللَّهِ وَ عَلَى مِلَّةِ رَسُولِ اللَّهِ ( صَلَّى اللَّهِ عَلَيْهِ وَآلِهِ )",
            "chunk_type": "body",
            "word_end": 72,
            "word_start": 47
          },
          {
            "arabic_text": "اللَّهُمَّ إِلَيْكَ أَسْلَمْتُ نَفْسِي وَ إِلَيْكَ وَجَّهْتُ وَجْهِي وَ إِلَيْكَ أَلْجَأْتُ ظَهْرِي وَ إِلَيْكَ فَوَّضْتُ أَمْرِي",
            "chunk_type": "body",
            "word_end": 88,
            "word_start": 72
          },
          {
            "arabic_text": "اللَّهُمَّ احْفَظْنِي بِحِفْظِ الْإِيمَانِ مِنْ بَيْنِ يَدَيَّ وَ مِنْ خَلْفِي وَ عَنْ يَمِينِي وَ عَنْ شِمَالِي وَ مِنْ فَوْقِي وَ مِنْ تَحْتِي وَ مِنْ قِبَلِي",
            "chunk_type": "body",
            "word_end": 113,
            "word_start": 88
          },
          {
            "arabic_text": "وَ ادْفَعْ عَنِّي بِحَوْلِكَ وَ قُوَّتِكَ فَإِنَّهُ لَا حَوْلَ وَ لَا قُوَّةَ إِلَّا بِكَ",
            "chunk_type": "body",
            "word_end": 127,
            "word_start": 113
          },
          {
            "arabic_text": "مُحَمَّدُ بْنُ يَحْيَى عَنْ أَحْمَدَ بْنِ مُحَمَّدِ بْنِ عِيسَى عَنِ ابْنِ أَبِي عُمَيْرٍ مِثْلَهُ",
