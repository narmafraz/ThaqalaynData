            "word_end": 18,
            "word_start": 0
          },
          {
            "arabic_text": "قُلْتُ لِأَبِي عَبْدِ اللَّهِ ( عَلَيْهِ السَّلَامُ ) يَدْخُلُنِيَ الْغَمُّ فَقَالَ أَكْثِرْ مِنْ أَنْ تَقُولَ اللَّهُ اللَّهُ رَبِّي لَا أُشْرِكُ بِهِ شَيْئاً",
            "chunk_type": "body",
            "word_end": 40,
            "word_start": 18
          },
          {
            "arabic_text": "فَإِذَا خِفْتَ وَسْوَسَةً أَوْ حَدِيثَ نَفْسٍ فَقُلِ اللَّهُمَّ إِنِّي عَبْدُكَ وَ ابْنُ عَبْدِكَ وَ ابْنُ أَمَتِكَ نَاصِيَتِي بِيَدِكَ عَدْلٌ فِيَّ حُكْمُكَ مَاضٍ فِيَّ قَضَاؤُكَ",
            "chunk_type": "body",
            "word_end": 64,
            "word_start": 40
          },
          {
            "arabic_text": "اللَّهُمَّ إِنِّي أَسْأَلُكَ بِكُلِّ اسْمٍ هُوَ لَكَ أَنْزَلْتَهُ فِي كِتَابِكَ أَوْ عَلَّمْتَهُ أَحَداً مِنْ خَلْقِكَ أَوِ اسْتَأْثَرْتَ بِهِ فِي عِلْمِ الْغَيْبِ عِنْدَكَ أَنْ تُصَلِّيَ عَلَى مُحَمَّدٍ وَ آلِ مُحَمَّدٍ",
            "chunk_type": "body",
            "word_end": 93,
            "word_start": 64
          },
          {
            "arabic_text": "وَ أَنْ تَجْعَلَ الْقُرْآنَ نُورَ بَصَرِي وَ رَبِيعَ قَلْبِي وَ جِلَاءَ حُزْنِي وَ ذَهَابَ هَمِّي اللَّهُ اللَّهُ رَبِّي لَا أُشْرِكُ بِهِ شَيْئاً",
