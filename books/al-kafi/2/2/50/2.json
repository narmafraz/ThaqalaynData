            "chunk_type": "isnad",
            "word_end": 22,
            "word_start": 0
          },
          {
            "arabic_text": "أَتَيْتُ بَابَ عَلِيِّ بْنِ الْحُسَيْنِ ( عَلَيْهِ السَّلَامُ ) فَوَافَقْتُهُ حِينَ خَرَجَ مِنَ الْبَابِ فَقَالَ: بِسْمِ اللَّهِ، آمَنْتُ بِاللَّهِ، وَ تَوَكَّلْتُ عَلَى اللَّهِ.",
            "chunk_type": "opening",
            "word_end": 45,
            "word_start": 22
          },
          {
            "arabic_text": "ثُمَّ قَالَ: يَا أَبَا حَمْزَةَ، إِنَّ الْعَبْدَ إِذَا خَرَجَ مِنْ مَنْزِلِهِ عُرِضَ لَهُ الشَّيْطَانُ، فَإِذَا قَالَ: بِسْمِ اللَّهِ، قَالَ الْمَلَكَانِ: كُفِيتَ، فَإِذَا قَالَ: آمَنْتُ بِاللَّهِ، قَالَا: هُدِيتَ، فَإِذَا قَالَ: تَوَكَّلْتُ عَلَى اللَّهِ، قَيَلَا: وُقِيتَ، فَيَتَنَحَّى الشَّيْطَانُ، فَيَقُولُ بَعْضُهُمْ لِبَعْضٍ: كَيْفَ لَنَا بِمَنْ هُدِيَ وَ كُفِيَ وَ وُقِيَ؟",
            "chunk_type": "body",
            "word_end": 92,
            "word_start": 45
          },
          {
            "arabic_text": "قَالَ: ثُمَّ قَالَ اللَّهُمَّ، إِنَّ عِرْضِي لَكَ الْيَوْمَ.",
            "chunk_type": "body",
            "word_end": 100,
            "word_start": 92
          },
          {
            "arabic_text": "ثُمَّ قَالَ: يَا أَبَا حَمْزَةَ، إِنْ تَرَكْتَ النَّاسَ لَمْ يَتْرُكُوكَ، وَ إِنْ رَفَضْتَهُمْ لَمْ يَرْفُضُوكَ. قُلْتُ: فَمَا أَصْنَعُ؟ قَالَ: أَعْطِهِمْ مِنْ عِرْضِكَ لِيَوْمِ فَقْرِكَ وَ فَاقَتِكَ.",
            "chunk_type": "body",
