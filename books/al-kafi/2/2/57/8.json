            "chunk_type": "isnad",
            "word_end": 24,
            "word_start": 0
          },
          {
            "arabic_text": "كَانَ رَسُولُ اللَّهِ ( صَلَّى اللَّهُ عَلَيْهِ وَآلِهِ ) فِي بَعْضِ مَغَازِيهِ إِذَا شَكَوْا إِلَيْهِ الْبَرَاغِيثَ أَنَّهَا تُؤْذِيهِمْ فَقَالَ إِذَا أَخَذَ أَحَدُكُمْ مَضْجَعَهُ فَلْيَقُلْ",
            "chunk_type": "body",
            "word_end": 48,
