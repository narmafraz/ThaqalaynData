            "chunk_type": "isnad",
            "word_end": 18,
            "word_start": 0
          },
          {
            "arabic_text": "مَرِضْتُ بِالْمَدِينَةِ مَرَضاً شَدِيداً فَبَلَغَ ذَلِكَ أَبَا عَبْدِ اللَّهِ ( عَلَيْهِ السَّلَامُ ) فَكَتَبَ إِلَيَّ قَدْ بَلَغَنِي عِلَّتُكَ فَاشْتَرِ صَاعاً مِنْ بُرٍّ ثُمَّ اسْتَلْقِ عَلَى قَفَاكَ وَ انْثُرْهُ عَلَى صَدْرِكَ كَيْفَمَا انْتَثَرَ وَ قُلِ",
            "chunk_type": "body",
            "word_end": 52,
            "word_start": 18
          },
          {
            "arabic_text": "اللَّهُمَّ إِنِّي أَسْأَلُكَ بِاسْمِكَ الَّذِي إِذَا سَأَلَكَ بِهِ الْمُضْطَرُّ كَشَفْتَ مَا بِهِ مِنْ ضُرٍّ وَ مَكَّنْتَ لَهُ فِي الْأَرْضِ وَ جَعَلْتَهُ خَلِيفَتَكَ عَلَى خَلْقِكَ أَنْ تُصَلِّيَ عَلَى مُحَمَّدٍ وَ آلِ مُحَمَّدٍ وَ أَنْ تُعَافِيَنِي مِنْ عِلَّتِي",
            "chunk_type": "body",
            "word_end": 88,
            "word_start": 52
          },
          {
            "arabic_text": "ثُمَّ اسْتَوِ جَالِساً وَ اجْمَعِ الْبُرَّ مِنْ حَوْلِكَ وَ قُلْ مِثْلَ ذَلِكَ وَ اقْسِمْهُ مُدّاً مُدّاً لِكُلِّ مِسْكِينٍ وَ قُلْ مِثْلَ ذَلِكَ",
            "chunk_type": "body",
            "word_end": 110,
            "word_start": 88
          },
          {
            "arabic_text": "قَالَ دَاوُدُ فَفَعَلْتُ ذَلِكَ فَكَأَنَّمَا نُشِطْتُ مِنْ عِقَالٍ وَ قَدْ فَعَلَهُ غَيْرُ وَاحِدٍ فَانْتَفَعَ بِهِ",
            "chunk_type": "closing",
