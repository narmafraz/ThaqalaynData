        "chunks": [
          {
            "arabic_text": "عِدَّةٌ مِنْ أَصْحَابِنَا عَنْ سَهْلِ بْنِ زِيَادٍ وَ أَحْمَدَ بْنِ مُحَمَّدٍ وَ عَلِيُّ بْنُ إِبْرَاهِيمَ عَنْ أَبِيهِ جَمِيعاً عَنِ الْحَسَنِ بْنِ مَحْبُوبٍ عَنْ مَالِكَ بْنِ عَطِيَّةَ عَنْ أَبِي حَمْزَةَ الثُّمَالِيِّ عَنْ أَبِي جَعْفَرٍ ( عَلَيْهِ السَّلَامُ ) قَالَ",
            "chunk_type": "isnad",
            "word_end": 38,
            "word_start": 0
          },
          {
            "arabic_text": "مَا مِنْ عَبْدٍ يَقُولُ إِذَا أَصْبَحَ قَبْلَ طُلُوعِ الشَّمْسِ اللَّهُ أَكْبَرُ اللَّهُ أَكْبَرُ كَبِيراً وَ سُبْحَانَ اللَّهِ بُكْرَةً وَ أَصِيلًا وَ الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ كَثِيراً لَا شَرِيكَ لَهُ وَ صَلَّى اللَّهُ عَلَى مُحَمَّدٍ وَ آلِهِ إِلَّا ابْتَدَرَهُنَّ مَلَكٌ وَ جَعَلَهُنَّ فِي جَوْفِ جَنَاحِهِ وَ صَعِدَ بِهِنَّ إِلَى السَّمَاءِ الدُّنْيَا",
            "chunk_type": "body",
            "word_end": 88,
            "word_start": 38
          },
          {
            "arabic_text": "فَتَقُولُ الْمَلَائِكَةُ مَا مَعَكَ فَيَقُولُ مَعِي كَلِمَاتٌ قَالَهُنَّ رَجُلٌ مِنَ الْمُؤْمِنِينَ وَ هِيَ كَذَا وَ كَذَا فَيَقُولُونَ رَحِمَ اللَّهُ مَنْ قَالَ هَؤُلَاءِ الْكَلِمَاتِ وَ غَفَرَ لَهُ",
            "chunk_type": "body",
            "word_end": 114,
            "word_start": 88
          },
          {
            "arabic_text": "قَالَ وَ كُلَّمَا مَرَّ بِسَمَاءٍ قَالَ لِأَهْلِهَا مِثْلَ ذَلِكَ فَيَقُولُونَ رَحِمَ اللَّهُ مَنْ قَالَ هَؤُلَاءِ الْكَلِمَاتِ وَ غَفَرَ لَهُ حَتَّى يَنْتَهِيَ بِهِنَّ إِلَى حَمَلَةِ الْعَرْشِ",
            "chunk_type": "body",
            "word_end": 139,
            "word_start": 114
          },
          {
            "arabic_text": "فَيَقُولُ لَهُمْ إِنَّ مَعِي كَلِمَاتٍ تَكَلَّمَ بِهِنَّ رَجُلٌ مِنَ الْمُؤْمِنِينَ وَ هِيَ كَذَا وَ كَذَا فَيَقُولُونَ رَحِمَ اللَّهُ هَذَا الْعَبْدَ وَ غَفَرَ لَهُ انْطَلِقْ بِهِنَّ إِلَى حَفَظَةِ كُنُوزِ مَقَالَةِ الْمُؤْمِنِينَ فَإِنَّ هَؤُلَاءِ كَلِمَاتُ الْكُنُوزِ حَتَّى تَكْتُبَهُنَّ فِي دِيوَانِ الْكُنُوزِ",
