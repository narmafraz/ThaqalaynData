            "arabic_text": "أَبُو عَلِيٍّ الْأَشْعَرِيُّ عَنْ مُحَمَّدِ بْنِ عَبْدِ الْجَبَّارِ عَنِ ابْنِ فَضَّالٍ عَنْ عَبْدِ اللَّهِ بْنِ إِبْرَاهِيمَ عَنْ جَعْفَرِ بْنِ إِبْرَاهِيمَ عَنْ أَبِي عَبْدِ اللَّهِ ( عَلَيْهِ السَّلَامُ ) قَالَ",
            "chunk_type": "isnad",
            "word_end": 29,
            "word_start": 0
          },
          {
            "arabic_text": "أَرْبَعَةٌ لَا تُسْتَجَابُ لَهُمْ دَعْوَةٌ رَجُلٌ جَالِسٌ فِي بَيْتِهِ يَقُولُ اللَّهُمَّ ارْزُقْنِي فَيُقَالُ لَهُ أَ لَمْ آمُرْكَ بِالطَّلَبِ وَ رَجُلٌ كَانَتْ لَهُ امْرَأَةٌ فَدَعَا عَلَيْهَا فَيُقَالُ لَهُ أَ لَمْ أَجْعَلْ أَمْرَهَا إِلَيْكَ",
            "chunk_type": "body",
            "word_end": 61,
            "word_start": 29
          },
          {
            "arabic_text": "وَ رَجُلٌ كَانَ لَهُ مَالٌ فَأَفْسَدَهُ فَيَقُولُ اللَّهُمَّ ارْزُقْنِي فَيُقَالُ لَهُ أَ لَمْ آمُرْكَ بِالِاقْتِصَادِ أَ لَمْ آمُرْكَ بِالْإِصْلَاحِ",
            "chunk_type": "body",
            "word_end": 80,
            "word_start": 61
          },
          {
            "arabic_text": "ثُمَّ قَالَ وَ الَّذِينَ إِذا أَنْفَقُوا لَمْ يُسْرِفُوا وَ لَمْ يَقْتُرُوا وَ كانَ بَيْنَ ذلِكَ قَوامَاً",
            "chunk_type": "body",
            "word_end": 96,
            "word_start": 80
          },
          {
            "arabic_text": "وَ رَجُلٌ كَانَ لَهُ مَالٌ فَأَدَانَهُ بِغَيْرِ بَيِّنَةٍ فَيُقَالُ لَهُ أَ لَمْ آمُرْكَ بِالشَّهَادَةِ",
            "chunk_type": "body",
            "word_end": 110,
            "word_start": 96
          },
          {
            "arabic_text": "مُحَمَّدُ بْنُ يَحْيَى عَنْ أَحْمَدَ بْنِ مُحَمَّدٍ عَنْ عَلِيِّ بْنِ الْحَكَمِ عَنْ عِمْرَانَ بْنِ أَبِي عَاصِمٍ عَنْ أَبِي عَبْدِ اللَّهِ ( عَلَيْهِ السَّلَامُ ) مِثْلَهُ",
