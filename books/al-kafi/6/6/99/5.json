        "chunks": [
          {
            "arabic_text": "مُحَمَّدُ بْنُ يَحْيَى عَنْ مُوسَى بْنِ الْحَسَنِ عَنْ بَعْضِ أَصْحَابِهِ عَنِ ابْنِ بَقَّاحٍ عَنْ هَارُونَ بْنِ الْخَطَّابِ عَنْ أَبِي الْحَسَنِ الرَّسَّانِ قَالَ",
            "chunk_type": "isnad",
            "word_end": 22,
            "word_start": 0
          },
          {
            "arabic_text": "كُنْتُ أَرْعَى جِمَالِي فِي طَرِيقِ الْخَوَرْنَقِ فَبَصُرْتُ بِقَوْمٍ قَادِمِينَ فَمِلْتُ إِلَى بَعْضِ مَنْ مَعَهُمْ فَقُلْتُ مَنْ هَؤُلَاءِ فَقَالَ جَعْفَرُ بْنُ مُحَمَّدٍ ( عَلَيْهِ السَّلَامُ ) وَ عَبْدُ اللَّهِ بْنُ الْحَسَنِ قُدِّمَ بِهِمَا عَلَى الْمَنْصُورِ",
            "chunk_type": "body",
            "word_end": 56,
            "word_start": 22
          },
          {
            "arabic_text": "قَالَ فَسَأَلْتُ عَنْهُمْ مِنْ بَعْدُ فَقِيلَ لِي إِنَّهُمْ نَزَلُوا بِالْحِيرَةِ فَبَكَّرْتُ لِأُسَلِّمَ عَلَيْهِمْ فَدَخَلْتُ فَإِذَا قُدَّامَهُمْ سِلَالٌ فِيهَا رُطَبٌ قَدْ أُهْدِيَتْ إِلَيْهِمْ مِنَ الْكُوفَةِ فَكُشِفَتْ قُدَّامَهُمْ فَمَدَّ يَدَهُ جَعْفَرُ بْنُ مُحَمَّدٍ ( عَلَيْهِ السَّلَامُ ) فَأَكَلَ وَ قَالَ لِي كُلْ ثُمَّ قَالَ لِعَبْدِ اللَّهِ بْنِ الْحَسَنِ يَا أَبَا مُحَمَّدٍ مَا تَرَى مَا أَحْسَنَ هَذَا الرُّطَبَ",
            "chunk_type": "body",
            "word_end": 111,
            "word_start": 56
          },
          {
            "arabic_text": "ثُمَّ الْتَفَتَ إِلَيَّ جَعْفَرُ بْنُ مُحَمَّدٍ ( عَلَيْهِ السَّلَامُ ) فَقَالَ لِي يَا أَهْلَ الْكُوفَةِ فُضِّلْتُمْ عَلَى النَّاسِ فِي المَطْعَمِ بِثَلَاثٍ سَمَكِكُمْ هَذَا الْبُنَانِيِّ وَ عِنَبِكُمْ هَذَا الرَّازِقِيِّ وَ رُطَبِكُمْ هَذَا الْمُشَانِ",
