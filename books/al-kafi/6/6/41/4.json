            "word_start": 0
          },
          {
            "arabic_text": "سَأَلْتُ أَبَا جَعْفَرٍ ( عَلَيْهِ السَّلَامُ ) عَنْ قَوْلِ اللَّهِ عَزَّ وَ جَلَّ يَوْمَ تُبَدَّلُ الْأَرْضُ غَيْرَ الْأَرْضِ قَالَ تُبَدَّلُ خُبْزَةً نَقِيَّةً يَأْكُلُ مِنْهَا النَّاسُ حَتَّى يَفْرُغُوا مِنَ الْحِسَابِ",
            "chunk_type": "body",
            "word_end": 50,
            "word_start": 21
          },
          {
            "arabic_text": "فَقَالَ لَهُ قَائِلٌ إِنَّهُمْ لَفِي شُغُلٍ يَوْمَئِذٍ عَنِ الْأَكْلِ وَ الشُّرْبِ فَقَالَ إِنَّ اللَّهَ عَزَّ وَ جَلَّ خَلَقَ ابْنَ آدَمَ أَجْوَفَ وَ لَا بُدَّ لَهُ مِنَ الطَّعَامِ وَ الشَّرَابِ أَ هُمْ أَشَدُّ شُغُلًا يَوْمَئِذٍ أَمْ مَنْ فِي النَّارِ",
            "chunk_type": "body",
            "word_end": 88,
            "word_start": 50
          },
          {
            "arabic_text": "فَقَدِ اسْتَغَاثُوا وَ اللَّهُ عَزَّ وَ جَلَّ يَقُولُ وَ إِنْ يَسْتَغِيثُوا يُغاثُوا بِمَاءٍ كَالْمُهْلِ يَشْوِي الْوُجُوهَ بِئْسَ الشَّرابُ",
