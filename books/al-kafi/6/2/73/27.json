        "chunks": [
          {
            "arabic_text": "عَلِيُّ بْنُ إِبْرَاهِيمَ عَنْ أَبِيهِ عَنِ النَّوْفَلِيِّ عَنِ السَّكُونِيِّ عَنْ أَبِي عَبْدِ اللَّهِ ( عَلَيْهِ السَّلَامُ ) قَالَ",
            "chunk_type": "isnad",
            "word_end": 18,
            "word_start": 0
          },
          {
            "arabic_text": "قَالَ أَمِيرُ الْمُؤْمِنِينَ ( عَلَيْهِ السَّلَامُ ) إِذَا قَالَتِ الْمَرْأَةُ زَوْجِي عَلَيَّ حَرَامٌ كَظَهْرِ أُمِّي فَلَا كَفَّارَةَ عَلَيْهَا",
            "chunk_type": "body",
            "word_end": 36,
            "word_start": 18
          },
          {
            "arabic_text": "قَالَ وَ جَاءَ رَجُلٌ مِنَ الْأَنْصَارِ مِنْ بَنِي النَّجَّارِ إِلَى رَسُولِ اللَّهِ ( صَلَّى اللَّهِ عَلَيْهِ وَآلِهِ ) فَقَالَ إِنِّي ظَاهَرْتُ مِنْ امْرَأَتِي فَوَاقَعْتُهَا قَبْلَ أَنْ أُكَفِّرَ",
            "chunk_type": "body",
            "word_end": 63,
            "word_start": 36
          },
          {
            "arabic_text": "فَقَالَ وَ مَا حَمَلَكَ عَلَى ذَلِكَ قَالَ لَمَّا ظَاهَرْتُ رَأَيْتُ بَرِيقَ خَلْخَالِهَا وَ بَيَاضَ سَاقِهَا فِي الْقَمَرِ فَوَاقَعْتُهَا قَبْلَ أَنْ أُكَفِّرَ",
            "chunk_type": "body",
            "word_end": 84,
            "word_start": 63
          },
          {
            "arabic_text": "فَقَالَ لَهُ اعْتَزِلْهَا حَتَّى تُكَفِّرَ وَ أَمَرَهُ بِكَفَّارَةٍ وَاحِدَةٍ وَ أَنْ يَسْتَغْفِرَ اللَّهَ",
            "chunk_type": "closing",
