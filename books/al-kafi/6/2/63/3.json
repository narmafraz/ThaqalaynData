        "chunks": [
          {
            "arabic_text": "عَلِيُّ بْنُ إِبْرَاهِيمَ عَنْ أَبِيهِ عَنِ ابْنِ أَبِي عُمَيْرٍ عَنْ أَبِي أَيُّوبَ عَنْ مُحَمَّدِ بْنِ مُسْلِمٍ عَنْ أَبِي عَبْدِ اللَّهِ ( عَلَيْهِ السَّلَامُ ) قَالَ",
            "chunk_type": "isnad",
            "word_end": 25,
            "word_start": 0
          },
          {
            "arabic_text": "الْمُخْتَلِعَةُ الَّتِي تَقُولُ لِزَوْجِهَا اخْلَعْنِي وَ أَنَا أُعْطِيكَ مَا أَخَذْتُ مِنْكَ فَقَالَ لَا يَحِلُّ لَهُ أَنْ يَأْخُذَ مِنْهَا شَيْئاً حَتَّى تَقُولَ وَ اللَّهِ لَا أُبِرُّ لَكَ قَسَمَاً وَ لَا أُطِيعُ لَكَ أَمْراً وَ لآَذَنَنَّ فِي بَيْتِكَ بِغَيْرِ إِذْنِكَ وَ لَأُوطِئَنَّ فِرَاشَكَ غَيْرَكَ فَإِذَا فَعَلَتْ ذَلِكَ مِنْ غَيْرِ أَنْ يَعْلَمَهَا حَلَّ لَهُ مَا أَخَذَ مِنْهَا وَ كَانَتْ تَطْلِيقَةً بِغَيْرِ طَلَاقٍ يَتْبَعُهَا فَكَانَتْ بَائِناً بِذَلِكَ وَ كَانَ خَاطِباً مِنَ الْخُطَّابِ",
            "chunk_type": "body",
            "word_end": 93,
            "word_start": 25
          },
          {
            "arabic_text": "بِاللَّهِ لَا أُبِرُّ لَكَ قَسَمَاً وَ لَا أُطِيعُ لَكَ أَمْراً وَ لآَذَنَنَّ فِي بَيْتِكَ بِغَيْرِ إِذْنِكَ وَ لَأُوطِئَنَّ فِرَاشَكَ غَيْرَكَ",
            "chunk_type": "body",
            "word_end": 113,
            "word_start": 93
          },
          {
            "arabic_text": "فَإِذَا فَعَلَتْ ذَلِكَ مِنْ غَيْرِ أَنْ يَعْلَمَهَا حَلَّ لَهُ مَا أَخَذَ مِنْهَا وَ كَانَتْ تَطْلِيقَةً بِغَيْرِ طَلَاقٍ يَتْبَعُهَا فَكَانَتْ بَائِناً بِذَلِكَ وَ كَانَ خَاطِباً مِنَ الْخُطَّابِ",
