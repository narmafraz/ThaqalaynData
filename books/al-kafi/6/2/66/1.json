            "word_end": 17,
            "word_start": 0
          },
          {
            "arabic_text": "سَأَلْتُ أَبَا الْحَسَنِ ( عَلَيْهِ السَّلَامُ ) عَنْ قَوْلِ اللَّهِ عَزَّ وَ جَلَّ وَ إِنِ امْرَأَةٌ خافَتْ مِنْ بَعْلِها نُشُوزاً أَوْ إِعْراضاً",
            "chunk_type": "body",
            "word_end": 39,
            "word_start": 17
          },
          {
            "arabic_text": "فَقَالَ إِذَا كَانَ كَذَلِكَ فَهَمَّ بِطَلَاقِهَا قَالَتْ لَهُ أَمْسِكْنِي وَ أَدَعَ لَكَ بَعْضَ مَا عَلَيْكَ وَ أُحَلِّلَكَ مِنْ يَوْمِي وَ لَيْلَتِي حَلَّ لَهُ ذَلِكَ وَ لَا جُنَاحَ عَلَيْهِمَا",
            "chunk_type": "body",
            "word_end": 67,
            "word_start": 39
          },
