        "chunks": [
          {
            "arabic_text": "حُمَيْدُ بْنُ زِيَادٍ عَنِ ابْنِ سَمَاعَةَ عَنْ غَيْرِ وَاحِدٍ عَنْ أَبَانٍ عَنْ زُرَارَةَ عَنْ أَحَدِهِمَا (عَلَيْهِمَا السَّلَامُ)",
            "chunk_type": "isnad",
            "word_end": 17,
            "word_start": 0
          },
          {
            "arabic_text": "فِي رَجُلٍ يُطَلِّقُ امْرَأَتَهُ تَطْلِيقَةً ثُمَّ يَدَعُهَا حَتَّى تَمْضِيَ ثَلَاثَةُ أَشْهُرٍ إِلَّا يَوْمًا ثُمَّ يُرَاجِعُهَا فِي مَجْلِسٍ ثُمَّ يُطَلِّقُهَا ثُمَّ فَعَلَ ذَلِكَ فِي آخِرِ الثَّلَاثَةِ الْأَشْهُرِ أَيْضًا",
            "chunk_type": "body",
            "word_end": 44,
            "word_start": 17
          },
          {
            "arabic_text": "قَالَ فَقَالَ إِذَا أَدْخَلَ الرَّجْعَةَ اعْتَدَّتْ بِالتَّطْلِيقَةِ الْأَخِيرَةِ وَإِذَا طَلَّقَ بِغَيْرِ رَجْعَةٍ لَمْ يَكُنْ لَهُ طَلَاقٌ",
            "chunk_type": "closing",
