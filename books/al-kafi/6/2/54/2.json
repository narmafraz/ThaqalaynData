            "arabic_text": "عَلِيٌّ عَنْ أَبِيهِ عَنِ ابْنِ أَبِي عُمَيْرٍ عَنْ عُمَرَ بْنِ أُذَيْنَةَ عَنْ زُرَارَةَ عَنْ أَبِي جَعْفَرٍ ( عَلَيْهِ السَّلَامُ ) قَالَ",
            "chunk_type": "isnad",
            "word_end": 21,
            "word_start": 0
          },
          {
            "arabic_text": "سَأَلْتُهُ عَنْ طَلَاقِ الْمُكْرَهِ وَ عِتْقِهِ فَقَالَ لَيْسَ طَلَاقُهُ بِطَلَاقٍ وَ لَا عِتْقُهُ بِعِتْقٍ",
            "chunk_type": "body",
            "word_end": 35,
            "word_start": 21
          },
          {
            "arabic_text": "فَقُلْتُ إِنِّي رَجُلٌ تَاجِرٌ أَمُرُّ بِالْعَشَّارِ وَ مَعِي مَالٌ",
            "chunk_type": "body",
            "word_end": 44,
            "word_start": 35
          },
          {
            "arabic_text": "فَقَالَ غَيِّبْهُ مَا اسْتَطَعْتَ وَ ضَعْهُ مَوَاضِعَهُ",
            "chunk_type": "body",
            "word_end": 51,
            "word_start": 44
          },
          {
            "arabic_text": "فَقُلْتُ وَ إِنْ حَلَّفَنِي بِالطَّلَاقِ وَ الْعَتَاقِ",
            "chunk_type": "body",
            "word_end": 58,
            "word_start": 51
          },
          {
            "arabic_text": "فَقَالَ احْلِفْ لَهُ ثُمَّ أَخَذَ تَمْرَةً فَحَفَنَ بِهَا مِنْ زُبْدٍ كَانَ قُدَّامَهُ",
            "chunk_type": "body",
            "word_end": 70,
            "word_start": 58
          },
          {
            "arabic_text": "فَقَالَ مَا أُبَالِي حَلَفْتُ لَهُمْ بِالطَّلَاقِ وَ الْعَتَاقِ أَوْ أَكَلْتُهَا",
