            "arabic_text": "حُمَيْدُ بْنُ زِيَادٍ عَنِ ابْنِ سَمَاعَةَ عَنْ مُحَمَّدِ بْنِ زِيَادٍ عَنْ عَبْدِ اللَّهِ بْنِ سِنَانٍ وَعَلِيُّ بْنُ إِبْرَاهِيمَ عَنْ أَبِيهِ عَنْ عُثْمَانَ بْنِ عِيسَى عَنْ سَمَاعَةَ جَمِيعاً عَنْ أَبِي عَبْدِ اللَّهِ ( عَلَيْهِ السَّلَامُ ) أَنَّهُ قَالَ",
            "chunk_type": "isnad",
            "word_end": 37,
            "word_start": 0
          },
          {
            "arabic_text": "فِي قَوْلِ اللَّهِ عَزَّ وَ جَلَّ وَ لِلْمُطَلَّقاتِ مَتَاعٌ بِالْمَعْرُوفِ حَقًّا عَلَى الْمُتَّقِينَ",
            "chunk_type": "body",
            "word_end": 50,
            "word_start": 37
          },
          {
            "arabic_text": "قَالَ مَتَاعُهَا بَعْدَ مَا تَنْقَضِي عِدَّتُهَا عَلَى الْمُوسِعِ قَدَرُهُ وَعَلَى الْمُقْتِرِ قَدَرُهُ",
            "chunk_type": "body",
            "word_end": 62,
            "word_start": 50
          },
          {
            "arabic_text": "قَالَ كَيْفَ يُمَتِّعُهَا فِي عِدَّتِهَا وَ هِيَ تَرْجُوهُ وَ يَرْجُوهَا وَ يُحْدِثُ اللَّهُ مَا يَشَاءُ",
            "chunk_type": "body",
            "word_end": 77,
            "word_start": 62
          },
          {
            "arabic_text": "أَمَا إِنَّ الرَّجُلَ الْمُوسِعَ يُمَتِّعُ الْمَرْأَةَ بِالْعَبْدِ وَ الْأَمَةِ وَ يُمَتِّعُ الْفَقِيرُ بِالْحِنْطَةِ وَ التَّمْرِ وَ الزَّبِيبِ وَ الثَّوْبِ وَ الدَّرَاهِمِ",
            "chunk_type": "body",
            "word_end": 98,
            "word_start": 77
          },
          {
            "arabic_text": "وَ إِنَّ الْحَسَنَ بْنَ عَلِيٍّ ( عَلَيْهِ السَّلَامُ ) مَتَّعَ امْرَأَةً طَلَّقَهَا بِأَمَةٍ وَ لَمْ يَكُنْ يُطَلِّقُ امْرَأَةً إِلَّا مَتَّعَهَا",
            "chunk_type": "body",
            "word_end": 118,
