        "chunks": [
          {
            "arabic_text": "عِدَّةٌ مِنْ أَصْحَابِنَا عَنْ سَهْلِ بْنِ زِيَادٍ عَنْ هَارُونَ بْنِ مُسْلِمٍ عَنْ مَسْعَدَةَ بْنِ صَدَقَةَ عَنْ أَبِي عَبْدِ اللَّهِ ( عَلَيْهِ السَّلَامُ ) قَالَ",
            "chunk_type": "isnad",
            "word_end": 24,
            "word_start": 0
          },
          {
            "arabic_text": "كَانَ عِنْدَ أَبِي قَوْمٌ فَاخْتَلَفُوا فِي النَّبِيذِ فَقَالَ بَعْضُهُمْ الْقَدَحُ الَّذِي يُسْكِرُ هُوَ حَرَامٌ فَقَالَ بَعْضُهُمْ قَلِيلُ مَا أَسْكَرَ وَ كَثِيرُهُ حَرَامٌ فَرَدُّوا الْأَمْرَ إِلَى أَبِي ( عَلَيْهِ السَّلَامُ ) فَقَالَ أَبِي أَ رَأَيْتُمُ الْقِسْطَ لَوْ لَا مَا يُطْرَحُ فِيهِ أَوَّلًا كَانَ يَمْتَلِئُ وَ كَذَلِكَ الْقَدَحُ الْآَرُ لَوْ لَا الْأَوَّلُ مَا أَسْكَرَ",
            "chunk_type": "body",
            "word_end": 76,
            "word_start": 24
          },
          {
            "arabic_text": "قَالَ ثُمَّ قَالَ ( عَلَيْهِ السَّلَامُ ) إِنَّ رَسُولَ اللَّهِ ( صَلَّى اللَّهِ عَلَيْهِ وَآلِهِ ) قَالَ مَنْ أَدْخَلَ عِرْقاً وَاحِداً مِنْ عُرُوقِهِ قَلِيلَ مَا أَسْكَرَ كَثِيرُهُ عَذَّبَ اللَّهُ ذَلِكَ الْعِرْقَ بِثَلَاثِمِائَةٍ وَ سِتِّينَ نَوْعاً مِنْ أَنْوَاعِ الْعَذَابِ",
