            "chunk_type": "isnad",
            "word_end": 14,
            "word_start": 0
          },
          {
            "arabic_text": "نَزَلْنَا الْمَدِينَةَ فَأَتَيْنَا أَبَا عَبْدِ اللَّهِ ( عَلَيْهِ السَّلَامُ ) فَقَالَ لَنَا أَيْنَ نَزَلْتُمْ فَقُلْنَا عَلَى فُلَانٍ صَاحِبِ الْقِيَانِ فَقَالَ كُونُوا كِرَامَاً فَوَ اللَّهِ مَا عَلِمْنَا مَا أَرَادَ بِهِ وَ ظَنَنَا أَنَّهُ يَقُولُ تَفَضَّلُوا عَلَيْهِ فَعُدْنَا إِلَيْهِ فَقُلْنَا إِنَّا لَا نَدْرِي مَا أَرَدْتَ بِقَوْلِكَ كُونُوا كِرَامَاً",
            "chunk_type": "body",
            "word_end": 60,
