            "arabic_text": "عَلِيُّ بْنُ إِبْرَاهِيمَ عَنْ أَبِيهِ عَنِ ابْنِ أَبِي عُمَيْرٍ عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْحَجَّاجِ قَالَ",
            "chunk_type": "isnad",
            "word_end": 15,
            "word_start": 0
          },
          {
            "arabic_text": "اسْتَأْذَنْتُ لِبَعْضِ أَصْحَابِنَا عَلَى أَبِي عَبْدِ اللَّهِ ( عَلَيْهِ السَّلَامُ ) فَسَأَلَهُ عَنِ النَّبِيذِ فَقَالَ حَلَالٌ فَقَالَ أَصْلَحَكَ اللَّهُ إِنَّمَا سَأَلْتُكَ عَنِ النَّبِيذِ الَّذِي يُجْعَلُ فِيهِ الْعَكَرُ فَيَغْلِي حَتَّى يُسْكِرَ",
            "chunk_type": "body",
            "word_end": 45,
            "word_start": 15
          },
          {
            "arabic_text": "فَقَالَ أَبُو عَبْدِ اللَّهِ ( عَلَيْهِ السَّلَامُ ) قَالَ رَسُولُ اللَّهِ ( صَلَّى اللَّهِ عَلَيْهِ وَآلِهِ ) كُلُّ مُسْكِرٍ حَرَامٌ",
            "chunk_type": "body",
            "word_end": 65,
            "word_start": 45
          },
          {
            "arabic_text": "فَقَالَ الرَّجُلُ أَصْلَحَكَ اللَّهُ فَإِنَّ مَنْ عِنْدَنَا بِالْعِرَاقِ يَقُولُونَ إِنَّ رَسُولَ اللَّهِ ( صَلَّى اللَّهِ عَلَيْهِ وَآلِهِ ) إِنَّمَا عَنَى بِذَلِكَ الْقَدَحَ الَّذِي يُسْكِرُ",
            "chunk_type": "body",
            "word_end": 89,
            "word_start": 65
          },
          {
            "arabic_text": "فَقَالَ أَبُو عَبْدِ اللَّهِ ( عَلَيْهِ السَّلَامُ ) إِنَّ مَا أَسْكَرَ كَثِيرُهُ فَقَلِيلُهُ حَرَامٌ",
            "chunk_type": "body",
            "word_end": 103,
            "word_start": 89
          },
          {
            "arabic_text": "فَقَالَ لَهُ الرَّجُلُ فَأَكْسِرُهُ بِالْمَاءِ",
            "chunk_type": "body",
            "word_end": 108,
            "word_start": 103
          },
          {
            "arabic_text": "فَقَالَ أَبُو عَبْدِ اللَّهِ ( عَلَيْهِ السَّلَامُ ) لَا وَ مَا لِلْمَاءِ أَنْ يُحَلِّلَ الْحَرَامَ اتَّقِ اللَّهَ عَزَّ وَ جَلَّ وَ لَا تَشْرَبْهُ",
