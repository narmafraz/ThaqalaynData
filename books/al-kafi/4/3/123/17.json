            "chunk_type": "body",
            "word_end": 102,
            "word_start": 95
          },
          {
            "arabic_text": "قَالَ فَقَالَ قَدْ زَعَمْتَ أَنَّ رَسُولَ اللَّهِ ( صَلَّى اللَّهِ عَلَيْهِ وَآلِهِ ) اسْتَلَمَهُ قَالَ نَعَمْ",
            "chunk_type": "body",
            "word_end": 118,
            "word_start": 102
          },
          {
