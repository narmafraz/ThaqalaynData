            "chunk_type": "quran_quote",
            "word_end": 64,
            "word_start": 53
          },
          {
            "arabic_text": "لَا شَرِيكَ لَهُ وَ بِذَلِكَ أُمِرْتُ وَ أَنَا مِنَ الْمُسْلِمِينَ",
            "chunk_type": "body",
            "word_end": 74,
            "word_start": 64
          },
          {
            "arabic_text": "اللَّهُمَّ مِنْكَ وَ لَكَ بِسْمِ اللَّهِ وَ اللَّهُ أَكْبَرُ اللَّهُمَّ تَقَبَّلْ مِنِّي",
