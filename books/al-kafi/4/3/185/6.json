          {
            "arabic_text": "قَالَ أَبُو عَبْدِ اللَّهِ ( عَلَيْهِ السَّلَامُ ) إِذَا اشْتَرَيْتَ هَدْيَكَ فَاسْتَقْبِلْ بِهِ الْقِبْلَةَ وَ انْحَرْهُ أَوِ اذْبَحْهُ",
            "chunk_type": "body",
            "word_end": 38,
            "word_start": 20
