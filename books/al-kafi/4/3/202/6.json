            "chunk_type": "body",
            "word_end": 53,
            "word_start": 38
          },
          {
            "arabic_text": "وَ صَلِّ بَيْنَ الْعَمُودَيْنِ اللَّذَيْنِ يَلِيَانِ عَلَى الرُّخَامَةِ الْحَمْرَاءِ",
