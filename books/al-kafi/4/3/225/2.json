          {
            "arabic_text": "مُحَمَّدُ بْنُ يَحْيَى عَنْ مُحَمَّدِ بْنِ الْحُسَيْنِ عَنِ الْحَجَّالِ عَنْ عَبْدِ الصَّمَدِ بْنِ بَشِيرٍ عَنْ حَسَّانَ الْجَمَّالِ قَالَ",
            "chunk_type": "isnad",
            "word_end": 18,
            "word_start": 0
          },
          {
            "arabic_text": "حَمَلْتُ أَبَا عَبْدِ اللَّهِ ( عَلَيْهِ السَّلَامُ ) مِنَ الْمَدِينَةِ إِلَى مَكَّةَ فَلَمَّا انْتَهَيْنَا إِلَى مَسْجِدِ الْغَدِيرِ نَظَرَ إِلَى مَيْسَرَةِ الْمَسْجِدِ فَقَالَ ذَلِكَ مَوْضِعُ قَدَمِ رَسُولِ اللَّهِ ( صَلَّى اللَّهِ عَلَيْهِ وَآلِهِ ) حَيْثُ قَالَ مَنْ كُنْتُ مَوْلَاهُ فَعَلِيٌّ مَوْلَاهُ",
            "chunk_type": "body",
            "word_end": 58,
            "word_start": 18
          },
          {
            "arabic_text": "ثُمَّ نَظَرَ إِلَى الْجَانِبِ الْآخَرِ فَقَالَ ذَلِكَ مَوْضِعُ فُسْطَاطِ أَبِي فُلَانٍ وَ فُلَانٍ وَ سَالِمٍ مَوْلَى أَبِي حُذَيْفَةَ وَ أَبِي عُبَيْدَةَ الْجَرَّاحِ",
            "chunk_type": "body",
            "word_end": 80,
            "word_start": 58
          },
          {
            "arabic_text": "فَلَمَّا أَنْ رَأَوْهُ رَافِعاً يَدَيْهِ قَالَ بَعْضُهُمْ لِبَعْضٍ انْظُرُوا إِلَى عَيْنَيْهِ تَدُورُ كَأَنَّهُمَا عَيْنَا مَجْنُونٍ",
            "chunk_type": "body",
            "word_end": 95,
            "word_start": 80
          },
          {
            "arabic_text": "فَنَزَلَ جَبْرَئِيلُ ( عَلَيْهِ السَّلَامُ ) بِهَذِهِ الْآيَةِ وَ إِنْ يَكادُ الَّذِينَ كَفَرُوا لَيُزْلِقُونَكَ بِأَبْصارِهِمْ لَمَّا سَمِعُوا الذِّكْرَ وَ يَقُولُونَ إِنَّهُ لَمَجْنُونٌ وَ مَا هُوَ إِلَّا ذِكْرٌ لِلْعالَمِينَ",
