        "chunks": [
          {
            "arabic_text": "عَلِيُّ بْنُ إِبْرَاهِيمَ عَنْ أَبِيهِ وَ مُحَمَّدُ بْنُ إِسْمَاعِيلَ عَنِ الْفَضْلِ بْنِ شَاذَانَ عَنْ صَفْوَانَ وَ ابْنِ أَبِي عُمَيْرٍ عَنْ مُعَاوِيَةَ بْنِ عَمَّارٍ عَنْ أَبِي عَبْدِ اللَّهِ ( عَلَيْهِ السَّلَامُ ) قَالَ",
            "chunk_type": "isnad",
            "word_end": 32,
            "word_start": 0
          },
          {
            "arabic_text": "لَا تَبِتْ لَيَالِيَ التَّشْرِيقِ إِلَّا بِمِنًى فَإِنْ بِتَّ فِي غَيْرِهَا فَعَلَيْكَ دَمٌ وَ إِنْ خَرَجْتَ أَوَّلَ اللَّيْلِ فَلَا يَنْتَصِفْ لَكَ اللَّيْلُ إِلَّا وَ أَنْتَ بِمِنًى إِلَّا أَنْ يَكُونَ شُغُلُكَ بِنُسُكِكَ أَوْ قَدْ خَرَجْتَ مِنْ مَكَّةَ وَ إِنْ خَرَجْتَ نِصْفَ اللَّيْلِ فَلَا يَضُرُّكَ أَنْ تُصْبِحَ بِغَيْرِهَا",
            "chunk_type": "body",
            "word_end": 77,
            "word_start": 32
          },
          {
            "arabic_text": "قَالَ وَ سَأَلْتُهُ عَنْ رَجُلٍ زَارَ عِشَاءً فَلَمْ يَزَلْ فِي طَوَافِهِ وَ دُعَائِهِ وَ فِي السَّعْيِ بَيْنَ الصَّفَا وَ الْمَرْوَةِ حَتَّى يَطْلُعَ الْفَجْرُ قَالَ لَيْسَ عَلَيْهِ شَيْ‏ءٌ كَانَ فِي طَاعَةِ اللَّهِ",
