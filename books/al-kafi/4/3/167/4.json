        "chunks": [
          {
            "arabic_text": "عَلِيُّ بْنُ إِبْرَاهِيمَ عَنْ أَبِيهِ عَنِ ابْنِ أَبِي عُمَيْرٍ وَ مُحَمَّدُ بْنُ إِسْمَاعِيلَ عَنِ الْفَضْلِ بْنِ شَاذَانَ عَنْ صَفْوَانَ بْنِ يَحْيَى وَ ابْنِ أَبِي عُمَيْرٍ عَنْ مُعَاوِيَةَ بْنِ عَمَّارٍ عَنْ أَبِي عَبْدِ اللَّهِ ( عَلَيْهِ السَّلَامُ ) قَالَ",
            "chunk_type": "isnad",
            "word_end": 38,
            "word_start": 0
          },
          {
            "arabic_text": "أَصْبِحْ عَلَى طُهْرٍ بَعْدَ مَا تُصَلِّي الْفَجْرَ فَقِفْ إِنْ شِئْتَ قَرِيباً مِنَ الْجَبَلِ وَ إِنْ شِئْتَ حَيْثُ شِئْتَ",
            "chunk_type": "body",
            "word_end": 56,
            "word_start": 38
          },
          {
            "arabic_text": "فَإِذَا وَقَفْتَ فَاحْمَدِ اللَّهَ وَ أَثْنِ عَلَيْهِ وَ اذْكُرْ مِنْ آلَائِهِ وَ بَلَائِهِ مَا قَدَرْتَ عَلَيْهِ وَ صَلِّ عَلَى النَّبِيِّ ( صَلَّى اللَّهِ عَلَيْهِ وَآلِهِ )",
            "chunk_type": "body",
            "word_end": 82,
            "word_start": 56
          },
          {
            "arabic_text": "وَلْيَكُنْ مِنْ قَوْلِكَ اللَّهُمَّ رَبَّ الْمَشْعَرِ الْحَرَامِ فُكَّ رَقَبَتِي مِنَ النَّارِ وَ أَوْسِعْ عَلَيَّ مِنْ رِزْقِكَ الْحَلَالِ وَ ادْرَأْ عَنِّي شَرَّ فَسَقَةِ الْجِنِّ وَ الْإِنْسِ",
            "chunk_type": "body",
            "word_end": 107,
            "word_start": 82
          },
          {
            "arabic_text": "اللَّهُمَّ أَنْتَ خَيْرُ مَطْلُوبٍ إِلَيْهِ وَ خَيْرُ مَدْعُوٍّ وَ خَيْرُ مَسْئُولٍ وَ لِكُلِّ وَافِدٍ جَائِزَةٌ فَاجْعَلْ جَائِزَتِي فِي مَوْطِنِي هَذَا أَنْ تُقِيلَنِي عَثْرَتِي وَ تَقْبَلَ مَعْذِرَتِي وَ أَنْ تَجَاوَزَ عَنْ خَطِيئَتِي ثُمَّ اجْعَلِ التَّقْوَى مِنَ الدُّنْيَا زَادِي",
            "chunk_type": "body",
            "word_end": 144,
            "word_start": 107
          },
          {
            "arabic_text": "ثُمَّ أَفِضْ حِينَ يُشْرِقُ لَكَ ثَبِيرٌ وَ تَرَى الْإِبِلُ مَوْضِعَ أَخْفَافِهَا",
            "chunk_type": "closing",
