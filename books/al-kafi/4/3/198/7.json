            "word_end": 24,
            "word_start": 0
          },
          {
            "arabic_text": "إِذَا نَفَرْتَ فِي النَّفْرِ الْأَوَّلِ فَإِنْ شِئْتَ أَنْ تُقِيمَ بِمَكَّةَ وَ تَبِيتَ بِهَا فَلَا بَأْسَ بِذَلِكَ",
