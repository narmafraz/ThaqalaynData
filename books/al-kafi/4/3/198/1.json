            "word_start": 0
          },
          {
            "arabic_text": "قُلْتُ لِأَبِي عَبْدِ اللَّهِ ( عَلَيْهِ السَّلَامُ ) إِنَّا نُرِيدُ أَنْ نَتَعَجَّلَ السَّيْرَ وَ كَانَتْ لَيْلَةُ النَّفْرِ حِينَ سَأَلْتُهُ فَأَيَّ سَاعَةٍ نَنْفِرُ",
            "chunk_type": "body",
            "word_end": 41,
            "word_start": 19
          },
          {
            "arabic_text": "فَقَالَ لِي أَمَّا الْيَوْمَ الثَّانِيَ فَلَا تَنْفِرْ حَتَّى تَزُولَ الشَّمْسُ وَ كَانَتْ لَيْلَةُ النَّفْرِ",
            "chunk_type": "body",
            "word_end": 55,
            "word_start": 41
          },
          {
            "arabic_text": "وَ أَمَّا الْيَوْمَ الثَّالِثَ فَإِذَا ابْيَضَّتِ الشَّمْسُ فَانْفِرْ عَلَى بَرَكَةِ اللَّهِ",
            "chunk_type": "body",
            "word_end": 66,
            "word_start": 55
          },
          {
            "arabic_text": "فَمَنْ تَعَجَّلَ فِي يَوْمَيْنِ فَلَا إِثْمَ عَلَيْهِ وَ مَنْ تَأَخَّرَ فَلَا إِثْمَ عَلَيْهِ",
            "chunk_type": "quran_quote",
            "word_end": 79,
            "word_start": 66
          },
          {
            "arabic_text": "فَلَوْ سَكَتَ لَمْ يَبْقَ أَحَدٌ إِلَّا تَعَجَّلَ وَ لَكِنَّهُ قَالَ وَ مَنْ تَأَخَّرَ فَلَا إِثْمَ عَلَيْهِ",
