            "arabic_text": "عِدَّةٌ مِنْ أَصْحَابِنَا عَنْ أَحْمَدَ بْنِ مُحَمَّدٍ عَنْ مُعَاوِيَةَ بْنِ حُكَيْمٍ عَنْ مُحَمَّدِ بْنِ أَبِي عُمَيْرٍ عَنِ الْحَسَنِ بْنِ عَلِيٍّ الصَّيْرَفِيِّ عَنْ بَعْضِ أَصْحَابِنَا قَالَ",
            "chunk_type": "isnad",
            "word_end": 25,
            "word_start": 0
          },
          {
            "arabic_text": "سُئِلَ أَبُو عَبْدِ اللَّهِ ( عَلَيْهِ السَّلَامُ ) عَنِ السَّعْيِ بَيْنَ الصَّفَا وَ الْمَرْوَةِ فَرِيضَةٌ أَمْ سُنَّةٌ فَقَالَ فَرِيضَةٌ",
            "chunk_type": "body",
            "word_end": 44,
            "word_start": 25
          },
          {
            "arabic_text": "قُلْتُ أَ وَ لَيْسَ قَالَ اللَّهُ عَزَّ وَ جَلَّ فَلَا جُناحَ عَلَيْهِ أَنْ يَطَّوَّفَ بِهِمَا",
            "chunk_type": "body",
            "word_end": 59,
            "word_start": 44
          },
          {
            "arabic_text": "قَالَ كَانَ ذَلِكَ فِي عُمْرَةِ الْقَضَاءِ",
            "chunk_type": "body",
            "word_end": 65,
            "word_start": 59
          },
          {
            "arabic_text": "إِنَّ رَسُولَ اللَّهِ ( صَلَّى اللَّهِ عَلَيْهِ وَآلِهِ ) شَرَطَ عَلَيْهِمْ أَنْ يَرْفَعُوا الْأَصْنَامَ مِنَ الصَّفَا وَ الْمَرْوَةِ",
            "chunk_type": "body",
            "word_end": 83,
            "word_start": 65
          },
          {
            "arabic_text": "فَتَشَاغَلَ رَجُلٌ وَ تَرَكَ السَّعْيَ حَتَّى انْقَضَتِ الْأَيَّامُ وَ أُعِيدَتِ الْأَصْنَامُ",
            "chunk_type": "body",
            "word_end": 94,
            "word_start": 83
          },
          {
            "arabic_text": "فَجَاءُوا إِلَيْهِ فَقَالُوا يَا رَسُولَ اللَّهِ إِنَّ فُلَاناً لَمْ يَسْعَ بَيْنَ الصَّفَا وَ الْمَرْوَةِ وَ قَدْ أُعِيدَتِ الْأَصْنَامُ",
            "chunk_type": "body",
            "word_end": 112,
            "word_start": 94
          },
          {
            "arabic_text": "فَأَنْزَلَ اللَّهُ عَزَّ وَ جَلَّ فَلَا جُناحَ عَلَيْهِ أَنْ يَطَّوَّفَ بِهِمَا",
            "chunk_type": "quran_quote",
            "word_end": 123,
            "word_start": 112
          },
          {
