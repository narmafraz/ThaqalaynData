          },
          {
            "arabic_text": "كَتَبْتُ إِلَى أَبِي عَبْدِ اللَّهِ ( عَلَيْهِ السَّلَامُ ) بِمَسَائِلَ بَعْضُهَا مَعَ ابْنِ بُكَيْرٍ وَ بَعْضُهَا مَعَ أَبِي الْعَبَّاسِ فَجَاءَ الْجَوَابُ بِإِمْلَائِهِ",
            "chunk_type": "body",
            "word_end": 36,
            "word_start": 14
          },
          {
            "arabic_text": "سَأَلْتَ عَنْ قَوْلِ اللَّهِ عَزَّ وَ جَلَّ وَ لِلَّهِ عَلَى النَّاسِ حِجُّ الْبَيْتِ مَنِ اسْتَطاعَ إِلَيْهِ سَبِيلًا",
            "chunk_type": "body",
            "word_end": 53,
            "word_start": 36
          },
          {
            "arabic_text": "يَعْنِي بِهِ الْحَجَّ وَ الْعُمْرَةَ جَمِيعاً لِأَنَّهُمَا مَفْرُوضَانِ",
            "chunk_type": "body",
            "word_end": 61,
            "word_start": 53
          },
          {
            "arabic_text": "وَ سَأَلْتُهُ عَنْ قَوْلِ اللَّهِ عَزَّ وَ جَلَّ وَ أَتِمُّوا الْحَجَّ وَ الْعُمْرَةَ لِلَّهِ",
            "chunk_type": "body",
            "word_end": 75,
            "word_start": 61
          },
          {
            "arabic_text": "قَالَ يَعْنِي بِتَمَامِهِمَا أَدَاءَهُمَا وَ اتِّقَاءَ مَا يَتَّقِي الْمُحْرِمُ فِيهِمَا",
            "chunk_type": "body",
            "word_end": 85,
            "word_start": 75
          },
          {
            "arabic_text": "وَ سَأَلْتُهُ عَنْ قَوْلِهِ تَعَالَى الْحَجِّ الْأَكْبَرِ",
            "chunk_type": "body",
            "word_end": 92,
            "word_start": 85
          },
          {
            "arabic_text": "مَا يَعْنِي بِالْحَجِّ الْأَكْبَرِ",
            "chunk_type": "body",
            "word_end": 96,
            "word_start": 92
