            "chunk_type": "body",
            "word_end": 56,
            "word_start": 41
          },
          {
            "arabic_text": "أَشْهَدُ أَنَّكَ قَدْ نَصَحْتَ لِأُمَّتِكَ وَ جَاهَدْتَ فِي سَبِيلِ اللَّهِ وَ عَبَدْتَهُ حَتَّى أَتَاكَ الْيَقِينُ",
            "chunk_type": "body",
            "word_end": 71,
            "word_start": 56
          },
          {
            "arabic_text": "فَجَزَاكَ اللَّهُ أَفْضَلَ مَا جَزَى نَبِيّاً عَنْ أُمَّتِهِ",
            "chunk_type": "body",
            "word_end": 79,
            "word_start": 71
