            "word_end": 29,
            "word_start": 0
          },
          {
            "arabic_text": "سَأَلْتُهُ عَنْ قَوْلِ اللَّهِ عَزَّ وَ جَلَّ وَ مَنْ دَخَلَهُ كانَ آمِناً قَالَ",
            "chunk_type": "body",
            "word_end": 42,
            "word_start": 29
          },
          {
            "arabic_text": "إِنْ سَرَقَ سَارِقٌ بِغَيْرِ مَكَّةَ أَوْ جَنَى جِنَايَةً عَلَى نَفْسِهِ فَفَرَّ إِلَى مَكَّةَ لَمْ يُؤْخَذْ مَا دَامَ فِي الْحَرَمِ حَتَّى يَخْرُجَ مِنْهُ",
            "chunk_type": "body",
            "word_end": 64,
            "word_start": 42
          },
          {
            "arabic_text": "وَلَكِنْ يُمْنَعُ مِنَ السُّوقِ وَ لَا يُبَايَعُ وَ لَا يُجَالَسُ حَتَّى يَخْرُجَ مِنْهُ فَيُؤْخَذَ",
            "chunk_type": "body",
            "word_end": 78,
            "word_start": 64
