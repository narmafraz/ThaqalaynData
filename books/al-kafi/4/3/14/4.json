        "chunks": [
          {
            "arabic_text": "عَلِيُّ بْنُ إِبْرَاهِيمَ عَنْ أَبِيهِ وَ مُحَمَّدُ بْنُ إِسْمَاعِيلَ عَنِ الْفَضْلِ بْنِ شَاذَانَ جَمِيعاً عَنِ ابْنِ أَبِي عُمَيْرٍ عَنْ مُعَاوِيَةَ بْنِ عَمَّارٍ قَالَ",
            "chunk_type": "isnad",
            "word_end": 23,
            "word_start": 0
          },
          {
            "arabic_text": "سَأَلْتُ أَبَا عَبْدِ اللَّهِ ( عَلَيْهِ السَّلَامُ ) عَنْ رَجُلٍ قَتَلَ رَجُلًا فِي الْحِلِّ ثُمَّ دَخَلَ الْحَرَمَ فَقَالَ لَا يُقْتَلُ وَ لَا يُطْعَمُ وَ لَا يُسْقَى وَ لَا يُبَايَعُ وَ لَا يُؤْوَى حَتَّى يَخْرُجَ مِنَ الْحَرَمِ فَيُقَامَ عَلَيْهِ الْحَدُّ",
            "chunk_type": "body",
            "word_end": 62,
            "word_start": 23
          },
          {
            "arabic_text": "قُلْتُ فَمَا تَقُولُ فِي رَجُلٍ قَتَلَ فِي الْحَرَمِ أَوْ سَرَقَ قَالَ يُقَامُ عَلَيْهِ الْحَدُّ فِي الْحَرَمِ صَاغِراً إِنَّهُ لَمْ يَرَ لِلْحَرَمِ حُرْمَةً",
            "chunk_type": "body",
            "word_end": 84,
            "word_start": 62
          },
          {
            "arabic_text": "وَقَدْ قَالَ اللَّهُ تَعَالَى فَمَنِ اعْتَدَى عَلَيْكُمْ فَاعْتَدُوا عَلَيْهِ بِمِثْلِ مَا اعْتَدَى عَلَيْكُمْ",
            "chunk_type": "quran_quote",
            "word_end": 97,
            "word_start": 84
          },
          {
            "arabic_text": "فَقَالَ هَذَا هُوَ فِي الْحَرَمِ فَقَالَ فَلَا عُدْوانَ إِلَّا عَلَى الظَّالِمِينَ",
            "chunk_type": "closing",
            "word_end": 108,
            "word_start": 97
          }
