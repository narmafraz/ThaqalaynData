      "part_type": "Hadith",
      "path": "/books/al-kafi:4:3:209:8",
      "text": [
        " سَأَلْتُهُ عَنْ مُفْرِدِ الْعُمْرَةِ عَلَيْهِ طَوَافُ النِّسَاءِ قَالَ نَعَمْ ."
