        "chunks": [
          {
            "arabic_text": "عَلِيُّ بْنُ إِبْرَاهِيمَ عَنْ أَبِيهِ عَنِ ابْنِ أَبِي عُمَيْرٍ وَ مُحَمَّدُ بْنُ إِسْمَاعِيلَ عَنِ الْفَضْلِ بْنِ شَاذَانَ عَنِ ابْنِ أَبِي عُمَيْرٍ وَ صَفْوَانَ عَنْ مُعَاوِيَةَ بْنِ عَمَّارٍ عَنْ أَبِي عَبْدِ اللَّهِ ( عَلَيْهِ السَّلَامُ ) قَالَ",
            "chunk_type": "isnad",
            "word_end": 36,
            "word_start": 0
          },
          {
            "arabic_text": "إِذَا كَانَ يَوْمُ التَّرْوِيَةِ إِنْ شَاءَ اللَّهُ فَاغْتَسِلْ وَ الْبَسْ ثَوْبَيْكَ وَ ادْخُلِ الْمَسْجِدَ حَافِياً وَ عَلَيْكَ السَّكِينَةَ وَ الْوَقَارَ ثُمَّ صَلِّ رَكْعَتَيْنِ عِنْدَ مَقَامِ إِبْرَاهِيمَ ( عَلَيْهِ السَّلَامُ ) أَوْ فِي الْحِجْرِ",
            "chunk_type": "body",
            "word_end": 69,
            "word_start": 36
          },
          {
            "arabic_text": "ثُمَّ اقْعُدْ حَتَّى تَزُولَ الشَّمْسُ فَصَلِّ الْمَكْتُوبَةَ ثُمَّ قُلْ فِي دُبُرِ صَلَاتِكَ كَمَا قُلْتَ حِينَ أَحْرَمْتَ مِنَ الشَّجَرَةِ وَ أَحْرِمْ بِالْحَجِّ",
            "chunk_type": "body",
            "word_end": 90,
            "word_start": 69
          },
          {
            "arabic_text": "ثُمَّ امْضِ وَ عَلَيْكَ السَّكِينَةَ وَ الْوَقَارَ فَإِذَا انْتَهَيْتَ إِلَى الرَّفْضَاءِ دُونَ الرَّدْمِ فَلَبِّ",
            "chunk_type": "body",
            "word_end": 104,
            "word_start": 90
          },
          {
            "arabic_text": "فَإِذَا انْتَهَيْتَ إِلَى الرَّدْمِ وَ أَشْرَفْتَ عَلَى الْأَبْطَحِ فَارْفَعْ صَوْتَكَ بِالتَّلْبِيَةِ حَتَّى تَأْتِيَ مِنًى",
            "chunk_type": "body",
            "word_end": 118,
            "word_start": 104
          }
