          {
            "arabic_text": "عَلِيُّ بْنُ إِبْرَاهِيمَ عَنْ أَبِيهِ عَنِ ابْنِ أَبِي عُمَيْرٍ وَ مُحَمَّدُ بْنُ إِسْمَاعِيلَ عَنِ الْفَضْلِ بْنِ شَاذَانَ عَنِ ابْنِ أَبِي عُمَيْرٍ وَ صَفْوَانَ بْنُ يَحْيَى عَنْ مُعَاوِيَةَ بْنِ عَمَّارٍ قَالَ",
            "chunk_type": "isnad",
            "word_end": 30,
            "word_start": 0
          },
          {
            "arabic_text": "قَالَ أَبُو عَبْدِ اللَّهِ ( عَلَيْهِ السَّلَامُ ) إِذَا فَرَغْتَ مِنْ طَوَافِكَ وَ بَلَغْتَ مُؤَخَّرَ الْكَعْبَةِ وَ هُوَ بِحِذَاءِ الْمُسْتَجَارِ دُونَ الرُّكْنِ الْيَمَانِيِّ بِقَلِيلٍ فَابْسُطْ يَدَيْكَ عَلَى الْبَيْتِ وَ أَلْصِقْ بَطْنَكَ وَ خَدَّكَ بِالْبَيْتِ وَ قُلِ اللَّهُمَّ الْبَيْتُ بَيْتُكَ وَ الْعَبْدُ عَبْدُكَ وَ هَذَا مَكَانُ الْعَائِذِ بِكَ مِنَ النَّارِ",
            "chunk_type": "body",
            "word_end": 79,
            "word_start": 30
          },
          {
            "arabic_text": "ثُمَّ أَقِرَّ لِرَبِّكَ بِمَا عَمِلْتَ فَإِنَّهُ لَيْسَ مِنْ عَبْدٍ مُؤْمِنٍ يُقِرُّ لِرَبِّهِ بِذُنُوبِهِ فِي هَذَا الْمَكَانِ إِلَّا غَفَرَ اللَّهُ لَهُ إِنْ شَاءَ اللَّهُ",
            "chunk_type": "body",
            "word_end": 102,
            "word_start": 79
          },
          {
            "arabic_text": "وَتَقُولُ اللَّهُمَّ مِنْ قِبَلِكَ الرَّوْحُ وَ الْفَرَجُ وَ الْعَافِيَةُ اللَّهُمَّ إِنَّ عَمَلِي ضَعِيفٌ فَضَاعِفْهُ لِي وَ اغْفِرْ لِي مَا اطَّلَعْتَ عَلَيْهِ مِنِّي وَ خَفِيَ عَلَى خَلْقِكَ",
            "chunk_type": "body",
            "word_end": 128,
            "word_start": 102
          },
          {
            "arabic_text": "ثُمَّ تَسْتَجِيرُ بِاللَّهِ مِنَ النَّارِ وَ تَخَيَّرُ لِنَفْسِكَ مِنَ الدُّعَاءِ ثُمَّ اسْتَلِمِ الرُّكْنَ الْيَمَانِيَّ ثُمَّ ائْتِ الْحَجَرَ الْأَسْوَدَ",
            "chunk_type": "body",
