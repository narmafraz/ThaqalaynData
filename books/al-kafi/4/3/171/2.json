        "chunks": [
          {
            "arabic_text": "عَلِيُّ بْنُ إِبْرَاهِيمَ عَنْ أَبِيهِ وَ مُحَمَّدُ بْنُ إِسْمَاعِيلَ عَنِ الْفَضْلِ بْنِ شَاذَانَ عَنْ صَفْوَانَ بْنِ يَحْيَى وَ ابْنِ أَبِي عُمَيْرٍ عَنْ مُعَاوِيَةَ بْنِ عَمَّارٍ عَنْ أَبِي عَبْدِ اللَّهِ ( عَلَيْهِ السَّلَامُ ) قَالَ",
            "chunk_type": "isnad",
            "word_end": 34,
            "word_start": 0
          },
          {
            "arabic_text": "مَنْ أَدْرَكَ جَمْعاً فَقَدْ أَدْرَكَ الْحَجَّ",
            "chunk_type": "body",
            "word_end": 40,
            "word_start": 34
          },
          {
            "arabic_text": "وَقَالَ أَيُّمَا قَارِنٍ أَوْ مُفْرِدٍ أَوْ مُتَمَتِّعٍ قَدِمَ وَ قَدْ فَاتَهُ الْحَجُّ فَلْيَحِلَّ بِعُمْرَةٍ وَ عَلَيْهِ الْحَجُّ مِنْ قَابِلٍ",
            "chunk_type": "body",
            "word_end": 59,
            "word_start": 40
          },
          {
            "arabic_text": "قَالَ وَ قَالَ فِي رَجُلٍ أَدْرَكَ الْإِمَامَ وَ هُوَ بِجَمْعٍ فَقَالَ إِنْ ظَنَّ أَنَّهُ يَأْتِي عَرَفَاتٍ فَيَقِفُ بِهَا قَلِيلًا ثُمَّ يُدْرِكُ جَمْعاً قَبْلَ طُلُوعِ الشَّمْسِ فَلْيَأْتِهَا وَ إِنْ ظَنَّ أَنَّهُ لَا يَأْتِهَا حَتَّى يُفِيضُوا فَلَا يَأْتِهَا وَ لْيُقِمْ بِجَمْعٍ فَقَدْ تَمَّ حَجُّهُ",
