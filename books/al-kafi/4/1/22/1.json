            "word_end": 32,
            "word_start": 0
          },
          {
            "arabic_text": "كَانَ أَمِيرُ الْمُؤْمِنِينَ صَلَوَاتُ اللَّهِ عَلَيْهِ يَقُولُ مَنْ صَنَعَ بِمِثْلِ مَا صُنِعَ إِلَيْهِ فَإِنَّمَا كَافَأَهُ وَ مَنْ أَضْعَفَهُ كَانَ شَكُوراً وَ مَنْ شَكَرَ كَانَ كَرِيمَاً",
            "chunk_type": "body",
            "word_end": 57,
            "word_start": 32
          },
          {
            "arabic_text": "وَ مَنْ عَلِمَ أَنَّ مَا صَنَعَ إِنَّمَا صَنَعَ إِلَى نَفْسِهِ لَمْ يَسْتَبْطِ النَّاسَ فِي شُكْرِهِمْ وَ لَمْ يَسْتَزِدْهُمْ فِي مَوَدَّتِهِمْ",
            "chunk_type": "body",
            "word_end": 77,
            "word_start": 57
          },
          {
            "arabic_text": "فَلَا تَلْتَمِسْ مِنْ غَيْرِكَ شُكْرَ مَا أَتَيْتَ إِلَى نَفْسِكَ وَ وَقَيْتَ بِهِ عِرْضَكَ",
            "chunk_type": "body",
            "word_end": 90,
            "word_start": 77
          },
          {
            "arabic_text": "وَ اعْلَمْ أَنَّ الطَّالِبَ إِلَيْكَ الْحَاجَةَ لَمْ يُكْرِمْ وَجْهَهُ عَنْ وَجْهِكَ فَأَكْرِمْ وَجْهَكَ عَنْ رَدِّهِ",
