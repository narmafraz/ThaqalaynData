        "chunks": [
          {
            "arabic_text": "أَحْمَدُ بْنُ مُحَمَّدٍ عَنْ عَلِيِّ بْنِ الْحُسَيْنِ عَنْ مُحَمَّدِ بْنِ الْوَلِيدِ وَ مُحَمَّدِ بْنِ أَحْمَدَ عَنْ يُونُسَ بْنِ يَعْقُوبَ عَنْ عَلِيِّ بْنِ عِيسَى الْقَمَّاطِ عَنْ عَمِّهِ عَنْ أَبِي عَبْدِ اللَّهِ ( عَلَيْهِ السَّلَامُ ) قَالَ",
            "chunk_type": "isnad",
            "word_end": 35,
            "word_start": 0
          },
          {
            "arabic_text": "رَأَى رَسُولُ اللَّهِ ( صَلَّى اللَّهِ عَلَيْهِ وَآلِهِ ) فِي مَنَامِهِ بَنِي أُمَيَّةَ يَصْعَدُونَ عَلَى مِنْبَرِهِ مِنْ بَعْدِهِ وَ يُضِلُّونَ النَّاسَ عَنِ الصِّرَاطِ الْقَهْقَرَى فَأَصْبَحَ كَئِيباً حَزِيناً",
            "chunk_type": "body",
            "word_end": 62,
            "word_start": 35
          },
          {
            "arabic_text": "فَهَبَطَ عَلَيْهِ جَبْرَئِيلُ ( عَلَيْهِ السَّلَامُ ) فَقَالَ يَا رَسُولَ اللَّهِ مَا لِي أَرَاكَ كَئِيباً حَزِيناً قَالَ يَا جَبْرَئِيلُ إِنِّي رَأَيْتُ بَنِي أُمَيَّةَ فِي لَيْلَتِي هَذِهِ يَصْعَدُونَ مِنْبَرِي مِنْ بَعْدِي وَ يُضِلُّونَ النَّاسَ عَنِ الصِّرَاطِ الْقَهْقَرَى",
            "chunk_type": "body",
            "word_end": 98,
            "word_start": 62
          },
          {
            "arabic_text": "فَقَالَ وَ الَّذِي بَعَثَكَ بِالْحَقِّ نَبِيّاً إِنَّ هَذَا شَيْ‏ءٌ مَا اطَّلَعْتُ عَلَيْهِ فَعَرَجَ إِلَى السَّمَاءِ فَلَمْ يَلْبَثْ أَنْ نَزَلَ عَلَيْهِ بِآيٍ مِنَ الْقُرْآنِ يُؤْنِسُهُ بِهَا",
            "chunk_type": "body",
            "word_end": 123,
            "word_start": 98
          },
          {
            "arabic_text": "أَفَرَأَيْتَ إِنْ مَتَّعْناهُمْ سِنِينَ ثُمَّ جاءَهُمْ مَا كانُوا يُوعَدُونَ مَا أَغْنى عَنْهُمْ مَا كانُوا يُمَتَّعُونَ",
            "chunk_type": "quran_quote",
            "word_end": 138,
            "word_start": 123
          },
          {
            "arabic_text": "وَ أَنْزَلَ عَلَيْهِ إِنَّا أَنْزَلْناهُ فِي لَيْلَةِ الْقَدْرِ وَ مَا أَدْراكَ مَا لَيْلَةُ الْقَدْرِ لَيْلَةُ الْقَدْرِ خَيْرٌ مِنْ أَلْفِ شَهْرٍ",
            "chunk_type": "quran_quote",
            "word_end": 158,
            "word_start": 138
          },
          {
            "arabic_text": "جَعَلَ اللَّهُ عَزَّ وَ جَلَّ لَيْلَةَ الْقَدْرِ لِنَبِيِّهِ ( صَلَّى اللَّهِ عَلَيْهِ وَآلِهِ ) خَيْراً مِنْ أَلْفِ شَهْرِ مُلْكِ بَنِي أُمَيَّةَ",
            "chunk_type": "closing",
            "word_end": 179,
            "word_start": 158
          }
        ],
