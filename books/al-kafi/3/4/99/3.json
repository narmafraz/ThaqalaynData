            "chunk_type": "isnad",
            "word_end": 25,
            "word_start": 0
          },
          {
            "arabic_text": "مَنْ أَرَادَ أَنْ يُحْبَلَ لَهُ فَلْيُصَلِّ رَكْعَتَيْنِ بَعْدَ الْجُمُعَةِ يُطِيلُ فِيهِمَا الرُّكُوعَ وَالسُّجُودَ",
            "chunk_type": "body",
            "word_end": 38,
            "word_start": 25
          },
          {
            "arabic_text": "ثُمَّ يَقُولُ اللَّهُمَّ إِنِّي أَسْأَلُكَ بِمَا سَأَلَكَ بِهِ زَكَرِيَّا إِذْ قَالَ رَبِّ لَا تَذَرْنِي فَرْداً وَأَنْتَ خَيْرُ الْوَارِثِينَ",
            "chunk_type": "body",
            "word_end": 56,
            "word_start": 38
          },
          {
            "arabic_text": "اللَّهُمَّ هَبْ لِي ذُرِّيَّةً طَيِّيبَةً إِنَّكَ سَمِيعُ الدُّعَاءِ",
            "chunk_type": "body",
            "word_end": 64,
            "word_start": 56
          },
          {
            "arabic_text": "اللَّهُمَّ بِاسْمِكَ اسْتَحْلَلْتُهَا وَفِي أَمَانَتِكَ أَخَذْتُهَا فَإِنْ قَضَيْتَ فِي رَحِمِهَا وَلَداً فَاجْعَلْهُ غُلَامَاً وَلَا تَجْعَلْ لِلشَّيْطَانِ فِيهِ نَصِيباً وَلَا شِرْكاً",
