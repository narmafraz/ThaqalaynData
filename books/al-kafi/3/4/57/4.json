            "arabic_text": "عَلِيُّ بْنُ إِبْرَاهِيمَ عَنْ أَبِيهِ عَنْ حَمَّادِ بْنِ عِيسَى عَنْ حَرِيزٍ عَنْ زُرَارَةَ عَنْ أَبِي جَعْفَرٍ ( عَلَيْهِ السَّلَامُ ) قَالَ",
            "chunk_type": "isnad",
            "word_end": 21,
            "word_start": 0
          },
          {
            "arabic_text": "إِنْ صَلَّى قَوْمٌ وَ بَيْنَهُمْ وَ بَيْنَ الْإِمَامِ مَا لَا يُتَخَطَّى فَلَيْسَ ذَلِكَ الْإِمَامُ لَهُمْ بِإِمَامٍ",
            "chunk_type": "body",
            "word_end": 37,
            "word_start": 21
          },
          {
            "arabic_text": "و أَيُّ صَفٍّ كَانَ أَهْلُهُ يُصَلُّونَ بِصَلَاةِ إِمَامٍ وَ بَيْنَهُمْ وَ بَيْنَ الصَّفِّ الَّذِي يَتَقَدَّمُهُمْ قَدْرَ مَا لَا يُتَخَطَّى فَلَيْسَ تِلْكَ لَهُمْ",
            "chunk_type": "body",
            "word_end": 59,
            "word_start": 37
          },
          {
            "arabic_text": "فَإِنْ كَانَ بَيْنَهُمْ سُتْرَةٌ أَوْ جِدَارٌ فَلَيْسَتْ تِلْكَ لَهُمْ بِصَلَاةٍ إِلَّا مَنْ كَانَ مِنْ حِيَالِ الْبَابِ",
            "chunk_type": "body",
            "word_end": 75,
            "word_start": 59
          },
          {
            "arabic_text": "قَالَ وَ قَالَ هَذِهِ الْمَقَاصِيرُ لَمْ يَكُنْ فِي زَمَانِ أَحَدٍ مِنَ النَّاسِ وَ إِنَّمَا أَحْدَثَهَا الْجَبَّارُونَ",
            "chunk_type": "body",
            "word_end": 91,
            "word_start": 75
          },
          {
            "arabic_text": "لَيْسَتْ لِمَنْ صَلَّى خَلْفَهَا مُقْتَدِياً بِصَلَاةِ مَنْ فِيهَا صَلَاةٌ",
            "chunk_type": "body",
            "word_end": 100,
            "word_start": 91
          },
          {
            "arabic_text": "قَالَ وَ قَالَ أَبُو جَعْفَرٍ ( عَلَيْهِ السَّلَامُ ) يَنْبَغِي أَنْ يَكُونَ الصُّفُوفُ تَامَّةً مُتَوَاصِلَةً بَعْضُهَا إِلَى بَعْضٍ لَا يَكُونُ بَيْنَ صَفَّيْنِ مَا لَا يُتَخَطَّى يَكُونُ قَدْرَ ذَلِكَ مَسْقَطَ جَسَدِ الْإِنْسَانِ",
