          {
            "arabic_text": "عَلِيٌّ عَنْ أَبِيهِ عَنِ ابْنِ أَبِي عُمَيْرٍ عَنْ حَمَّادٍ عَنِ الْحَلَبِيِّ عَنْ أَبِي عَبْدِ اللَّهِ عَنْ أَبِيهِ ( عَلَيْهِمَا السَّلَامُ ) قَالَ",
            "chunk_type": "isnad",
            "word_end": 22,
            "word_start": 0
          },
          {
            "arabic_text": "إِنَّا نَأْمُرُ صِبْيَانَنَا بِالصَّلَاةِ إِذَا كَانُوا بَنِي خَمْسِ سِنِينَ، فَمُرُوا صِبْيَانَكُمْ بِالصَّلَاةِ إِذَا كَانُوا بَنِي سَبْعِ سِنِينَ",
            "chunk_type": "body",
            "word_end": 39,
            "word_start": 22
          },
          {
            "arabic_text": "وَنَحْنُ نَأْمُرُ صِبْيَانَنَا بِالصَّوْمِ إِذَا كَانُوا بَنِي سَبْعِ سِنِينَ، بِمَا أَطَاقُوا مِنْ صِيَامِ الْيَوْمِ، إِنْ كَانَ إِلَى نِصْفِ النَّهَارِ أَوْ أَكْثَرَ مِنْ ذَلِكَ أَوْ أَقَلَّ، فَإِذَا غَلَبَهُمُ الْعَطَشُ وَالْغَرَثُ أَفْطَرُوا، حَتَّى يَتَعَوَّدُوا الصَّوْمَ وَيُطِيقُوهُ",
            "chunk_type": "body",
            "word_end": 73,
            "word_start": 39
          },
          {
            "arabic_text": "فَمُرُوا صِبْيَانَكُمْ إِذَا كَانُوا بَنِي تِسْعِ سِنِينَ بِالصَّوْمِ، مَا اسْتَطَاعُوا مِنْ صِيَامِ الْيَوْمِ، فَإِذَا غَلَبَهُمُ الْعَطَشُ أَفْطَرُوا",
            "chunk_type": "body",
            "word_end": 90,
