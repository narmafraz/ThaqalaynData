          {
            "arabic_text": "مُحَمَّدُ بْنُ يَحْيَى عَنْ سَلَمَةَ بْنِ الْخَطَّابِ عَنْ سُلَيْمَانَ بْنِ سَمَاعَةَ عَنِ الْحُسَيْنِ بْنِ الْمُخْتَارِ عَنْ أَبِي عَبْدِ اللَّهِ ( عَلَيْهِ السَّلَامُ ) قَالَ",
            "chunk_type": "isnad",
            "word_end": 24,
            "word_start": 0
          },
          {
            "arabic_text": "لَمَّا قُبِضَ رَسُولُ اللَّهِ ( صَلَّى اللَّهِ عَلَيْهِ وَآلِهِ ) جَاءَهُمْ جَبْرَئِيلُ ( عَلَيْهِ السَّلَامُ ) وَ النَّبِيُّ مُسَجًّى وَ فِي الْبَيْتِ عَلِيٌّ وَ فَاطِمَةُ وَ الْحَسَنُ وَ الْحُسَيْنُ ( عَلَيْهِم السَّلَامُ )",
            "chunk_type": "body",
            "word_end": 57,
            "word_start": 24
          },
          {
            "arabic_text": "فَقَالَ السَّلَامُ عَلَيْكُمْ يَا أَهْلَ بَيْتِ الرَّحْمَةِ كُلُّ نَفْسٍ ذائِقَةُ الْمَوْتِ",
            "chunk_type": "body",
            "word_end": 68,
            "word_start": 57
          },
          {
            "arabic_text": "وَ إِنَّمَا تُوَفَّوْنَ أُجُورَكُمْ يَوْمَ الْقِيامَةِ فَمَنْ زُحْزِحَ عَنِ النَّارِ وَ أُدْخِلَ الْجَنَّةَ فَقَدْ فازَ",
            "chunk_type": "quran_quote",
            "word_end": 83,
            "word_start": 68
          },
          {
            "arabic_text": "وَ مَا الْحَياةُ الدُّنْيا إِلَّا مَتاعُ الْغُرُورِ",
            "chunk_type": "body",
            "word_end": 90,
            "word_start": 83
          },
          {
            "arabic_text": "إِنَّ فِي اللَّهِ عَزَّ وَ جَلَّ عَزَاءً مِنْ كُلِّ مُصِيبَةٍ وَ خَلَفاً مِنْ كُلِّ هَالِكٍ وَ دَرَكاً لِمَا فَاتَ",
            "chunk_type": "body",
            "word_end": 109,
            "word_start": 90
          },
          {
            "arabic_text": "فَبِاللَّهِ فَثِقُوا وَ إِيَّاهُ فَارْجُوا فَإِنَّ الْمُصَابَ مَنْ حُرِمَ الثَّوَابَ",
            "chunk_type": "body",
            "word_end": 119,
            "word_start": 109
          },
          {
            "arabic_text": "هَذَا آخِرُ وَطْئِي مِنَ الدُّنْيَا قَالُوا فَسَمِعْنَا الصَّوْتَ وَ لَمْ نَرَ الشَّخْصَ",
            "chunk_type": "body",
