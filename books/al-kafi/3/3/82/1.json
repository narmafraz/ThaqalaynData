          },
          {
            "arabic_text": "قُلْتُ لَهُ مَا الْجَزَعُ قَالَ أَشَدُّ الْجَزَعِ الصُّرَاخُ بِالْوَيْلِ وَ الْعَوِيلِ وَ لَطْمُ الْوَجْهِ وَ الصَّدْرِ وَ جَزُّ الشَّعْرِ مِنَ النَّوَاصِي",
            "chunk_type": "body",
            "word_end": 53,
            "word_start": 32
          },
          {
            "arabic_text": "و مَنْ أَقَامَ النُّوَاحَةَ فَقَدْ تَرَكَ الصَّبْرَ وَ أَخَذَ فِي غَيْرِ طَرِيقِهِ",
            "chunk_type": "body",
            "word_end": 65,
            "word_start": 53
          },
          {
