            "chunk_type": "body",
            "word_end": 55,
            "word_start": 50
          },
          {
            "arabic_text": "وَالْتَفَّتِ السَّاقُ بِالسَّاقِ الْتَفَّتِ الدُّنْيَا بِالْآخِرَةِ",
