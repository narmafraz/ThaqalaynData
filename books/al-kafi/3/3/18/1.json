        "chunks": [
          {
            "arabic_text": "عَلِيُّ بْنُ إِبْرَاهِيمَ عَنْ أَبِيهِ عَنِ ابْنِ أَبِي عُمَيْرٍ عَنْ حَمَّادٍ عَنِ الْحَلَبِيِّ عَنْ أَبِي عَبْدِ اللَّهِ ( عَلَيْهِ السَّلَامُ ) قَالَ",
            "chunk_type": "isnad",
            "word_end": 22,
            "word_start": 0
          },
          {
            "arabic_text": "إِذَا أَرَدْتَ غُسْلَ الْمَيِّتِ فَاجْعَلْ بَيْنَكَ وَ بَيْنَهُ ثَوْباً يَسْتُرُ عَنْكَ عَوْرَتَهُ إِمَّا قَمِيصٌ وَ إِمَّا غَيْرُهُ ثُمَّ تَبْدَأُ بِكَفَّيْهِ وَ رَأْسِهِ ثَلَاثَ مَرَّاتٍ بِالسِّدْرِ ثُمَّ سَائِرِ جَسَدِهِ وَ ابْدَأْ بِشِقِّهِ الْأَيْمَنِ",
            "chunk_type": "body",
            "word_end": 54,
            "word_start": 22
          },
          {
            "arabic_text": "فَإِذَا أَرَدْتَ أَنْ تَغْسِلَ فَرْجَهُ فَخُذْ خِرْقَةً نَظِيفَةً فَلُفَّهَا عَلَى يَدِكَ الْيُسْرَى ثُمَّ أَدْخِلْ يَدَكَ مِنْ تَحْتِ الثَّوْبِ الَّذِي عَلَى فَرْجِ الْمَيِّتِ فَاغْسِلْهُ مِنْ غَيْرِ أَنْ تَرَى عَوْرَتَهُ",
            "chunk_type": "body",
            "word_end": 82,
            "word_start": 54
          },
          {
            "arabic_text": "فَإِذَا فَرَغْتَ مِنْ غُسْلِهِ بِالسِّدْرِ فَاغْسِلْهُ مَرَّةً أُخْرَى بِمَاءٍ وَ كَافُورٍ وَ شَيْ‏ءٍ مِنْ حَنُوطِهِ ثُمَّ اغْسِلْهُ بِمَاءٍ بَحْتٍ غَسْلَةً أُخْرَى حَتَّى إِذَا فَرَغْتَ مِنْ ثَلَاثٍ جَعَلْتَهُ فِي ثَوْبٍ ثُمَّ جَفَّفْتَهُ",
            "chunk_type": "body",
