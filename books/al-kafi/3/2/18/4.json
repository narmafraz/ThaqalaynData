          },
          {
            "arabic_text": "قُلْتُ لِأَبِي جَعْفَرٍ ( عَلَيْهِ السَّلَامُ ) إِنَّ الْمُغِيرَةَ بْنَ سَعِيدٍ رَوَى عَنْكَ أَنَّكَ قُلْتَ لَهُ إِنَّ الْحَائِضَ تَقْضِي الصَّلَاةَ",
            "chunk_type": "body",
            "word_end": 35,
            "word_start": 15
          },
          {
            "arabic_text": "فَقَالَ مَا لَهُ لَا وَفَّقَهُ اللَّهُ إِنَّ امْرَأَةَ عِمْرَانَ نَذَرَتْ مَا فِي بَطْنِهَا مُحَرَّراً وَ الْمُحَرَّرُ لِلْمَسْجِدِ يَدْخُلُهُ ثُمَّ لَا يَخْرُجُ مِنْهُ أَبَداً",
            "chunk_type": "body",
            "word_end": 58,
            "word_start": 35
          },
          {
            "arabic_text": "فَلَمَّا وَضَعَتْهَا قَالَتْ رَبِّ إِنِّي وَضَعْتُهَا أُنْثَى... وَ لَيْسَ الذَّكَرُ كَالْأُنْثَى",
            "chunk_type": "quran_quote",
            "word_end": 69,
            "word_start": 58
          },
          {
            "arabic_text": "فَلَمَّا وَضَعَتْهَا أَدْخَلَتْهَا الْمَسْجِدَ فَسَاهَمَتْ عَلَيْهَا الْأَنْبِيَاءُ فَأَصَابَتِ الْقُرْعَةُ زَكَرِيَّا وَ كَفَّلَهَا زَكَرِيَّا",
            "chunk_type": "body",
            "word_end": 82,
            "word_start": 69
          },
          {
            "arabic_text": "فَلَمْ تَخْرُجْ مِنَ الْمَسْجِدِ حَتَّى بَلَغَتْ فَلَمَّا بَلَغَتْ مَا تَبْلُغُ النِّسَاءُ خَرَجَتْ",
            "chunk_type": "body",
            "word_end": 94,
            "word_start": 82
          },
          {
            "arabic_text": "فَهَلْ كَانَتْ تَقْدِرُ عَلَى أَنْ تَقْضِيَ تِلْكَ الْأَيَّامَ الَّتِي خَرَجَتْ وَ هِيَ عَلَيْهَا أَنْ تَكُونَ الدَّهْرَ فِي الْمَسْجِدِ",
