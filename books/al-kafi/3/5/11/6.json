          {
            "arabic_text": "عَلِيُّ بْنُ إِبْرَاهِيمَ عَنْ أَبِيهِ عَنْ حَمَّادٍ عَنْ حَرِيزٍ عَنْ زُرَارَةَ قَالَ",
            "chunk_type": "isnad",
            "word_end": 12,
            "word_start": 0
          },
          {
            "arabic_text": "قُلْتُ لِأَبِي عَبْدِ اللَّهِ ( عَلَيْهِ السَّلَامُ ) رَجُلٌ دَفَعَ إِلَى رَجُلٍ مَالًا قَرْضاً عَلَى مَنْ زَكَاتُهُ عَلَى الْمُقْرِضِ أَوْ عَلَى الْمُقْتَرِضِ قَالَ لَا بَلْ زَكَاتُهَا إِنْ كَانَتْ مَوْضُوعَةً عِنْدَهُ حَوْلًا عَلَى الْمُقْتَرِضِ",
            "chunk_type": "body",
            "word_end": 45,
            "word_start": 12
          },
          {
            "arabic_text": "قُلْتُ فَلَيْسَ عَلَى الْمُقْرِضِ زَكَاتُهَا قَالَ لَا يُزَكَّى الْمَالُ مِنْ وَجْهَيْنِ فِي عَامٍ وَاحِدٍ وَ لَيْسَ عَلَى الدَّافِعِ شَيْ‏ءٌ لِأَنَّهُ لَيْسَ فِي يَدِهِ شَيْ‏ءٌ إِنَّمَا الْمَالُ فِي يَدِ الْآخِذِ فَمَنْ كَانَ الْمَالُ فِي يَدِهِ زَكَّاهُ",
            "chunk_type": "body",
            "word_end": 80,
            "word_start": 45
          },
          {
            "arabic_text": "قُلْتُ أَ فَيُزَكِّي مَالَ غَيْرِهِ مِنْ مَالِهِ فَقَالَ إِنَّهُ مَالُهُ مَا دَامَ فِي يَدِهِ وَ لَيْسَ ذَلِكَ الْمَالُ لِأَحَدٍ غَيْرِهِ",
            "chunk_type": "body",
            "word_end": 100,
            "word_start": 80
          },
          {
            "arabic_text": "ثُمَّ قَالَ يَا زُرَارَةُ أَ رَأَيْتَ وَضِيعَةَ ذَلِكَ الْمَالِ وَ رِبْحَهُ لِمَنْ هُوَ وَ عَلَى مَنْ قُلْتُ لِلْمُقْتَرِضِ قَالَ فَلَهُ الْفَضْلُ وَ عَلَيْهِ النُّقْصَانُ وَ لَهُ أَنْ يَنْكِحَ وَ يَلْبَسَ مِنْهُ وَ يَأْكُلَ مِنْهُ",
            "chunk_type": "body",
            "word_end": 134,
            "word_start": 100
          },
          {
            "arabic_text": "وَلَا يَنْبَغِي لَهُ أَنْ يُزَكِّيَهُ بَلْ يُزَكِّيهِ فَإِنَّهُ عَلَيْهِ",
            "chunk_type": "body",
