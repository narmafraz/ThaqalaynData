            "chunk_type": "opening",
            "word_end": 26,
            "word_start": 18
          },
          {
            "arabic_text": "مَا مِنْ ذِي مَالٍ ذَهَبٍ أَوْ فِضَّةٍ يَمْنَعُ زَكَاةَ مَالِهِ إِلَّا حَبَسَهُ اللَّهُ عَزَّ وَ جَلَّ يَوْمَ الْقِيَامَةِ بِقَاعٍ قَرْقَرٍ وَ سَلَّطَ عَلَيْهِ شُجَاعاً أَقْرَعَ يُرِيدُهُ وَ هُوَ يَحِيدُ عَنْهُ فَإِذَا رَأَى أَنَّهُ لَا مَخْلَصَ لَهُ مِنْهُ أَمْكَنَهُ مِنْ يَدِهِ فَقَضِمَهَا كَمَا يُقْضَمُ الْفُجْلُ",
            "chunk_type": "body",
            "word_end": 70,
            "word_start": 26
          },
          {
            "arabic_text": "سَيُطَوَّقُونَ مَا بَخِلُوا بِهِ يَوْمَ الْقِيامَةِ",
            "chunk_type": "quran_quote",
            "word_end": 76,
            "word_start": 70
          },
          {
            "arabic_text": "وَ ذَلِكَ قَوْلُ اللَّهِ عَزَّ وَ جَلَّ وَ مَا مِنْ ذِي مَالٍ إِبِلٍ أَوْ غَنَمٍ أَوْ بَقَرٍ يَمْنَعُ زَكَاةَ مَالِهِ إِلَّا حَبَسَهُ اللَّهُ يَوْمَ الْقِيَامَةِ بِقَاعٍ قَرْقَرٍ يَطَؤُهُ كُلُّ ذَاتِ ظِلْفٍ بِظِلْفِهَا وَ يَنْهَشُهُ كُلُّ ذَاتِ نَابٍ بِنَابِهَا",
            "chunk_type": "body",
            "word_end": 114,
            "word_start": 76
          },
          {
            "arabic_text": "وَ مَا مِنْ ذِي مَالٍ نَخْلٍ أَوْ كَرْمٍ أَوْ زَرْعٍ يَمْنَعُ زَكَاتَهَا إِلَّا طَوَّقَهُ اللَّهُ رَيْعَةَ أَرْضِهِ إِلَى سَبْعِ أَرَضِينَ إِلَى يَوْمِ الْقِيَامَةِ",
