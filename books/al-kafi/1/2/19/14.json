          },
          {
            "arabic_text": "سَمِعْتُ أَبَا عَبْدِ اللَّهِ (عَلَيْهِ السَّلَامُ) يَقُولُ:",
            "chunk_type": "opening",
            "word_end": 18,
            "word_start": 11
          },
          {
            "arabic_text": "ضَلَّ عِلْمُ ابْنِ شُبْرُمَةَ عِنْدَ الْجَامِعَةِ، إِمْلَاءِ رَسُولِ اللَّهِ (صَلَّى اللَّهُ عَلَيْهِ وَآلِهِ) وَخَطِّ عَلِيٍّ (عَلَيْهِ السَّلَامُ) بِيَدِهِ.",
            "chunk_type": "body",
            "word_end": 36,
            "word_start": 18
          },
          {
            "arabic_text": "إِنَّ الْجَامِعَةَ لَمْ تَدَعْ لِأَحَدٍ كَلَامًا، فِيهَا عِلْمُ الْحَلَالِ وَالْحَرَامِ.",
            "chunk_type": "body",
            "word_end": 46,
            "word_start": 36
          },
          {
            "arabic_text": "إِنَّ أَصْحَابَ الْقِيَاسِ طَلَبُوا الْعِلْمَ بِالْقِيَاسِ، فَلَمْ يَزْدَادُوا مِنَ الْحَقِّ إِلَّا بُعْدًا. إِنَّ دِينَ اللَّهِ لَا يُصَابُ بِالْقِيَاسِ.",
            "chunk_type": "closing",
