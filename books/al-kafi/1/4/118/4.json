        "chunks": [
          {
            "arabic_text": "مُحَمَّدُ بْنُ يَحْيَى عَنْ مُحَمَّدِ بْنِ أَحْمَدَ عَنْ مُحَمَّدِ بْنِ الْحُسَيْنِ عَنْ مُحَمَّدِ بْنِ عَلِيٍّ عَنْ عَاصِمِ بْنِ حُمَيْدٍ عَنْ مُحَمَّدِ بْنِ مُسْلِمٍ عَنْ أَبِي جَعْفَرٍ عَلَيْهِ السَّلَامُ قَالَ",
            "chunk_type": "isnad",
            "word_end": 29,
            "word_start": 0
          },
          {
            "arabic_text": "كُنْتُ عِنْدَهُ يَوْمًا إِذْ وَقَعَ زَوْجُ وَرْشَانٍ عَلَى الْحَائِطِ وَهَدَلَا هَدِيلَهُمَا، فَرَدَّ أَبُو جَعْفَرٍ عَلَيْهِ السَّلَامُ عَلَيْهِمَا كَلَامَهُمَا سَاعَةً، ثُمَّ نَهَضَا، فَلَمَّا طَارَا عَلَى الْحَائِطِ هَدَلَ الذَّكَرُ عَلَى الْأُنْثَى سَاعَةً، ثُمَّ نَهَضَا.",
            "chunk_type": "opening",
            "word_end": 61,
            "word_start": 29
          },
          {
            "arabic_text": "فَقُلْتُ: جُعِلْتُ فِدَاكَ، مَا هَذَا الطَّيْرُ؟ قَالَ: يَا ابْنَ مُسْلِمٍ، كُلُّ شَيْءٍ خَلَقَهُ اللَّهُ مِنْ طَيْرٍ أَوْ بَهِيمَةٍ أَوْ شَيْءٍ فِيهِ رُوحٌ، فَهُوَ أَسْمَعُ لَنَا وَأَطْوَعُ مِنِ ابْنِ آدَمَ. إِنَّ هَذَا الْوَرْشَانَ ظَنَّ بِامْرَأَتِهِ، فَحَلَفَتْ لَهُ: مَا فَعَلْتُ. فَقَالَتْ: تَرْضَى بِمُحَمَّدِ بْنِ عَلِيٍّ؟ فَرَضِيَا بِي، فَأَخْبَرْتُهُ أَنَّهُ لَهَا ظَالِمٌ، فَصَدَّقَهَا.",
            "chunk_type": "body",
            "word_end": 111,
            "word_start": 61
          }
