        "chunks": [
          {
            "arabic_text": "مُحَمَّدُ بْنُ يَحْيَى عَنْ مُحَمَّدِ بْنِ أَحْمَدَ عَنْ عَبْدِ اللَّهِ بْنِ أَحْمَدَ عَنْ صَالِحِ بْنِ مَزْيَدٍ عَنْ عَبْدِ اللَّهِ بْنِ الْمُغِيرَةِ عَنْ أَبِي الصَّبَّاحِ عَنْ أَبِي جَعْفَرٍ (عَلَيْهِ السَّلَامُ) قَالَ",
            "chunk_type": "isnad",
            "word_end": 30,
            "word_start": 0
          },
          {
            "arabic_text": "كَانَتْ أُمِّي قَاعِدَةً عِنْدَ جِدَارٍ فَتَصَدَّعَ الْجِدَارُ وَسَمِعْنَا هَدَّةً شَدِيدَةً فَقَالَتْ بِيَدِهَا: لَا وَحَقِّ الْمُصْطَفَى صَلَّى اللَّهِ عَلَيْهِ وَآلِهِ وَسَلَّمَ مَا أَذِنَ اللَّهُ لَكَ فِي السُّقُوطِ، فَبَقِيَ مُعَلَّقًا فِي الْجَوِّ حَتَّى جَازَتْهُ، فَتَصَدَّقَ أَبِي عَنْهَا بِمِائَةِ دِينَارٍ.",
            "chunk_type": "body",
            "word_end": 67,
            "word_start": 30
          },
          {
            "arabic_text": "قَالَ أَبُو الصَّبَّاحِ: وَذَكَرَ أَبُو عَبْدِ اللَّهِ (عَلَيْهِ السَّلَامُ) جَدَّتَهُ أُمَّ أَبِيهِ يَوْمًا، فَقَالَ: كَانَتْ صِدِّيقَةً، لَمْ تُدْرَكْ فِي آلِ الْحَسَنِ امْرَأَةٌ مِثْلُهَا.",
            "chunk_type": "body",
            "word_end": 90,
