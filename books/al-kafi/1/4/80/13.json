        "chunks": [
          {
            "arabic_text": "عَلِيُّ بْنُ مُحَمَّدٍ عَنْ سَهْلِ بْنِ زِيَادٍ وَمُحَمَّدُ بْنُ يَحْيَى وَغَيْرُهُ عَنْ أَحْمَدَ بْنِ مُحَمَّدٍ وَعَلِيُّ بْنُ إِبْرَاهِيمَ عَنْ أَبِيهِ جَمِيعًا عَنِ ابْنِ مَحْبُوبٍ عَنْ هِشَامِ بْنِ سَالِمٍ عَنْ أَبِي حَمْزَةَ عَنْ أَبِي إِسْحَاقَ السَّبِيعِيِّ عَنْ بَعْضِ أَصْحَابِ أَمِيرِ الْمُؤْمِنِينَ عَلَيْهِ السَّلَامُ مِمَّنْ يُوثَقُ بِهِ أَنَّ أَمِيرَ الْمُؤْمِنِينَ عَلَيْهِ السَّلَامُ تَكَلَّمَ بِهَذَا الْكَلَامِ وَحُفِظَ عَنْهُ وَخَطَبَ بِهِ عَلَى مِنْبَرِ الْكُوفَةِ",
            "chunk_type": "isnad",
            "word_end": 60,
            "word_start": 0
          },
          {
            "arabic_text": "اللَّهُمَّ إِنَّهُ لَا بُدَّ لَكَ مِنْ حُجَجٍ فِي أَرْضِكَ، حُجَّةٍ بَعْدَ حُجَّةٍ عَلَى خَلْقِكَ، يَهْدُونَهُمْ إِلَى دِينِكَ وَيُعَلِّمُونَهُمْ عِلْمَكَ، كَيْلَا يَتَفَرَّقَ أَتْبَاعُ أَوْلِيَائِكَ.",
            "chunk_type": "opening",
            "word_end": 83,
            "word_start": 60
          },
          {
            "arabic_text": "ظَاهِرٍ غَيْرِ مُطَاعٍ أَوْ مُكْتَتَمٍ يُتَرَقَّبُ، إِنْ غَابَ عَنِ النَّاسِ شَخْصُهُمْ فِي حَالِ هُدْنَتِهِمْ فَلَمْ يَغِبْ عَنْهُمْ قَدِيمُ مَبْثُوثِ عِلْمِهِمْ، وَآدَابُهُمْ فِي قُلُوبِ الْمُؤْمِنِينَ مُثْبَتَةٌ، فَهُمْ بِهَا عَامِلُونَ.",
            "chunk_type": "body",
            "word_end": 111,
            "word_start": 83
          },
          {
            "arabic_text": "وَيَقُولُ عَلَيْهِ السَّلَامُ فِي هَذِهِ الْخُطْبَةِ فِي مَوْضِعٍ آخَرَ: فِيمَنْ هَذَا؟ وَلِهَذَا يَأْرِزُ الْعِلْمُ إِذَا لَمْ يُوجَدْ لَهُ حَمَلَةٌ يَحْفَظُونَهُ وَيَرْوُونَهُ كَمَا سَمِعُوهُ مِنَ الْعُلَمَاءِ وَيَصْدُقُونَ عَلَيْهِمْ فِيهِ.",
            "chunk_type": "body",
            "word_end": 139,
            "word_start": 111
          },
          {
            "arabic_text": "اللَّهُمَّ فَإِنِّي لَأَعْلَمُ أَنَّ الْعِلْمَ لَا يَأْرِزُ كُلُّهُ، وَلَا يَنْقَطِعُ مَوَادُّهُ، وَإِنَّكَ لَا تُخْلِي أَرْضَكَ مِنْ حُجَّةٍ لَكَ عَلَى خَلْقِكَ، ظَاهِرٍ لَيْسَ بِالْمُطَاعِ أَوْ خَائِفٍ مَغْمُورٍ، كَيْلَا تَبْطُلَ حُجَّتُكَ وَلَا يَضِلَّ أَوْلِيَاؤُكَ بَعْدَ إِذْ هَدَيْتَهُمْ، بَلْ أَيْنَ هُمْ وَكَمْ هُمْ؟ أُولَئِكَ الْأَقَلُّونَ عَدَدًا الْأَعْظَمُونَ عِنْدَ اللَّهِ قَدْرًا.",
            "chunk_type": "closing",
            "word_end": 186,
            "word_start": 139
          }
