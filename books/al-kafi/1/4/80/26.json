          {
            "arabic_text": "اَلْحُسَيْنُ بْنُ مُحَمَّدٍ وَغَيْرُهُ عَنْ جَعْفَرِ بْنِ مُحَمَّدٍ عَنْ عَلِيِّ بْنِ الْعَبَّاسِ بْنِ عَامِرٍ عَنْ مُوسَى بْنِ هِلَالٍ الْكِنْدِيِّ عَنْ عَبْدِ اللَّهِ بْنِ عَطَاءٍ عَنْ أَبِي جَعْفَرٍ ( عَلَيْهِ السَّلَامُ ) قَالَ",
            "chunk_type": "isnad",
            "word_end": 32,
            "word_start": 0
          },
          {
            "arabic_text": "قُلْتُ لَهُ إِنَّ شِيعَتَكَ بِالْعِرَاقِ كَثِيرَةٌ وَاللَّهِ مَا فِي أَهْلِ بَيْتِكَ مِثْلُكَ فَكَيْفَ لَا تَخْرُجُ",
            "chunk_type": "opening",
            "word_end": 47,
            "word_start": 32
          },
          {
            "arabic_text": "قَالَ فَقَالَ يَا عَبْدَ اللَّهِ بْنَ عَطَاءٍ قَدْ أَخَذْتَ تَفْرُشُ أُذُنَيْكَ لِلنَّوْكَى إِي وَاللَّهِ مَا أَنَا بِصَاحِبِكُمْ",
            "chunk_type": "body",
            "word_end": 64,
            "word_start": 47
          },
          {
            "arabic_text": "قَالَ قُلْتُ لَهُ فَمَنْ صَاحِبُنَا قَالَ انْظُرُوا مَنْ عَمِيَ عَلَى النَّاسِ وِلَادَتُهُ فَذَاكَ صَاحِبُكُمْ",
            "chunk_type": "body",
            "word_end": 78,
            "word_start": 64
          },
          {
            "arabic_text": "إِنَّهُ لَيْسَ مِنَّا أَحَدٌ يُشَارُ إِلَيْهِ بِالْإِصْبَعِ وَيُمْضَغُ بِالْأَلْسُنِ إِلَّا مَاتَ غَيْظاً أَوْ رَغِمَ أَنْفُهُ .",
