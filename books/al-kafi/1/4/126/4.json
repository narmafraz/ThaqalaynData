        "chunks": [
          {
            "arabic_text": "عَلِيُّ بْنُ إِبْرَاهِيمَ عَنْ أَبِيهِ عَنْ حَمَّادِ بْنِ عِيسَى عَنْ إِبْرَاهِيمَ بْنِ عُمَرَ الْيَمَانِيِّ عَنْ أَبَانِ بْنِ أَبِي عَيَّاشٍ عَنْ سُلَيْمِ بْنِ قَيْسٍ، وَ مُحَمَّدُ بْنُ يَحْيَى عَنْ أَحْمَدَ بْنِ مُحَمَّدٍ عَنِ ابْنِ أَبِي عُمَيْرٍ عَنْ عُمَرَ بْنِ أُذَيْنَةَ، وَ عَلِيُّ بْنُ مُحَمَّدٍ عَنْ أَحْمَدَ بْنِ هِلَالٍ عَنِ ابْنِ أَبِي عُمَيْرٍ عَنْ عُمَرَ بْنِ أُذَيْنَةَ عَنْ أَبَانِ بْنِ أَبِي عَيَّاشٍ عَنْ سُلَيْمِ بْنِ قَيْسٍ قَالَ:",
            "chunk_type": "isnad",
            "word_end": 65,
            "word_start": 0
          },
          {
            "arabic_text": "سَمِعْتُ عَبْدَ اللَّهِ بْنَ جَعْفَرٍ الطَّيَّارِ يَقُولُ: كُنَّا عِنْدَ مُعَاوِيَةَ أَنَا وَ الْحَسَنُ وَ الْحُسَيْنُ وَ عَبْدُ اللَّهِ بْنُ عَبَّاسٍ وَ عُمَرُ ابْنُ أُمِّ سَلَمَةَ وَ أُسَامَةُ بْنُ زَيْدٍ، فَجَرَى بَيْنِي وَ بَيْنَ مُعَاوِيَةَ كَلَامٌ.",
            "chunk_type": "opening",
            "word_end": 100,
            "word_start": 65
          },
          {
            "arabic_text": "فَقُلْتُ لِمُعَاوِيَةَ: سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهِ عَلَيْهِ وَآلِهِ يَقُولُ: أَنَا أَوْلَى بِالْمُؤْمِنِينَ مِنْ أَنْفُسِهِمْ، ثُمَّ أَخِي عَلِيُّ بْنُ أَبِي طَالِبٍ عَلَيْهِ السَّلَامُ أَوْلَى بِالْمُؤْمِنِينَ مِنْ أَنْفُسِهِمْ، فَإِذَا اسْتُشْهِدَ عَلِيٌّ عَلَيْهِ السَّلَامُ فَالْحَسَنُ بْنُ عَلِيٍّ عَلَيْهِمَا السَّلَامُ أَوْلَى بِالْمُؤْمِنِينَ مِنْ أَنْفُسِهِمْ، ثُمَّ ابْنِيَ الْحُسَيْنُ عَلَيْهِ السَّلَامُ مِنْ بَعْدِهِ أَوْلَى بِالْمُؤْمِنِينَ مِنْ أَنْفُسِهِمْ، فَإِذَا اسْتُشْهِدَ فَابْنُهُ عَلِيُّ بْنُ الْحُسَيْنِ عَلَيْهِمَا السَّلَامُ أَوْلَى بِالْمُؤْمِنِينَ مِنْ أَنْفُسِهِمْ، وَ سَتُدْرِكُهُ يَا عَلِيُّ، ثُمَّ ابْنُهُ مُحَمَّدُ بْنُ عَلِيٍّ عَلَيْهِمَا السَّلَامُ أَوْلَى بِالْمُؤْمِنِينَ مِنْ أَنْفُسِهِمْ، وَ سَتُدْرِكُهُ يَا حُسَيْنُ، ثُمَّ يُكَمِّلُهُ اثْنَا عَشَرَ إِمَامًا تِسْعَةً مِنْ وُلْدِ الْحُسَيْنِ عَلَيْهِ السَّلَامُ.",
            "chunk_type": "body",
            "word_end": 194,
            "word_start": 100
          },
          {
            "arabic_text": "قَالَ عَبْدُ اللَّهِ بْنُ جَعْفَرٍ: وَ اسْتَشْهَدْتُ الْحَسَنَ وَ الْحُسَيْنَ وَ عَبْدَ اللَّهِ بْنَ عَبَّاسٍ وَ عُمَرَ ابْنَ أُمِّ سَلَمَةَ وَ أُسَامَةَ بْنَ زَيْدٍ، فَشَهِدُوا لِي عِنْدَ مُعَاوِيَةَ. قَالَ سُلَيْمٌ: وَ قَدْ سَمِعْتُ ذَلِكَ مِنْ سَلْمَانَ وَ أَبِي ذَرٍّ وَ الْمِقْدَادِ، وَ ذَكَرُوا أَنَّهُمْ سَمِعُوا ذَلِكَ مِنْ رَسُولِ اللَّهِ صَلَّى اللَّهِ عَلَيْهِ وَآلِهِ.",
            "chunk_type": "closing",
            "word_end": 247,
            "word_start": 194
          }
