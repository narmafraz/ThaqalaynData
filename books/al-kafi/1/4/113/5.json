          {
            "arabic_text": "عِدَّةٌ مِنْ أَصْحَابِنَا عَنْ أَحْمَدَ بْنِ مُحَمَّدٍ عَنْ عَلِيِّ بْنِ الْحَكَمِ عَنْ صَفْوَانَ الْجَمَّالِ قَالَ",
            "chunk_type": "isnad",
            "word_end": 15,
            "word_start": 0
          },
          {
            "arabic_text": "كُنْتُ أَنَا وَعَامِرٌ وَعَبْدُ اللَّهِ بْنُ جُذَاعَةَ الْأَزْدِيُّ عِنْدَ أَبِي عَبْدِ اللَّهِ عَلَيْهِ السَّلَامُ، قَالَ: فَقَالَ لَهُ عَامِرٌ: جُعِلْتُ فِدَاكَ، إِنَّ النَّاسَ يَزْعُمُونَ أَنَّ أَمِيرَ الْمُؤْمِنِينَ عَلَيْهِ السَّلَامُ دُفِنَ بِالرَّحْبَةِ.",
            "chunk_type": "opening",
            "word_end": 45,
            "word_start": 15
          },
          {
            "arabic_text": "قَالَ: لَا. قَالَ: فَأَيْنَ دُفِنَ؟ قَالَ: إِنَّهُ لَمَّا مَاتَ احْتَمَلَهُ الْحَسَنُ عَلَيْهِ السَّلَامُ، فَأَتَى بِهِ ظَهْرَ الْكُوفَةِ، قَرِيبًا مِنَ النَّجَفِ، يَسْرَةً عَنِ الْغَرِيِّ، يَمْنَةً عَنِ الْحِيرَةِ، فَدَفَنَهُ بَيْنَ رَكَوَاتٍ بِيضٍ.",
            "chunk_type": "body",
            "word_end": 75,
            "word_start": 45
          },
          {
            "arabic_text": "قَالَ: فَلَمَّا كَانَ بَعْدُ ذَهَبْتُ إِلَى الْمَوْضِعِ، فَتَوَهَّمْتُ مَوْضِعًا مِنْهُ، ثُمَّ أَتَيْتُهُ فَأَخْبَرْتُهُ، فَقَالَ لِي: أَصَبْتَ، رَحِمَكَ اللَّهُ، ثَلَاثَ مَرَّاتٍ.",
            "chunk_type": "closing",
            "word_end": 95,
            "word_start": 75
          }
