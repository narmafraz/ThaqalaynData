        "chunks": [
          {
            "arabic_text": "عَلِيُّ بْنُ إِبْرَاهِيمَ عَنْ أَبِيهِ وَصَالِحِ بْنِ السِّنْدِيِّ عَنْ جَعْفَرِ بْنِ بَشِيرٍ عَنْ يَحْيَى بْنِ مُعَمَّرٍ الْعَطَّارِ عَنْ بَشِيرٍ الدَّهَّانِ عَنْ أَبِي عَبْدِ اللَّهِ عَلَيْهِ السَّلَامُ قَالَ",
            "chunk_type": "isnad",
            "word_end": 27,
            "word_start": 0
          },
          {
            "arabic_text": "قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَآلِهِ فِي مَرَضِهِ الَّذِي تُوُفِّيَ فِيهِ: ادْعُوا لِي خَلِيلِي، فَأَرْسَلَتَا إِلَى أَبَوَيْهِمَا، فَلَمَّا نَظَرَ إِلَيْهِمَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَآلِهِ أَعْرَضَ عَنْهُمَا، ثُمَّ قَالَ: ادْعُوا لِي خَلِيلِي، فَأُرْسِلَ إِلَى عَلِيٍّ، فَلَمَّا نَظَرَ إِلَيْهِ أَكَبَّ عَلَيْهِ يُحَدِّثُهُ.",
            "chunk_type": "body",
            "word_end": 70,
            "word_start": 27
          },
          {
            "arabic_text": "فَلَمَّا خَرَجَ لَقِيَاهُ فَقَالَا لَهُ: مَا حَدَّثَكَ خَلِيلُكَ؟ فَقَالَ: حَدَّثَنِي أَلْفَ بَابٍ، يَفْتَحُ كُلُّ بَابٍ أَلْفَ بَابٍ.",
            "chunk_type": "closing",
            "word_end": 87,
            "word_start": 70
          }
