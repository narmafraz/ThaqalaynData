            "chunk_type": "isnad",
            "word_end": 25,
            "word_start": 0
          },
          {
            "arabic_text": "دَخَلْتُ عَلَى أَبِي عَبْدِ اللَّهِ (عَلَيْهِ السَّلَامُ) فَسَمِعْتُهُ يَقُولُ: إِنَّ اللَّهَ عَزَّ وَجَلَّ أَدَّبَ نَبِيَّهُ عَلَى مَحَبَّتِهِ،",
            "chunk_type": "opening",
            "word_end": 42,
            "word_start": 25
          },
          {
            "arabic_text": "فَقَالَ: وَإِنَّكَ لَعَلَىٰ خُلُقٍ عَظِيمٍ",
            "chunk_type": "quran_quote",
            "word_end": 47,
            "word_start": 42
          },
          {
            "arabic_text": "ثُمَّ فَوَّضَ إِلَيْهِ،",
            "chunk_type": "body",
            "word_end": 50,
            "word_start": 47
          },
          {
            "arabic_text": "فَقَالَ عَزَّ وَجَلَّ: وَمَا آتَاكُمُ الرَّسُولُ فَخُذُوهُ وَمَا نَهَاكُمْ عَنْهُ فَانْتَهُوا",
            "chunk_type": "quran_quote",
            "word_end": 61,
            "word_start": 50
          },
          {
            "arabic_text": "وَقَالَ عَزَّ وَجَلَّ: مَنْ يُطِعِ الرَّسُولَ فَقَدْ أَطَاعَ اللَّهَ",
            "chunk_type": "quran_quote",
            "word_end": 70,
            "word_start": 61
          },
          {
            "arabic_text": "قَالَ: ثُمَّ قَالَ: وَإِنَّ نَبِيَّ اللَّهِ فَوَّضَ إِلَىٰ عَلِيٍّ وَائْتَمَنَهُ، فَسَلَّمْتُمْ وَجَحَدَ النَّاسُ، فَوَاللَّهِ لَنُحِبُّكُمْ أَنْ تَقُولُوا إِذَا قُلْنَا، وَأَنْ تَصْمُتُوا إِذَا صَمَتْنَا، وَنَحْنُ فِيمَا بَيْنَكُمْ وَبَيْنَ اللَّهِ عَزَّ وَجَلَّ، مَا جَعَلَ اللَّهُ لِأَحَدٍ خَيْرًا فِي خِلَافِ أَمْرِنَا.",
            "chunk_type": "body",
            "word_end": 108,
            "word_start": 70
          },
          {
            "arabic_text": "عِدَّةٌ مِنْ أَصْحَابِنَا عَنْ أَحْمَدَ بْنِ مُحَمَّدٍ عَنِ ابْنِ أَبِي نَجْرَانَ عَنْ عَاصِمِ بْنِ حُمَيْدٍ عَنْ أَبِي إِسْحَاقَ قَالَ: سَمِعْتُ أَبَا جَعْفَرٍ (عَلَيْهِ السَّلَامُ) يَقُولُ، ثُمَّ ذَكَرَ نَحْوَهُ.",
