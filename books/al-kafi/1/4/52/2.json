        "chunks": [
          {
            "arabic_text": "عَلِيُّ بْنُ إِبْرَاهِيمَ عَنْ أَبِيهِ عَنْ يَحْيَى بْنِ أَبِي عِمْرَانَ عَنْ يُونُسَ عَنْ بَكَّارِ بْنِ بَكْرٍ عَنْ مُوسَى بْنِ أَشْيَمَ قَالَ",
            "chunk_type": "isnad",
            "word_end": 21,
            "word_start": 0
          },
          {
            "arabic_text": "كُنْتُ عِنْدَ أَبِي عَبْدِ اللَّهِ عَلَيْهِ السَّلَامُ فَسَأَلَهُ رَجُلٌ عَنْ آيَةٍ مِنْ كِتَابِ اللَّهِ عَزَّ وَجَلَّ فَأَخْبَرَهُ بِهَا، ثُمَّ دَخَلَ عَلَيْهِ دَاخِلٌ فَسَأَلَهُ عَنْ تِلْكَ الْآيَةِ فَأَخْبَرَهُ بِخِلَافِ مَا أَخْبَرَ بِهِ الْأَوَّلَ، فَدَخَلَنِي مِنْ ذَلِكَ مَا شَاءَ اللَّهُ حَتَّى كَأَنَّ قَلْبِي يُشْرَحُ بِالسَّكَاكِينِ.",
            "chunk_type": "opening",
            "word_end": 64,
            "word_start": 21
          },
          {
            "arabic_text": "فَقُلْتُ فِي نَفْسِي: تَرَكْتُ أَبَا قَتَادَةَ بِالشَّامِ لَا يُخْطِئُ فِي الْوَاوِ وَشِبْهِهِ، وَجِئْتُ إِلَى هَذَا يُخْطِئُ هَذَا الْخَطَأَ كُلَّهُ. فَبَيْنَا أَنَا كَذَلِكَ إِذْ دَخَلَ عَلَيْهِ آخَرُ فَسَأَلَهُ عَنْ تِلْكَ الْآيَةِ فَأَخْبَرَهُ بِخِلَافِ مَا أَخْبَرَنِي وَأَخْبَرَ صَاحِبَيَّ، فَسَكَنَتْ نَفْسِي فَعَلِمْتُ أَنَّ ذَلِكَ مِنْهُ تَقِيَّةٌ.",
            "chunk_type": "body",
            "word_end": 107,
            "word_start": 64
          },
          {
            "arabic_text": "قَالَ: ثُمَّ الْتَفَتَ إِلَيَّ فَقَالَ لِي: يَا ابْنَ أَشْيَمَ، إِنَّ اللَّهَ عَزَّ وَجَلَّ فَوَّضَ إِلَى سُلَيْمَانَ بْنِ دَاوُدَ، فَقَالَ:",
            "chunk_type": "body",
            "word_end": 126,
            "word_start": 107
          },
          {
            "arabic_text": "هَذَا عَطَاؤُنَا فَامْنُنْ أَوْ أَمْسِكْ بِغَيْرِ حِسَابٍ",
            "chunk_type": "quran_quote",
            "word_end": 133,
            "word_start": 126
          },
          {
            "arabic_text": "وَفَوَّضَ إِلَى نَبِيِّهِ صَلَّى اللَّهُ عَلَيْهِ وَآلِهِ فَقَالَ:",
            "chunk_type": "body",
            "word_end": 141,
            "word_start": 133
          },
          {
            "arabic_text": "مَا آتَاكُمُ الرَّسُولُ فَخُذُوهُ وَمَا نَهَاكُمْ عَنْهُ فَانْتَهُوا",
            "chunk_type": "quran_quote",
            "word_end": 149,
            "word_start": 141
          },
          {
            "arabic_text": "فَمَا فُوِّضَ إِلَى رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَآلِهِ فَقَدْ فُوِّضَ إِلَيْنَا.",
            "chunk_type": "closing",
            "word_end": 161,
            "word_start": 149
          }
