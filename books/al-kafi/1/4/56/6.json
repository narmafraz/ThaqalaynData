            "word_end": 20,
            "word_start": 0
          },
          {
            "arabic_text": "أَتَى رَجُلٌ أَمِيرَ الْمُؤْمِنِينَ ( عَلَيْهِ السَّلَامُ ) يَسْأَلُهُ عَنِ الرُّوحِ أَ لَيْسَ هُوَ جَبْرَئِيلَ فَقَالَ لَهُ أَمِيرُ الْمُؤْمِنِينَ ( عَلَيْهِ السَّلَامُ ) جَبْرَئِيلُ ( عَلَيْهِ السَّلَامُ ) مِنَ الْمَلَائِكَةِ وَ الرُّوحُ غَيْرُ جَبْرَئِيلَ فَكَرَّرَ ذَلِكَ عَلَى الرَّجُلِ فَقَالَ لَهُ لَقَدْ قُلْتَ عَظِيمَاً مِنَ الْقَوْلِ مَا أَحَدٌ يَزْعُمُ أَنَّ الرُّوحَ غَيْرُ جَبْرَئِيلَ",
            "chunk_type": "body",
            "word_end": 72,
            "word_start": 20
          },
          {
            "arabic_text": "فَقَالَ لَهُ أَمِيرُ الْمُؤْمِنِينَ ( عَلَيْهِ السَّلَامُ ) إِنَّكَ ضَالٌّ تَرْوِي عَنْ أَهْلِ الضَّلَالِ",
            "chunk_type": "body",
            "word_end": 86,
            "word_start": 72
          },
          {
            "arabic_text": "يَقُولُ اللَّهُ تَعَالَى لِنَبِيِّهِ ( صَلَّى اللَّهِ عَلَيْهِ وَآلِهِ وَسَلَّمَ ) أَتَى أَمْرُ اللَّهِ فَلَا تَسْتَعْجِلُوهُ سُبْحانَهُ وَ تَعالى عَمَّا يُشْرِكُونَ يُنَزِّلُ الْمَلَائِكَةَ بِالرُّوحِ وَ الرُّوحُ غَيْرُ الْمَلَائِكَةِ",
