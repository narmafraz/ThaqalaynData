        "chunks": [
          {
            "arabic_text": "مُحَمَّدُ بْنُ يَحْيَى وَالْحَسَنُ بْنُ مُحَمَّدٍ عَنْ جَعْفَرِ بْنِ مُحَمَّدٍ عَنِ الْقَاسِمِ بْنِ إِسْمَاعِيلَ الْأَنْبَارِيِّ عَنِ الْحُسَيْنِ بْنِ عَلِيٍّ عَنْ أَبِي الْمَغْرَاءِ عَنِ ابْنِ أَبِي يَعْفُورٍ قَالَ",
            "chunk_type": "isnad",
            "word_end": 27,
            "word_start": 0
          },
          {
            "arabic_text": "سَمِعْتُ أَبَا عَبْدِ اللَّهِ (عَلَيْهِ السَّلَامُ) يَقُولُ: وَيْلٌ لِطُغَاةِ الْعَرَبِ مِنْ أَمْرٍ قَدِ اقْتَرَبَ.",
            "chunk_type": "body",
            "word_end": 41,
            "word_start": 27
          },
          {
            "arabic_text": "قُلْتُ: جُعِلْتُ فِدَاكَ، كَمْ مَعَ الْقَائِمِ مِنَ الْعَرَبِ؟",
            "chunk_type": "body",
            "word_end": 49,
            "word_start": 41
          },
          {
            "arabic_text": "قَالَ: نَفَرٌ يَسِيرٌ.",
            "chunk_type": "body",
            "word_end": 52,
            "word_start": 49
          },
          {
            "arabic_text": "قُلْتُ: وَاللَّهِ إِنَّ مَنْ يَصِفُ هَذَا الْأَمْرَ مِنْهُمْ لَكَثِيرٌ.",
            "chunk_type": "body",
            "word_end": 61,
            "word_start": 52
          },
          {
            "arabic_text": "قَالَ: لَا بُدَّ لِلنَّاسِ مِنْ أَنْ يُمَحَّصُوا وَيُمَيَّزُوا وَيُغَرْبَلُوا وَيُسْتَخْرَجُ فِي الْغِرْبَالِ خَلْقٌ كَثِيرٌ.",
            "chunk_type": "closing",
            "word_end": 75,
            "word_start": 61
          }
