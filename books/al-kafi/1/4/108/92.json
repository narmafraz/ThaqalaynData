        "chunks": [
          {
            "arabic_text": "مُحَمَّدُ بْنُ يَحْيَى عَنْ سَلَمَةَ بْنِ الْخَطَّابِ عَنِ الْحُسَيْنِ بْنِ عَبْدِ الرَّحْمَنِ عَنْ عَلِيِّ بْنِ أَبِي حَمْزَةَ عَنْ أَبِي بَصِيرٍ عَنْ أَبِي عَبْدِ اللَّهِ عَلَيْهِ السَّلَامُ فِي قَوْلِ اللَّهِ عَزَّ وَجَلَّ",
            "chunk_type": "isnad",
            "word_end": 31,
            "word_start": 0
          },
          {
            "arabic_text": "وَمَنْ أَعْرَضَ عَنْ ذِكْرِي فَإِنَّ لَهُ مَعِيشَةً ضَنْكًا",
            "chunk_type": "quran_quote",
            "word_end": 39,
            "word_start": 31
          },
          {
            "arabic_text": "قَالَ: يَعْنِي بِهِ وَلَايَةَ أَمِيرِ الْمُؤْمِنِينَ عَلَيْهِ السَّلَامُ.",
            "chunk_type": "body",
            "word_end": 47,
            "word_start": 39
          },
          {
            "arabic_text": "قُلْتُ: وَنَحْشُرُهُ يَوْمَ الْقِيَامَةِ أَعْمَى",
            "chunk_type": "quran_quote",
            "word_end": 52,
            "word_start": 47
          },
          {
            "arabic_text": "قَالَ: يَعْنِي أَعْمَى الْبَصَرِ فِي الْآخِرَةِ، أَعْمَى الْقَلْبِ فِي الدُّنْيَا عَنْ وَلَايَةِ أَمِيرِ الْمُؤْمِنِينَ عَلَيْهِ السَّلَامُ. قَالَ: وَهُوَ مُتَحَيِّرٌ فِي الْقِيَامَةِ يَقُولُ:",
            "chunk_type": "body",
            "word_end": 74,
            "word_start": 52
          },
          {
            "arabic_text": "لِمَ حَشَرْتَنِي أَعْمَى وَقَدْ كُنْتُ بَصِيرًا",
            "chunk_type": "quran_quote",
            "word_end": 80,
            "word_start": 74
          },
          {
            "arabic_text": "قَالَ:",
            "chunk_type": "body",
            "word_end": 81,
            "word_start": 80
          },
          {
            "arabic_text": "كَذَٰلِكَ أَتَتْكَ آيَاتُنَا فَنَسِيتَهَا",
            "chunk_type": "quran_quote",
            "word_end": 85,
            "word_start": 81
          },
          {
            "arabic_text": "قَالَ: الْآيَاتُ الْأَئِمَّةُ عَلَيْهِمُ السَّلَامُ، فَنَسِيتَهَا. وَكَذَٰلِكَ الْيَوْمَ تُنْسَى، يَعْنِي تَرَكْتَهَا، وَكَذَٰلِكَ الْيَوْمَ تُتْرَكُ فِي النَّارِ كَمَا تَرَكْتَ الْأَئِمَّةَ عَلَيْهِمُ السَّلَامُ، فَلَمْ تُطِعْ أَمْرَهُمْ وَلَمْ تَسْمَعْ قَوْلَهُمْ.",
            "chunk_type": "body",
            "word_end": 112,
            "word_start": 85
          },
          {
            "arabic_text": "قُلْتُ: وَكَذَٰلِكَ نَجْزِي مَنْ أَسْرَفَ وَلَمْ يُؤْمِنْ بِآيَاتِ رَبِّهِ وَلَعَذَابُ الْآخِرَةِ أَشَدُّ وَأَبْقَى",
            "chunk_type": "quran_quote",
            "word_end": 125,
            "word_start": 112
          },
          {
            "arabic_text": "قَالَ: يَعْنِي مَنْ أَشْرَكَ بِوَلَايَةِ أَمِيرِ الْمُؤْمِنِينَ عَلَيْهِ السَّلَامُ غَيْرَهُ، وَلَمْ يُؤْمِنْ بِآيَاتِ رَبِّهِ، وَتَرَكَ الْأَئِمَّةَ مُعَانَدَةً، فَلَمْ يَتَّبِعْ آثَارَهُمْ وَلَمْ يَتَوَلَّهُمْ.",
            "chunk_type": "body",
            "word_end": 147,
            "word_start": 125
          },
          {
            "arabic_text": "قُلْتُ: اللَّهُ لَطِيفٌ بِعِبَادِهِ يَرْزُقُ مَنْ يَشَاءُ",
            "chunk_type": "quran_quote",
            "word_end": 154,
            "word_start": 147
          },
          {
            "arabic_text": "قَالَ: وَلَايَةُ أَمِيرِ الْمُؤْمِنِينَ عَلَيْهِ السَّلَامُ.",
            "chunk_type": "body",
            "word_end": 160,
            "word_start": 154
          },
          {
            "arabic_text": "قُلْتُ: مَنْ كَانَ يُرِيدُ حَرْثَ الْآخِرَةِ",
            "chunk_type": "quran_quote",
            "word_end": 166,
            "word_start": 160
          },
          {
            "arabic_text": "قَالَ: مَعْرِفَةُ أَمِيرِ الْمُؤْمِنِينَ عَلَيْهِ السَّلَامُ وَالْأَئِمَّةِ، نَزِدْ لَهُ فِي حَرْثِهِ. قَالَ: نَزِيدُهُ مِنْهَا. قَالَ: يَسْتَوْفِي نَصِيبَهُ مِنْ دَوْلَتِهِمْ.",
            "chunk_type": "body",
            "word_end": 185,
            "word_start": 166
          },
          {
            "arabic_text": "وَمَنْ كَانَ يُرِيدُ حَرْثَ الدُّنْيَا نُؤْتِهِ مِنْهَا وَمَا لَهُ فِي الْآخِرَةِ مِنْ نَصِيبٍ",
            "chunk_type": "quran_quote",
            "word_end": 198,
            "word_start": 185
          },
          {
            "arabic_text": "قَالَ: لَيْسَ لَهُ فِي دَوْلَةِ الْحَقِّ مَعَ الْقَائِمِ نَصِيبٌ.",
            "chunk_type": "closing",
            "word_end": 207,
            "word_start": 198
          }
        ],
