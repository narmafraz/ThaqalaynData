            "chunk_type": "body",
            "word_end": 65,
            "word_start": 48
          },
          {
            "arabic_text": "قَالَ قَوْلُهُ فَكُّ رَقَبَةٍ",
            "chunk_type": "quran_quote",
            "word_end": 69,
            "word_start": 65
          },
          {
