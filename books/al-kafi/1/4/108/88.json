            "word_end": 29,
            "word_start": 25
          },
          {
            "arabic_text": "قَوْلُهُ فَلَا اقْتَحَمَ الْعَقَبَةَ",
            "chunk_type": "quran_quote",
            "word_end": 33,
            "word_start": 29
          },
          {
            "arabic_text": "فَقَالَ مَنْ أَكْرَمَهُ اللَّهُ بِوَلَايَتِنَا فَقَدْ جَازَ الْعَقَبَةَ وَنَحْنُ تِلْكَ الْعَقَبَةُ الَّتِي مَنِ اقْتَحَمَهَا نَجَا",
            "chunk_type": "body",
