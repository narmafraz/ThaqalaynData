            "chunk_type": "body",
            "word_end": 28,
            "word_start": 0
          },
          {
            "arabic_text": "ثُمَّ عَطَفَ ٱلْقَوْلَ عَلَى ٱبْنِ حَنْتَمَةَ وَصَاحِبِهِ فَقَالَ فِي ٱلْخَاصِّ وَٱلْعَامِّ: ﴿وَإِنْ جَاهَدَاكَ عَلَىٰ أَنْ تُشْرِكَ بِي﴾.",
            "chunk_type": "quran_quote",
            "word_end": 45,
            "word_start": 28
          },
          {
            "arabic_text": "يَقُولُ فِي ٱلْوَصِيَّةِ وَتَعْدِلُ عَمَّنْ أُمِرْتَ بِطَاعَتِهِ فَلَا تُطِعْهُمَا وَلَا تَسْمَعْ قَوْلَهُمَا.",
            "chunk_type": "body",
            "word_end": 57,
            "word_start": 45
          },
          {
            "arabic_text": "ثُمَّ عَطَفَ ٱلْقَوْلَ عَلَى ٱلْوَالِدَيْنِ فَقَالَ: ﴿وَصَاحِبْهُمَا فِي ٱلدُّنْيَا مَعْرُوفًا﴾.",
            "chunk_type": "quran_quote",
            "word_end": 67,
            "word_start": 57
          },
          {
            "arabic_text": "يَقُولُ عَرِّفِ ٱلنَّاسَ فَضْلَهُمَا وَٱدْعُ إِلَىٰ سَبِيلِهِمَا وَذَٰلِكَ قَوْلُهُ: ﴿وَٱتَّبِعْ سَبِيلَ مَنْ أَنَابَ إِلَيَّ ثُمَّ إِلَيَّ مَرْجِعُكُمْ﴾.",
            "chunk_type": "body",
            "word_end": 84,
            "word_start": 67
          },
          {
