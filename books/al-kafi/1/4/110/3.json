        "chunks": [
          {
            "arabic_text": "أَحْمَدُ بْنُ إِدْرِيسَ وَمُحَمَّدُ بْنُ يَحْيَى عَنِ الْحَسَنِ بْنِ عَلِيٍّ الْكُوفِيِّ عَنْ عُبَيْسِ بْنِ هِشَامٍ عَنْ عَبْدِ اللَّهِ بْنِ سُلَيْمَانَ عَنْ أَبِي عَبْدِ اللَّهِ عَلَيْهِ السَّلَامُ قَالَ",
            "chunk_type": "isnad",
            "word_end": 27,
            "word_start": 0
          },
          {
            "arabic_text": "سَأَلْتُهُ عَنِ الْإِمَامِ فَوَّضَ اللَّهُ إِلَيْهِ كَمَا فَوَّضَ إِلَى سُلَيْمَانَ بْنِ دَاوُدَ فَقَالَ نَعَمْ وَذَلِكَ أَنَّ رَجُلًا سَأَلَهُ عَنْ مَسْأَلَةٍ فَأَجَابَهُ فِيهَا وَسَأَلَهُ آخَرُ عَنْ تِلْكَ الْمَسْأَلَةِ فَأَجَابَهُ بِغَيْرِ جَوَابِ الْأَوَّلِ ثُمَّ سَأَلَهُ آخَرُ فَأَجَابَهُ بِغَيْرِ جَوَابِ الْأَوَّلَيْنِ ثُمَّ قَالَ",
            "chunk_type": "opening",
            "word_end": 67,
            "word_start": 27
          },
          {
            "arabic_text": "هَذَا عَطَاؤُنَا فَامْنُنْ أَوْ أَعْطِ بِغَيْرِ حِسَابٍ",
            "chunk_type": "quran_quote",
            "word_end": 74,
            "word_start": 67
          },
          {
            "arabic_text": "وَهَكَذَا هِيَ فِي قِرَاءَةِ عَلِيٍّ عَلَيْهِ السَّلَامُ.",
            "chunk_type": "body",
            "word_end": 81,
            "word_start": 74
          },
          {
            "arabic_text": "قُلْتُ أَصْلَحَكَ اللَّهُ فَحِينَ أَجَابَهُمْ بِهَذَا الْجَوَابِ يَعْرِفُهُمُ الْإِمَامُ قَالَ سُبْحَانَ اللَّهِ أَمَا تَسْمَعُ اللَّهَ يَقُولُ",
            "chunk_type": "body",
            "word_end": 97,
            "word_start": 81
          },
          {
            "arabic_text": "إِنَّ فِي ذَٰلِكَ لَآيَاتٍ لِلْمُتَوَسِّمِينَ",
            "chunk_type": "quran_quote",
            "word_end": 102,
            "word_start": 97
          },
          {
            "arabic_text": "وَهُمُ الْأَئِمَّةُ",
            "chunk_type": "body",
            "word_end": 104,
            "word_start": 102
          },
          {
            "arabic_text": "وَإِنَّهَا لَبِسَبِيلٍ مُقِيمٍ",
            "chunk_type": "quran_quote",
            "word_end": 107,
            "word_start": 104
          },
          {
            "arabic_text": "لَا يَخْرُجُ مِنْهَا أَبَدًا.",
            "chunk_type": "body",
            "word_end": 111,
            "word_start": 107
          },
          {
            "arabic_text": "ثُمَّ قَالَ لِي نَعَمْ إِنَّ الْإِمَامَ إِذَا أَبْصَرَ إِلَى الرَّجُلِ عَرَفَهُ وَعَرَفَ لَوْنَهُ وَإِنْ سَمِعَ كَلَامَهُ مِنْ خَلْفِ حَائِطٍ عَرَفَهُ وَعَرَفَ مَا هُوَ إِنَّ اللَّهَ يَقُولُ",
            "chunk_type": "body",
            "word_end": 137,
            "word_start": 111
          },
          {
            "arabic_text": "وَمِنْ آيَاتِهِ خَلْقُ السَّمَاوَاتِ وَالْأَرْضِ وَاخْتِلَافُ أَلْسِنَتِكُمْ وَأَلْوَانِكُمْ إِنَّ فِي ذَٰلِكَ لَآيَاتٍ لِلْعَالِمِينَ",
            "chunk_type": "quran_quote",
            "word_end": 150,
            "word_start": 137
          },
          {
            "arabic_text": "وَهُمُ الْعُلَمَاءُ فَلَيْسَ يَسْمَعُ شَيْئًا مِنَ الْأَمْرِ يَنْطِقُ بِهِ إِلَّا عَرَفَهُ نَاجٍ أَوْ هَالِكٌ فَلِذَٰلِكَ يُجِيبُهُمْ بِالَّذِي يُجِيبُهُمْ.",
            "chunk_type": "closing",
            "word_end": 168,
            "word_start": 150
          }
