            "word_end": 16,
            "word_start": 0
          },
          {
            "arabic_text": "سَمِعْتُ أَبَا الْحَسَنِ الْعَسْكَرِيَّ عَلَيْهِ السَّلَامُ يَقُولُ: الْخَلَفُ مِنْ بَعْدِي الْحَسَنُ، فَكَيْفَ لَكُمْ بِالْخَلَفِ مِنْ بَعْدِ الْخَلَفِ؟",
            "chunk_type": "opening",
            "word_end": 33,
            "word_start": 16
          },
          {
            "arabic_text": "فَقُلْتُ: وَلِمَ جَعَلَنِيَ اللَّهُ فِدَاكَ؟ قَالَ: إِنَّكُمْ لَا تَرَوْنَ شَخْصَهُ، وَلَا يَحِلُّ لَكُمْ ذِكْرُهُ بِاسْمِهِ.",
            "chunk_type": "body",
            "word_end": 48,
            "word_start": 33
          },
          {
            "arabic_text": "فَقُلْتُ: فَكَيْفَ نَذْكُرُهُ؟ فَقَالَ: قُولُوا: الْحُجَّةُ مِنْ آلِ مُحَمَّدٍ صَلَوَاتُ اللَّهِ عَلَيْهِ وَسَلَامُهُ.",
            "chunk_type": "closing",
