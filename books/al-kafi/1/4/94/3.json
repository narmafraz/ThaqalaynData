        "chunks": [
          {
            "arabic_text": "عَلِيُّ بْنُ إِبْرَاهِيمَ عَنْ عَلِيِّ بْنِ حَسَّانَ وَمُحَمَّدُ بْنُ يَحْيَى عَنْ سَلَمَةَ بْنِ الْخَطَّابِ وَغَيْرِهِ عَنْ عَلِيِّ بْنِ حَسَّانَ عَنْ عَلِيِّ بْنِ عَطِيَّةَ عَنْ عَلِيِّ بْنِ رِئَابٍ رَفَعَهُ إِلَى أَمِيرِ الْمُؤْمِنِينَ (عَلَيْهِ السَّلَامُ) قَالَ",
            "chunk_type": "isnad",
            "word_end": 34,
            "word_start": 0
          },
          {
            "arabic_text": "قَالَ أَمِيرُ الْمُؤْمِنِينَ (عَلَيْهِ السَّلَامُ) إِنَّ لِلَّهِ نَهَرًا دُونَ عَرْشِهِ وَدُونَ النَّهَرِ الَّذِي دُونَ عَرْشِهِ نُورًا نَوَّرَهُ وَإِنَّ فِي حَافَتَيِ النَّهَرِ رُوحَيْنِ مَخْلُوقَيْنِ: رُوحُ الْقُدُسِ وَرُوحٌ مِنْ أَمْرِهِ، وَإِنَّ لِلَّهِ عَشْرَ طِينَاتٍ، خَمْسَةً مِنَ الْجَنَّةِ وَخَمْسَةً مِنَ الْأَرْضِ، فَفَسَّرَ الْجِنَانَ وَفَسَّرَ الْأَرْضَ.",
            "chunk_type": "opening",
            "word_end": 76,
            "word_start": 34
          },
          {
            "arabic_text": "ثُمَّ قَالَ: مَا مِنْ نَبِيٍّ وَلَا مَلَكٍ مِنْ بَعْدِهِ جَبَلَهُ إِلَّا نَفَخَ فِيهِ مِنْ إِحْدَى الرُّوحَيْنِ، وَجَعَلَ النَّبِيَّ (صَلَّى اللَّهُ عَلَيْهِ وَآلِهِ) مِنْ إِحْدَى الطِّينَتَيْنِ.",
            "chunk_type": "body",
            "word_end": 101,
            "word_start": 76
          },
          {
            "arabic_text": "قُلْتُ لِأَبِي الْحَسَنِ الْأَوَّلِ (عَلَيْهِ السَّلَامُ): مَا الْجَبْلُ؟ فَقَالَ: الْخَلْقُ غَيْرُنَا أَهْلَ الْبَيْتِ، فَإِنَّ اللَّهَ عَزَّ وَجَلَّ خَلَقَنَا مِنَ الْعَشْرِ طِينَاتٍ وَنَفَخَ فِينَا مِنَ الرُّوحَيْنِ جَمِيعًا، فَأَطْيِبْ بِهَا طِيبًا.",
            "chunk_type": "body",
            "word_end": 130,
            "word_start": 101
          },
          {
            "arabic_text": "وَرَوَى غَيْرُهُ عَنْ أَبِي الصَّامِتِ قَالَ: طِينُ الْجِنَانِ جَنَّةُ عَدْنٍ وَجَنَّةُ الْمَأْوَى وَجَنَّةُ النَّعِيمِ وَالْفِرْدَوْسُ وَالْخُلْدُ، وَطِينُ الْأَرْضِ مَكَّةُ وَالْمَدِينَةُ وَالْكُوفَةُ وَبَيْتُ الْمَقْدِسِ وَالْحَائِرُ.",
            "chunk_type": "closing",
            "word_end": 154,
            "word_start": 130
          }
