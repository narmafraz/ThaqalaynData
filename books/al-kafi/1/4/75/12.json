          {
            "arabic_text": "كَتَبَ إِلَيَّ أَبُو الْحَسَنِ فِي كِتَابٍ: أَرَدْتَ أَنْ تَسْأَلَ عَنِ الْخَلَفِ بَعْدَ أَبِي جَعْفَرٍ، وَقَلِقْتَ لِذَلِكَ، فَلَا تَغْتَمَّ، فَإِنَّ اللَّهَ عَزَّ وَجَلَّ لَا يُضِلُّ قَوْمًا بَعْدَ إِذْ هَدَاهُمْ حَتَّى يُبَيِّنَ لَهُمْ مَا يَتَّقُونَ.",
            "chunk_type": "opening",
            "word_end": 47,
            "word_start": 14
          },
          {
            "arabic_text": "وَصَاحِبُكَ بَعْدِي أَبُو مُحَمَّدٍ ابْنِي، وَعِنْدَهُ مَا تَحْتَاجُونَ إِلَيْهِ، يُقَدِّمُ مَا يَشَاءُ اللَّهُ وَيُؤَخِّرُ مَا يَشَاءُ اللَّهُ",
            "chunk_type": "body",
            "word_end": 64,
            "word_start": 47
          },
          {
            "arabic_text": "مَا نَنْسَخْ مِنْ آيَةٍ أَوْ نُنْسِهَا نَأْتِ بِخَيْرٍ مِنْهَا أَوْ مِثْلِهَا",
            "chunk_type": "quran_quote",
            "word_end": 75,
            "word_start": 64
          },
          {
