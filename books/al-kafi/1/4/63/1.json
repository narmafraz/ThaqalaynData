            "chunk_type": "isnad",
            "word_end": 25,
            "word_start": 0
          },
          {
            "arabic_text": "لَا تَعُودُ الْإِمَامَةُ فِي أَخَوَيْنِ بَعْدَ الْحَسَنِ وَالْحُسَيْنِ أَبَدًا.",
