            "chunk_type": "quran_quote",
            "word_end": 53,
            "word_start": 40
          },
          {
            "arabic_text": "فَلَا تَكُونُ بَعْدَ عَلِيِّ بْنِ الْحُسَيْنِ ( عَلَيْهِ السَّلَامُ ) إِلَّا فِي الْأَعْقَابِ وَأَعْقَابِ الْأَعْقَابِ.",
