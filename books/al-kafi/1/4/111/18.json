            "chunk_type": "isnad",
            "word_end": 12,
            "word_start": 0
          },
          {
            "arabic_text": "أَكَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَآلِهِ مَحْجُوجًا بِأَبِي طَالِبٍ",
            "chunk_type": "opening",
            "word_end": 22,
            "word_start": 12
          },
          {
            "arabic_text": "فَقَالَ لَا وَلَكِنَّهُ كَانَ مُسْتَوْدَعًا لِلْوَصَايَا فَدَفَعَهَا إِلَيْهِ صَلَّى اللَّهُ عَلَيْهِ وَآلِهِ",
            "chunk_type": "body",
            "word_end": 34,
            "word_start": 22
          },
          {
            "arabic_text": "قَالَ قُلْتُ فَدَفَعَ إِلَيْهِ الْوَصَايَا عَلَى أَنَّهُ مَحْجُوجٌ بِهِ",
            "chunk_type": "body",
            "word_end": 43,
            "word_start": 34
          },
          {
            "arabic_text": "فَقَالَ لَوْ كَانَ مَحْجُوجًا بِهِ مَا دَفَعَ إِلَيْهِ الْوَصِيَّةَ",
            "chunk_type": "body",
            "word_end": 52,
            "word_start": 43
          },
          {
            "arabic_text": "قَالَ فَقُلْتُ فَمَا كَانَ حَالُ أَبِي طَالِبٍ",
            "chunk_type": "body",
            "word_end": 59,
            "word_start": 52
          },
          {
