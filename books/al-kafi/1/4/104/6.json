        "chunks": [
          {
            "arabic_text": "عِدَّةٌ مِنْ أَصْحَابِنَا عَنْ أَحْمَدَ بْنِ مُحَمَّدٍ الْبَرْقِيِّ وَعَلِيُّ بْنُ إِبْرَاهِيمَ عَنْ أَبِيهِ جَمِيعًا عَنِ الْقَاسِمِ بْنِ مُحَمَّدٍ الْأَصْبَهَانِيِّ عَنْ سُلَيْمَانَ بْنِ دَاوُدَ الْمِنْقَرِيِّ عَنْ سُفْيَانَ بْنِ عُيَيْنَةَ عَنْ أَبِي عَبْدِ اللَّهِ (عَلَيْهِ السَّلَامُ) أَنَّ النَّبِيَّ (صَلَّى اللَّهُ عَلَيْهِ وَآلِهِ) قَالَ",
            "chunk_type": "isnad",
            "word_end": 41,
            "word_start": 0
          },
          {
            "arabic_text": "أَنَا أَوْلَى بِكُلِّ مُؤْمِنٍ مِنْ نَفْسِهِ وَعَلِيٌّ أَوْلَى بِهِ مِنْ بَعْدِي.",
            "chunk_type": "opening",
            "word_end": 52,
            "word_start": 41
          },
          {
            "arabic_text": "فَقِيلَ لَهُ: مَا مَعْنَى ذَلِكَ؟ فَقَالَ: قَوْلُ النَّبِيِّ (صَلَّى اللَّهُ عَلَيْهِ وَآلِهِ): مَنْ تَرَكَ دَيْنًا أَوْ ضَيَاعًا فَعَلَيَّ، وَمَنْ تَرَكَ مَالًا فَلِوَرَثَتِهِ.",
            "chunk_type": "body",
            "word_end": 74,
            "word_start": 52
          },
          {
            "arabic_text": "فَالرَّجُلُ لَيْسَتْ لَهُ عَلَى نَفْسِهِ وِلَايَةٌ إِذَا لَمْ يَكُنْ لَهُ مَالٌ، وَلَيْسَ لَهُ عَلَى عِيَالِهِ أَمْرٌ وَلَا نَهْيٌ إِذَا لَمْ يُجْرِ عَلَيْهِمُ النَّفَقَةَ.",
            "chunk_type": "body",
            "word_end": 97,
            "word_start": 74
          },
          {
            "arabic_text": "وَالنَّبِيُّ وَأَمِيرُ الْمُؤْمِنِينَ (عَلَيْهِ السَّلَامُ) وَمَنْ بَعْدَهُمَا أَلْزَمَهُمْ هَذَا، فَمِنْ هُنَاكَ صَارُوا أَوْلَى بِهِمْ مِنْ أَنْفُسِهِمْ، وَمَا كَانَ سَبَبُ إِسْلَامِ عَامَّةِ الْيَهُودِ إِلَّا مِنْ بَعْدِ هَذَا الْقَوْلِ مِنْ رَسُولِ اللَّهِ (صَلَّى اللَّهُ عَلَيْهِ وَآلِهِ)، وَإِنَّهُمْ آمَنُوا عَلَى أَنْفُسِهِمْ وَعَلَى عِيَالَاتِهِمْ.",
            "chunk_type": "closing",
