            "chunk_type": "opening",
            "word_end": 42,
            "word_start": 29
          },
          {
            "arabic_text": "لَا تُدْرِكُهُ الْأَبْصَارُ وَهُوَ يُدْرِكُ الْأَبْصَارَ وَهُوَ اللَّطِيفُ الْخَبِيرُ",
            "chunk_type": "quran_quote",
            "word_end": 51,
            "word_start": 42
          },
          {
            "arabic_text": "وَلَا يُوصَفُ بِكَيْفٍ وَلَا أَيْنٍ وَحَيْثٍ وَكَيْفَ أَصِفُهُ بِالْكَيْفِ وَهُوَ الَّذِي كَيَّفَ الْكَيْفَ حَتَّى صَارَ كَيْفًا فَعُرِفَتِ الْكَيْفُ بِمَا كَيَّفَ لَنَا مِنَ الْكَيْفِ",
            "chunk_type": "body",
            "word_end": 74,
            "word_start": 51
          },
          {
            "arabic_text": "أَمْ كَيْفَ أَصِفُهُ بِأَيْنٍ وَهُوَ الَّذِي أَيَّنَ الْأَيْنَ حَتَّى صَارَ أَيْنًا فَعُرِفَتِ الْأَيْنُ بِمَا أَيَّنَ لَنَا مِنَ الْأَيْنِ",
            "chunk_type": "body",
            "word_end": 92,
            "word_start": 74
          },
          {
            "arabic_text": "أَمْ كَيْفَ أَصِفُهُ بِحَيْثٍ وَهُوَ الَّذِي حَيَّثَ الْحَيْثَ حَتَّى صَارَ حَيْثًا فَعُرِفَتِ الْحَيْثُ بِمَا حَيَّثَ لَنَا مِنَ الْحَيْثِ",
