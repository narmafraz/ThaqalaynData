            "word_start": 0
          },
          {
            "arabic_text": "قُلْتُ لِأَبِي جَعْفَرٍ (عَلَيْهِ السَّلَامُ) جُعِلْتُ فِدَاكَ إِنْ رَأَيْتَ أَنْ تُعَلِّمَنِي هَلْ كَانَ اللَّهُ جَلَّ وَجْهُهُ يَعْلَمُ قَبْلَ أَنْ يَخْلُقَ الْخَلْقَ أَنَّهُ وَحْدَهُ فَقَدِ اخْتَلَفَ مَوَالِيكَ فَقَالَ بَعْضُهُمْ قَدْ كَانَ يَعْلَمُ قَبْلَ أَنْ يَخْلُقَ شَيْئًا مِنْ خَلْقِهِ وَقَالَ بَعْضُهُمْ إِنَّمَا مَعْنَى يَعْلَمُ يَفْعَلُ فَهُوَ الْيَوْمَ يَعْلَمُ أَنَّهُ لَا غَيْرُهُ قَبْلَ فِعْلِ الْأَشْيَاءِ",
            "chunk_type": "opening",
            "word_end": 77,
            "word_start": 25
          },
          {
            "arabic_text": "فَقَالُوا إِنْ أَثْبَتْنَا أَنَّهُ لَمْ يَزَلْ عَالِمًا بِأَنَّهُ لَا غَيْرُهُ فَقَدْ أَثْبَتْنَا مَعَهُ غَيْرَهُ فِي أَزَلِيَّتِهِ",
            "chunk_type": "body",
            "word_end": 93,
