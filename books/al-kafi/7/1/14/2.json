            "word_start": 0
          },
          {
            "arabic_text": "سَأَلْتُ أَبَا جَعْفَرٍ ( عَلَيْهِ السَّلَامُ ) عَنْ قَوْلِ اللَّهِ تَبَارَكَ وَ تَعَالَى فَمَنْ بَدَّلَهُ بَعْدَ مَا سَمِعَهُ فَإِنَّمَا إِثْمُهُ عَلَى الَّذِينَ يُبَدِّلُونَهُ",
            "chunk_type": "body",
            "word_end": 42,
            "word_start": 19
          },
          {
            "arabic_text": "قَالَ نَسَخَتْهَا الْآيَةُ الَّتِي بَعْدَهَا قَوْلُهُ عَزَّ وَ جَلَّ فَمَنْ خافَ مِنْ مُوصٍ جَنَفاً أَوْ إِثْمَاً فَأَصْلَحَ بَيْنَهُمْ فَلَا إِثْمَ عَلَيْهِ",
            "chunk_type": "body",
            "word_end": 63,
