            "word_start": 0
          },
          {
            "arabic_text": "أَيُّمَا رَجُلٍ وَقَعَ عَلَى وَلِيدَةِ قَوْمٍ حَرَامَاً ثُمَّ اشْتَرَاهَا ثُمَّ ادَّعَى وَلَدَهَا فَإِنَّهُ لَا يُوَرَّثُ مِنْهُ شَيْ‏ءٌ",
            "chunk_type": "body",
