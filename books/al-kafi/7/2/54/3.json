            "word_start": 0
          },
          {
            "arabic_text": "عَلِيُّ بْنُ إِبْرَاهِيمَ عَنْ أَبِيهِ عَنِ ابْنِ أَبِي عُمَيْرٍ عَنْ حَمَّادٍ عَنِ الْحَلَبِيِّ عَنْ أَبِي عَبْدِ اللَّهِ ( عَلَيْهِ السَّلَامُ ) أَنَّهُ قَالَ فِي الْمُلَاعِنِ",
            "chunk_type": "isnad",
            "word_end": 51,
            "word_start": 26
          },
          {
            "arabic_text": "إِنْ أَكْذَبَ نَفْسَهُ قَبْلَ اللِّعَانِ رُدَّتْ إِلَيْهِ امْرَأَتُهُ وَ ضُرِبَ الْحَدَّ وَ إِنْ أَبَى لَاعَنَ وَ لَمْ تَحِلَّ لَهُ أَبَداً",
            "chunk_type": "body",
            "word_end": 71,
            "word_start": 51
          },
          {
            "arabic_text": "وَ إِنْ قَذَفَ رَجُلٌ امْرَأَتَهُ كَانَ عَلَيْهِ الْحَدُّ وَ إِنْ مَاتَ وَلَدُهُ وَرِثَهُ أَخْوَالُهُ",
            "chunk_type": "body",
            "word_end": 85,
