        "chunks": [
          {
            "arabic_text": "عَلِيُّ بْنُ إِبْرَاهِيمَ عَنْ أَبِيهِ عَنِ ابْنِ أَبِي عُمَيْرٍ عَنْ عُمَرَ بْنِ أُذَيْنَةَ عَنْ زُرَارَةَ وَ بُكَيْرٍ وَ الْفُضَيْلِ وَ مُحَمَّدٍ وَ بُرَيْدٍ عَنْ أَحَدِهِمَا (عَلَيْهِ السَّلَامُ) قَالَ",
            "chunk_type": "isnad",
            "word_end": 28,
            "word_start": 0
          },
          {
            "arabic_text": "إِنَّ الْجَدَّ مَعَ الْإِخْوَةِ مِنَ الْأَبِ يَصِيرُ مِثْلَ وَاحِدٍ مِنَ الْإِخْوَةِ مَا بَلَغُوا",
            "chunk_type": "body",
            "word_end": 41,
            "word_start": 28
          },
          {
            "arabic_text": "قَالَ قُلْتُ رَجُلٌ تَرَكَ أَخَاهُ لِأَبِيهِ وَ أُمِّهِ وَ جَدَّهُ أَوْ قُلْتُ تَرَكَ جَدَّهُ وَ أَخَاهُ لِأَبِيهِ وَ أُمِّهِ قَالَ الْمَالُ بَيْنَهُمَا وَ إِنْ كَانَا أَخَوَيْنِ أَوْ مِائَةَ أَلْفٍ فَلَهُ مِثْلُ نَصِيبِ وَاحِدٍ مِنَ الْإِخْوَةِ",
            "chunk_type": "body",
            "word_end": 76,
            "word_start": 41
          },
          {
            "arabic_text": "قَالَ قُلْتُ رَجُلٌ تَرَكَ جَدَّهُ وَ أُخْتَهُ فَقَالَ لِلذَّكَرِ مِثْلُ حَظِّ الْأُنْثَيَيْنِ وَ إِنْ كَانَتَا أُخْتَيْنِ فَالنِّصْفُ لِلْجَدِّ وَ النِّصْفُ الْآخَرُ لِلْأُخْتَيْنِ وَ إِنْ كُنَّ أَكْثَرَ مِنْ ذَلِكَ فَعَلَى هَذَا الْحِسَابِ وَ إِنْ تَرَكَ إِخْوَةً وَ أَخَوَاتٍ لِأَبٍ وَ أُمٍّ أَوْ لِأَبٍ وَ جَدّاً فَالْجَدُّ أَحَدُ الْإِخْوَةِ فَالْمَالُ بَيْنَهُمْ لِلذَّكَرِ مِثْلُ حَظِّ الْأُنْثَيَيْنِ",
            "chunk_type": "body",
            "word_end": 129,
            "word_start": 76
          },
          {
            "arabic_text": "قَالَ زُرَارَةُ هَذَا مِمَّا لَا يُؤْخَذُ عَلَيَّ فِيهِ قَدْ سَمِعْتُهُ مِنْ أَبِيهِ وَ مِنْهُ قَبْلَ ذَلِكَ وَ لَيْسَ عِنْدَنَا فِي ذَلِكَ شَكٌّ وَ لَا اخْتِلَافٌ",
            "chunk_type": "closing",
            "word_end": 154,
            "word_start": 129
          }
