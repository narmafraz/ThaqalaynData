        "chunks": [
          {
            "arabic_text": "عَلِيُّ بْنُ إِبْرَاهِيمَ عَنْ مُحَمَّدِ بْنِ عِيسَى عَنْ يُونُسَ عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْحَجَّاجِ وَ حُمَيْدُ بْنُ زِيَادٍ عَنِ ابْنِ سَمَاعَةَ عَنْ مُحَمَّدِ بْنِ أَبِي حَمْزَةَ عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْحَجَّاجِ عَنْ أَبِي عَبْدِ اللَّهِ ( عَلَيْهِ السَّلَامُ ) قَالَ",
            "chunk_type": "isnad",
            "word_end": 40,
            "word_start": 0
          },
          {
            "arabic_text": "قُلْتُ لَهُ رَجُلٌ وَ امْرَأَةٌ سَقَطَ عَلَيْهِمَا الْبَيْتُ فَمَاتَا قَالَ يُوَرَّثُ الرَّجُلُ مِنَ الْمَرْأَةِ وَ الْمَرْأَةُ مِنَ الرَّجُلِ",
            "chunk_type": "body",
            "word_end": 58,
            "word_start": 40
          },
          {
            "arabic_text": "قُلْتُ فَإِنَّ أَبَا حَنِيفَةَ قَدْ أَدْخَلَ عَلَيْهِمْ فِي هَذَا شَيْئاً قَالَ وَ أَيَّ شَيْ‏ءٍ أَدْخَلَ عَلَيْهِمْ قُلْتُ رَجُلَيْنِ أَخَوَيْنِ أَعْجَمِيَّيْنِ لَيْسَ لَهُمَا وَارِثٌ إِلَّا مَوَالِيهِمَا أَحَدُهُمَا لَهُ مِائَةُ أَلْفِ دِرْهَمٍ مَعْرُوفَةٍ وَ الْآخَرُ لَيْسَ لَهُ شَيْ‏ءٌ رَكِبَا فِي سَفِينَةٍ فَغَرِقَا فَأُخْرِجَتِ الْمِائَةُ أَلْفٍ كَيْفَ يُصْنَعُ بِهَا",
            "chunk_type": "body",
            "word_end": 104,
            "word_start": 58
          },
          {
            "arabic_text": "قَالَ تُدْفَعُ إِلَى مَوَالِي الَّذِي لَيْسَ لَهُ شَيْ‏ءٌ",
            "chunk_type": "body",
            "word_end": 112,
            "word_start": 104
          },
          {
            "arabic_text": "قَالَ فَقَالَ مَا أُنْكِرُ مَا أَدْخَلَ فِيهَا صَدَقَ وَ هُوَ هَكَذَا ثُمَّ قَالَ يُدْفَعُ الْمَالُ إِلَى مَوَالِي الَّذِي لَيْسَ لَهُ شَيْ‏ءٌ وَ لَمْ يَكُنْ لِلْآخَرِ مَالٌ يَرِثُهُ مَوَالِي الْآخَرِ فَلَا شَيْ‏ءَ لِوَرَثَتِهِ",
