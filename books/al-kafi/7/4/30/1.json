        "chunks": [
          {
            "arabic_text": "عَلِيُّ بْنُ إِبْرَاهِيمَ عَنْ أَبِيهِ عَنِ ابْنِ فَضَّالٍ عَنْ سُلَيْمَانَ الدَّهَّانِ عَنْ رِفَاعَةَ عَنْ أَبِي عَبْدِ اللَّهِ ( عَلَيْهِ السَّلَامُ ) قَالَ",
            "chunk_type": "isnad",
            "word_end": 22,
            "word_start": 0
          },
          {
            "arabic_text": "إِنَّ عُثْمَانَ أَتَاهُ رَجُلٌ مِنْ قَيْسٍ بِمَوْلًى لَهُ قَدْ لَطَمَ عَيْنَهُ فَأَنْزَلَ الْمَاءَ فِيهَا وَ هِيَ قَائِمَةٌ لَيْسَ يُبْصِرُ بِهَا شَيْئاً فَقَالَ لَهُ أُعْطِيكَ الدِّيَةَ فَأَبَى",
            "chunk_type": "body",
            "word_end": 48,
            "word_start": 22
          },
          {
            "arabic_text": "قَالَ فَأَرْسَلَ بِهِمَا إِلَى عَلِيٍّ ( عَلَيْهِ السَّلَامُ ) وَ قَالَ احْكُمْ بَيْنَ هَذَيْنِ فَأَعْطَاهُ الدِّيَةَ فَأَبَى قَالَ فَلَمْ يَزَالُوا يُعْطُونَهُ حَتَّى أَعْطَوْهُ دِيَتَيْنِ قَالَ فَقَالَ لَيْسَ أُرِيدُ إِلَّا الْقِصَاصَ",
            "chunk_type": "body",
            "word_end": 78,
            "word_start": 48
          },
          {
            "arabic_text": "قَالَ فَدَعَا عَلِيٌّ بِمِرْآةٍ فَحَمَاهَا ثُمَّ دَعَا بِكُرْسُفٍ فَبَلَّهُ ثُمَّ جَعَلَهُ عَلَى أَشْفَارِ عَيْنَيْهِ وَ عَلَى حَوَالَيْهَا ثُمَّ اسْتَقْبَلَ بِعَيْنِهِ عَيْنَ الشَّمْسِ قَالَ وَ جَاءَ بِالْمِرْآةِ فَقَالَ انْظُرْ فَنَظَرَ فَذَابَ الشَّحْمُ وَ بَقِيَتْ عَيْنُهُ قَائِمَةً وَ ذَهَبَ الْبَصَرُ",
            "chunk_type": "body",
            "word_end": 116,
