            "arabic_text": "عَلِيُّ بْنُ إِبْرَاهِيمَ عَنْ أَبِيهِ عَنِ ابْنِ أَبِي عُمَيْرٍ عَنْ أَبِي أُسَامَةَ زَيْدٍ الشَّحَّامِ عَنْ أَبِي عَبْدِ اللَّهِ ( عَلَيْهِ السَّلَامُ ) قَالَ",
            "chunk_type": "isnad",
            "word_end": 23,
            "word_start": 0
          },
          {
            "arabic_text": "إِنَّ رَسُولَ اللَّهِ ( صَلَّى اللَّهِ عَلَيْهِ وَآلِهِ ) وَقَفَ بِمِنًى حِينَ قَضَى مَنَاسِكَهَا فِي حَجَّةِ الْوَدَاعِ فَقَالَ أَيُّهَا النَّاسُ اسْمَعُوا مَا أَقُولُ لَكُمْ وَ اعْقِلُوهُ عَنِّي فَإِنِّي لَا أَدْرِي لَعَلِّي لَا أَلْقَاكُمْ فِي هَذَا الْمَوْقِفِ بَعْدَ عَامِنَا هَذَا",
            "chunk_type": "opening",
            "word_end": 62,
            "word_start": 23
          },
          {
            "arabic_text": "ثُمَّ قَالَ أَيُّ يَوْمٍ أَعْظَمُ حُرْمَةً قَالُوا هَذَا الْيَوْمُ قَالَ فَأَيُّ شَهْرٍ أَعْظَمُ حُرْمَةً قَالُوا هَذَا الشَّهْرُ قَالَ فَأَيُّ بَلَدٍ أَعْظَمُ حُرْمَةً قَالُوا هَذَا الْبَلَدُ",
            "chunk_type": "body",
            "word_end": 87,
            "word_start": 62
          },
          {
            "arabic_text": "قَالَ فَإِنَّ دِمَاءَكُمْ وَ أَمْوَالَكُمْ عَلَيْكُمْ حَرَامٌ كَحُرْمَةِ يَوْمِكُمْ هَذَا فِي شَهْرِكُمْ هَذَا فِي بَلَدِكُمْ هَذَا إِلَى يَوْمِ تَلْقَوْنَهُ فَيَسْأَلُكُمْ عَنْ أَعْمَالِكُمْ",
            "chunk_type": "body",
            "word_end": 109,
            "word_start": 87
          },
          {
            "arabic_text": "أَلَا هَلْ بَلَّغْتُ قَالُوا نَعَمْ",
