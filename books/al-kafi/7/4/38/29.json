        "chunks": [
          {
            "arabic_text": "عِدَّةٌ مِنْ أَصْحَابِنَا عَنْ سَهْلِ بْنِ زِيَادٍ عَنْ مُحَمَّدِ بْنِ الْحَسَنِ بْنِ شَمُّونٍ عَنْ عَبْدِ اللَّهِ بْنِ عَبْدِ الرَّحْمَنِ الْأَصَمِّ عَنْ مِسْمَعٍ عَنْ أَبِي عَبْدِ اللَّهِ ( عَلَيْهِ السَّلَامُ ) قَالَ",
            "chunk_type": "isnad",
            "word_end": 31,
            "word_start": 0
          },
          {
            "arabic_text": "قَضَى أَمِيرُ الْمُؤْمِنِينَ ( عَلَيْهِ السَّلَامُ ) فِي الظُّفُرِ إِذَا قُلِعَ وَ لَمْ يَنْبُتْ وَ خَرَجَ أَسْوَدَ فَاسِداً عَشَرَةَ دَنَانِيرَ فَإِنْ خَرَجَ أَبْيَضَ فَخَمْسَةُ دَنَانِيرَ .",
            "chunk_type": "body",
            "word_end": 57,
            "word_start": 31
          },
          {
            "arabic_text": "رَجَعَ إِلَى الْإِسْنَادِ الْأَوَّلِ قَالَ وَ قَضَى فِي مُوضِحَةِ الْأَصَابِعِ ثُلُثَ دِيَةِ الْإِصْبَعِ",
            "chunk_type": "body",
            "word_end": 70,
            "word_start": 57
          },
          {
            "arabic_text": "فَإِنْ أُصِيبَ رَجُلٌ فَأَدِرَ خُصْيَتَاهُ كِلْتَاهُمَا فَدِيَتُهُ أَرْبَعُمِائَةِ دِينَارٍ",
            "chunk_type": "body",
            "word_end": 79,
            "word_start": 70
          },
          {
            "arabic_text": "فَإِنْ فَحِجَ فَلَمْ يَسْتَطِعِ الْمَشْيَ إِلَّا مَشْياً يَسِيراً لَا يَنْفَعُهُ فَدِيَتُهُ أَرْبَعُمِائَةِ أَخْمَاسِ دِيَةِ النَّفْسِ ثَمَانُمِائَةِ دِينَارٍ",
            "chunk_type": "body",
            "word_end": 96,
            "word_start": 79
          },
          {
            "arabic_text": "فَإِنْ أُحْدِبَ مِنْهَا الظَّهْرُ فَحِينَئِذٍ تَمَّتْ دِيَتُهُ أَلْفُ دِينَارٍ",
            "chunk_type": "body",
            "word_end": 105,
            "word_start": 96
          },
          {
            "arabic_text": "وَ الْقَسَامَةُ فِي كُلِّ شَيْ‏ءٍ مِنْ ذَلِكَ سِتَّةُ نَفَرٍ عَلَى مَا بَلَغَتْ دِيَتُهُ",
            "chunk_type": "body",
            "word_end": 118,
            "word_start": 105
          },
          {
            "arabic_text": "وَ دِيَةُ الْبُجْرَةِ إِذَا كَانَتْ فَوْقَ الْعَانَةِ عُشْرُ دِيَةِ النَّفْسِ مِائَةُ دِينَارٍ",
            "chunk_type": "body",
            "word_end": 130,
            "word_start": 118
          },
          {
            "arabic_text": "فَإِنْ كَانَتْ فِي الْعَانَةِ فَخَرَقَتِ الصِّفَاقَ فَصَارَتْ أُدْرَةً فِي إِحْدَى الْبَيْضَتَيْنِ فَدِيَتُهَا مِائَتَا دِينَارٍ خُمُسُ الدِّيَةِ .",
            "chunk_type": "body",
            "word_end": 147,
            "word_start": 130
          }
        ],
