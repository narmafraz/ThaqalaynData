            "word_start": 0
          },
          {
            "arabic_text": "قُلْتُ لِأَبِي عَبْدِ اللَّهِ ( عَلَيْهِ السَّلَامُ ) رَجُلٌ يَخْرُجُ مِنْ مَنْزِلِهِ يُرِيدُ الْمَسْجِدَ أَوْ يُرِيدُ الْحَاجَةَ فَيَلْقَاهُ رَجُلٌ أَوْ يَسْتَقْفِيهِ فَيَضْرِبُهُ وَ يَأْخُذُ ثَوْبَهُ",
            "chunk_type": "body",
            "word_end": 52,
            "word_start": 27
          },
          {
            "arabic_text": "قَالَ أَيَّ شَيْ‏ءٍ يَقُولُ فِيهِ مَنْ قِبَلَكُمْ قُلْتُ يَقُولُونَ هَذِهِ دَغَارَةٌ مُعْلَنَةٌ وَ إِنَّمَا الْمُحَارِبُ فِي قُرًى مُشْرِكِيَّةٍ",
            "chunk_type": "body",
            "word_end": 70,
            "word_start": 52
          },
          {
            "arabic_text": "فَقَالَ أَيُّهُمَا أَعْظَمُ حُرْمَةً دَارُ الْإِسْلَامِ أَوْ دَارُ الشِّرْكِ قَالَ فَقُلْتُ دَارُ الْإِسْلَامِ",
            "chunk_type": "body",
            "word_end": 83,
            "word_start": 70
          },
          {
            "arabic_text": "فَقَالَ هَؤُلَاءِ مِنْ أَهْلِ هَذِهِ الْآيَةِ إِنَّمَا جَزاءُ الَّذِينَ يُحارِبُونَ اللَّهَ وَ رَسُولَهُ إِلَى آخِرِ الْآيَةِ",
