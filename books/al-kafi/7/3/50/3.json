        "chunks": [
          {
            "arabic_text": "عَلِيُّ بْنُ إِبْرَاهِيمَ عَنْ أَبِيهِ عَنِ ابْنِ أَبِي عُمَيْرٍ عَنْ جَمِيلِ بْنِ دَرَّاجٍ قَالَ",
            "chunk_type": "isnad",
            "word_end": 14,
            "word_start": 0
          },
          {
            "arabic_text": "سَأَلْتُ أَبَا عَبْدِ اللَّهِ ( عَلَيْهِ السَّلَامُ ) عَنْ قَوْلِ اللَّهِ عَزَّ وَ جَلَّ إِنَّمَا جَزاءُ الَّذِينَ يُحارِبُونَ اللَّهَ وَ رَسُولَهُ وَ يَسْعَوْنَ فِي الْأَرْضِ فَساداً أَنْ يُقَتَّلُوا أَوْ يُصَلَّبُوا أَوْ تُقَطَّعَ أَيْدِيهِمْ إِلَى آخِرِ الْآيَةِ",
            "chunk_type": "body",
            "word_end": 50,
            "word_start": 14
          },
          {
            "arabic_text": "فَقُلْتُ أَيُّ شَيْ‏ءٍ عَلَيْهِمْ مِنْ هَذِهِ الْحُدُودِ الَّتِي سَمَّى اللَّهُ عَزَّ وَ جَلَّ",
            "chunk_type": "body",
            "word_end": 63,
            "word_start": 50
          },
          {
            "arabic_text": "قَالَ ذَلِكَ إِلَى الْإِمَامِ إِنْ شَاءَ قَطَعَ وَ إِنْ شَاءَ صَلَبَ وَ إِنْ شَاءَ نَفَى وَ إِنْ شَاءَ قَتَلَ",
            "chunk_type": "body",
            "word_end": 82,
            "word_start": 63
          },
          {
            "arabic_text": "قُلْتُ النَّفْيُ إِلَى أَيْنَ قَالَ يُنْفَى مِنْ مِصْرٍ إِلَى مِصْرٍ آخَرَ",
            "chunk_type": "body",
            "word_end": 93,
            "word_start": 82
          },
          {
            "arabic_text": "وَ قَالَ إِنَّ عَلِيّاً ( عَلَيْهِ السَّلَامُ ) نَفَى رَجُلَيْنِ مِنَ الْكُوفَةِ إِلَى الْبَصْرَةِ",
            "chunk_type": "closing",
