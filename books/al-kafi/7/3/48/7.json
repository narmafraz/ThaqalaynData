        "chunks": [
          {
            "arabic_text": "عَلِيُّ بْنُ إِبْرَاهِيمَ عَنْ مُحَمَّدِ بْنِ عِيسَى عَنْ يُونُسَ عَنْ زُرْعَةَ عَنْ سَمَاعَةَ قَالَ",
            "chunk_type": "isnad",
            "word_end": 14,
            "word_start": 0
          },
          {
            "arabic_text": "سَأَلْتُهُ عَنْ شُهُودِ الزُّورِ قَالَ فَقَالَ يُجْلَدُونَ حَدّاً لَيْسَ لَهُ وَقْتٌ وَ ذَلِكَ إِلَى الْإِلَى الْإِمَامِ وَ يُطَافُ بِهِمْ حَتَّى يَعْرِفَهُمُ النَّاسُ",
            "chunk_type": "body",
            "word_end": 36,
            "word_start": 14
          },
          {
            "arabic_text": "وَ أَمَّا قَوْلُ اللَّهِ عَزَّ وَ جَلَّ وَ لَا تَقْبَلُوا لَهُمْ شَهادَةً أَبَداً... إِلَّا الَّذِينَ تابُوا",
            "chunk_type": "body",
            "word_end": 52,
            "word_start": 36
          },
          {
            "arabic_text": "قَالَ قُلْتُ كَيْفَ تُعْرَفُ تَوْبَتُهُ قَالَ يُكْذِبُ نَفْسَهُ عَلَى رُءُوسِ النَّاسِ حَتَّى يُضْرَبَ وَ يَسْتَغْفِرَ رَبَّهُ وَ إِذَا فَعَلَ ذَلِكَ فَقَدْ ظَهَرَتْ تَوْبَتُهُ",
            "chunk_type": "body",
