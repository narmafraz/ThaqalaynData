        "chunks": [
          {
            "arabic_text": "عَلِيٌّ عَنْ أَبِيهِ عَنِ ابْنِ أَبِي نَجْرَانَ عَنْ عَاصِمِ بْنِ حُمَيْدٍ عَنْ مُحَمَّدِ بْنِ قَيْسٍ عَنْ أَبِي جَعْفَرٍ ( عَلَيْهِ السَّلَامُ ) قَالَ",
            "chunk_type": "isnad",
            "word_end": 23,
            "word_start": 0
          },
          {
            "arabic_text": "قَضَى أَمِيرُ الْمُؤْمِنِينَ ( عَلَيْهِ السَّلَامُ ) فِي امْرَأَةٍ وَهَبَتْ جَارِيَتَهَا لِزَوْجِهَا فَوَقَعَ عَلَيْهَا فَحَمَلَتِ الْأَمَةُ فَأَنْكَرَتِ الْمَرْأَةُ أَنَّهَا وَهَبَتْهَا لَهُ وَ قَالَتْ هِيَ خَادِمِي فَلَمَّا خَشِيَتْ أَنْ يُقَامَ عَلَى الرَّجُلِ الْحَدُّ أَقَرَّتْ بِأَنَّهَا وَهَبَتْهَا لَهُ",
            "chunk_type": "body",
            "word_end": 59,
