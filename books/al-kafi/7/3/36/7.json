        "chunks": [
          {
            "arabic_text": "عَلِيُّ بْنُ إِبْرَاهِيمَ عَنْ أَبِيهِ وَ عِدَّةٌ مِنْ أَصْحَابِنَا عَنْ سَهْلِ بْنِ زِيَادٍ جَمِيعاً عَنِ ابْنِ أَبِي نَجْرَانَ عَنْ عَاصِمِ بْنِ حُمَيْدٍ عَنْ مُحَمَّدِ بْنِ قَيْسٍ عَنْ أَبِي جَعْفَرٍ ( عَلَيْهِ السَّلَامُ ) قَالَ",
            "chunk_type": "isnad",
            "word_end": 34,
            "word_start": 0
          },
          {
            "arabic_text": "قَضَى أَمِيرُ الْمُؤْمِنِينَ ( عَلَيْهِ السَّلَامُ ) فِي رَجُلٍ أُمِرَ بِهِ أَنْ يُقْطَعَ يَمِينُهُ فَقُدِّمَتْ شِمَالُهُ فَقَطَعُوهَا وَ حَسَبُوهَا يَمِينَهُ وَ قَالُوا إِنَّمَا قَطَعْنَا شِمَالَهُ أَ تُقْطَعُ يَمِينُهُ قَالَ فَقَالَ لَا يُقْطَعُ يَمِينُهُ وَ قَدْ قُطِعَتْ شِمَالُهُ",
            "chunk_type": "body",
            "word_end": 71,
            "word_start": 34
          },
          {
            "arabic_text": "وَقَالَ فِي رَجُلٍ أَخَذَ بَيْضَةً مِنَ الْمَغْنَمِ وَ قَالُوا قَدْ سَرَقَ اقْطَعْهُ فَقَالَ إِنِّي لَمْ أَقْطَعْ أَحَداً لَهُ فِيْمَا أَخَذَ شِرْكٌ",
