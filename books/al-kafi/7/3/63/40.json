        "chunks": [
          {
            "arabic_text": "عِدَّةٌ مِنْ أَصْحَابِنَا عَنْ سَهْلِ بْنِ زِيَادٍ عَنِ ابْنِ مَحْبُوبٍ عَنْ بَعْضِ أَصْحَابِهِ عَنْ أَبِي عَبْدِ اللَّهِ ( عَلَيْهِ السَّلَامُ ) قَالَ",
            "chunk_type": "isnad",
            "word_end": 22,
            "word_start": 0
          },
          {
            "arabic_text": "بَعَثَ أَمِيرُ الْمُؤْمِنِينَ ( عَلَيْهِ السَّلَامُ ) إِلَى بِشْرِ بْنِ عُطَارِدٍ التَّمِيمِيِّ فِي كَلَامٍ بَلَغَهُ فَمَرَّ بِهِ رَسُولُ أَمِيرِ الْمُؤْمِنِينَ ( عَلَيْهِ السَّلَامُ ) فِي بَنِي أَسَدٍ وَ أَخَذَهُ فَقَامَ إِلَيْهِ نُعَيْمُ بْنُ دَجَاجَةَ الْأَسَدِيُّ فَأَفْلَتَهُ",
            "chunk_type": "body",
            "word_end": 58,
            "word_start": 22
          },
          {
            "arabic_text": "فَبَعَثَ إِلَيْهِ أَمِيرُ الْمُؤْمِنِينَ ( عَلَيْهِ السَّلَامُ ) فَأَتَوْهُ بِهِ وَ أَمَرَ بِهِ أَنْ يُضْرَبَ فَقَالَ لَهُ نُعَيْمٌ أَمَا وَ اللَّهِ إِنَّ الْمُقَامَ مَعَكَ لَذُلٌّ وَ إِنَّ فِرَاقَكَ لَكُفْرٌ",
            "chunk_type": "body",
            "word_end": 87,
            "word_start": 58
          },
          {
            "arabic_text": "قَالَ فَلَمَّا سَمِعَ ذَلِكَ مِنْهُ قَالَ لَهُ يَا نُعَيْمُ قَدْ عَفَوْنَا عَنْكَ",
            "chunk_type": "body",
            "word_end": 99,
            "word_start": 87
          },
          {
            "arabic_text": "إِنَّ اللَّهَ عَزَّ وَ جَلَّ يَقُولُ ادْفَعْ بِالَّتِي هِيَ أَحْسَنُ السَّيِّئَةَ",
            "chunk_type": "quran_quote",
            "word_end": 110,
            "word_start": 99
          },
          {
            "arabic_text": "أَمَّا قَوْلُكَ إِنَّ الْمُقَامَ مَعَكَ لَذُلٌّ فَسَيِّئَةٌ اكْتَسَبْتَهَا وَ أَمَّا قَوْلُكَ إِنَّ فِرَاقَكَ لَكُفْرٌ فَحَسَنَةٌ اكْتَسَبْتَهَا فَهَذِهِ بِهَذِهِ",
            "chunk_type": "body",
            "word_end": 128,
            "word_start": 110
          },
          {
            "arabic_text": "ثُمَّ أَمَرَ أَنْ يُخَلَّى عَنْهُ",
