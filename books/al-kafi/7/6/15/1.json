            "chunk_type": "isnad",
            "word_end": 30,
            "word_start": 0
          },
          {
            "arabic_text": "إِذَا رَضِيَ صَاحِبُ الْحَقِّ بِيَمِينِ الْمُنْكِرِ لِحَقِّهِ فَاسْتَحْلَفَهُ فَحَلَفَ أَنْ لَا حَقَّ لَهُ قِبَلَهُ ذَهَبَتِ الْيَمِينُ بِحَقِّ الْمُدَّعِي فَلَا دَعْوَى لَهُ",
            "chunk_type": "body",
            "word_end": 51,
