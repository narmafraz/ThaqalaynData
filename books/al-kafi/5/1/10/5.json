            "word_end": 25,
            "word_start": 0
          },
          {
            "arabic_text": "لَمَّا هُزِمَ النَّاسُ يَوْمَ الْجَمَلِ قَالَ أَمِيرُ الْمُؤْمِنِينَ ( عَلَيْهِ السَّلَامُ ) لَا تَتْبَعُوا مُوَلِّياً وَ لَا تُجِيزُوا عَلَى جَرِيحٍ وَ مَنْ أَغْلَقَ بَابَهُ فَهُوَ آمِنٌ",
            "chunk_type": "body",
            "word_end": 51,
