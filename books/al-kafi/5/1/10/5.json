            "chunk_type": "body",
            "word_end": 63,
            "word_start": 51
          },
          {
            "arabic_text": "فَقَالَ أَبَانُ بْنُ تَغْلِبَ لِعَبْدِ اللَّهِ بْنِ شَرِيكٍ هَذِهِ سِيرَتَانِ مُخْتَلِفَتَانِ",
            "chunk_type": "body",
            "word_end": 74,
            "word_start": 63
          },
          {
            "arabic_text": "فَقَالَ إِنَّ أَهْلَ الْجَمَلِ قَتَلَ طَلْحَةَ وَ الزُّبَيْرَ وَ إِنَّ مُعَاوِيَةَ كَانَ قَائِمَاً بِعَيْنِهِ وَ كَانَ قَائِدَهُمْ.",
