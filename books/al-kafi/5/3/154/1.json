            "word_end": 31,
            "word_start": 0
          },
          {
            "arabic_text": "إِنَّ رَجُلًا مِنَ الْأَنْصَارِ عَلَى عَهْدِ رَسُولِ اللَّهِ ( صَلَّى اللَّهِ عَلَيْهِ وَآلِهِ ) خَرَجَ فِي بَعْضِ حَوَائِجِهِ فَعَهِدَ إِلَى امْرَأَتِهِ عَهْداً أَلَّا تَخْرُجَ مِنْ بَيْتِهَا حَتَّى يَقْدَمَ",
            "chunk_type": "body",
            "word_end": 59,
            "word_start": 31
          },
          {
            "arabic_text": "وَ إِنَّ أَبَاهَا مَرِضَ فَبَعَثَتِ الْمَرْأَةُ إِلَى النَّبِيِّ ( صَلَّى اللَّهِ عَلَيْهِ وَآلِهِ ) فَقَالَتْ إِنَّ زَوْجِي خَرَجَ وَ عَهِدَ إِلَيَّ أَنْ لَا أَخْرُجَ مِنْ بَيْتِي حَتَّى يَقْدَمَ وَ إِنَّ أَبِي قَدْ مَرِضَ فَتَأْمُرُنِي أَنْ أَعُودَهُ فَقَالَ رَسُولُ اللَّهِ ( صَلَّى اللَّهِ عَلَيْهِ وَآلِهِ ) لَا اجْلِسِي فِي بَيْتِكِ وَ أَطِيعِي زَوْجَكِ",
            "chunk_type": "body",
            "word_end": 111,
            "word_start": 59
          },
          {
            "arabic_text": "فَثَقُلَ فَأَرْسَلَتْ إِلَيْهِ ثَانِياً بِذَلِكَ فَقَالَتْ فَتَأْمُرُنِي أَنْ أَعُودَهُ فَقَالَ اجْلِسِي فِي بَيْتِكِ وَ أَطِيعِي زَوْجَكِ",
            "chunk_type": "body",
            "word_end": 127,
            "word_start": 111
          },
          {
            "arabic_text": "فَمَاتَ أَبُوهَا فَبَعَثَتْ إِلَيْهِ إِنَّ أَبِي قَدْ مَاتَ فَتَأْمُرُنِي أَنْ أُصَلِّيَ عَلَيْهِ فَقَالَ لَا اجْلِسِي فِي بَيْتِكِ وَ أَطِيعِي زَوْجَكِ",
