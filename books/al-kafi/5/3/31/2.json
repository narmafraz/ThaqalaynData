            "word_end": 20,
            "word_start": 0
          },
          {
            "arabic_text": "سَأَلْتُ أَبَا عَبْدِ اللَّهِ ( عَلَيْهِ السَّلَامُ ) عَنْ قَوْلِ اللَّهِ عَزَّ وَ جَلَّ الزَّانِي لَا يَنْكِحُ إِلَّا زانِيَةً أَوْ مُشْرِكَةً",
            "chunk_type": "body",
            "word_end": 41,
            "word_start": 20
          },
          {
            "arabic_text": "فَقَالَ كُنَّ نِسْوَةٌ مَشْهُورَاتٌ بِالزِّنَا وَ رِجَالٌ مَشْهُورُونَ بِالزِّنَا قَدْ عُرِفُوا بِذَلِكَ وَ النَّاسُ الْيَوْمَ بِتِلْكَ الْمَنْزِلَةِ",
            "chunk_type": "body",
            "word_end": 58,
            "word_start": 41
          },
          {
            "arabic_text": "فَمَنْ أُقِيمَ عَلَيْهِ حَدُّ الزِّنَا أَوْ شُهِرَ بِهِ لَمْ يَنْبَغِ لِأَحَدٍ أَنْ يُنَاكِحَهُ حَتَّى يَعْرِفَ مِنْهُ التَّوْبَةَ",
