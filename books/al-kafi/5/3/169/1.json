        "chunks": [
          {
            "arabic_text": "عِدَّةٌ مِنْ أَصْحَابِنَا عَنْ أَحْمَدَ بْنِ أَبِي عَبْدِ اللَّهِ عَنْ أَبِيهِ وَ مُحَمَّدُ بْنُ يَحْيَى عَنْ أَحْمَدَ بْنِ مُحَمَّدِ بْنِ عِيسَى عَنِ الْحُسَيْنِ بْنِ سَعِيدٍ جَمِيعاً عَنِ النَّضْرِ بْنِ سُوَيْدٍ عَنِ الْقَاسِمِ بْنِ سُلَيْمَانَ عَنْ جَرَّاحٍ الْمَدَائِنِيِّ عَنْ أَبِي عَبْدِ اللَّهِ ( عَلَيْهِ السَّلَامُ ) قَالَ",
            "chunk_type": "isnad",
            "word_end": 46,
            "word_start": 0
          },
          {
            "arabic_text": "لِيَسْتَأْذِنِ الَّذِينَ مَلَكَتْ أَيْمَانُكُمْ وَ الَّذِينَ لَمْ يَبْلُغُوا الْحُلُمَ مِنْكُمْ ثَلَاثَ مَرَّاتٍ كَمَا أَمَرَكُمُ اللَّهُ عَزَّ وَ جَلَّ",
            "chunk_type": "body",
            "word_end": 64,
            "word_start": 46
          },
          {
            "arabic_text": "و مَنْ بَلَغَ الْحُلُمَ فَلَا يَلِجُ عَلَى أُمِّهِ وَ لَا عَلَى أُخْتِهِ وَ لَا عَلَى خَالَتِهِ وَ لَا عَلَى سِوَى ذَلِكَ إِلَّا بِإِذْنٍ",
            "chunk_type": "body",
            "word_end": 87,
            "word_start": 64
          },
          {
            "arabic_text": "فَلَا تَأْذَنُوا حَتَّى يُسَلِّمَ وَ السَّلَامُ طَاعَةٌ لِلَّهِ عَزَّ وَ جَلَّ",
            "chunk_type": "body",
            "word_end": 98,
            "word_start": 87
          },
          {
            "arabic_text": "قَالَ وَ قَالَ أَبُو عَبْدِ اللَّهِ ( عَلَيْهِ السَّلَامُ ) لِيَسْتَأْذِنْ عَلَيْكَ خَادِمُكَ إِذَا بَلَغَ الْحُلُمَ فِي ثَلَاثِ عَوْرَاتٍ إِذَا دَخَلَ فِي شَيْ‏ءٍ مِنْهُنَّ وَ لَوْ كَانَ بَيْتُهُ فِي بَيْتِكَ",
            "chunk_type": "closing",
            "word_end": 128,
            "word_start": 98
          },
          {
            "arabic_text": "و لْيَسْتَأْذِنْ عَلَيْكَ بَعْدَ الْعِشَاءِ الَّتِي تُسَمَّى الْعَتَمَةَ وَ حِينَ تُصْبِحُ وَ حِينَ تَضَعُونَ ثِيَابَكُمْ مِنَ الظَّهِيرَةِ",
            "chunk_type": "closing",
            "word_end": 145,
            "word_start": 128
          },
          {
            "arabic_text": "إِنَّمَا أَمَرَ اللَّهُ عَزَّ وَ جَلَّ بِذَلِكَ لِلْخَلْوَةِ فَإِنَّهَا سَاعَةُ غِرَّةٍ وَ خَلْوَةٍ",
            "chunk_type": "closing",
            "word_end": 158,
            "word_start": 145
          }
