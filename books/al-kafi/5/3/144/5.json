            "chunk_type": "isnad",
            "word_end": 19,
            "word_start": 0
          },
          {
            "arabic_text": "قَالَ لِي أَبُو عَبْدِ اللَّهِ ( عَلَيْهِ السَّلَامُ ) يَا أَبَا مُحَمَّدٍ إِذَا أَتَيْتَ أَهْلَكَ فَأَيَّ شَيْءٍ تَقُولُ",
            "chunk_type": "body",
            "word_end": 37,
            "word_start": 19
          },
          {
            "arabic_text": "قُلْتُ جُعِلْتُ فِدَاكَ وَ أُطِيقُ أَنْ أَقُولَ شَيْئاً",
            "chunk_type": "body",
            "word_end": 45,
            "word_start": 37
          },
          {
            "arabic_text": "قَالَ بَلَى قُلِ اللَّهُمَّ بِكَلِمَاتِكَ اسْتَحْلَلْتُ فَرْجَهَا وَ بِأَمَانَتِكَ أَخَذْتُهَا",
            "chunk_type": "body",
            "word_end": 55,
            "word_start": 45
          },
          {
            "arabic_text": "فَإِنْ قَضَيْتَ فِي رَحِمِهَا شَيْئاً فَاجْعَلْهُ تَقِيّاً زَكِيّاً وَ لَا تَجْعَلْ لِلشَّيْطَانِ فِيهِ شِرْكا ً",
            "chunk_type": "body",
            "word_end": 70,
            "word_start": 55
          },
          {
            "arabic_text": "قَالَ قُلْتُ جُعِلْتُ فِدَاكَ وَ يَكُونُ فِيهِ شِرْكٌ لِلشَّيْطَانِ",
            "chunk_type": "body",
            "word_end": 79,
            "word_start": 70
          },
          {
            "arabic_text": "قَالَ نَعَمْ أَ مَا تَسْمَعُ قَوْلَ اللَّهِ عَزَّ وَ جَلَّ فِي كِتَابِهِ وَ شارِكْهُمْ فِي الْأَمْوالِ وَ الْأَوْلَادِ",
            "chunk_type": "body",
            "word_end": 97,
            "word_start": 79
          },
          {
            "arabic_text": "إِنَّ الشَّيْطَانَ يَجِي‏ءُ فَيَقْعُدُ كَمَا يَقْعُدُ الرَّجُلُ وَ يُنْزِلُ كَمَا يُنْزِلُ الرَّجُلُ",
            "chunk_type": "body",
            "word_end": 109,
            "word_start": 97
          },
          {
            "arabic_text": "قَالَ قُلْتُ بِأَيِّ شَيْ‏ءٍ يُعْرَفُ ذَلِكَ",
