            "word_end": 19,
            "word_start": 0
          },
          {
            "arabic_text": "سَأَلْتُ أَبَا عَبْدِ اللَّهِ ( عَلَيْهِ السَّلَامُ ) عَنْ قَوْلِ اللَّهِ عَزَّ وَ جَلَّ لَا يَحِلُّ لَكَ النِّسَاءُ مِنْ بَعْدُ وَ لَا أَنْ تَبَدَّلَ بِهِنَّ مِنْ أَزْوَاجٍ وَ لَوْ أَعْجَبَكَ حُسْنُهُنَّ إِلَّا مَا مَلَكَتْ يَمِينُكَ",
            "chunk_type": "body",
            "word_end": 54,
