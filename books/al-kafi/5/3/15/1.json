            "arabic_text": "عِدَّةٌ مِنْ أَصْحَابِنَا عَنْ سَهْلِ بْنِ زِيَادٍ وَ أَحْمَدَ بْنِ مُحَمَّدٍ عَنِ ابْنِ مَحْبُوبٍ عَنْ عَلِيِّ بْنِ رِئَابٍ عَنْ عَبْدِ الْأَعْلَى بْنِ أَعْيَنَ مَوْلَى آلِ سَامٍ عَنْ أَبِي عَبْدِ اللَّهِ ( عَلَيْهِ السَّلَامُ ) قَالَ",
            "chunk_type": "isnad",
            "word_end": 35,
            "word_start": 0
          },
          {
            "arabic_text": "قَالَ رَسُولُ اللَّهِ ( صَلَّى اللَّهِ عَلَيْهِ وَآلِهِ ) تَزَوَّجُوا الْأَبْكَارَ فَإِنَّهُنَّ أَطْيَبُ شَيْ‏ءٍ أَفْوَاهاً",
            "chunk_type": "body",
            "word_end": 50,
            "word_start": 35
          },
          {
            "arabic_text": "وَ فِي حَدِيثٍ آخَرَ وَ أَنْشَفُهُ أَرْحَامَاً وَ أَدَرُّ شَيْ‏ءٍ أَخْلَافاً وَ أَفْتَحُ شَيْ‏ءٍ أَرْحَامَاً",
            "chunk_type": "body",
            "word_end": 65,
            "word_start": 50
          },
          {
            "arabic_text": "أَ مَا عَلِمْتُمْ أَنِّي أُبَاهِي بِكُمُ الْأُمَمَ يَوْمَ الْقِيَامَةِ حَتَّى بِالسِّقْطِ يَظَلُّ مُحْبَنْطِئاً عَلَى بَابِ الْجَنَّةِ",
            "chunk_type": "body",
            "word_end": 81,
            "word_start": 65
          },
          {
            "arabic_text": "فَيَقُولُ اللَّهُ عَزَّ وَ جَلَّ ادْخُلِ الْجَنَّةَ فَيَقُولُ لَا أَدْخُلُ حَتَّى يَدْخُلَ أَبَوَايَ قَبْلِي",
            "chunk_type": "body",
            "word_end": 95,
            "word_start": 81
          },
          {
            "arabic_text": "فَيَقُولُ اللَّهُ تَبَارَكَ وَ تَعَالَى لِمَلَكٍ مِنَ الْمَلَائِكَةِ ائْتِنِي بِأَبَوَيْهِ فَيَأْمُرُ بِهِمَا إِلَى الْجَنَّةِ",
            "chunk_type": "body",
            "word_end": 109,
