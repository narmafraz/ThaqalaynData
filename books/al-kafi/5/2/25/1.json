            "chunk_type": "isnad",
            "word_end": 16,
            "word_start": 0
          },
          {
            "arabic_text": "دَخَلَ رَجُلٌ عَلَى أَبِي عَبْدِ اللَّهِ ( عَلَيْهِ السَّلَامُ ) فَشَكَا إِلَيْهِ رَجُلًا مِنْ أَصْحَابِهِ فَلَمْ يَلْبَثْ أَنْ جَاءَ الْمَشْكُوُّ",
            "chunk_type": "opening",
            "word_end": 36,
            "word_start": 16
          },
          {
            "arabic_text": "فَقَالَ لَهُ أَبُو عَبْدِ اللَّهِ ( عَلَيْهِ السَّلَامُ ) مَا لِفُلَانٍ يَشْكُوكَ فَقَالَ لَهُ يَشْكُونِي أَنِّي اسْتَقْضَيْتُ مِنْهُ حَقِّي",
            "chunk_type": "body",
            "word_end": 55,
            "word_start": 36
          },
          {
            "arabic_text": "قَالَ فَجَلَسَ أَبُو عَبْدِ اللَّهِ ( عَلَيْهِ السَّلَامُ ) مُغْضَباً ثُمَّ قَالَ كَأَنَّكَ إِذَا اسْتَقْضَيْتَ حَقَّكَ لَمْ تُسِئْ",
            "chunk_type": "body",
            "word_end": 73,
            "word_start": 55
          },
          {
            "arabic_text": "يَخافُونَ سُوءَ الْحِسَابِ",
            "chunk_type": "quran_quote",
            "word_end": 76,
            "word_start": 73
          },
          {
            "arabic_text": "أَتَرَى أَنَّهُمْ خَافُوا اللَّهَ أَنْ يَجُورَ عَلَيْهِمْ لَا وَ اللَّهِ مَا خَافُوا إِلَّا الِاسْتِقْضَاءَ فَسَمَّاهُ اللَّهُ عَزَّ وَ جَلَّ سُوءَ الْحِسَابِ",
