          {
            "arabic_text": "عَلِيُّ بْنُ إِبْرَاهِيمَ عَنْ مُحَمَّدِ بْنِ عِيسَى عَنْ يُونُسَ بْنِ عَبْدِ الرَّحْمَنِ قَالَ",
            "chunk_type": "isnad",
            "word_end": 13,
            "word_start": 0
          },
          {
            "arabic_text": "سَأَلْتُ عَبْداً صَالِحاً فَقُلْتُ جُعِلْتُ فِدَاكَ كُنَّا مُرَافِقِينَ لِقَوْمٍ بِمَكَّةَ فَارْتَحَلْنَا عَنْهُمْ وَ حَمَلْنَا بَعْضَ مَتَاعِهِمْ بِغَيْرِ عِلْمٍ وَ قَدْ ذَهَبَ الْقَوْمُ وَ لَا نَعْرِفُهُمْ وَ لَا نَعْرِفُ أَوْطَانَهُمْ فَقَدْ بَقِيَ الْمَتَاعُ عِنْدَنَا فَمَا نَصْنَعُ بِهِ",
            "chunk_type": "body",
            "word_end": 49,
            "word_start": 13
          },
          {
            "arabic_text": "قَالَ فَقَالَ تَحْمِلُونَهُ حَتَّى تَلْحَقُوهُمْ بِالْكُوفَةِ",
            "chunk_type": "body",
            "word_end": 55,
            "word_start": 49
          },
          {
            "arabic_text": "فَقَالَ يُونُسُ قُلْتُ لَهُ لَسْتُ أَعْرِفُهُمْ وَ لَا نَدْرِي كَيْفَ نَسْأَلُ عَنْهُمْ",
            "chunk_type": "body",
            "word_end": 67,
            "word_start": 55
          },
          {
            "arabic_text": "قَالَ فَقَالَ بِعْهُ وَ أَعْطِ ثَمَنَهُ أَصْحَابَكَ",
            "chunk_type": "body",
            "word_end": 74,
            "word_start": 67
          },
          {
            "arabic_text": "فَقُلْتُ جُعِلْتُ فِدَاكَ أَهْلَ الْوَلَايَةِ",
            "chunk_type": "body",
            "word_end": 79,
