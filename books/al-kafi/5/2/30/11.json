        "chunks": [
          {
            "arabic_text": "عَلِيُّ بْنُ إِبْرَاهِيمَ عَنْ أَبِيهِ وَ عَلِيِّ بْنِ مُحَمَّدٍ الْقَاسَانِيِّ عَنِ الْقَاسِمِ بْنِ مُحَمَّدٍ عَنْ سُلَيْمَانَ الْمِنْقَرِيِّ عَنْ فُضَيْلِ بْنِ عِيَاضٍ قَالَ",
            "chunk_type": "isnad",
            "word_end": 22,
            "word_start": 0
          },
          {
            "arabic_text": "سَأَلْتُ أَبَا عَبْدِ اللَّهِ ( عَلَيْهِ السَّلَامُ ) عَنْ أَشْيَاءَ مِنَ الْمَكَاسِبِ فَنَهَانِي عَنْهَا فَقَالَ يَا فُضَيْلُ وَ اللَّهِ لَضَرَرُ هَؤُلَاءِ عَلَى هَذِهِ الْأُمَّةِ أَشَدُّ مِنْ ضَرَرِ التُّرْكِ وَ الدَّيْلَمِ",
            "chunk_type": "body",
            "word_end": 52,
            "word_start": 22
          },
          {
            "arabic_text": "قَالَ وَ سَأَلْتُهُ عَنِ الْوَرَعِ مِنَ النَّاسِ قَالَ الَّذِي يَتَوَرَّعُ عَنْ مَحَارِمِ اللَّهِ عَزَّ وَ جَلَّ وَ يَجْتَنِبُ هَؤُلَاءِ",
            "chunk_type": "body",
            "word_end": 71,
            "word_start": 52
          },
          {
            "arabic_text": "وَ إِذَا لَمْ يَتَّقِ الشُّبُهَاتِ وَقَعَ فِي الْحَرَامِ وَ هُوَ لَا يَعْرِفُهُ",
            "chunk_type": "body",
            "word_end": 83,
            "word_start": 71
          },
          {
            "arabic_text": "وَ إِذَا رَأَى الْمُنْكَرَ فَلَمْ يُنْكِرْهُ وَ هُوَ يَقْدِرُ عَلَيْهِ فَقَدْ أَحَبَّ أَنْ يُعْصَى اللَّهُ عَزَّ وَ جَلَّ",
            "chunk_type": "body",
            "word_end": 101,
            "word_start": 83
          },
          {
            "arabic_text": "وَ مَنْ أَحَبَّ أَنْ يُعْصَى اللَّهُ فَقَدْ بَارَزَ اللَّهَ عَزَّ وَ جَلَّ بِالْعَدَاوَةِ",
            "chunk_type": "body",
            "word_end": 114,
            "word_start": 101
          },
          {
            "arabic_text": "وَ مَنْ أَحَبَّ بَقَاءَ الظَّالِمِينَ فَقَدْ أَحَبَّ أَنْ يُعْصَى اللَّهُ",
            "chunk_type": "body",
            "word_end": 124,
            "word_start": 114
          },
          {
            "arabic_text": "إِنَّ اللَّهَ تَعَالَى حَمِدَ نَفْسَهُ عَلَى هَلَاكِ الظَّالِمِينَ فَقَالَ",
            "chunk_type": "body",
            "word_end": 133,
            "word_start": 124
          },
          {
            "arabic_text": "فَقُطِعَ دَابِرُ الْقَوْمِ الَّذِينَ ظَلَمُوا وَ الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ",
            "chunk_type": "quran_quote",
