        "chunks": [
          {
            "arabic_text": "مُحَمَّدُ بْنُ يَحْيَى عَنْ أَحْمَدَ بْنِ مُحَمَّدٍ عَنِ ابْنِ مَحْبُوبٍ عَنْ هِشَامِ بْنِ سَالِمٍ عَنْ أَبِي خَالِدٍ الْكَابُلِيِّ عَنْ أَبِي جَعْفَرٍ ( عَلَيْهِ السَّلَامُ ) قَالَ",
            "chunk_type": "isnad",
            "word_end": 26,
            "word_start": 0
          },
          {
            "arabic_text": "وَجَدْنَا فِي كِتَابِ عَلِيٍّ ( عَلَيْهِ السَّلَامُ ) إِنَّ الْأَرْضَ لِلَّهِ يُورِثُهَا مَنْ يَشَاءُ مِنْ عِبَادِهِ وَالْعَاقِبَةُ لِلْمُتَّقِينَ أَنَا وَأَهْلُ بَيْتِيَ الَّذِينَ أَوْرَثَنَا الْأَرْضَ وَنَحْنُ الْمُتَّقُونَ وَالْأَرْضُ كُلُّهَا لَنَا",
            "chunk_type": "body",
            "word_end": 55,
            "word_start": 26
          },
          {
            "arabic_text": "فَمَنْ أَحْيَا أَرْضًا مِنَ الْمُسْلِمِينَ فَلْيُعْمِرْهَا وَلْيُؤَدِّ خَرَاجَهَا إِلَى الْإِمَامِ مِنْ أَهْلِ بَيْتِي وَلَهُ مَا أَكَلَ مِنْهَا",
            "chunk_type": "body",
            "word_end": 72,
            "word_start": 55
          },
          {
            "arabic_text": "فَإِنْ تَرَكَهَا أَوْ أَخْرَبَهَا فَأَخَذَهَا رَجُلٌ مِنَ الْمُسْلِمِينَ مِنْ بَعْدِهِ فَعَمَرَهَا وَأَحْيَاهَا فَهُوَ أَحَقُّ بِهَا مِنَ الَّذِي تَرَكَهَا فَلْيُؤَدِّ خَرَاجَهَا إِلَى الْإِمَامِ مِنْ أَهْلِ بَيْتِي وَلَهُ مَا أَكَلَ",
            "chunk_type": "body",
            "word_end": 100,
            "word_start": 72
          },
          {
            "arabic_text": "حَتَّى يَظْهَرَ الْقَائِمُ ( عَلَيْهِ السَّلَامُ ) مِنْ أَهْلِ بَيْتِي بِالسَّيْفِ فَيَحْوِيَهَا وَيَمْنَعَهَا وَيُخْرِجَهُمْ مِنْهَا كَمَا حَوَاهَا رَسُولُ اللَّهِ ( صَلَّى اللَّهِ عَلَيْهِ وَآلِهِ ) وَمَنَعَهَا",
            "chunk_type": "body",
            "word_end": 126,
            "word_start": 100
          },
          {
            "arabic_text": "إِلَّا مَا كَانَ فِي أَيْدِي شِيعَتِنَا فَإِنَّهُ يُقَاطِعُهُمْ عَلَى مَا فِي أَيْدِيهِمْ وَيَتْرُكُ الْأَرْضَ فِي أَيْدِيهِمْ",
            "chunk_type": "body",
