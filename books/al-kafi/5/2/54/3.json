        "chunks": [
          {
            "arabic_text": "عِدَّةٌ مِنْ أَصْحَابِنَا عَنْ سَهْلِ بْنِ زِيَادٍ وَ أَحْمَدُ بْنُ مُحَمَّدٍ وَ عَلِيُّ بْنُ إِبْرَاهِيمَ عَنْ أَبِيهِ جَمِيعاً عَنِ ابْنِ مَحْبُوبٍ عَنْ عَمْرِو بْنِ أَبِي الْمِقْدَامِ عَنْ جَابِرٍ عَنْ أَبِي جَعْفَرٍ ( عَلَيْهِ السَّلَامُ ) قَالَ",
            "chunk_type": "isnad",
            "word_end": 36,
            "word_start": 0
          },
          {
            "arabic_text": "كَانَ أَمِيرُ الْمُؤْمِنِينَ ( عَلَيْهِ السَّلَامُ ) بِالْكُوفَةِ عِنْدَكُمْ يَغْتَدِي كُلَّ يَوْمٍ بُكْرَةً مِنَ الْقَصْرِ فَيَطُوفُ فِي أَسْوَاقِ الْكُوفَةِ سُوقاً سُوقاً وَ مَعَهُ الدِّرَّةُ عَلَى عَاتِقِهِ وَ كَانَ لَهَا طَرَفَانِ وَ كَانَتْ تُسَمَّى السَّبِيبَةَ",
            "chunk_type": "body",
            "word_end": 70,
            "word_start": 36
          },
          {
            "arabic_text": "فَيَقِفُ عَلَى أَهْلِ كُلِّ سُوقٍ فَيُنَادِي يَا مَعْشَرَ التُّجَّارِ اتَّقُوا اللَّهَ عَزَّ وَ جَلَّ فَإِذَا سَمِعُوا صَوْتَهُ ( عَلَيْهِ السَّلَامُ ) أَلْقَوْا مَا بِأَيْدِيهِمْ وَ أَرْعَوْا إِلَيْهِ بِقُلُوبِهِمْ وَ سَمِعُوا بِآذَانِهِمْ",
            "chunk_type": "body",
            "word_end": 101,
            "word_start": 70
          },
          {
            "arabic_text": "فَيَقُولُ ( عَلَيْهِ السَّلَامُ ) قَدِّمُوا الِاسْتِخَارَةَ وَ تَبَرَّكُوا بِالسُّهُولَةِ وَ اقْتَرِبُوا مِنَ الْمُبْتَاعِينَ وَ تَزَيَّنُوا بِالْحِلْمِ وَ تَنَاهَوْا عَنِ الْيَمِينِ وَ جَانِبُوا الْكَذِبَ وَ تَجَافَوْا عَنِ الظُّلْمِ وَ أَنْصِفُوا الْمَظْلُومِينَ وَ لَا تَقْرَبُوا الرِّبَا وَ أَوْفُوا الْكَيْلَ وَ الْمِيزَانَ وَ لَا تَبْخَسُوا النَّاسَ أَشْياءَهُمْ وَ لَا تَعْثَوْا فِي الْأَرْضِ مُفْسِدِينَ",
            "chunk_type": "body",
            "word_end": 152,
            "word_start": 101
          },
          {
            "arabic_text": "فَيَطُوفُ ( عَلَيْهِ السَّلَامُ ) فِي جَمِيعِ أَسْوَاقِ الْكُوفَةِ ثُمَّ يَرْجِعُ فَيَقْعُدُ لِلنَّاسِ",
            "chunk_type": "closing",
            "word_end": 165,
            "word_start": 152
          }
