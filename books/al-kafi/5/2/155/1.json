          {
            "arabic_text": "عَلِيُّ بْنُ إِبْرَاهِيمَ [عَنْ أَبِيهِ] عَنْ مُحَمَّدِ بْنِ عِيسَى عَنْ يُونُسَ وَ عِدَّةٌ مِنْ أَصْحَابِنَا عَنْ أَحْمَدَ بْنِ أَبِي عَبْدِ اللَّهِ عَنْ أَبِيهِ جَمِيعاً عَنْ يُونُسَ عَنْ عَبْدِ اللَّهِ بْنِ سِنَانٍ وَ ابْنِ مُسْكَانَ عَنْ أَبِي الْجَارُودِ قَالَ",
            "chunk_type": "isnad",
            "word_end": 38,
            "word_start": 0
          },
          {
            "arabic_text": "قَالَ أَبُو جَعْفَرٍ ( عَلَيْهِ السَّلَامُ ) إِذَا حَدَّثْتُكُمْ بِشَيْ‏ءٍ فَاسْأَلُونِي عَنْ كِتَابِ اللَّهِ",
            "chunk_type": "body",
            "word_end": 52,
            "word_start": 38
          },
          {
            "arabic_text": "ثُمَّ قَالَ فِي حَدِيثِهِ إِنَّ اللَّهَ نَهَى عَنِ الْقِيلِ وَ الْقَالِ وَ فَسَادِ الْمَالِ وَ كَثْرَةِ السُّؤَالِ",
            "chunk_type": "body",
            "word_end": 69,
            "word_start": 52
          },
          {
            "arabic_text": "فَقَالُوا يَا ابْنَ رَسُولِ اللَّهِ وَ أَيْنَ هَذَا مِنْ كِتَابِ اللَّهِ",
            "chunk_type": "body",
            "word_end": 80,
            "word_start": 69
          },
          {
            "arabic_text": "قَالَ إِنَّ اللَّهَ عَزَّ وَ جَلَّ يَقُولُ فِي كِتَابِهِ لَا خَيْرَ فِي كَثِيرٍ مِنْ نَجْواهُمْ الْآيَةَ",
            "chunk_type": "body",
            "word_end": 96,
            "word_start": 80
          },
          {
            "arabic_text": "وَ قَالَ وَ لَا تُؤْتُوا السُّفَهاءَ أَمْوالَكُمُ الَّتِي جَعَلَ اللَّهُ لَكُمْ قِيامَاً",
            "chunk_type": "quran_quote",
            "word_end": 108,
            "word_start": 96
          },
          {
            "arabic_text": "وَ قَالَ لَا تَسْئَلُوا عَنْ أَشْياءَ إِنْ تُبْدَ لَكُمْ تَسُؤْكُمْ",
            "chunk_type": "quran_quote",
            "word_end": 118,
            "word_start": 108
          }
